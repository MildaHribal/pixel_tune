#!/system/bin/sh
#
# pxtune-doze - let the phone actually suspend
#               Google Pixel 8a "akita" / Tensor G3 "zuma" / Android 16 / KernelSU-Next
#
# POSIX sh (toybox/mksh). No bashisms.
# Exit codes: 0 = OK, 1 = argument error, 2 = runtime error.
#
# ===========================================================================
# WHAT THIS IS FOR
# ===========================================================================
#
# This does NOT implement Android Doze - Android already has that and it works.
# What it does is remove the thing that BLOCKS it: a permanent PARTIAL_WAKE_LOCK
# held by a foreground app (here Termux, which keeps a remote-control bot and an
# SSH tunnel alive).
#
# Measured on this device with the Termux wake lock held permanently:
#   /sys/power/suspend_stats/success = 0   (the SoC never suspended, not once)
#   idle drain with the screen off   = 133 mA median (207 mA mean)
#   skin temperature at rest         = 33-34 C instead of ambient
# For comparison, a Pixel 8a in real suspend idles at roughly 15-30 mA.
#
# The trade-off is explicit: while the wake lock is released the phone can be
# unreachable (the bot only answers once something wakes the device). That is
# why the release is delayed, why charging can keep the phone awake, and why
# every path re-acquires the lock.
#
# ===========================================================================
# HOW IT WORKS
# ===========================================================================
#
# One loop, no timers that wake the device:
#
#   screen ON            -> hold the wake lock, poll every POLL_ON seconds
#   screen OFF           -> wait DELAY_SEC, then release the wake lock
#   screen OFF, released -> poll every POLL_OFF seconds
#
# The poll loop is deliberately a plain `sleep`. A plain sleep does NOT arm an
# RTC alarm, so it cannot wake the device: while the phone is suspended the loop
# is frozen along with everything else and costs nothing. It resumes when the
# phone wakes for its own reasons (screen, alarm, push, incoming call).
#
# ===========================================================================
# CONFIGURATION - $STATE/doze.conf (read through a whitelist, NOT sourced)
# ===========================================================================
#
#   DELAY_SEC=300        how long the screen must stay off before releasing
#   KEEP_WHEN_CHARGING=1 1 = stay awake while charging (the bot stays reachable
#                        and there is no battery to save), 0 = sleep anyway
#   POLL_ON=30           poll period while the screen is on (seconds)
#   POLL_OFF=60          poll period while the screen is off
#   WAKELOCK=termux      which foreign wake lock to manage: termux | none
#   TERMUX_UID=10384     the Termux uid; changes when Termux is reinstalled

MODDIR=${0%/*}
case "$MODDIR" in
/*) ;;
*) MODDIR=/data/adb/modules/pixel_tune/bin ;;
esac

STATE=/data/adb/pixel_tune
LOG="$STATE/pxtune.log"
LOG_MAX=524288
ONF="$STATE/doze.on"                 # exists = enabled, survives a reboot
CONF="$STATE/doze.conf"
PIDF="$STATE/pxtune-doze.pid"
HELDF="$STATE/.doze_released"        # exists = WE released the wake lock

PXTUNE_DOZE_VERSION="1.0.0"

# defaults
DELAY_SEC=300
KEEP_WHEN_CHARGING=1
POLL_ON=30
POLL_OFF=60
WAKELOCK=termux
TERMUX_UID=10384

BACKLIGHT=/sys/class/backlight/panel0-backlight/brightness
BATT_STATUS=/sys/class/power_supply/battery/status
SUSPEND_OK=/sys/power/suspend_stats/success
SUSPEND_FAIL=/sys/power/suspend_stats/fail

# ---------------------------------------------------------------------------
# helpers (same conventions as bin/pxtune: no forks in the hot path)
# ---------------------------------------------------------------------------
log() {
	_lvl="$1"
	shift
	[ -d "$STATE" ] || return 0
	if [ -f "$LOG" ]; then
		_sz=$(stat -c %s "$LOG" 2>/dev/null)
		case "$_sz" in
		'' | *[!0-9]*) _sz=0 ;;
		esac
		[ "$_sz" -gt "$LOG_MAX" ] && mv -f "$LOG" "$LOG.old" 2>/dev/null
	fi
	{ echo "[$(date '+%Y-%m-%d %H:%M:%S')] [$_lvl] $*" >>"$LOG"; } 2>/dev/null
	return 0
}

warn() { echo "$*" >&2; }

# rdv <path> <default> -> V   (builtin read, no fork; see SPEC "PERFORMANCE")
rdv() {
	V="$2"
	[ -r "$1" ] || return 0
	read -r V <"$1" 2>/dev/null || V="$2"
	[ -n "$V" ] || V="$2"
}

load_conf() {
	[ -f "$CONF" ] || return 0
	while IFS='=' read -r _k _v; do
		case "$_k" in
		DELAY_SEC | KEEP_WHEN_CHARGING | POLL_ON | POLL_OFF | TERMUX_UID)
			case "$_v" in
			'' | *[!0-9]*) continue ;;
			esac
			eval "$_k=\$_v"
			;;
		WAKELOCK)
			case "$_v" in
			termux | none) WAKELOCK="$_v" ;;
			esac
			;;
		esac
	done <"$CONF"
}

screen_on() {
	rdv "$BACKLIGHT" 0
	[ "$V" != "0" ]
}

charging() {
	rdv "$BATT_STATUS" Unknown
	case "$V" in
	Charging | Full) return 0 ;;
	esac
	return 1
}

# ---------------------------------------------------------------------------
# The foreign wake lock.
#
# Termux exposes it as two service actions. Sending the intent is preferred:
# it works even when the Termux shell environment is not set up. The fallback
# runs the packaged termux-wake-* helper as the Termux uid (the same pattern
# volkeys.sh uses for termux-torch), with group 3003 (inet) so it can talk.
# ---------------------------------------------------------------------------
TERMUX_PREFIX=/data/data/com.termux/files/usr
TERMUX_HOME=/data/data/com.termux/files/home

wl_intent() {
	am startservice --user 0 -a "com.termux.service_$1" \
		com.termux/com.termux.app.TermuxService >/dev/null 2>&1
}

wl_helper() {
	su -G 3003 "$TERMUX_UID" -c "export PREFIX=$TERMUX_PREFIX HOME=$TERMUX_HOME \
PATH=$TERMUX_PREFIX/bin:$TERMUX_PREFIX/bin/applets:/system/bin \
LD_LIBRARY_PATH=$TERMUX_PREFIX/lib TMPDIR=$TERMUX_PREFIX/tmp; termux-$1" \
		>/dev/null 2>&1
}

wake_release() {
	[ "$WAKELOCK" = "none" ] && return 0
	wl_intent wake_unlock || wl_helper wake-unlock
	: >"$HELDF" 2>/dev/null
	log INFO "doze: wake lock released (screen off ${DELAY_SEC}s)"
}

wake_acquire() {
	[ "$WAKELOCK" = "none" ] && return 0
	wl_intent wake_lock || wl_helper wake-lock
	rm -f "$HELDF" 2>/dev/null
	log INFO "doze: wake lock re-acquired"
}

# ---------------------------------------------------------------------------
# the loop
# ---------------------------------------------------------------------------
run() {
	load_conf
	echo $$ >"$PIDF" 2>/dev/null
	trap 'wake_acquire; rm -f "$PIDF"; exit 0' TERM INT HUP

	log INFO "doze: daemon started (delay=${DELAY_SEC}s charging_keeps_awake=$KEEP_WHEN_CHARGING wakelock=$WAKELOCK)"

	_off_since=0
	_released=0
	rdv "$SUSPEND_OK" 0
	_susp0="$V"

	while [ -f "$ONF" ]; do
		if screen_on; then
			if [ "$_released" = "1" ]; then
				wake_acquire
				_released=0
				rdv "$SUSPEND_OK" 0
				_d=$((V - _susp0))
				[ "$_d" -gt 0 ] && log INFO "doze: woke up, $_d suspend cycles since the last release"
				_susp0="$V"
			fi
			_off_since=0
			sleep "$POLL_ON"
			continue
		fi

		# screen is off
		if [ "$KEEP_WHEN_CHARGING" = "1" ] && charging; then
			if [ "$_released" = "1" ]; then
				wake_acquire
				_released=0
			fi
			_off_since=0
			sleep "$POLL_OFF"
			continue
		fi

		if [ "$_released" = "0" ]; then
			if [ "$_off_since" = "0" ]; then
				_off_since=$(date +%s 2>/dev/null)
				case "$_off_since" in '' | *[!0-9]*) _off_since=0 ;; esac
			else
				_now=$(date +%s 2>/dev/null)
				case "$_now" in '' | *[!0-9]*) _now=$_off_since ;; esac
				if [ $((_now - _off_since)) -ge "$DELAY_SEC" ]; then
					wake_release
					_released=1
				fi
			fi
		fi
		sleep "$POLL_OFF"
	done

	# the flag was removed -> put everything back the way we found it
	wake_acquire
	rm -f "$PIDF" 2>/dev/null
	log INFO "doze: daemon stopped"
}

running_pid() {
	RP=""
	[ -f "$PIDF" ] || return 1
	read -r RP <"$PIDF" 2>/dev/null || return 1
	case "$RP" in
	'' | *[!0-9]*) RP=""; return 1 ;;
	esac
	[ -d "/proc/$RP" ] || { RP=""; return 1; }
	grep -q 'pxtune-doze' "/proc/$RP/cmdline" 2>/dev/null || { RP=""; return 1; }
	return 0
}

do_start() {
	if running_pid; then
		echo "pxtune doze: already running (pid $RP)"
		return 0
	fi
	: >"$ONF" 2>/dev/null
	setsid "$0" run >/dev/null 2>&1 </dev/null &
	sleep 1
	if running_pid; then
		echo "pxtune doze: enabled (pid $RP)"
	else
		warn "pxtune doze: the daemon did not start"
		return 2
	fi
}

do_stop() {
	rm -f "$ONF" 2>/dev/null
	if running_pid; then
		kill "$RP" 2>/dev/null
		sleep 1
	fi
	# whatever happened, the phone must not be left without its wake lock
	load_conf
	wake_acquire
	echo "pxtune doze: disabled, wake lock restored"
}

do_status() {
	load_conf
	echo "pxtune doze $PXTUNE_DOZE_VERSION"
	if [ -f "$ONF" ]; then
		if running_pid; then
			echo "  state          : ENABLED (pid $RP)"
		else
			echo "  state          : ENABLED but NOT RUNNING (start it: pxtune doze on)"
		fi
	else
		echo "  state          : disabled"
	fi
	rdv "$SUSPEND_OK" 0;   echo "  suspends OK    : $V"
	rdv "$SUSPEND_FAIL" 0; echo "  suspends failed: $V"
	rdv "$BACKLIGHT" 0;    echo "  backlight      : $V"
	rdv "$BATT_STATUS" '?'; echo "  charging       : $V"
	if [ -f "$HELDF" ]; then
		echo "  wake lock      : released by pxtune"
	else
		echo "  wake lock      : held (normal state)"
	fi
	echo "  config         : delay=${DELAY_SEC}s charging_keeps_awake=$KEEP_WHEN_CHARGING poll=${POLL_ON}/${POLL_OFF}s wakelock=$WAKELOCK"
	echo
	echo "  wake locks currently held:"
	dumpsys power 2>/dev/null | sed -n '/Wake Locks: size=/,/^$/p' | sed 's/^/    /' | head -12
}

case "${1:-}" in
on | start) do_start ;;
off | stop) do_stop ;;
status | '') do_status ;;
run) run ;;
*)
	warn "pxtune doze: usage: pxtune doze <on|off|status>"
	exit 1
	;;
esac
