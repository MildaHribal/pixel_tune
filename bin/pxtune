#!/system/bin/sh
#
# pxtune - CLI jadro kernel manageru pixel_tune
# Google Pixel 8a "akita" / Tensor G3 "zuma" / Android 16 / KernelSU-Next
#
# POSIX sh (toybox/mksh). ZADNE bashismy.
# Exit kody: 0 = OK, 1 = chyba argumentu, 2 = chyba behu.
#
# Vsechny cesty a hodnoty pochazi ze SPEC.md. Nic tady neni odhadnute.
#
# DULEZITE: "status --json" cte VYHRADNE sysfs. Zadny dumpsys, zadne cmd,
# zadne settings - tedy zadny binder. WebUI ho vola pres ksu.exec (root shell)
# kazdych 5 s a dumpsys pod su na tomhle zarizeni visi na binderu.

PXTUNE_VERSION="1.3.0"

# ---------------------------------------------------------------------------
# Cesty
# ---------------------------------------------------------------------------
STATE_DIR="/data/adb/pixel_tune"
PROFILE_DIR="$STATE_DIR/profiles"
BACKUP_DIR="$STATE_DIR/backup"
STOCK_CONF="$BACKUP_DIR/stock.conf"
ACTIVE_FILE="$STATE_DIR/active"
OVERRIDE_FILE="$STATE_DIR/manual_override"
AUTO_FILE="$STATE_DIR/auto"
DISABLE_FILE="$STATE_DIR/DISABLE"
BOOTCNT_FILE="$STATE_DIR/boot_count"
RESPEND_FILE="$STATE_DIR/res_pending"
DISPSTATE_FILE="$STATE_DIR/display_state"
LOG_FILE="$STATE_DIR/pxtune.log"
LOG_MAX=524288

# Adaptivni demon (bin/pxtune-auto). Cesta se odvozuje od umisteni tohoto
# skriptu, aby to fungovalo i kdyz je modul jinde nez v /data/adb/modules.
AUTOD="$(dirname "$0")/pxtune-auto"
AUTOD_PID="$STATE_DIR/pxtune-auto.pid"

# Per-app profily (bin/pxtune-perapp). Stejne odvozeni cesty jako u AUTOD.
# Proc je to samostatny soubor a ne dalsi funkce tady: "status --json" vola
# WebUI kazdych 5 s pres synchronni most, takze kazdy radek navic v tomhle
# skriptu stoji cas i tehdy, kdyz se per-app profily vubec nepouzivaji.
PERAPP="$(dirname "$0")/pxtune-perapp"
[ -x "$PERAPP" ] || PERAPP="/data/adb/modules/pixel_tune/bin/pxtune-perapp"
APPDIR="$STATE_DIR/apps"
APPMODE="$STATE_DIR/appmode.active"

CPUCTL="/dev/cpuctl"
MALI="/sys/class/misc/mali0/device"
CHARGER="/sys/devices/platform/google,charger"
BATT="/sys/class/power_supply/battery"
ZRAM="/sys/block/zram0"
THERMAL="/sys/class/thermal"
CPUFREQ="/sys/devices/system/cpu/cpufreq"

# absolutni cesta k sobe samemu (kvuli res watchdogu na pozadi)
case "$0" in
	/*) SELF="$0" ;;
	*)  SELF="$PWD/$0" ;;
esac

# ---------------------------------------------------------------------------
# Overena HW data (SPEC.md -> "OVERENA HARDWAROVA FAKTA")
# Frekvence CPU vzestupne, kHz.
# ---------------------------------------------------------------------------
FREQ_P0="324000 610000 820000 955000 1098000 1197000 1328000 1425000 1548000 1704000"
FREQ_P4="402000 578000 697000 712000 910000 1065000 1221000 1328000 1418000 1572000 1836000 1945000 2130000 2245000 2367000"
FREQ_P8="500000 880000 1164000 1298000 1557000 1745000 1885000 2049000 2147000 2294000 2363000 2556000 2687000 2850000 2914000"

# GPU frekvence - SPEC je uvadi sestupne; vzestupna varianta je pro prepocet cdev.
GPU_FREQS_ASC="150000 302000 337000 376000 419000 467000 521000 580000 649000 723000 807000 850000 890000"

# --- Vazba cooling device -> policy a thermal zony -------------------------
#
# POZOR: ciselne indexy cooling_deviceN a thermal_zoneN NEJSOU stabilni pres
# reboot. Overeno na zarizeni: po restartu se thermal-cpufreq-1 presunul
# z cooling_device10 na 9, thermal-cpufreq-2 z 12 na 11, soc_therm ze
# zone11 na zone13 a battery ze zone16 na zone12.
# Zadratovane indexy by tedy po restartu cetly UPLNE JINE cidlo.
#
# Proto se indexy rozpoznavaji za behu podle pole `type`. Nize uvedena cisla
# jsou jen fallback pro pripad, ze by scan selhal.
CDEV_P0=8
CDEV_P4=10
CDEV_P8=12
CDEV_GPU=24

THERMAL_ZONES="big:0 mid:1 little:2 g3d:3 skin:8 soc:11 charger:12 display:13 battery:16"

# resolve_thermal_ids - prevede jmena zon/cdev na aktualni indexy.
#
# VYKON: puvodni verze skenovala vsech ~54 uzlu pres $(cat) = ~350 forku
# pri KAZDEM spusteni pxtune. Na telefonu priskrcenem na 610 MHz to delalo
# 20+ s na jedno spusteni a WebUI vypadalo zamrzle (synchronni ksu.exec).
# Tato verze cte symlinky /dev/thermal/*-by-name (1 readlink na polozku,
# 13 forku celkem) a vysledek jeste cachuje per-boot do souboru, takze
# druhe a dalsi spusteni stoji 1 fork (cat cache).
IDS_CACHE="$STATE_DIR/.thermal_ids"

# _link_idx <symlink> <prefix> - index z cile symlinku, prazdno pri chybe
_link_idx() {
	_li=$(readlink "$1" 2>/dev/null) || return 1
	case "$_li" in
		*"$2"*) print -rn -- "${_li##*"$2"}"; return 0 ;;
	esac
	return 1
}

# Pomaly fallback pro pripad, ze /dev/thermal neexistuje (nemelo by nastat,
# adresar vytvari vendor.thermal.symlinks pri kazdem bootu).
_scan_idx() {
	for _n in "$2"*; do
		[ -r "$_n/type" ] || continue
		if [ "$(cat "$_n/type" 2>/dev/null)" = "$1" ]; then
			print -rn -- "${_n##*"$3"}"
			return 0
		fi
	done
	return 1
}

resolve_thermal_ids() {
	# 1) zkus cache z tohoto bootu (btime se pres reboot zmeni)
	#
	# POZOR: btime sam o sobe NESTACI. Overeno na zarizeni, ze se zony
	# precisluji i BEHEM jednoho bootu - quiet_therm byl v 04:06 na
	# thermal_zone8 a o tri hodiny pozdeji (stejny boot, uptime 11094 s)
	# uz na thermal_zone9. Cache proto vzdy overime jednim ctenim typu
	# ("sentinel"): kdyz zona, kterou mame ulozenou jako skin, uz neni
	# quiet_therm, cache zahodime a resolvujeme znovu. Stoji to 1 cteni
	# (~0,2 ms) a chrani to pred tim, abychom tise cetli UPLNE JINE cidlo.
	_bt=$(sed -n 's/^btime //p' /proc/stat 2>/dev/null)
	if [ -f "$IDS_CACHE" ]; then
		_cl=$(head -n1 "$IDS_CACHE" 2>/dev/null)
		case "$_cl" in
			"$_bt "*)
				set -- $_cl
				# Poskozena/useknuta cache nesmi shodit skript: `shift 4`
				# na kratsim seznamu je v shellu fatalni chyba. Proto se
				# nejdriv overi delka a teprve pak se cache pouzije.
				# (Nelze pouzit `break` - nejsme uvnitr smycky.)
				if [ "$#" -ge 6 ]; then
				shift   # btime
				_c0="$1"; _c4="$2"; _c8="$3"; _cg="$4"
				shift 4
				_zl="$*"
				# sentinel: najdi ulozeny index skinu a over jeho typ
				_sidx=""
				for _p in $_zl; do
					case "$_p" in skin:*) _sidx="${_p#skin:}"; break ;; esac
				done
				if [ -n "$_sidx" ] && [ -r "/sys/class/thermal/thermal_zone$_sidx/type" ]; then
					IFS= read -r _styp < "/sys/class/thermal/thermal_zone$_sidx/type" 2>/dev/null
					if [ "$_styp" = "quiet_therm" ]; then
						CDEV_P0="$_c0"; CDEV_P4="$_c4"; CDEV_P8="$_c8"; CDEV_GPU="$_cg"
						THERMAL_ZONES="$_zl"
						return 0
					fi
				fi
				else
					# cache je useknuta -> zahodit a resolvovat znovu
					rm -f "$IDS_CACHE" 2>/dev/null
				fi
				;;
		esac
	fi

	# 2) rychla cesta: readlink na stabilnich symlincich
	_t=$(_link_idx /dev/thermal/cdev-by-name/thermal-cpufreq-0 cooling_device) \
		|| _t=$(_scan_idx thermal-cpufreq-0 /sys/class/thermal/cooling_device cooling_device)
	[ -n "$_t" ] && CDEV_P0="$_t"
	_t=$(_link_idx /dev/thermal/cdev-by-name/thermal-cpufreq-1 cooling_device) \
		|| _t=$(_scan_idx thermal-cpufreq-1 /sys/class/thermal/cooling_device cooling_device)
	[ -n "$_t" ] && CDEV_P4="$_t"
	_t=$(_link_idx /dev/thermal/cdev-by-name/thermal-cpufreq-2 cooling_device) \
		|| _t=$(_scan_idx thermal-cpufreq-2 /sys/class/thermal/cooling_device cooling_device)
	[ -n "$_t" ] && CDEV_P8="$_t"
	_t=$(_link_idx /dev/thermal/cdev-by-name/thermal-gpufreq-0 cooling_device) \
		|| _t=$(_scan_idx thermal-gpufreq-0 /sys/class/thermal/cooling_device cooling_device)
	[ -n "$_t" ] && CDEV_GPU="$_t"

	# klic:typ  ->  klic:index  (klice odpovidaji kontraktu JSON pro WebUI)
	_zl=""
	for _pair in big:BIG mid:MID little:LITTLE g3d:G3D skin:quiet_therm \
	             soc:soc_therm charger:charger_therm display:display_therm \
	             battery:battery; do
		_key="${_pair%%:*}"
		_typ="${_pair#*:}"
		_idx=$(_link_idx "/dev/thermal/tz-by-name/$_typ" thermal_zone) \
			|| _idx=$(_scan_idx "$_typ" /sys/class/thermal/thermal_zone thermal_zone)
		if [ -n "$_idx" ]; then
			_zl="$_zl $_key:$_idx"
		fi
	done
	# Fallback konstanty pouzijeme jen kdyz scan nenasel vubec nic.
	[ -n "$_zl" ] && THERMAL_ZONES="${_zl# }"

	# 3) uloz cache pro dalsi spusteni v tomto bootu
	if [ -n "$_bt" ] && [ -d "$STATE_DIR" ]; then
		{ print -r -- "$_bt $CDEV_P0 $CDEV_P4 $CDEV_P8 $CDEV_GPU $THERMAL_ZONES" > "$IDS_CACHE"; } 2>/dev/null
	fi
	return 0
}
resolve_thermal_ids

# uclamp cgroup skupiny
UCLAMP_GROUPS="top-app foreground background system-background camera-daemon nnapi-hal"

# Klice kontraktu profilu (SPEC.md -> "KONTRAKT: formát profilu").
# Pouziva je profile_apply() pro vynulovani PF_*/PFSET_* i validace
# per-app overlay (APP_OVERLAY_<klic>), aby byl seznam na JEDNOM miste.
PROFILE_KEYS="UCLAMP_TOPAPP_MIN UCLAMP_TOPAPP_MAX UCLAMP_FG_MIN UCLAMP_FG_MAX
UCLAMP_BG_MIN UCLAMP_BG_MAX UCLAMP_SYSBG_MIN UCLAMP_SYSBG_MAX
GPU_MAX_FREQ GPU_MIN_FREQ GPU_POWER_POLICY
