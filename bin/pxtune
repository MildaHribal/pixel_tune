# ---------------------------------------------------------------------------
# STOCK values (a fallback when stock.conf is corrupted or missing)
# SPEC.md: uclamp min=0.00/max=max (nnapi-hal min=1.00), GPU 890000/150000/adaptive,
#          charge stop=100 start=0, vm 60/20/10/100/0, thermal profile = "" (default)
# ---------------------------------------------------------------------------
DEF_UCLAMP_MIN="0"
