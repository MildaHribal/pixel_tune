WR_OK=0
WR_FAIL=0
VAL_FAIL=0

# FRAMEWORK_OK=0 => je zakazane volat cokoli pres binder (settings/cmd/dumpsys).
# Nastavuje se pro "status --json" a pro interni watchdog-check.
FRAMEWORK_OK=1

# ---------------------------------------------------------------------------
# Zaklad: cteni, logovani
# ---------------------------------------------------------------------------

# rd <path> -> prvni radka souboru na stdout, navratovy kod 1 kdyz nelze cist
rd() {
	_rd=""
	[ -f "$1" ] || return 1
	[ -r "$1" ] || return 1
	# POZOR: `IFS= read -r x < soubor` vraci na /proc/sys/* jen PRVNI ZNAK.
	# Procfs hlasi st_size=0, takze mksh cte po jednom bajtu a skonci.
	# Overeno na zarizeni:
	#     /proc/sys/vm/swappiness            cat=40    read="4"
	#     /proc/sys/kernel/sched_util_clamp_min  cat=1024  read="1"
	#     /sys/class/thermal/.../temp        cat=63000 read=63000  (OK)
	# Fork (head) je ale nutny JEN pro /proc/sys/* - jinde pouzivame
	# builtin read (0 forku). To je zasadni pro vykon: status --json cte
	# ~80 hodnot a na priskrcenem telefonu stal fork-na-kazde-cteni
	# pres 10 s (WebUI pak vypadalo zamrzle).
	case "$1" in
		/proc/sys/*)
			_rd=$(head -n1 "$1" 2>/dev/null) || return 1
			;;
		*)
			IFS= read -r _rd < "$1" 2>/dev/null || return 1
			;;
	esac
	print -rn -- "$_rd"
	return 0
}

# rd_def <path> <default>
rd_def() {
	_rdd=$(rd "$1") || _rdd=""
	[ -n "$_rdd" ] || _rdd="$2"
	print -rn -- "$_rdd"
}

# bracket <string> -> obsah [zavorek], jinak cely retezec
# (comp_algorithm / power_policy maji tvar "a [b] c")
bracket() {
	case "$1" in
		*\[*\]*) print -rn -- "$1" | sed -n 's/.*\[\([^]]*\)\].*/\1/p' ;;
		*)         print -rn -- "$1" ;;
	esac
}

is_int() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

is_snum() {
	_isn="$1"
	case "$_isn" in -*) _isn=${_isn#-} ;; esac
	is_int "$_isn"
}

LOG_N=0
log_rotate() {
	[ -f "$LOG_FILE" ] || return 0
	# POZOR: nazvy promennych v log()/log_rotate() musi byt unikatni - vola se
	# uprostred jinych funkci a prepsani jejich promenne by bylo tise fatalni.
	#
	# VYKON: `wc -c` je fork. Aplikace profilu zapisuje ~40 radku, takze puvodni
	# verze forkovala 40x jen kvuli kontrole velikosti. Kontrolujeme proto jen
	# kazdy 50. zapis - log ma strop 512 kB a jeden radek ma radove 100 B,
	# takze 50 radku navic je ~5 kB, tj. 1 % preteceni. Zanedbatelne.
	LOG_N=$((LOG_N + 1))
	[ "$((LOG_N % 50))" -eq 1 ] || return 0
	_logsz=$(wc -c < "$LOG_FILE" 2>/dev/null)
	is_int "$_logsz" || return 0
	[ "$_logsz" -gt "$LOG_MAX" ] || return 0
	mv -f "$LOG_FILE" "$LOG_FILE.old" 2>/dev/null
	{ : > "$LOG_FILE"; } 2>/dev/null
	chmod 0640 "$LOG_FILE" 2>/dev/null
}

# log <LEVEL> <zprava...>
LOG_TS=""
log() {
	_loglvl="$1"
	shift
	log_rotate
	# VYKON: date = fork+exec na kazdy radek; aplikace profilu zapisuje
	# ~40 radku a na priskrcenem telefonu to stalo nekolik sekund.
	# Timestamp se proto pocita jen JEDNOU za beh procesu - radky jednoho
	# behu sdili cas startu, coz je pro tenhle log dostacujici granularita.
	[ -n "$LOG_TS" ] || LOG_TS=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
	# print je builtin, printf je /system/bin/printf (fork, ~17 ms).
	{ print -r -- "[$LOG_TS] [$_loglvl] $*" >> "$LOG_FILE"; } 2>/dev/null
}

msg()  { print -r -- "$*"; }
warn() { print -r -- "$*" >&2; }
die()  { _c="$1"; shift; warn "pxtune: $*"; log ERROR "$*"; exit "$_c"; }

# vfail <zprava> - odmitnuta (neplatna) hodnota; skript pokracuje dal
vfail() {
	VAL_FAIL=$((VAL_FAIL + 1))
	warn "pxtune: $*"
	log ERROR "$*"
	return 1
}

# ---------------------------------------------------------------------------
# wr - JEDINA cesta zapisu do sysfs.
# Overi existenci, overi zapisovatelnost, zaloguje "stara -> nova".
# Pri chybe zaloguje a POKRACUJE (nikdy neshodi skript).
# ---------------------------------------------------------------------------
wr() {
	_wp="$1"
	_wv="$2"

	if [ -z "$_wp" ]; then
		log ERROR "wr: prazdna cesta"
		WR_FAIL=$((WR_FAIL + 1))
		return 1
	fi
	if [ ! -e "$_wp" ]; then
		log ERROR "wr: neexistuje: $_wp (hodnota '$_wv' zahozena)"
		WR_FAIL=$((WR_FAIL + 1))
		return 1
	fi
	if [ ! -w "$_wp" ]; then
		log ERROR "wr: neni zapisovatelne: $_wp (hodnota '$_wv' zahozena)"
		WR_FAIL=$((WR_FAIL + 1))
		return 1
	fi

	# VYKON: cteni pres rdv() (globalni V), ne pres $(rd ...). Kazde $()
	# je fork a wr() se pri prepnuti profilu vola ~40x - to delalo pres
	# 80 forku jen na cteni stare a nove hodnoty.
	rdv "$_wp" "?"
	_wold="$V"

	# Kdyz uz je hodnota spravna, nezapisujeme. Nektere sysfs nody odmitaji
	# i zapis vlastni aktualni hodnoty a hlasily by zbytecnou chybu.
	# Realny pripad z tohoto zarizeni: google,charger/charge_start_level
	# odmita zapis '0', i kdyz '0' uz tam je -> revert hlasil chybu, ackoli
	# byl stav v poradku.
	if [ "$_wold" = "$_wv" ]; then
		WR_OK=$((WR_OK + 1))
		return 0
	fi

	# POZOR na poradi redirekci: `> soubor 2>/dev/null` chybu OTEVRENI
	# souboru nepotlaci (vyhodnocuje se zleva doprava), takze
	# "Permission denied" utece na stderr - v boot fazi az do bootlogu.
	# Cely blok proto obalujeme.
	if { print -r -- "$_wv" > "$_wp"; } 2>/dev/null; then
		rdv "$_wp" "?"
		log INFO "wr: $_wp: '$_wold' -> '$_wv' (ctenim: '$V')"
		WR_OK=$((WR_OK + 1))
		return 0
	fi

	log ERROR "wr: zapis selhal: $_wp <- '$_wv' (stara: '$_wold')"
	WR_FAIL=$((WR_FAIL + 1))
	return 1
}

# ---------------------------------------------------------------------------
# Stav / adresare
# ---------------------------------------------------------------------------
ensure_dirs() {
	[ -d "$STATE_DIR" ]   || mkdir -p "$STATE_DIR"   2>/dev/null
	[ -d "$PROFILE_DIR" ] || mkdir -p "$PROFILE_DIR" 2>/dev/null
	[ -d "$BACKUP_DIR" ]  || mkdir -p "$BACKUP_DIR"  2>/dev/null
	[ -d "$APPDIR" ]      || mkdir -p "$APPDIR"      2>/dev/null
	[ -f "$LOG_FILE" ]    || : > "$LOG_FILE" 2>/dev/null
	chmod 0700 "$STATE_DIR" 2>/dev/null
}

active_profile() {
	_ap=$(rd "$ACTIVE_FILE") || _ap=""
	[ -n "$_ap" ] || _ap="unknown"
	print -rn -- "$_ap"
}

auto_state() {
	_as=$(rd "$AUTO_FILE") || _as=""
	case "$_as" in
		off|OFF|0|false) print -rn -- 'off' ;;
		*) print -rn -- 'on' ;;
	esac
}

# ---------------------------------------------------------------------------
# Prace s KEY=VALUE soubory (profily i stock.conf).
# NESOURCUJEME je - poskozeny/podvrzeny soubor nesmi nic spustit.
# ---------------------------------------------------------------------------
# kv_get <file> <key>
kv_get() {
	[ -f "$1" ] || return 1
	sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" 2>/dev/null \
		| tail -n 1 \
		| sed -e 's/^"\([^"]*\)".*$/\1/;t' \
		      -e "s/^'\([^']*\)'.*\$/\1/;t" \
		      -e 's/[[:space:]]*#.*$//' \
		      -e 's/[[:space:]]*$//'
}

# has_key <file> <key>
has_key() {
	grep -q "^[[:space:]]*$2[[:space:]]*=" "$1" 2>/dev/null
}

# stock.conf je pouzitelny jen kdyz existuje, ma magii a same tvary KEY=VALUE
stock_valid() {
	[ -f "$STOCK_CONF" ] || return 1
	grep -q '^STOCK_MAGIC=' "$STOCK_CONF" 2>/dev/null || return 1
	if grep -qv -e '^[[:space:]]*#' -e '^[[:space:]]*$' -e '^[A-Z0-9_]\{1,\}=.*$' "$STOCK_CONF" 2>/dev/null; then
		return 1
	fi
	return 0
}

# stock_get <key> <default> -> hodnota ze stock.conf, jinak default ze SPEC
# --- nacitani KEY=VALUE souboru do promennych (bez forku) -------------------
#
# VYKON: kv_get() je `sed | tail | sed` = 3 forky na jedno cteni. Pri prepnuti
# profilu se cte 20x ze stock.conf (reset) a 21x z profilu = pres 120 forku.
# Na priskrcenem telefonu to delalo 13 s na jedno kliknuti ve WebUI.
# Nacteme kazdy soubor JEDNOU do promennych s prefixem a dal uz jen ctem.
#
# Bezpecnost: klic se propousti jen [A-Za-z0-9_], hodnota se prirazuje pres
# `eval "PREFIX_$k=\$_v"` - to je prirazeni Z PROMENNE, ne re-evaluace obsahu,
# takze `$(...)` ani backtick v hodnote se neprovede.

# kvload <soubor> <prefix> - naplni <prefix>_<KLIC> promenne
kvload() {
	[ -f "$1" ] || return 1
	while IFS='=' read -r _kl_k _kl_v; do
		case "$_kl_k" in
			''|\#*)          continue ;;
			*[!A-Za-z0-9_]*) continue ;;
		esac
		_kl_v="${_kl_v%%#*}"
		# osekej mezery na konci
		while :; do
			case "$_kl_v" in
				*' '|*"	") _kl_v="${_kl_v%?}" ;;
				*) break ;;
			esac
		done
		# osekej uvozovky
		case "$_kl_v" in
			\"*\") _kl_v="${_kl_v#\"}"; _kl_v="${_kl_v%\"}" ;;
			\'*\') _kl_v="${_kl_v#\'}"; _kl_v="${_kl_v%\'}" ;;
		esac
		eval "$2_$_kl_k=\$_kl_v"
	done < "$1"
	return 0
}

STOCK_LOADED=0
stock_load() {
	[ "$STOCK_LOADED" = "1" ] && return 0
	STOCK_LOADED=1
	stock_valid || return 0
	kvload "$STOCK_CONF" SC
	return 0
}

# stock_getv <klic> <default> -> globalni SV. Bez forku, na rozdil od
# $(stock_get ...), coz je subshell (~7,7 ms). cmd_revert jich mel 19.
stock_getv() {
	stock_load
	eval "SV=\${SC_$1:-}"
	[ -n "$SV" ] || SV="$2"
}

stock_get() {
	stock_load
	eval "_sv=\${SC_$1:-}"
	if [ -z "$_sv" ]; then
		print -rn -- "$2"
	else
		print -rn -- "$_sv"
	fi
}

# uclamp_keyv <skupina> -> UK. `tr` byl fork; skupin je pevna mala mnozina.
uclamp_keyv() {
	case "$1" in
		top-app)           UK=TOP_APP ;;
		foreground)        UK=FOREGROUND ;;
		background)        UK=BACKGROUND ;;
		system-background) UK=SYSTEM_BACKGROUND ;;
		camera-daemon)     UK=CAMERA_DAEMON ;;
		nnapi-hal)         UK=NNAPI_HAL ;;
		*)                 UK=$(print -rn -- "$1" | tr 'a-z-' 'A-Z_') ;;
	esac
}

uclamp_key() {
	uclamp_keyv "$1"
	print -rn -- "$UK"
}

# ---------------------------------------------------------------------------
# Framework (binder) - settings. NIKDY se nesmi zavolat pri "status --json".
# ---------------------------------------------------------------------------
FW_CHECKED=0
FW_RESULT=1
framework_ok() {
	[ "$FRAMEWORK_OK" = "1" ] || return 1
	# Explicitni deaktivace pro volajici v rane fazi bootu (uninstall.sh):
	[ "${PXTUNE_NO_FRAMEWORK:-0}" = "1" ] && return 1
	# VYKON: `command -v` i `getprop` jsou forky (~8-17 ms) a framework_ok
	# se vola jednou za kazdy tweak s mechanismem `settings`. Vysledek se
	# behem jednoho behu nemuze zmenit, tak ho zjistujeme jen jednou.
	if [ "$FW_CHECKED" = "0" ]; then
		FW_CHECKED=1
		FW_RESULT=1
		if command -v settings >/dev/null 2>&1 &&
		   [ "$(getprop sys.boot_completed 2>/dev/null)" = "1" ]; then
			FW_RESULT=0
		fi
	fi
	return "$FW_RESULT"
}

# settings_get <namespace> <key>  ("null" -> prazdno)
settings_get() {
	framework_ok || return 1
	if command -v timeout >/dev/null 2>&1; then
		timeout 10 settings get "$1" "$2" 2>/dev/null | sed -e 's/^null$//' -e 's/[[:space:]]*$//'
	else
		settings get "$1" "$2" 2>/dev/null | sed -e 's/^null$//' -e 's/[[:space:]]*$//'
	fi
}

# settings_run <akce> <namespace> <klic> [hodnota] - zapis pres `settings`
# VZDY s timeoutem. `settings` je binder volani; bez timeoutu by zaseknuty
# system_server (nebo bezici raná faze bootu pri odinstalaci) zablokoval
# cely skript - v post-fs-data kontextu i cely boot.
settings_run() {
	framework_ok || return 1
	if command -v timeout >/dev/null 2>&1; then
		timeout 10 settings "$@" >/dev/null 2>&1
	else
		settings "$@" >/dev/null 2>&1
	fi
}

# ---------------------------------------------------------------------------
# Snapshot stock hodnot - vytvori se JEDNOU, nikdy neprepisuje.
# ---------------------------------------------------------------------------
snapshot_stock() {
	if [ -f "$STOCK_CONF" ]; then
		stock_fill_display
		return 0
	fi

	if framework_ok; then
		_dsz=$(settings_get global display_size_forced)
		_dds=$(settings_get secure display_density_forced)
		_dcap=1
	else
		# bez binderu se displej doplni pri prvnim spusteni, ktere framework smi volat
		_dsz=""
		_dds=""
		_dcap=0
	fi

	_tmp="$STOCK_CONF.tmp.$$"
	{
		printf '# pixel_tune - snapshot stock hodnot\n'
		printf '# Vytvoreno: %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
		printf '# NEEDITOVAT RUCNE. Smazani = snapshot se vytvori znovu z AKTUALNICH hodnot.\n'
		printf 'STOCK_MAGIC="pixel_tune-stock-v1"\n'

		for _g in $UCLAMP_GROUPS; do
			uclamp_keyv "$_g"; _k="$UK"
			printf 'STOCK_UCLAMP_%s_MIN="%s"\n' "$_k" "$(rd_def "$CPUCTL/$_g/cpu.uclamp.min" "")"
			printf 'STOCK_UCLAMP_%s_MAX="%s"\n' "$_k" "$(rd_def "$CPUCTL/$_g/cpu.uclamp.max" "")"
		done

		printf 'STOCK_GPU_MAX_FREQ="%s"\n'      "$(rd_def "$MALI/scaling_max_freq" "$DEF_GPU_MAX")"
		printf 'STOCK_GPU_MIN_FREQ="%s"\n'      "$(rd_def "$MALI/scaling_min_freq" "$DEF_GPU_MIN")"
		printf 'STOCK_GPU_HINT_MAX_FREQ="%s"\n' "$(rd_def "$MALI/hint_max_freq" "")"
		printf 'STOCK_GPU_POWER_POLICY="%s"\n'  "$(bracket "$(rd_def "$MALI/power_policy" "$DEF_GPU_POLICY")")"

		printf 'STOCK_VM_SWAPPINESS="%s"\n'         "$(rd_def /proc/sys/vm/swappiness "$DEF_SWAPPINESS")"
		printf 'STOCK_VM_DIRTY_RATIO="%s"\n'        "$(rd_def /proc/sys/vm/dirty_ratio "$DEF_DIRTY_RATIO")"
		printf 'STOCK_VM_DIRTY_BG_RATIO="%s"\n'     "$(rd_def /proc/sys/vm/dirty_background_ratio "$DEF_DIRTY_BG_RATIO")"
		printf 'STOCK_VM_VFS_CACHE_PRESSURE="%s"\n' "$(rd_def /proc/sys/vm/vfs_cache_pressure "$DEF_VFS_CACHE_PRESSURE")"
		printf 'STOCK_VM_PAGE_CLUSTER="%s"\n'       "$(rd_def /proc/sys/vm/page-cluster "$DEF_PAGE_CLUSTER")"

		printf 'STOCK_CHARGE_STOP_LEVEL="%s"\n'  "$(rd_def "$CHARGER/charge_stop_level" "$DEF_CHARGE_STOP")"
		printf 'STOCK_CHARGE_START_LEVEL="%s"\n' "$(rd_def "$CHARGER/charge_start_level" "$DEF_CHARGE_START")"

		for _d in $IO_DEVS; do
			_k=$(print -rn -- "$_d" | tr 'a-z' 'A-Z')
			printf 'STOCK_IO_READAHEAD_%s="%s"\n' "$_k" "$(rd_def "/sys/block/$_d/queue/read_ahead_kb" "")"
		done

		printf 'STOCK_THERMAL_PROFILE_CPU_MID="%s"\n'  "$(getprop "vendor.thermal.$THERMAL_SENSOR_MID.profile" 2>/dev/null)"
		printf 'STOCK_THERMAL_PROFILE_CPU_HIGH="%s"\n' "$(getprop "vendor.thermal.$THERMAL_SENSOR_HIGH.profile" 2>/dev/null)"

		printf 'STOCK_DISPLAY_CAPTURED="%s"\n'       "$_dcap"
		printf 'STOCK_DISPLAY_SIZE_FORCED="%s"\n'    "$_dsz"
		printf 'STOCK_DISPLAY_DENSITY_FORCED="%s"\n' "$_dds"

		# Jen pro informaci - zram se za behu NEMENI (swapoff je nebezpecny, SPEC).
		printf 'STOCK_ZRAM_DISKSIZE="%s"\n'        "$(rd_def "$ZRAM/disksize" "")"
		printf 'STOCK_ZRAM_ALGORITHM="%s"\n'       "$(bracket "$(rd_def "$ZRAM/comp_algorithm" "")")"
		printf 'STOCK_SCHED_UTIL_CLAMP_MIN="%s"\n' "$(rd_def /proc/sys/kernel/sched_util_clamp_min "")"

		# kontrakt v2 - stock hodnoty novych uzlu (pro revert). Fresh instalace
		# je zachyti z aktualniho (=stock) stavu; na starem snapshotu chybi a
		# revert pak pouzije DEF_V2_* fallback.
		for _e in $V2_TABLE; do
			_vk="${_e%%:*}"; _vrest="${_e#*:}"; _vp="${_vrest%:*}"
			printf 'STOCK_%s="%s"\n' "$_vk" "$(rd_def "$_vp" "")"
		done
	} > "$_tmp" 2>/dev/null

	if [ -s "$_tmp" ]; then
		mv -f "$_tmp" "$STOCK_CONF" 2>/dev/null
		chmod 0600 "$STOCK_CONF" 2>/dev/null
		log INFO "stock.conf vytvoren: $STOCK_CONF (displej zachycen=$_dcap)"
	else
		rm -f "$_tmp" 2>/dev/null
		log ERROR "stock.conf se nepodarilo vytvorit"
	fi
}

# Kdyz snapshot vznikl bez binderu, doplni hodnoty displeje pri prvni prilezitosti.
stock_fill_display() {
	framework_ok || return 0
	stock_valid || return 0
	[ "$(kv_get "$STOCK_CONF" STOCK_DISPLAY_CAPTURED)" = "0" ] || return 0

	_dsz=$(settings_get global display_size_forced)
	_dds=$(settings_get secure display_density_forced)
	_t="$STOCK_CONF.tmp.$$"
	sed -e "s|^STOCK_DISPLAY_CAPTURED=.*|STOCK_DISPLAY_CAPTURED=\"1\"|" \
	    -e "s|^STOCK_DISPLAY_SIZE_FORCED=.*|STOCK_DISPLAY_SIZE_FORCED=\"$_dsz\"|" \
	    -e "s|^STOCK_DISPLAY_DENSITY_FORCED=.*|STOCK_DISPLAY_DENSITY_FORCED=\"$_dds\"|" \
	    "$STOCK_CONF" > "$_t" 2>/dev/null
	if [ -s "$_t" ]; then
		mv -f "$_t" "$STOCK_CONF" 2>/dev/null
		chmod 0600 "$STOCK_CONF" 2>/dev/null
		log INFO "stock.conf: doplneny hodnoty displeje (size='$_dsz' density='$_dds')"
	else
		rm -f "$_t" 2>/dev/null
	fi
}

# balanced.conf je doslovna kopie prikladu ze SPEC.md (kontrakt formatu profilu).
# Zadne jine profily se negeneruji - jejich hodnoty ve SPEC nejsou.
seed_profiles() {
	[ -d "$PROFILE_DIR" ] || return 0
	[ -f "$PROFILE_DIR/balanced.conf" ] && return 0
	for _f in "$PROFILE_DIR"/*.conf; do
		[ -f "$_f" ] && return 0
	done
	cat > "$PROFILE_DIR/balanced.conf" 2>/dev/null <<'EOF'
# povinne
PROFILE_NAME="balanced"
PROFILE_DESC="Vyvazeny - stock chovani"

# uclamp (0-100, nebo "max"; prazdne = nesahat)
UCLAMP_TOPAPP_MIN=""
UCLAMP_TOPAPP_MAX=""
UCLAMP_FG_MIN=""
UCLAMP_FG_MAX=""
UCLAMP_BG_MIN=""
UCLAMP_BG_MAX=""
UCLAMP_SYSBG_MIN=""
UCLAMP_SYSBG_MAX=""

# GPU (kHz, musi byt z povoleneho seznamu; prazdne = nesahat)
GPU_MAX_FREQ=""
GPU_MIN_FREQ=""
GPU_POWER_POLICY=""

# thermal HAL profil ("game" | "camera" | "" = default)
THERMAL_PROFILE_CPU_MID=""
THERMAL_PROFILE_CPU_HIGH=""

# vm
VM_SWAPPINESS=""
VM_DIRTY_RATIO=""
VM_DIRTY_BG_RATIO=""
VM_VFS_CACHE_PRESSURE=""

# I/O
IO_READAHEAD_KB=""

# nabijeni
CHARGE_STOP_LEVEL=""
EOF
	[ -f "$PROFILE_DIR/balanced.conf" ] && log INFO "vytvoren vychozi profil balanced.conf"
	return 0
}

# ---------------------------------------------------------------------------
# Prepocty
# ---------------------------------------------------------------------------
# nth <index0> <polozka...>
nth() {
	_ni="$1"
	shift
	_nn=0
	for _ne in "$@"; do
		if [ "$_nn" -eq "$_ni" ]; then
			print -rn -- "$_ne"
			return 0
		fi
		_nn=$((_nn + 1))
	done
	return 1
}

in_list() {
	_il="$1"
	shift
	for _ie in "$@"; do
		[ "$_ie" = "$_il" ] && return 0
	done
	return 1
}

# cdev_cap_khz <cur_state> <frekvence vzestupne...>
# SPEC: cur_state = N  =>  strop = frekvence na indexu (pocet - 1 - N)
cdev_cap_khz() {
	_cck="$1"
	shift
	is_int "$_cck" || return 1
	_ccn=$#
	_cci=$((_ccn - 1 - _cck))
	[ "$_cci" -lt 0 ] && return 1
	[ "$_cci" -ge "$_ccn" ] && return 1
	nth "$_cci" "$@"
}

khz_to_mhz() {
	is_int "$1" || return 1
	print -rn -- $(($1 / 1000))
}

# mc_to_c <millicelsius> -> "45.6"
mc_to_c() {
	_mc="$1"
	is_snum "$_mc" || return 1
	_sg=""
	case "$_mc" in -*) _sg="-"; _mc=${_mc#-} ;; esac
	printf '%s%d.%d' "$_sg" $((_mc / 1000)) $(((_mc % 1000) / 100))
}

# last_of <seznam> -> posledni polozka
last_of() {
	# shellcheck disable=SC2086
	set -- $1
	eval "print -rn -- \"\${$#}\""
}

# ---------------------------------------------------------------------------
# JSON helpery
# ---------------------------------------------------------------------------
json_esc() {
	# VYKON: sed = fork+exec na kazdy retezec; status --json jich emituje
	# ~30 a na priskrcenem telefonu to stalo sekundy. Bezne hodnoty
	# (jmena profilu, stavy, frekvence) zadne escapovani nepotrebuji -
	# rychla cesta je pozna pure-shellove a sed se spousti jen vyjimecne.
	case "$1" in
		*[!A-Za-z0-9\ _.,:/%+-]*)
			# poradi: nejdriv zpetne lomitko, pak uvozovka, pak ridici znaky
			print -rn -- "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/[[:cntrl:]]/ /g'
			;;
		*)
			print -rn -- "$1"
			;;
	esac
}

jstr() { printf '"%s"' "$(json_esc "$1")"; }

# jnum <hodnota> -> cele cislo nebo null
jnum() {
	if is_snum "$1"; then print -rn -- "$1"; else printf 'null'; fi
}

# jnum_f <hodnota> -> desetinne cislo nebo null
jnum_f() {
	case "$1" in
		''|*[!0-9.-]*) printf 'null' ;;
		*) print -rn -- "$1" ;;
	esac
}

jbool() {
	if [ "$1" = "1" ]; then printf 'true'; else printf 'false'; fi
}

# jtemp <cesta k zone> -> °C jako desetinne cislo nebo null
jtemp() {
	_t=$(rd_def "$1" "")
	if is_snum "$_t"; then mc_to_c "$_t"; else printf 'null'; fi
}

# ---------------------------------------------------------------------------
# Validace
# ---------------------------------------------------------------------------
valid_uclamp() {
	[ "$1" = "max" ] && return 0
	is_int "$1" || return 1
	[ "$1" -ge 0 ] && [ "$1" -le 100 ]
}

valid_gpu_freq() {
	# shellcheck disable=SC2086
	in_list "$1" $GPU_FREQS_ASC
}

valid_gpu_policy() {
	case "$1" in
		coarse_demand|adaptive|always_on) return 0 ;;
		*) return 1 ;;
	esac
}

valid_thermal_profile() {
	case "$1" in
		game|camera|"") return 0 ;;
		*) return 1 ;;
	esac
}

valid_charge() {
	is_int "$1" || return 1
	[ "$1" -ge 1 ] && [ "$1" -le 100 ]
}

# ---------------------------------------------------------------------------
# Zapisove operace
# ---------------------------------------------------------------------------
set_uclamp() {
	# set_uclamp <skupina> <min|max> <hodnota>
	[ -n "$3" ] || return 0
	if ! valid_uclamp "$3"; then
		vfail "neplatna uclamp hodnota '$3' pro $1/$2 (povoleno 0-100 nebo 'max')"
		return 1
	fi
	wr "$CPUCTL/$1/cpu.uclamp.$2" "$3"
}

set_thermal_profile() {
	# set_thermal_profile <senzor> <profil>
	if ! command -v setprop >/dev/null 2>&1; then
		log ERROR "setprop neni k dispozici, thermal profil $1 nenastaven"
		return 1
	fi
	_old=$(getprop "vendor.thermal.$1.profile" 2>/dev/null)
	setprop "vendor.thermal.$1.profile" "$2" 2>/dev/null
	log INFO "setprop vendor.thermal.$1.profile: '$_old' -> '$2'"
	return 0
}

set_io_readahead() {
	[ -n "$1" ] || return 0
	if ! is_int "$1"; then
		vfail "neplatny IO_READAHEAD_KB '$1' (ocekavano cele cislo)"
		return 1
	fi
	for _d in $IO_DEVS; do
		[ -e "/sys/block/$_d/queue/read_ahead_kb" ] || continue
		wr "/sys/block/$_d/queue/read_ahead_kb" "$1"
	done
	return 0
}

set_gpu() {
	# set_gpu <max> <min> <policy>  (prazdne = nesahat)
	_gmax="$1"
	_gmin="$2"
	_gpol="$3"

	if [ -n "$_gmax" ]; then
		if valid_gpu_freq "$_gmax"; then
			wr "$MALI/scaling_max_freq" "$_gmax"
		else
			vfail "GPU_MAX_FREQ '$_gmax' neni z povoleneho seznamu frekvenci"
		fi
	fi
	if [ -n "$_gmin" ]; then
		if valid_gpu_freq "$_gmin"; then
			wr "$MALI/scaling_min_freq" "$_gmin"
		else
			vfail "GPU_MIN_FREQ '$_gmin' neni z povoleneho seznamu frekvenci"
		fi
	fi
	# min mohl driv blokovat snizeni maxima - po zapisu min zkusime max znovu
	if [ -n "$_gmax" ] && [ -n "$_gmin" ] && valid_gpu_freq "$_gmax"; then
		[ "$(rd_def "$MALI/scaling_max_freq" "")" = "$_gmax" ] || wr "$MALI/scaling_max_freq" "$_gmax"
	fi
	if [ -n "$_gpol" ]; then
		if valid_gpu_policy "$_gpol"; then
			wr "$MALI/power_policy" "$_gpol"
		else
			vfail "GPU_POWER_POLICY '$_gpol' neplatna (coarse_demand|adaptive|always_on)"
		fi
	fi
	return 0
}

# v2_valid <druh> <hodnota> - vrati 0 kdyz hodnota sedi na druh uzlu.
v2_valid() {
	case "$1" in
		int)      is_int "$2" ;;
		bool01)   case "$2" in 0|1) return 0 ;; *) return 1 ;; esac ;;
		enum1020) case "$2" in 10|20) return 0 ;; *) return 1 ;; esac ;;
		load)     # dvojice celych cisel "N M"
			case "$2" in
				*[!0-9\ ]*) return 1 ;;
				*' '*) is_int "${2%% *}" && is_int "${2##* }" ;;
				*) return 1 ;;
			esac ;;
		*) return 1 ;;
	esac
}

# set_v2 - nasadi klice kontraktu v2 z PF_* na uzly. Prazdne = nesahat.
# Vola se z profile_apply() az PO restore_stock_values(), takze stock je
# jiz obnoven a prazdny klic korektne znamena "nech stock".
set_v2() {
	_e=""
	for _e in $V2_TABLE; do
		_vk="${_e%%:*}"
		_vrest="${_e#*:}"
		_vp="${_vrest%:*}"
		_vkind="${_vrest##*:}"
		eval "_vv=\$PF_$_vk"
		[ -n "$_vv" ] || continue
		if v2_valid "$_vkind" "$_vv"; then
			wr "$_vp" "$_vv"
		else
			vfail "neplatna hodnota '$_vv' pro $_vk (druh $_vkind)"
		fi
	done

	# THERMAL_CDEV_BYPASS - riziko 3, pise na TRI CPU cooling devices najednou.
	# Zadny dodavany profil to nenastavuje; smysl ma jen kratkodobe s vlastni
	# teplotni pojistkou. Prazdne = nesahat.
	if [ -n "$PF_THERMAL_CDEV_BYPASS" ]; then
		if v2_valid bool01 "$PF_THERMAL_CDEV_BYPASS"; then
			[ "$PF_THERMAL_CDEV_BYPASS" = "1" ] && \
				log WARN "THERMAL_CDEV_BYPASS=1: VYPINAM skin-driven CPU throttling na 3 cdev (riziko 3, telefon se ohreje)"
			for _bn in $CDEV_BYPASS_NODES; do
				[ -e "$_bn" ] && wr "$_bn" "$PF_THERMAL_CDEV_BYPASS"
			done
		else
			vfail "neplatny THERMAL_CDEV_BYPASS '$PF_THERMAL_CDEV_BYPASS' (0|1)"
		fi
	fi
	return 0
}

# set_vm_one <klic> <cesta> <hodnota>
set_vm_one() {
	[ -n "$3" ] || return 0
	if is_int "$3"; then
		wr "$2" "$3"
		return 0
	fi
	vfail "neplatna hodnota '$3' pro $1 (ocekavano cele cislo)"
	return 1
}

set_vm() {
	set_vm_one VM_SWAPPINESS          /proc/sys/vm/swappiness             "$1"
	set_vm_one VM_DIRTY_RATIO         /proc/sys/vm/dirty_ratio            "$2"
	set_vm_one VM_DIRTY_BG_RATIO      /proc/sys/vm/dirty_background_ratio "$3"
	set_vm_one VM_VFS_CACHE_PRESSURE  /proc/sys/vm/vfs_cache_pressure     "$4"
	return 0
}

# ---------------------------------------------------------------------------
# profile
# ---------------------------------------------------------------------------
cmd_profile() {
	case "$1" in
		""|list) profile_list ;;
		current) active_profile; printf '\n' ;;
		auto)    profile_auto ;;
		*)
			_pname="$1"
			shift
			_pauto=0
			_poverlay=""
			while [ "$#" -gt 0 ]; do
				case "$1" in
					--auto) _pauto=1 ;;
					# --reset je prijimano jako NO-OP: reset na stock se dela
					# VZDY (restore_stock_values() na zacatku profile_apply),
					# takze profily nejsou lepive. Priznak existuje kvuli
					# kontraktu s pxtune-auto, ktery si podporu --reset zjistuje
					# za behu - bez nej by spadl do rezimu bez resetu a zbytecne
					# varoval do logu.
					--reset) : ;;
					# --overlay <pkg>: pred zapisem prebij klice profilu
					# hodnotami APP_OVERLAY_* z apps/<pkg>.conf. Posila to
					# demon, kdyz je v popredi aplikace s per-app pravidlem.
					--overlay)
						shift
						_poverlay="$1"
						case "$_poverlay" in
							''|.*|*/*|*[!A-Za-z0-9._]*)
								warn "pxtune: --overlay chce jmeno balicku, ne '$_poverlay'"
								exit 1
								;;
						esac
						;;
					*) warn "pxtune: neznamy parametr '$1' (podporovano: --auto, --reset, --overlay <pkg>)"; exit 1 ;;
				esac
				shift
			done
			profile_apply "$_pname" "$_pauto" "$_poverlay"
			;;
	esac
}

profile_list() {
	# VYKON: puvodne 3 forky na profil (basename + $(active_profile) + kv_get,
	# ktery je sam `sed|tail|sed`). Vsechno jde bez forku: jmeno pres expanzi
	# parametru, aktivni profil precteme jednou, popis vytahneme ctenim souboru.
	_found=0
	rdv "$ACTIVE_FILE" "unknown"
	_act="$V"
	for _f in "$PROFILE_DIR"/*.conf; do
		[ -f "$_f" ] || continue
		_found=1
		_n="${_f##*/}"
		_n="${_n%.conf}"
		_mark=" "
		[ "$_n" = "$_act" ] && _mark="*"
		_desc=""
		while IFS='=' read -r _pk _pv || [ -n "$_pk" ]; do
			[ "$_pk" = "PROFILE_DESC" ] || continue
			_pv="${_pv%%#*}"
			while :; do case "$_pv" in *' '|*"	") _pv="${_pv%?}" ;; *) break ;; esac; done
			case "$_pv" in \"*\") _pv="${_pv#\"}"; _pv="${_pv%\"}" ;; esac
			_desc="$_pv"
			break
		done < "$_f"
		# zarovnani bez printf (ten je na Androidu externi binarka)
		_pad="$_n"
		while [ "${#_pad}" -lt 14 ]; do _pad="$_pad "; done
		print -r -- "$_mark $_pad $_desc"
	done
	if [ "$_found" -eq 0 ]; then
		warn "pxtune: v $PROFILE_DIR nejsou zadne profily (*.conf)"
		return 2
	fi
	return 0
}

profile_auto() {
	if [ -f "$OVERRIDE_FILE" ]; then
		rm -f "$OVERRIDE_FILE" 2>/dev/null
		log INFO "manual_override zrusen, rizeni profilu vraceno automatu"
	fi
	# Rucni zaklad drzeny demonem behem per-app epizody uz nema smysl bez override.
	rm -f "$STATE_DIR/manual_base" 2>/dev/null
	# Demon zjisti zmenu az pri nejblizsi udalosti (prepnuti aplikace).
	# SIGHUP mu rekne, at prehodnoti stav hned - jinak by se spravny profil
	# nasadil treba az za nekolik minut.
	auto_signal HUP
	msg "manual_override zrusen - profil ridi automat (auto=$(auto_state))"
	return 0
}

# auto_signal <signal> - posle signal bezicimu demonovi, pokud bezi.
# Nikdy neselze tak, aby shodila volajiciho.
auto_signal() {
	_apid=$(rd "$AUTOD_PID" 2>/dev/null | tr -dc '0-9')
	[ -n "$_apid" ] || return 0
	[ -d "/proc/$_apid" ] || return 0
	if kill -"$1" "$_apid" 2>/dev/null; then
		log INFO "demonovi (pid $_apid) poslan SIG$1"
	fi
	return 0
}

# skin_mc_v -> V = skin teplota (quiet_therm) v milicelsiich, "" kdyz necitelne.
# Cte pres stabilni symlink /dev/thermal/tz-by-name (indexy zon se posouvaji,
# viz resolve_thermal_ids); fallback na resolvovany index skin: z THERMAL_ZONES.
# Bez forku (rdv nastavuje globalni V).
skin_mc_v() {
	rdv "/dev/thermal/tz-by-name/quiet_therm/temp" ""
	[ -n "$V" ] && return 0
	_skmi=""
	for _skz in $THERMAL_ZONES; do
		case "$_skz" in skin:*) _skmi="${_skz#skin:}"; break ;; esac
	done
	[ -n "$_skmi" ] && rdv "$THERMAL/thermal_zone$_skmi/temp" ""
	return 0
}

# profile_apply <jmeno> <0|1 = volano automatem>
profile_apply() {
	_name="$1"
	_auto="$2"
	_overlay="$3"
	case "$_name" in
		*/*|.*|"") die 1 "neplatne jmeno profilu: '$_name'" ;;
	esac
	_pf="$PROFILE_DIR/$_name.conf"
	if [ ! -f "$_pf" ]; then
		warn "pxtune: profil '$_name' neexistuje ($_pf)"
		warn "        dostupne:"
		profile_list 1>&2
		exit 1
	fi

	if [ "$_auto" = "1" ]; then
		log INFO "=== aplikuji profil '$_name' (automat, manual_override se nemeni) ==="
	else
		log INFO "=== aplikuji profil '$_name' (rucne) ==="
	fi
	WR_OK=0
	WR_FAIL=0
	VAL_FAIL=0

	# Nejdriv vse zpet na stock, aby profil nezdedil hodnoty po tom predchozim.
	# Bez toho by prazdne klice ("nesahat") znamenaly, ze se predchozi profil
	# jen castecne prekryje - viz komentar u restore_stock_values().
	restore_stock_values

	# Profil nacteme JEDNOU do promennych PF_* (bez forku). Nejdriv je vsechny
	# vynulujeme, aby po predchozim profilu nezustala viset stara hodnota.
	# shellcheck disable=SC2086
	for _pk in $PROFILE_KEYS; do
		eval "PF_$_pk="
		eval "PFSET_$_pk=0"
	done
	# PFSET_* rozlisuje "klic v profilu chybi" od "klic je prazdny" - to je
	# u THERMAL_PROFILE_* podstatne (prazdna hodnota = vratit na default).
	while IFS='=' read -r _pk _pv; do
		case "$_pk" in
			''|\#*)          continue ;;
			*[!A-Za-z0-9_]*) continue ;;
		esac
		_pv="${_pv%%#*}"
		while :; do
			case "$_pv" in
				*' '|*"	") _pv="${_pv%?}" ;;
				*) break ;;
			esac
		done
		case "$_pv" in
			\"*\") _pv="${_pv#\"}"; _pv="${_pv%\"}" ;;
			\'*\') _pv="${_pv#\'}"; _pv="${_pv%\'}" ;;
		esac
		eval "PF_$_pk=\$_pv"
		eval "PFSET_$_pk=1"
	done < "$_pf"

	# --- VRSTVA 2 per-app: overlay ------------------------------------------
	# APP_OVERLAY_<klic> z apps/<pkg>.conf prebiji stejnojmenny klic profilu,
	# a to POUZE po dobu, co je ten balicek v popredi.
	#
	# Proc se to dela PRAVE TADY: profil uz je nacteny v PF_*, ale jeste se nic
	# nezapsalo. Overlay tedy projde uplne stejnou validaci (set_uclamp,
	# set_gpu, set_vm, ...) jako hodnoty z profilu - zadna druha cesta zapisu
	# nevznika a `wr()` zustava jedinym mistem, kudy se do sysfs pise.
	#
	# NAVRAT JE ZDARMA: restore_stock_values() vyse uz probehl a probehne znovu
	# pri kazdem dalsim profile_apply(). Overlay se tedy nemuze "zaseknout" -
	# presne proto je vrstva 2 postavena na profilech a ne na vlastnim stavu.
	_ovn=0
	if [ -n "$_overlay" ] && [ -f "$APPDIR/$_overlay.conf" ]; then
		while IFS='=' read -r _ok _ov; do
			case "$_ok" in
				APP_OVERLAY_?*) _ok="${_ok#APP_OVERLAY_}" ;;
				*) continue ;;
			esac
			case "$_ok" in *[!A-Za-z0-9_]*) continue ;; esac
			# shellcheck disable=SC2086
			if ! in_list "$_ok" $PROFILE_KEYS; then
				log WARN "overlay $_overlay: '$_ok' neni klic kontraktu profilu, ignoruji"
				continue
			fi
			_ov="${_ov%%#*}"
			while :; do
				case "$_ov" in
					*' '|*"	") _ov="${_ov%?}" ;;
					*) break ;;
				esac
			done
			case "$_ov" in
				\"*\") _ov="${_ov#\"}"; _ov="${_ov%\"}" ;;
				\'*\') _ov="${_ov#\'}"; _ov="${_ov%\'}" ;;
			esac
			eval "PF_$_ok=\$_ov"
			eval "PFSET_$_ok=1"
			_ovn=$((_ovn + 1))
			log INFO "overlay $_overlay: $_ok='$_ov' prebiji profil '$_name'"
		done < "$APPDIR/$_overlay.conf"
		[ "$_ovn" -eq 0 ] && log INFO "overlay $_overlay: zadny APP_OVERLAY_* klic"
	elif [ -n "$_overlay" ]; then
		log WARN "overlay: pravidlo pro '$_overlay' neexistuje ($APPDIR/$_overlay.conf), profil '$_name' se aplikuje beze zmeny"
	fi

	set_uclamp top-app            min "$PF_UCLAMP_TOPAPP_MIN"
	set_uclamp top-app            max "$PF_UCLAMP_TOPAPP_MAX"
	set_uclamp foreground         min "$PF_UCLAMP_FG_MIN"
	set_uclamp foreground         max "$PF_UCLAMP_FG_MAX"
	set_uclamp background         min "$PF_UCLAMP_BG_MIN"
	set_uclamp background         max "$PF_UCLAMP_BG_MAX"
	set_uclamp system-background  min "$PF_UCLAMP_SYSBG_MIN"
	set_uclamp system-background  max "$PF_UCLAMP_SYSBG_MAX"

	set_gpu "$PF_GPU_MAX_FREQ" "$PF_GPU_MIN_FREQ" "$PF_GPU_POWER_POLICY"

	# Pozor: prop si nastavuje i system (napr. "camera" kdyz bezi fotak).
	# Prazdna hodnota = "nesahat" (kontrakt profilu), default se nevynucuje.
	_tm="$PF_THERMAL_PROFILE_CPU_MID"
	_th="$PF_THERMAL_PROFILE_CPU_HIGH"

	# --- THERMAL_PROFILE_MAX_SKIN (°C) - pojistka proti "hrani na slunci" -----
	# game.conf nastavuje thermal prop na "game", coz VYPINA CPU thermal
	# throttling ze 2 ze 4 skin senzoru (SPEC: "Mode":"game" -> cdev Disabled).
	# Kdyz je THERMAL_PROFILE_MAX_SKIN neprazdne a skin (quiet_therm) uz je NAD
	# touhle teplotou, hodnotu "game" NENASADIME - jinak bychom za horka telefon
	# uvarili. Ostatni hodnoty ("camera", "" = default) nejsou nebezpecne, ty
	# pojistka nechava projit. Prazdny klic = pojistka vypnuta.
	# Runtime dohled resi demon (therm_prop_maxskin_guard); tohle je kontrola
	# v okamziku APLIKACE profilu.
	_skin_over=0
	if [ -n "$PF_THERMAL_PROFILE_MAX_SKIN" ] && is_int "$PF_THERMAL_PROFILE_MAX_SKIN"; then
		skin_mc_v
		if is_int "$V" && [ "$V" -gt "$((PF_THERMAL_PROFILE_MAX_SKIN * 1000))" ]; then
			_skin_over=1
		fi
	fi

	if [ "$PFSET_THERMAL_PROFILE_CPU_MID" = "1" ] && [ -n "$_tm" ]; then
		if [ "$_skin_over" = "1" ] && [ "$_tm" = "game" ]; then
			log WARN "THERMAL_PROFILE_CPU_MID='game' NENASAZEN: skin nad THERMAL_PROFILE_MAX_SKIN=${PF_THERMAL_PROFILE_MAX_SKIN} C (jinak by za horka zustalo VYPNUTE CPU thermal throttling)"
		elif valid_thermal_profile "$_tm"; then
			set_thermal_profile "$THERMAL_SENSOR_MID" "$_tm"
		else
			vfail "neplatny THERMAL_PROFILE_CPU_MID '$_tm' (game|camera|prazdne)"
		fi
	fi
	if [ "$PFSET_THERMAL_PROFILE_CPU_HIGH" = "1" ] && [ -n "$_th" ]; then
		if [ "$_skin_over" = "1" ] && [ "$_th" = "game" ]; then
			log WARN "THERMAL_PROFILE_CPU_HIGH='game' NENASAZEN: skin nad THERMAL_PROFILE_MAX_SKIN=${PF_THERMAL_PROFILE_MAX_SKIN} C (jinak by za horka zustalo VYPNUTE CPU thermal throttling)"
		elif valid_thermal_profile "$_th"; then
			set_thermal_profile "$THERMAL_SENSOR_HIGH" "$_th"
		else
			vfail "neplatny THERMAL_PROFILE_CPU_HIGH '$_th' (game|camera|prazdne)"
		fi
	fi

	set_vm "$PF_VM_SWAPPINESS" \
	       "$PF_VM_DIRTY_RATIO" \
	       "$PF_VM_DIRTY_BG_RATIO" \
	       "$PF_VM_VFS_CACHE_PRESSURE"

	set_io_readahead "$PF_IO_READAHEAD_KB"

	_cs="$PF_CHARGE_STOP_LEVEL"
	if [ -n "$_cs" ]; then
		if valid_charge "$_cs"; then
			wr "$CHARGER/charge_stop_level" "$_cs"
		else
			vfail "neplatny CHARGE_STOP_LEVEL '$_cs' (povoleno 1-100)"
		fi
	fi

	# Klice kontraktu v2 (vendor_sched, sched_pixel/limit+down_rate, devfreq,
	# cpupm residency, GPU dvfs_period, cdev bypass). Prazdne = nesahat.
	set_v2

	print -r -- "$_name" > "$ACTIVE_FILE" 2>/dev/null

	if [ "$_auto" = "1" ]; then
		log INFO "profil '$_name' aplikovan automatem (ok=$WR_OK chyb=$WR_FAIL neplatnych=$VAL_FAIL)"
		msg "Profil '$_name' aplikovan (automat). Zapisu OK: $WR_OK, chyb: $WR_FAIL, neplatnych hodnot: $VAL_FAIL."
	else
		: > "$OVERRIDE_FILE" 2>/dev/null
		log INFO "profil '$_name' aplikovan rucne (ok=$WR_OK chyb=$WR_FAIL neplatnych=$VAL_FAIL), manual_override nastaven"
		msg "Profil '$_name' aplikovan. Zapisu OK: $WR_OK, chyb: $WR_FAIL, neplatnych hodnot: $VAL_FAIL."
		msg "manual_override nastaven (automat do profilu nemluvi). Zrusis: pxtune profile auto"
	fi

	[ "$WR_FAIL" -gt 0 ] && return 2
	[ "$VAL_FAIL" -gt 0 ] && return 2
	return 0
}

# ---------------------------------------------------------------------------
# revert
# ---------------------------------------------------------------------------
cmd_revert() {
	WR_OK=0
	WR_FAIL=0

	if stock_valid; then
		msg "Vracim stock hodnoty z $STOCK_CONF"
		log INFO "=== revert ze stock.conf ==="
	else
		warn "pxtune: stock.conf chybi nebo je poskozeny - pouzivam vychozi hodnoty ze SPEC"
		log WARN "=== revert: stock.conf nepouzitelny, fallback na SPEC defaulty ==="
	fi

	# uclamp
	for _g in $UCLAMP_GROUPS; do
		uclamp_keyv "$_g"; _k="$UK"
		if [ "$_g" = "nnapi-hal" ]; then
			_dmin="$DEF_UCLAMP_MIN_NNAPI"
		else
			_dmin="$DEF_UCLAMP_MIN"
		fi
		stock_getv "STOCK_UCLAMP_${_k}_MIN" "$_dmin"; _vmin="$SV"
		stock_getv "STOCK_UCLAMP_${_k}_MAX" "$DEF_UCLAMP_MAX"; _vmax="$SV"
		[ -n "$_vmin" ] && wr "$CPUCTL/$_g/cpu.uclamp.min" "$_vmin"
		[ -n "$_vmax" ] && wr "$CPUCTL/$_g/cpu.uclamp.max" "$_vmax"
	done

	# GPU: nejdriv min dolu, pak max nahoru (aby se nebranily navzajem)
	stock_getv STOCK_GPU_MIN_FREQ "$DEF_GPU_MIN"; _gmin="$SV"
	stock_getv STOCK_GPU_MAX_FREQ "$DEF_GPU_MAX"; _gmax="$SV"
	stock_getv STOCK_GPU_POWER_POLICY "$DEF_GPU_POLICY"; _gpol="$SV"
	valid_gpu_freq "$_gmin"   || _gmin="$DEF_GPU_MIN"
	valid_gpu_freq "$_gmax"   || _gmax="$DEF_GPU_MAX"
	valid_gpu_policy "$_gpol" || _gpol="$DEF_GPU_POLICY"
	wr "$MALI/scaling_min_freq" "$_gmin"
	wr "$MALI/scaling_max_freq" "$_gmax"
	# hint_max_freq se zalohuje ve snapshot_stock, tak ho i vracime
	stock_getv STOCK_GPU_HINT_MAX_FREQ ""; _ghint="$SV"
	if [ -n "$_ghint" ] && valid_gpu_freq "$_ghint"; then
		wr "$MALI/hint_max_freq" "$_ghint"
	fi
	wr "$MALI/power_policy" "$_gpol"

	# vm
	stock_getv STOCK_VM_SWAPPINESS "$DEF_SWAPPINESS"; _v="$SV";                 is_int "$_v" || _v="$DEF_SWAPPINESS";         wr /proc/sys/vm/swappiness "$_v"
	stock_getv STOCK_VM_DIRTY_RATIO "$DEF_DIRTY_RATIO"; _v="$SV";               is_int "$_v" || _v="$DEF_DIRTY_RATIO";        wr /proc/sys/vm/dirty_ratio "$_v"
	stock_getv STOCK_VM_DIRTY_BG_RATIO "$DEF_DIRTY_BG_RATIO"; _v="$SV";         is_int "$_v" || _v="$DEF_DIRTY_BG_RATIO";     wr /proc/sys/vm/dirty_background_ratio "$_v"
	stock_getv STOCK_VM_VFS_CACHE_PRESSURE "$DEF_VFS_CACHE_PRESSURE"; _v="$SV"; is_int "$_v" || _v="$DEF_VFS_CACHE_PRESSURE"; wr /proc/sys/vm/vfs_cache_pressure "$_v"
	stock_getv STOCK_VM_PAGE_CLUSTER "$DEF_PAGE_CLUSTER"; _v="$SV";             is_int "$_v" || _v="$DEF_PAGE_CLUSTER";       wr /proc/sys/vm/page-cluster "$_v"

	# nabijeni
	stock_getv STOCK_CHARGE_STOP_LEVEL "$DEF_CHARGE_STOP"; _v="$SV";   valid_charge "$_v" || _v="$DEF_CHARGE_STOP"
	wr "$CHARGER/charge_stop_level" "$_v"
	stock_getv STOCK_CHARGE_START_LEVEL "$DEF_CHARGE_START"; _v="$SV"; is_int "$_v" || _v="$DEF_CHARGE_START"
	wr "$CHARGER/charge_start_level" "$_v"

	# I/O readahead
	for _d in $IO_DEVS; do
		[ -e "/sys/block/$_d/queue/read_ahead_kb" ] || continue
		_k=$(print -rn -- "$_d" | tr 'a-z' 'A-Z')
		stock_getv "STOCK_IO_READAHEAD_$_k" ""; _v="$SV"
		[ -n "$_v" ] && is_int "$_v" && wr "/sys/block/$_d/queue/read_ahead_kb" "$_v"
	done

	# thermal HAL profily
	stock_getv STOCK_THERMAL_PROFILE_CPU_MID "$DEF_THERMAL_PROFILE"; _v="$SV"
	valid_thermal_profile "$_v" || _v="$DEF_THERMAL_PROFILE"
	set_thermal_profile "$THERMAL_SENSOR_MID" "$_v"
	stock_getv STOCK_THERMAL_PROFILE_CPU_HIGH "$DEF_THERMAL_PROFILE"; _v="$SV"
	valid_thermal_profile "$_v" || _v="$DEF_THERMAL_PROFILE"
	set_thermal_profile "$THERMAL_SENSOR_HIGH" "$_v"

	# kontrakt v2 - vrat nove uzly na stock. Ze stock.conf, jinak DEF_V2_*
	# (stary snapshot z doby pred v2 tyhle klice nema). Uzly, ktere na tomhle
	# buildu neexistuji, se preskoci ([ -e ]).
	for _e in $V2_TABLE; do
		_vk="${_e%%:*}"; _vrest="${_e#*:}"; _vp="${_vrest%:*}"; _vkind="${_vrest##*:}"
		eval "_vdef=\$DEF_V2_$_vk"
		stock_getv "STOCK_$_vk" "$_vdef"; _v="$SV"
		[ -n "$_v" ] || _v="$_vdef"
		v2_valid "$_vkind" "$_v" || _v="$_vdef"
		[ -n "$_v" ] && [ -e "$_vp" ] && wr "$_vp" "$_v"
	done
	# THERMAL_CDEV_BYPASS: revert vzdy VYPNE (0) - bezpecny smer, at uz ho
	# nastavil kdokoli. Stock je 0.
	for _bn in $CDEV_BYPASS_NODES; do
		[ -e "$_bn" ] && wr "$_bn" "0"
	done

	# Pri pouziti jako "reset pred profilem" tady koncime: rozliseni ani
	# stavove soubory se nesmi sahat, to je vec plneho revertu.
	if [ "${RESTORE_ONLY:-0}" = "1" ]; then
		return 0
	fi

	# --- VRSTVA 3 per-app: sundat DRIV, nez zapiseme stock displej ----------
	# "Vrat VSECHNO na stock" zahrnuje i vrstvu 3 nasazenou per-app pravidlem
	# (refresh rate, rozliseni). `app leave` je IDEMPOTENTNI, takze se smi
	# volat naslepo - kdyz nic nasazeno neni, tise skonci s kodem 0.
	# Tohle je 6. z SESTI nezavislych cest, ktere ho musi volat; ostatnich pet
	# je v demonovi a v service.sh. Vycet a duvody viz komentar u cmd_leave()
	# v bin/pxtune-perapp.
	# Poradi je podstatne: leave zapisuje stary displej, takze musi probehnout
	# PRED res_write_settings() nize - jinak by prepsal stock hodnotu.
	if [ -x "$PERAPP" ]; then
		"$PERAPP" leave >/dev/null 2>&1
	elif [ -f "$APPMODE" ]; then
		log ERROR "$PERAPP neni spustitelny - appmode.active mazu bez navratu vrstvy 3 (rozliseni/refresh muze zustat po per-app pravidle)"
		rm -f "$APPMODE" 2>/dev/null
	fi

	# displej
	stock_getv STOCK_DISPLAY_SIZE_FORCED "$DEF_DISPLAY_SIZE"; _size="$SV"
	stock_getv STOCK_DISPLAY_DENSITY_FORCED "$DEF_DISPLAY_DENSITY"; _dens="$SV"
	res_write_settings "$_size" "$_dens"
	rm -f "$RESPEND_FILE" 2>/dev/null

	# stav
	# Zamerne PRAZDNE, ne "stock": profiles/stock.conf neexistuje a service.sh
	# by kazdy boot logoval ERROR "profil 'stock' neexistuje". Prazdno uz umi
	# zpracovat jako "nic neaplikuj".
	{ : > "$ACTIVE_FILE"; } 2>/dev/null
	: > "$OVERRIDE_FILE" 2>/dev/null
	# Rucni zaklad per-app epizody je soucast "vseho na stock" - jinak by ho
	# demon po revertu omylem obnovil misto cerstve pripnuteho stavu.
	rm -f "$STATE_DIR/manual_base" 2>/dev/null

	log INFO "revert dokoncen (zapisu ok=$WR_OK chyb=$WR_FAIL)"
	msg "Revert dokoncen. Zapisu OK: $WR_OK, chyb: $WR_FAIL."
	msg "manual_override nastaven, aby automat hned nezapsal jiny profil."
	msg "POZNAMKA: zram se za behu nemeni (swapoff je nebezpecny) - zmeny jen v post-fs-data.sh."
	[ "$WR_FAIL" -gt 0 ] && return 2
	return 0
}

# restore_stock_values - vrati vsechny profilem ovladane hodnoty na stock,
# ale NESAHA na rozliseni ani na stavove soubory.
#
# Proc to existuje: prazdna hodnota v profilu znamena "nesahat" (kontrakt
# profilu). Bez tohohle resetu by profily byly "lepive" - po prepnuti
# z powersave na balanced (ktery ma vsechny klice prazdne) by zustaly
# hodnoty z powersave a balanced by nevratil stock, jak slibuje.
# Overeno na zarizeni: prepnuti powersave -> balanced nechalo top-app
# uclamp.max na 60 misto 'max'.
restore_stock_values() {
	_rsv_ok="$WR_OK"
	_rsv_fail="$WR_FAIL"
	RESTORE_ONLY=1
	cmd_revert >/dev/null 2>&1
	RESTORE_ONLY=0
	# zapisy z resetu se nepocitaji do statistiky profilu
	WR_OK="$_rsv_ok"
	WR_FAIL="$_rsv_fail"
	return 0
}

# ---------------------------------------------------------------------------
# res - rozliseni / DPI
# ---------------------------------------------------------------------------
# res_split <polozka> -> nastavi _pn _pw _ph _pd
res_split() {
	_pn=${1%%:*}
	_pr=${1#*:}
	_pw=${_pr%%:*}
	_pr=${_pr#*:}
	_ph=${_pr%%:*}
	_pd=${_pr##*:}
}

# res_lookup <jmeno|WxH|W> -> "W H DPI"
res_lookup() {
	for _p in $RES_PRESETS; do
		res_split "$_p"
		if [ "$1" = "$_pn" ] || [ "$1" = "${_pw}x${_ph}" ] || [ "$1" = "$_pw" ]; then
			printf '%s %s %s' "$_pw" "$_ph" "$_pd"
			return 0
		fi
	done
	return 1
}

# res_preset_names -> "native 900x2000 810x1800 720x1600"
res_preset_names() {
	_out=""
	for _p in $RES_PRESETS; do
		res_split "$_p"
		_out="$_out $_pn"
	done
	print -rn -- "${_out# }"
}

# display_state_write <W> <H> <DPI> - cache pro status --json (bez binderu)
display_state_write() {
	printf '%s %s %s\n' "$1" "$2" "$3" > "$DISPSTATE_FILE" 2>/dev/null
}

# display_state_read -> "W H DPI"; fallback nativni + hustota z stock.conf/getprop
display_state_read() {
	_ds=$(rd "$DISPSTATE_FILE") || _ds=""
	if [ -n "$_ds" ]; then
		print -rn -- "$_ds"
		return 0
	fi
	stock_getv STOCK_DISPLAY_DENSITY_FORCED ""; _d="$SV"
	if ! is_int "$_d"; then
		_d=$(getprop ro.sf.lcd_density 2>/dev/null)
		is_int "$_d" || _d="$NATIVE_DPI"
	fi
	printf '%s %s %s' "$NATIVE_W" "$NATIVE_H" "$_d"
}

# res_write_settings <"W,H" | ""> <dpi | "">
res_write_settings() {
	_sz="$1"
	_dp="$2"
	if ! framework_ok; then
		warn "pxtune: prikaz 'settings' neni k dispozici (nebo je framework zakazany)"
		log ERROR "settings nedostupny, rozliseni nezmeneno"
		return 2
	fi

	if [ -z "$_sz" ]; then
		settings_run delete global display_size_forced \
			|| settings_run put global display_size_forced ""
		log INFO "settings global display_size_forced -> (smazano/prazdne)"
	else
		settings_run put global display_size_forced "$_sz"
		log INFO "settings global display_size_forced -> '$_sz'"
	fi

	if [ -n "$_dp" ]; then
		settings_run put secure display_density_forced "$_dp"
		log INFO "settings secure display_density_forced -> '$_dp'"
	else
		settings_run delete secure display_density_forced \
			|| settings_run put secure display_density_forced ""
		log INFO "settings secure display_density_forced -> (smazano/prazdne)"
	fi

	# cache pro status --json
	if [ -z "$_sz" ]; then
		_cw="$NATIVE_W"; _ch="$NATIVE_H"
	else
		_cw=${_sz%%,*}; _ch=${_sz##*,}
	fi
	if [ -n "$_dp" ]; then
		_cd="$_dp"
	else
		_cd=$(getprop ro.sf.lcd_density 2>/dev/null)
		is_int "$_cd" || _cd="$NATIVE_DPI"
	fi
	display_state_write "$_cw" "$_ch" "$_cd"
	return 0
}

# res_pending_seconds -> kolik sekund zbyva do automatickeho navratu (0 = nic nebezi)
res_pending_seconds() {
	if [ ! -f "$RESPEND_FILE" ]; then
		printf '0'
		return 0
	fi
	_tok=$(rd "$RESPEND_FILE") || _tok=""
	_start=${_tok%%-*}
	_now=$(date '+%s' 2>/dev/null)
	if ! is_int "$_start" || ! is_int "$_now"; then
		printf '0'
		return 0
	fi
	_left=$((RES_TIMEOUT - (_now - _start)))
	[ "$_left" -lt 0 ] && _left=0
	[ "$_left" -gt "$RES_TIMEOUT" ] && _left="$RES_TIMEOUT"
	print -rn -- "$_left"
}

res_current() {
	_s=$(settings_get global display_size_forced)
	_d=$(settings_get secure display_density_forced)
	[ -n "$_s" ] || _s="(prazdne = nativni ${NATIVE_W}x${NATIVE_H})"
	[ -n "$_d" ] || _d="(prazdne)"
	msg "display_size_forced   : $_s"
	msg "display_density_forced: $_d"
	if [ -f "$RESPEND_FILE" ]; then
		msg "res_pending           : ANO - zbyva $(res_pending_seconds) s na 'pxtune res confirm'"
	else
		msg "res_pending           : ne"
	fi
}

res_apply_native() {
	res_write_settings "$NATIVE_W,$NATIVE_H" "$NATIVE_DPI"
}

cmd_res() {
	case "$1" in
		""|status|current)
			res_current
			return 0
			;;
		list)
			msg "Dostupne presety:"
			for _p in $RES_PRESETS; do
				res_split "$_p"
				printf '  %-10s %sx%s @ %s dpi\n' "$_pn" "$_pw" "$_ph" "$_pd"
			done
			return 0
			;;
		confirm)
			if [ -f "$RESPEND_FILE" ]; then
				rm -f "$RESPEND_FILE" 2>/dev/null
				log INFO "res confirm - zmena rozliseni potvrzena, watchdog zrusen"
				msg "Rozliseni potvrzeno, automaticky navrat zrusen."
			else
				msg "Nic k potvrzeni (res_pending neexistuje)."
			fi
			return 0
			;;
		reset)
			rm -f "$RESPEND_FILE" 2>/dev/null
			log INFO "res reset - slepy navrat na nativni ${NATIVE_W}x${NATIVE_H} @ ${NATIVE_DPI}dpi"
			res_apply_native || return 2
			msg "Nastaveno nativni ${NATIVE_W}x${NATIVE_H} @ ${NATIVE_DPI} dpi."
			return 0
			;;
	esac

	if ! _r=$(res_lookup "$1"); then
		warn "pxtune: neznamy preset rozliseni '$1'"
		warn "        pouzij: pxtune res list  (presety: $(res_preset_names))"
		exit 1
	fi
	# shellcheck disable=SC2086
	set -- $_r
	_w="$1"; _h="$2"; _d="$3"

	log INFO "res: nastavuji ${_w}x${_h} @ ${_d}dpi"
	res_write_settings "$_w,$_h" "$_d" || return 2

	if [ "$_w" = "$NATIVE_W" ] && [ "$_h" = "$NATIVE_H" ] && [ "$_d" = "$NATIVE_DPI" ]; then
		rm -f "$RESPEND_FILE" 2>/dev/null
		msg "Nastaveno nativni ${_w}x${_h} @ ${_d} dpi (bez pojistky)."
		return 0
	fi

	# POJISTKA: res_pending + odlozeny navrat na nativni za RES_TIMEOUT sekund.
	# Token = "<epoch vzniku>-<pid>"; z epochy se pocita i res_pending_seconds.
	_tok="$(date '+%s' 2>/dev/null)-$$"
	print -r -- "$_tok" > "$RESPEND_FILE" 2>/dev/null
	res_arm_watchdog "$_tok"

	msg "Nastaveno ${_w}x${_h} @ ${_d} dpi."
	msg "POJISTKA: pokud do ${RES_TIMEOUT} s nespustis 'pxtune res confirm',"
	msg "          rozliseni se vrati na nativni ${NATIVE_W}x${NATIVE_H} @ ${NATIVE_DPI} dpi."
	return 0
}

res_arm_watchdog() {
	_tok="$1"
	if [ -x "$SELF" ]; then
		if command -v nohup >/dev/null 2>&1; then
			nohup "$SELF" __res_watchdog "$_tok" >/dev/null 2>&1 &
		else
			"$SELF" __res_watchdog "$_tok" >/dev/null 2>&1 &
		fi
	else
		if command -v nohup >/dev/null 2>&1; then
			nohup /system/bin/sh "$SELF" __res_watchdog "$_tok" >/dev/null 2>&1 &
		else
			/system/bin/sh "$SELF" __res_watchdog "$_tok" >/dev/null 2>&1 &
		fi
	fi
	log INFO "res watchdog nasazen (token=$_tok, timeout=${RES_TIMEOUT}s)"
}

res_watchdog() {
	_tok="$1"
	sleep "$RES_TIMEOUT"
	if [ ! -f "$RESPEND_FILE" ]; then
		log INFO "res watchdog ($_tok): potvrzeno, nic nedelam"
		return 0
	fi
	_cur=$(rd "$RESPEND_FILE") || _cur=""
	if [ "$_cur" != "$_tok" ]; then
		log INFO "res watchdog ($_tok): mezitim prisla novejsi zmena ($_cur), koncim"
		return 0
	fi
	log WARN "res watchdog ($_tok): potvrzeni neprislo, vracim nativni rozliseni"
	res_apply_native
	rm -f "$RESPEND_FILE" 2>/dev/null
	return 0
}

# ---------------------------------------------------------------------------
# dpi - samostatna zmena hustoty displeje (nezavisle na rozliseni)
#
# MECHANISMUS (overeno na zarizeni 2026-08-07):
#   `wm density <n>`  -> Override density: n  A ZAROVEN zapise
#                        settings secure display_density_forced = n
#   `wm density reset` -> override zrusi
#
#   POZOR: samotny `settings put secure display_density_forced` se NEPROJEVI.
#   Overeno: zapis 380 nechal Override na 353. WindowManager musi hodnotu
#   aplikovat, a to dela prave prikaz `wm`. Klic v settings je jen misto, kam
#   si ji WM uklada pro pristi boot.
#
# HODNOTY
#   Fyzicka hustota panelu je 420 (ro.sf.lcd_density).
#   Uzivatel ma vlastni override 353 (mensi = vic obsahu na obrazovce).
#   Rozsah 280-560 je zamerne konzervativni: pod 280 zacina byt UI necitelne
#   drobne a systemove dialogy se rozbijeji, nad 560 se nevejdou tlacitka.
#
# POJISTKA
#   Stejna jako u rozliseni: po zmene se ceka na `pxtune dpi confirm`.
#   Bez potvrzeni se do DPI_TIMEOUT sekund vrati puvodni hodnota - takze i
#   kdyz se UI stane neovladatelnym, samo se to opravi.
#   Slepy navrat odkudkoli:  su -c "pxtune dpi reset"
# ---------------------------------------------------------------------------
DPI_MIN=280
DPI_MAX=560
DPI_TIMEOUT=60
DPIPEND_FILE="$STATE_DIR/dpi_pending"

# dpi_current -> aktualni ucinna hustota (Override, jinak fyzicka)
dpi_current() {
	stock_getv STOCK_DISPLAY_DENSITY_FORCED ""
	_dc="$SV"
	rdv "$DISPSTATE_FILE" ""
	if [ -n "$V" ]; then
		# shellcheck disable=SC2086
		set -- $V
		[ -n "${3:-}" ] && _dc="$3"
	fi
	if framework_ok; then
		_q=$(settings_get secure display_density_forced)
		[ -n "$_q" ] && _dc="$_q"
	fi
	[ -n "$_dc" ] || _dc="$NATIVE_DPI_HW"
	printf '%s' "$_dc"
}

dpi_apply() {
	# dpi_apply <hodnota|reset>
	if ! framework_ok; then
		warn "pxtune: prikaz 'wm' neni k dispozici (system jeste nenabehl?)"
		return 2
	fi
	if [ "$1" = "reset" ]; then
		if command -v timeout >/dev/null 2>&1; then
			timeout 10 wm density reset >/dev/null 2>&1
		else
			wm density reset >/dev/null 2>&1
		fi
		log INFO "wm density reset"
	else
		if command -v timeout >/dev/null 2>&1; then
			timeout 10 wm density "$1" >/dev/null 2>&1
		else
			wm density "$1" >/dev/null 2>&1
		fi
		log INFO "wm density $1"
	fi
	return 0
}

dpi_watchdog() {
	_tok="$1"
	_old="$2"
	sleep "$DPI_TIMEOUT"
	[ -f "$DPIPEND_FILE" ] || { log INFO "dpi watchdog ($_tok): potvrzeno"; return 0; }
	_cur=$(rd "$DPIPEND_FILE") || _cur=""
	case "$_cur" in
		"$_tok"*) ;;
		*) log INFO "dpi watchdog ($_tok): prisla novejsi zmena, koncim"; return 0 ;;
	esac
	log WARN "dpi watchdog ($_tok): potvrzeni neprislo, vracim $_old"
	dpi_apply "$_old"
	rm -f "$DPIPEND_FILE" 2>/dev/null
	return 0
}

cmd_dpi() {
	case "${1:-}" in
		""|show|current)
			msg "aktualni hustota : $(dpi_current) dpi"
			msg "fyzicka panelu   : $NATIVE_DPI_HW dpi"
			msg "povoleny rozsah  : $DPI_MIN - $DPI_MAX"
			if [ -f "$DPIPEND_FILE" ]; then
				msg "POZOR: ceka na potvrzeni - 'pxtune dpi confirm' (jinak se to vrati)"
			fi
			return 0
			;;
		confirm)
			if [ -f "$DPIPEND_FILE" ]; then
				rm -f "$DPIPEND_FILE" 2>/dev/null
				msg "Potvrzeno, hustota $(dpi_current) dpi zustava."
			else
				msg "Nic k potvrzeni."
			fi
			return 0
			;;
		reset)
			# slepy navrat - funguje i kdyz uzivatel na displej nevidi
			stock_getv STOCK_DISPLAY_DENSITY_FORCED ""
			_rd="$SV"
			if is_int "$_rd"; then
				dpi_apply "$_rd"
				msg "Vraceno na ulozenou hustotu $_rd dpi."
			else
				dpi_apply reset
				msg "Override zrusen, plati fyzicka hustota $NATIVE_DPI_HW dpi."
			fi
			rm -f "$DPIPEND_FILE" 2>/dev/null
			return 0
			;;
	esac

	_nd="$1"
	if ! is_int "$_nd"; then
		warn "pxtune: pouziti: pxtune dpi <$DPI_MIN-$DPI_MAX | show | confirm | reset>"
		exit 1
	fi
	if [ "$_nd" -lt "$DPI_MIN" ] || [ "$_nd" -gt "$DPI_MAX" ]; then
		warn "pxtune: $_nd je mimo bezpecny rozsah $DPI_MIN-$DPI_MAX"
		warn "        Mimo nej se UI stava neovladatelnym."
		exit 1
	fi

	_old=$(dpi_current)
	dpi_apply "$_nd" || return 2

	_tok="$(date '+%s' 2>/dev/null)-$$"
	print -r -- "$_tok $_old" > "$DPIPEND_FILE" 2>/dev/null
	if [ -x "$SELF" ]; then
		nohup "$SELF" __dpi_watchdog "$_tok" "$_old" >/dev/null 2>&1 &
	else
		nohup /system/bin/sh "$SELF" __dpi_watchdog "$_tok" "$_old" >/dev/null 2>&1 &
	fi
	log INFO "dpi $_old -> $_nd (watchdog $_tok, timeout ${DPI_TIMEOUT}s)"

	msg "Hustota nastavena na $_nd dpi (bylo $_old)."
	msg "POJISTKA: do ${DPI_TIMEOUT} s spust 'pxtune dpi confirm',"
	msg "          jinak se to samo vrati na $_old."
	return 0
}

# ---------------------------------------------------------------------------
# charge
# ---------------------------------------------------------------------------
cmd_charge() {
	_node="$CHARGER/charge_stop_level"
	case "$1" in
		"")
			msg "charge_stop_level : $(rd_def "$_node" "?")"
			msg "charge_start_level: $(rd_def "$CHARGER/charge_start_level" "?")"
			msg "capacity          : $(rd_def "$BATT/capacity" "?") %"
			return 0
			;;
		off|OFF) _val="$DEF_CHARGE_STOP" ;;
		*)       _val="$1" ;;
	esac

	if ! valid_charge "$_val"; then
		warn "pxtune: neplatna hodnota '$1' - povoleno 1-100 nebo 'off'"
		exit 1
	fi

	if wr "$_node" "$_val"; then
		msg "charge_stop_level nastaven na $_val %."
		return 0
	fi
	warn "pxtune: zapis charge_stop_level selhal (viz log)"
	return 2
}

# ---------------------------------------------------------------------------
# game - obalka nad 'cmd game'
# ---------------------------------------------------------------------------
cmd_game() {
	case "${1:-}" in
		''|*[!A-Za-z0-9._]*)
			warn "pxtune: neplatne jmeno balicku '${1:-}'"
			exit 1 ;;
	esac
	_pkg="$1"
	_mode="$2"
	[ "$#" -ge 1 ] && shift
	[ "$#" -ge 1 ] && shift

	if [ -z "$_pkg" ]; then
		warn "pxtune: pouziti: pxtune game <package> <1|2|3|4|standard|performance|battery|custom>"
		warn "                 pxtune game <package>            # vypis rezimu a konfigu"
		warn "                 pxtune game <package> <mode> [--fps N] [--downscale 0.5..0.9|disable]"
		exit 1
	fi
	if ! command -v cmd >/dev/null 2>&1; then
		warn "pxtune: prikaz 'cmd' neni k dispozici"
		return 2
	fi

	if [ -z "$_mode" ]; then
		msg "--- list-modes $_pkg ---"
		cmd game list-modes "$_pkg" 2>&1
		msg "--- list-configs $_pkg ---"
		cmd game list-configs "$_pkg" 2>&1
		return 0
	fi

	case "$_mode" in
		1|2|3|4|standard|performance|battery|custom) ;;
		*)
			warn "pxtune: neplatny rezim '$_mode' (1|2|3|4|standard|performance|battery|custom)"
			exit 1
			;;
	esac

	cmd game mode "$_mode" "$_pkg" 2>&1
	_rc=$?
	log INFO "cmd game mode $_mode $_pkg -> rc=$_rc"

	_fps=""
	_ds=""
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--fps)
				shift
				_fps="$1"
				is_int "$_fps" || { warn "pxtune: --fps chce cele cislo"; exit 1; }
				;;
			--downscale)
				shift
				_ds="$1"
				case "$_ds" in
					disable|0.[5-9]|0.[5-9]0) ;;
					*) warn "pxtune: --downscale chce 0.5..0.9 nebo 'disable' (pod 0.5 se rozbiji dotyk u her)"; exit 1 ;;
				esac
				;;
			*)
				warn "pxtune: neznamy parametr '$1'"
				exit 1
				;;
		esac
		shift
	done
	[ -n "$_fps" ] && { cmd game set --fps "$_fps" "$_pkg" 2>&1; log INFO "cmd game set --fps $_fps $_pkg"; }
	[ -n "$_ds" ]  && { cmd game set --downscale "$_ds" "$_pkg" 2>&1; log INFO "cmd game set --downscale $_ds $_pkg"; }

	[ "$_rc" -eq 0 ] || return 2
	return 0
}

# ---------------------------------------------------------------------------
# zram - AKCE nad zram0 (ne profil)
#
# `pxtune zram writeback [sekundy]` - odsune komprimovane stranky, ktere jsou
# necinne >= <sekundy> (default 3600 = 1 h), na backing device (loop50), a tim
# uvolni RAM. Je to AKCE, ne nastaveni (jako wake_lock), proto CLI a ne profil.
#
# Bezpecnost UFS: writeback_limit_enable=1 + writeback_limit stropuje pocet
# zapsanych stranek na 65536 (po 4 KiB = ~256 MiB / beh), aby se opakovanym
# spoustenim zbytecne neopotreboval flash. Uzly idle/writeback jsou write-only
# (prava 220), takze wr() u nich nemuze precist starou hodnotu (zaloguje '?') -
# to je v poradku, jen se vzdy zapise. bd_stat je citelny, logujeme pred/po.
#
# NENI to nebezpecne jako swapoff (SPEC): writeback jen presouva stranky na disk,
# swap zustava aktivni. Proto smi bezet za behu, na rozdil od zmen velikosti zramu.
# ---------------------------------------------------------------------------
zram_writeback() {
	_age="${1:-3600}"
	if ! is_int "$_age"; then
		warn "pxtune: zram writeback <sekundy> chce cele cislo (vek necinnosti), vychozi 3600"
		exit 1
	fi
	if [ ! -d "$ZRAM" ]; then
		warn "pxtune: $ZRAM neexistuje"
		return 2
	fi
	if [ ! -e "$ZRAM/writeback" ]; then
		warn "pxtune: zram writeback neni podporovan (chybi $ZRAM/writeback - neni nastaveny backing_dev?)"
		log ERROR "zram writeback: $ZRAM/writeback neexistuje"
		return 2
	fi

	WR_OK=0
	WR_FAIL=0

	_bd_before=$(rd_def "$ZRAM/bd_stat" "n/a")
	log INFO "=== zram writeback (vek >= ${_age}s) === bd_stat pred: $_bd_before"

	# Strop tohoto behu: 65536 stranek po 4 KiB = ~256 MiB. Konzervativne, aby
	# se pri opakovanem volani zbytecne neopotreboval UFS.
	wr "$ZRAM/writeback_limit_enable" 1
	wr "$ZRAM/writeback_limit" 65536
	# idle a writeback jsou WRITE-ONLY (0220). wr() je pred zapisem cte (rdv),
	# coz na write-only uzlu vyhodi "Permission denied" na stderr. Pisem proto
	# primo, se spravnym poradim redirekci (2>/dev/null uvnitr {}). Uspech
	# poznat z bd_stat pred/po, ne ze zpetneho cteni.
	if { print -r -- "$_age" > "$ZRAM/idle"; } 2>/dev/null; then
		WR_OK=$((WR_OK + 1))
		log INFO "wr: $ZRAM/idle <- '$_age' (write-only, bez zpetneho cteni)"
	else
		WR_FAIL=$((WR_FAIL + 1))
		log ERROR "wr: zapis do $ZRAM/idle selhal (vek $_age)"
	fi
	if { print -r -- idle > "$ZRAM/writeback"; } 2>/dev/null; then
		WR_OK=$((WR_OK + 1))
		log INFO "wr: $ZRAM/writeback <- 'idle' (write-only, bez zpetneho cteni)"
	else
		WR_FAIL=$((WR_FAIL + 1))
		log ERROR "wr: zapis do $ZRAM/writeback selhal"
	fi

	_bd_after=$(rd_def "$ZRAM/bd_stat" "n/a")
	log INFO "=== zram writeback hotovo (ok=$WR_OK chyb=$WR_FAIL) === bd_stat po: $_bd_after"

	msg "zram writeback: stranky necinne >= ${_age}s oznaceny a zapsany na backing device."
	msg "  strop tohoto behu : 65536 stranek (~256 MiB)"
	msg "  bd_stat pred      : $_bd_before"
	msg "  bd_stat po        : $_bd_after"
	msg "  (bd_stat = 'bd_count bd_reads bd_writes' ve 4KiB strankach)"
	[ "$WR_FAIL" -gt 0 ] && return 2
	return 0
}

cmd_zram() {
	case "${1:-}" in
		writeback)
			shift
			zram_writeback "$@"
			;;
		""|*)
			warn "pxtune: pouziti: pxtune zram writeback [sekundy]   (vychozi 3600 = 1 h)"
			exit 1
			;;
	esac
}

# ---------------------------------------------------------------------------
# dexopt - obalka nad `pm compile -m speed -f <pkg>`
#
# Prekompiluje balicek do plne AOT (speed), coz zrychli beh za cenu mista
# a jednorazoveho CPU/tepla. `pm` je BINDER klient -> vzdy s timeoutem a jen
# kdyz uz nabehl framework. NIKDY nevolat z demona (blokujici, forkujici binder).
# ---------------------------------------------------------------------------
cmd_dexopt() {
	_pkg="${1:-}"
	case "$_pkg" in
		''|*[!A-Za-z0-9._]*)
			warn "pxtune: dexopt chce platne jmeno balicku, ne '${_pkg}'"
			warn "        pouziti: pxtune dexopt <package>"
			exit 1
			;;
	esac
	if ! command -v pm >/dev/null 2>&1; then
		warn "pxtune: prikaz 'pm' neni k dispozici"
		return 2
	fi
	if ! framework_ok; then
		warn "pxtune: framework jeste nenabehl (pm je binder) - zkus pozdeji"
		log ERROR "dexopt $_pkg: framework nedostupny"
		return 2
	fi

	log INFO "dexopt: pm compile -m speed -f $_pkg"
	if command -v timeout >/dev/null 2>&1; then
		_out=$(timeout 600 pm compile -m speed -f "$_pkg" 2>&1)
	else
		_out=$(pm compile -m speed -f "$_pkg" 2>&1)
	fi
	_rc=$?
	[ -n "$_out" ] && msg "$_out"
	log INFO "dexopt $_pkg -> rc=$_rc: $_out"
	if [ "$_rc" -ne 0 ]; then
		warn "pxtune: pm compile skoncil s kodem $_rc"
		return 2
	fi
	return 0
}

# ---------------------------------------------------------------------------
# thermal - vysvetleni aktualniho stavu skinu vuci prahum VIRTUAL-SKIN
#
# HORKA CESTA (WebUI to muze volat): akumuluj do promenne, vypis JEDNIM print,
# zadny printf/mc_to_c (fork). Prahy jsou ze SPEC/probe-analiza (mC):
#   LIGHT-ODPM 37/39 | CPU-MID 39/41 | CPU-HIGH 41/43/52 | GPU 43/45/46,5/52
#   hystereze 1,9 C (HotHysteresis)
# ---------------------------------------------------------------------------
thermal_explain() {
	skin_mc_v
	if ! is_int "$V"; then
		warn "pxtune: skin (quiet_therm) se nepodarilo precist"
		return 2
	fi
	_sk="$V"
	# skin je kladny => bezforkovy prepocet na °C s jednim desetinnym mistem
	_skc="$((_sk / 1000)).$(( (_sk % 1000) / 100 ))"

	# nejblizsi prah NAD aktualnim skinem
	_next=""
	for _t in 37000 39000 41000 43000 45000 46500 52000; do
		if [ "$_t" -gt "$_sk" ]; then _next="$_t"; break; fi
	done

	_o="=== pxtune thermal explain ==="
	_o="$_o
skin (quiet_therm): $_skc C   (rozhoduje o skrceni, ne junction)"

	if [ -z "$_next" ]; then
		_o="$_o
Skin je nad nejvyssim prahem 52,0 C - CPU-HIGH i GPU skrti KRITICKY."
		print -r -- "$_o"
		return 0
	fi

	# kolik °C zbyva k dalsimu prahu
	_d=$((_next - _sk))
	_dc="$((_d / 1000)).$(( (_d % 1000) / 100 ))"
	_nc="$((_next / 1000)).$(( (_next % 1000) / 100 ))"

	case "$_next" in
		37000) _lbl="VIRTUAL-SKIN-CPU-LIGHT-ODPM (1. stupen)"; _cool="CPU cooling (thermal-cpufreq-0/1/2)" ;;
		39000) _lbl="VIRTUAL-SKIN-CPU-MID (1) + LIGHT-ODPM (2)"; _cool="CPU cooling (thermal-cpufreq-0/1/2)" ;;
		41000) _lbl="VIRTUAL-SKIN-CPU-MID (2) + CPU-HIGH (1)"; _cool="CPU cooling, silnejsi strop (thermal-cpufreq-0/1/2)" ;;
		43000) _lbl="VIRTUAL-SKIN-CPU-HIGH (2) + GPU (1)"; _cool="CPU (thermal-cpufreq-0/1/2) + GPU (thermal-gpufreq-0)" ;;
		45000) _lbl="VIRTUAL-SKIN-GPU (2)"; _cool="GPU cooling (thermal-gpufreq-0)" ;;
		46500) _lbl="VIRTUAL-SKIN-GPU (3)"; _cool="GPU cooling (thermal-gpufreq-0)" ;;
		52000) _lbl="VIRTUAL-SKIN-CPU-HIGH (3) + GPU (4)"; _cool="CPU + GPU, KRITICKE skrceni" ;;
	esac

	_o="$_o
nejblizsi prah    : $_nc C  (zbyva $_dc C)
  spusti senzor   : $_lbl
  priskrti        : $_cool
hystereze         : 1,9 C (skrceni povoli az pri poklesu ~1,9 C pod prah)"
	print -r -- "$_o"
	return 0
}

cmd_thermal() {
	case "${1:-}" in
		explain) thermal_explain ;;
		""|*)
			warn "pxtune: pouziti: pxtune thermal explain"
			exit 1
			;;
	esac
}

# ---------------------------------------------------------------------------
# auto - prepinac adaptivniho demona (NEZAVISLY na manual_override)
# ---------------------------------------------------------------------------
cmd_auto() {
	case "$1" in
		on)
			printf 'on\n' > "$AUTO_FILE" 2>/dev/null
			log INFO "auto zapnut"
			# Samotny soubor demona nespusti - je potreba ho nastartovat.
			if [ -x "$AUTOD" ]; then
				"$AUTOD" start >/dev/null 2>&1 \
					&& msg "Adaptivni automat: ZAPNUT (demon spusten)" \
					|| msg "Adaptivni automat: ZAPNUT (demona se nepodarilo spustit, viz log)"
			else
				msg "Adaptivni automat: ZAPNUT (demon $AUTOD nenalezen)"
			fi
			;;
		off)
			printf 'off\n' > "$AUTO_FILE" 2>/dev/null
			log INFO "auto vypnut"
			if [ -x "$AUTOD" ]; then
				"$AUTOD" stop >/dev/null 2>&1
			fi
			msg "Adaptivni automat: VYPNUT"
			;;
		""|status)
			msg "auto            : $(auto_state)"
			if [ -x "$AUTOD" ]; then
				_apid=$(rd "$AUTOD_PID" 2>/dev/null | tr -dc '0-9')
				if [ -n "$_apid" ] && [ -d "/proc/$_apid" ]; then
					msg "demon           : bezi (pid $_apid)"
				else
					msg "demon           : nebezi"
				fi
			fi
			if [ -f "$OVERRIDE_FILE" ]; then
				msg "manual_override : ANO (uzivatel zamkl profil rucne)"
			else
				msg "manual_override : ne"
			fi
			msg "aktivni profil  : $(active_profile)"
			;;
		*)
			warn "pxtune: pouziti: pxtune auto <on|off|status>"
			exit 1
			;;
	esac
	return 0
}

# ---------------------------------------------------------------------------
# log
# ---------------------------------------------------------------------------
cmd_log() {
	_n=50
	if [ "$1" = "-n" ]; then
		shift
		is_int "$1" || { warn "pxtune: -n chce cele cislo"; exit 1; }
		_n="$1"
	elif [ -n "$1" ]; then
		warn "pxtune: pouziti: pxtune log [-n N]"
		exit 1
	fi
	if [ ! -f "$LOG_FILE" ]; then
		warn "pxtune: log neexistuje: $LOG_FILE"
		return 2
	fi
	tail -n "$_n" "$LOG_FILE"
	return 0
}

# ---------------------------------------------------------------------------
# status - spolecne cteni
# ---------------------------------------------------------------------------
# zram_stat -> "orig compr mem_used"
zram_stat() {
	_mm=$(rd "$ZRAM/mm_stat") || _mm=""
	[ -n "$_mm" ] || return 1
	# shellcheck disable=SC2086
	set -- $_mm
	printf '%s %s %s' "${1:-}" "${2:-}" "${3:-}"
}

# policy_cap_khz <cdev_id> <seznam frekvenci> -> aktualni tepelny strop v kHz
policy_cap_khz() {
	_cs=$(rd_def "$THERMAL/cooling_device$1/cur_state" "")
	# shellcheck disable=SC2086
	cdev_cap_khz "$_cs" $2
}

status_text() {
	msg "=== pxtune $PXTUNE_VERSION ==="
	msg "profil          : $(active_profile)"
	if [ -f "$OVERRIDE_FILE" ]; then msg "manual_override : ANO"; else msg "manual_override : ne"; fi
	msg "auto            : $(auto_state)"
	[ -f "$DISABLE_FILE" ] && msg "DISABLE         : ANO (modul je vypnuty)"
	[ -f "$RESPEND_FILE" ] && msg "res_pending     : ANO (zbyva $(res_pending_seconds) s)"
	msg ""

	msg "--- Teploty (kernelove sysfs zony) ---"
	for _z in $THERMAL_ZONES; do
		_zn=${_z%%:*}
		_zi=${_z##*:}
		_t=$(rd_def "$THERMAL/thermal_zone$_zi/temp" "")
		if is_snum "$_t"; then
			printf '  %-10s (zone%-2s) %6s C\n' "$_zn" "$_zi" "$(mc_to_c "$_t")"
		else
			printf '  %-10s (zone%-2s) %6s\n' "$_zn" "$_zi" "n/a"
		fi
	done
	msg "  VIRTUAL-SKIN*: preskoceno (dumpsys thermalservice pod su visi na binderu)"
	msg ""

	msg "--- CPU (governor sched_pixel, scaling_max_freq je 0444 = read-only) ---"
	status_cpu_line policy0 "Little 4xA510" "$FREQ_P0" "$CDEV_P0"
	status_cpu_line policy4 "Big 4xA715"    "$FREQ_P4" "$CDEV_P4"
	status_cpu_line policy8 "Prime 1xX3"    "$FREQ_P8" "$CDEV_P8"
	msg ""

	msg "--- Cooling devices (rizeni ma thermal HAL, jen cteme) ---"
	status_cdev_line "$CDEV_P0"  "thermal-cpufreq-0" policy0 "$FREQ_P0"
	status_cdev_line "$CDEV_P4"  "thermal-cpufreq-1" policy4 "$FREQ_P4"
	status_cdev_line "$CDEV_P8"  "thermal-cpufreq-2" policy8 "$FREQ_P8"
	status_cdev_line "$CDEV_GPU" "thermal-gpufreq-0" GPU     "$GPU_FREQS_ASC"
	msg ""

	msg "--- GPU Mali ---"
	printf '  cur_freq        %s kHz\n'  "$(rd_def "$MALI/cur_freq" "n/a")"
	printf '  scaling_max     %s kHz\n'  "$(rd_def "$MALI/scaling_max_freq" "n/a")"
	printf '  scaling_min     %s kHz\n'  "$(rd_def "$MALI/scaling_min_freq" "n/a")"
	printf '  hint_max        %s kHz\n'  "$(rd_def "$MALI/hint_max_freq" "n/a")"
	printf '  power_policy    %s\n'      "$(bracket "$(rd_def "$MALI/power_policy" "n/a")")"
	printf '  utilization     %s\n'      "$(rd_def "$MALI/utilization" "n/a")"
	msg ""

	msg "--- uclamp (/dev/cpuctl) ---"
	for _g in $UCLAMP_GROUPS; do
		printf '  %-18s min=%-7s max=%s\n' "$_g" \
			"$(rd_def "$CPUCTL/$_g/cpu.uclamp.min" "n/a")" \
			"$(rd_def "$CPUCTL/$_g/cpu.uclamp.max" "n/a")"
	done
	printf '  %-18s %s (stock 1024, NESAHAT)\n' "sched_util_clamp_min" \
		"$(rd_def /proc/sys/kernel/sched_util_clamp_min "n/a")"
	msg ""

	msg "--- Thermal HAL profily (setprop) ---"
	printf '  %-24s %s\n' "$THERMAL_SENSOR_MID"  "$(getprop "vendor.thermal.$THERMAL_SENSOR_MID.profile" 2>/dev/null)"
	printf '  %-24s %s\n' "$THERMAL_SENSOR_HIGH" "$(getprop "vendor.thermal.$THERMAL_SENSOR_HIGH.profile" 2>/dev/null)"
	msg ""

	msg "--- Pamet ---"
	_dsz=$(rd_def "$ZRAM/disksize" "")
	if is_int "$_dsz"; then
		# setiny GiB (3969961984 B = 3,70 GiB = 3,97 GB).
		# POZOR na mksh 32bit aritmetiku: _dsz * 100 pretece uz na
		# stock velikosti zramu. Proto se nejdriv deli na MiB.
		_gh=$(( ( (_dsz / 1048576) * 100 + 512 ) / 1024 ))
		printf '  zram disksize   %s B (%s MiB / %s.%02d GiB)\n' \
			"$_dsz" $((_dsz / 1048576)) $((_gh / 100)) $((_gh % 100))
	else
		printf '  zram disksize   n/a\n'
	fi
	printf '  zram algoritmus %s (HW Emerald Hill - NEMENIT)\n' "$(bracket "$(rd_def "$ZRAM/comp_algorithm" "n/a")")"
	if _zs=$(zram_stat); then
		# shellcheck disable=SC2086
		set -- $_zs
		printf '  zram data       orig=%s B compr=%s B mem_used=%s B\n' "$1" "$2" "$3"
	fi
	printf '  swappiness      %s\n' "$(rd_def /proc/sys/vm/swappiness "n/a")"
	printf '  dirty_ratio     %s / bg %s\n' "$(rd_def /proc/sys/vm/dirty_ratio "n/a")" "$(rd_def /proc/sys/vm/dirty_background_ratio "n/a")"
	printf '  vfs_cache_press %s\n' "$(rd_def /proc/sys/vm/vfs_cache_pressure "n/a")"
	printf '  page-cluster    %s\n' "$(rd_def /proc/sys/vm/page-cluster "n/a")"
	msg ""

	msg "--- Baterie / nabijeni ---"
	printf '  capacity        %s %%\n' "$(rd_def "$BATT/capacity" "n/a")"
	printf '  status          %s\n'    "$(rd_def "$BATT/status" "n/a")"
	_bt=$(rd_def "$BATT/temp" "")
	if is_snum "$_bt"; then
		printf '  temp            %s C\n' "$(mc_to_c "$((_bt * 100))")"
	else
		printf '  temp            n/a\n'
	fi
	printf '  cycle_count     %s\n'    "$(rd_def "$BATT/cycle_count" "n/a")"
	printf '  current_now     %s uA\n' "$(rd_def "$BATT/current_now" "n/a")"
	printf '  stop_level      %s\n'    "$(rd_def "$CHARGER/charge_stop_level" "n/a")"
	printf '  start_level     %s\n'    "$(rd_def "$CHARGER/charge_start_level" "n/a")"
	msg ""

	msg "--- Displej ---"
	res_current
	return 0
}

status_cpu_line() {
	_p="$1"; _lbl="$2"; _list="$3"; _cd="$4"
	_cap=$(policy_cap_khz "$_cd" "$_list") || _cap="n/a"
	printf '  %-8s %-14s cur=%-9s strop=%-9s hw_max=%s kHz\n' \
		"$_p" "$_lbl" "$(rd_def "$CPUFREQ/$_p/scaling_cur_freq" "n/a")" "$_cap" "$(last_of "$_list")"
}

status_cdev_line() {
	_id="$1"; _typ="$2"; _who="$3"; _list="$4"
	_d="$THERMAL/cooling_device$_id"
	_cs=$(rd_def "$_d/cur_state" "")
	_ms=$(rd_def "$_d/max_state" "")
	_cap="n/a"
	# shellcheck disable=SC2086
	if is_int "$_cs" && _capk=$(cdev_cap_khz "$_cs" $_list); then
		_cap="$(khz_to_mhz "$_capk") MHz"
	fi
	printf '  cd%-3s %-18s %-8s cur_state=%-3s max_state=%-3s strop=%s\n' \
		"$_id" "$_typ" "$_who" "${_cs:-n/a}" "${_ms:-n/a}" "$_cap"
}

# ---------------------------------------------------------------------------
# status --json
#
# ZAVAZNY KONTRAKT pro WebUI. Cte VYHRADNE sysfs + stavove soubory v $STATE_DIR.
# Zadny dumpsys, zadne cmd, zadne settings -> zadny binder, nemuze zatuhnout.
# Jednotky: thermal.* = °C (desetinne), cpu/gpu = kHz, mem.zram_* = bajty,
#           battery.temp = °C.
# ---------------------------------------------------------------------------
# ----- bezforkove pomocniky pro status --json ------------------------------
# VYKON: puvodni emitter delal ~120 subshellu ($(...) = fork). Na telefonu,
# ktery je zrovna termalne priskrceny, stal jeden beh 10-25 s a synchronni
# WebUI most pak vypadal zamrzle. Tyto helpery ctou builtin read-em do
# globalni promenne V - nula forku (vyjimka: /proc/sys/* potrebuje head,
# viz komentar v rd()).

# rdv <cesta> <default> -> V
rdv() {
	V="$2"
	[ -f "$1" ] && [ -r "$1" ] || return 0
	case "$1" in
		/proc/sys/*) V=$(head -n1 "$1" 2>/dev/null) || V="$2" ;;
		*)           IFS= read -r V < "$1" 2>/dev/null || V="$2" ;;
	esac
	[ -n "$V" ] || V="$2"
}

# nv - normalizuj V na JSON cislo (neplatne/prazdne -> null)
nv() {
	case "$V" in
		''|*[!0-9.-]*) V=null ;;
		-|.|*-*-*) V=null ;;
	esac
}

# tempv <cesta> -> V jako °C s jednim desetinnym mistem, nebo null
tempv() {
	rdv "$1" ""
	case "$V" in
		''|*[!0-9-]*) V=null; return 0 ;;
	esac
	if [ "$V" -lt 0 ]; then
		V="-$(( (0 - V) / 1000 )).$(( ((0 - V) % 1000) / 100 ))"
	else
		V="$(( V / 1000 )).$(( (V % 1000) / 100 ))"
	fi
}

# capv <cdev_id> <seznam freq vzestupne> -> V = ucinny strop v kHz, nebo null
# (cur_state = N => index pocet-1-N ve vzestupnem seznamu; overeno na zarizeni
# na trech nezavislych bodech: 8/9->610000, 10/14->910000, 12/14->1164000)
capv() {
	rdv "$THERMAL/cooling_device$1/cur_state" ""
	case "$V" in ''|*[!0-9]*) V=null; return 0 ;; esac
	_cs="$V"
	# shellcheck disable=SC2086
	set -- $2
	_i=$(( $# - _cs ))
	if [ "$_i" -lt 1 ] || [ "$_i" -gt $# ]; then V=null; return 0; fi
	shift $(( _i - 1 ))
	V="$1"
}

json_policy() {
	# json_policy <policy> <seznam frekvenci> <cdev_id> - pripoji do $J
	_jp="$1"; _jl="$2"; _jc="$3"
	# shellcheck disable=SC2086
	set -- $_jl
	_jhw=""
	while [ $# -gt 0 ]; do _jhw="$1"; shift; done
	rdv "$THERMAL/cooling_device$_jc/cur_state" ""; nv; _jcs="$V"
	rdv "$CPUFREQ/$_jp/scaling_cur_freq" ""; nv; _jcur="$V"
	capv "$_jc" "$_jl"
	if [ "$V" = "null" ]; then rdv "$CPUFREQ/$_jp/scaling_max_freq" ""; nv; fi
	J="$J\"$_jp\":{\"cur\":$_jcur,\"max\":$V,\"hw_max\":$_jhw,\"cdev_cur_state\":$_jcs}"
}

# bracketv - normalizuj V z tvaru "a [b] c" na "b" (bez forku)
bracketv() {
	case "$V" in
		*\[*\]*)
			V="${V#*\[}"
			V="${V%%\]*}"
			;;
	esac
}

# strv <cesta> - nacte V a obali ho do JSON retezce (rychla cesta bez seda,
# sed jen kdyz hodnota obsahuje neco, co je potreba escapovat)
strv() {
	rdv "$1" ""
	case "$V" in
		*[!A-Za-z0-9\ _.,:/%+-]*) V="\"$(json_esc "$V")\"" ;;
		*)                        V="\"$V\"" ;;
	esac
}

# status_json - ZAVAZNY KONTRAKT pro WebUI.
#
# VYKON: tahle funkce se vola z WebUI kazdych ~5 s pres synchronni ksu.exec.
# Puvodni verze mela 29 substituci (mnoho vnorenych, tj. ~50 forku) a na
# termalne priskrcenem telefonu (Little na 610 MHz z 1704) trvala pres 9 s -
# WebView se s ni zasekl a uzivatel to hlasil jako "modul je zaseknuty".
# Proto je cela prepsana na helpery rdv/nv/tempv/capv/bracketv/strv, ktere
# ctou builtin read-em do globalni V. Zadne $(...) uvnitr.
# Kdyz sem budes neco pridavat, drz se te konvence.
status_json() {
	# Akumulujeme do jedne promenne a vypisujeme JEDNIM print. Duvod je merenim
	# dolozeny: `printf` NENI na tomhle systemu builtin, je to /system/bin/printf,
	# tedy fork za ~17 ms. Puvodni verze mela 46 printf = ~800 ms jen na vypis.
	# `print` a `echo` builtiny jsou, akumulace do promenne je zdarma.
	J='{'

	# --- profile ---
	rdv "$ACTIVE_FILE" "unknown"
	case "$V" in *[!A-Za-z0-9_.-]*|'') V="unknown" ;; esac
	J="$J\"profile\":{\"active\":\"$V\",\"manual_override\":"
	if [ -f "$OVERRIDE_FILE" ]; then J="${J}true"; else J="${J}false"; fi
	J="$J,\"available\":["
	_first=1
	for _f in "$PROFILE_DIR"/*.conf; do
		[ -f "$_f" ] || continue
		[ "$_first" -eq 1 ] || J="$J,"
		_first=0
		_n="${_f##*/}"
		J="$J\"${_n%.conf}\""
	done
	J="$J]},"

	# --- auto (nezavisle na manual_override) ---
	rdv "$AUTO_FILE" "on"
	case "$V" in
		off|OFF|0|false) J="$J\"auto\":{\"enabled\":false}," ;;
		*)               J="$J\"auto\":{\"enabled\":true}," ;;
	esac

	# --- thermal (°C) ---
	J="$J\"thermal\":{"
	_first=1
	for _z in $THERMAL_ZONES; do
		[ "$_first" -eq 1 ] || J="$J,"
		_first=0
		tempv "$THERMAL/thermal_zone${_z##*:}/temp"
		J="$J\"${_z%%:*}\":$V"
	done
	J="$J},"

	# --- cpu (kHz) ---
	J="$J\"cpu\":{"
	json_policy policy0 "$FREQ_P0" "$CDEV_P0"
	J="$J,"
	json_policy policy4 "$FREQ_P4" "$CDEV_P4"
	J="$J,"
	json_policy policy8 "$FREQ_P8" "$CDEV_P8"
	J="$J},"

	# --- gpu (kHz) ---
	J="$J\"gpu\":{"
	rdv "$MALI/cur_freq"         ""; nv; J="$J\"cur\":$V,"
	rdv "$MALI/scaling_max_freq" ""; nv; J="$J\"max\":$V,"
	rdv "$MALI/scaling_min_freq" ""; nv; J="$J\"min\":$V,"
	rdv "$MALI/utilization"      ""; nv; J="$J\"util\":$V,"
	rdv "$MALI/power_policy"     ""; bracketv
	J="$J\"power_policy\":\"$V\"},"

	# --- mem (bajty) ---
	J="$J\"mem\":{"
	rdv "$ZRAM/disksize" ""; nv; J="$J\"zram_disksize\":$V,"
	rdv "$ZRAM/comp_algorithm" ""; bracketv
	J="$J\"zram_algorithm\":\"$V\","
	# mm_stat: orig_data_size compr_data_size mem_used_total ...
	_zorig=null; _zused=null
	rdv "$ZRAM/mm_stat" ""
	if [ -n "$V" ]; then
		# shellcheck disable=SC2086
		set -- $V
		_zorig="${1:-null}"; _zused="${3:-null}"
		case "$_zorig" in ''|*[!0-9]*) _zorig=null ;; esac
		case "$_zused" in ''|*[!0-9]*) _zused=null ;; esac
	fi
	J="$J\"zram_used\":$_zused,\"zram_orig\":$_zorig,"
	rdv /proc/sys/vm/swappiness ""; nv
	J="$J\"swappiness\":$V},"

	# --- battery ---
	J="$J\"battery\":{"
	rdv "$BATT/capacity" ""; nv; J="$J\"capacity\":$V,"
	strv "$BATT/status";         J="$J\"status\":$V,"
	# temp je v desetinach °C (napr. 378 = 37,8 °C)
	rdv "$BATT/temp" ""
	case "$V" in
		''|*[!0-9-]*) J="$J\"temp\":null," ;;
		-*)           J="$J\"temp\":-$(( (0 - V) / 10 )).$(( (0 - V) % 10 ))," ;;
		*)            J="$J\"temp\":$(( V / 10 )).$(( V % 10 ))," ;;
	esac
	rdv "$BATT/cycle_count" ""; nv;          J="$J\"cycle_count\":$V,"
	rdv "$CHARGER/charge_stop_level" ""; nv; J="$J\"charge_stop_level\":$V,"
	rdv "$CHARGER/charge_start_level" ""; nv
	J="$J\"charge_start_level\":$V},"

	# --- display (z cache, zadny binder) ---
	_dw="$NATIVE_W"; _dh="$NATIVE_H"; _dd="$NATIVE_DPI"
	rdv "$DISPSTATE_FILE" ""
	if [ -n "$V" ]; then
		# shellcheck disable=SC2086
		set -- $V
		[ -n "${1:-}" ] && _dw="$1"
		[ -n "${2:-}" ] && _dh="$2"
		[ -n "${3:-}" ] && _dd="$3"
	fi
	J="$J\"display\":{\"width\":$_dw,\"height\":$_dh,\"density\":$_dd,\"presets\":["
	_first=1
	for _p in $RES_PRESETS; do
		[ "$_first" -eq 1 ] || J="$J,"
		_first=0
		J="$J\"${_p%%:*}\""
	done
	J="$J],\"res_pending\":"
	if [ -f "$RESPEND_FILE" ]; then J="${J}true"; else J="${J}false"; fi
	J="$J,\"res_pending_seconds\":$(res_pending_seconds)}"

	# --- per-app (vrstva 3) - VYHRADNE ze souboru, zadny binder ------------
	# appmode.active ma jeden radek:
	#   <pkg>|<epoch>|<stara_min_refresh>|<stary_peak_refresh>|<stare_size>|<stara_density>
	# Sentinely: "-" = nebylo nastaveno (navrat = delete), "=" = nesahali jsme.
	# Parsuje se ${x%%|*} / ${x#*|} = nula forku (konvence rdv/nv/bracketv).
	_apkg=""; _at=null; _armin="="; _arpk="="; _asz="="; _ade="="
	rdv "$APPMODE" ""
	if [ -n "$V" ]; then
		_al="$V"
		_apkg="${_al%%|*}"; _al="${_al#*|}"
		_at="${_al%%|*}";   _al="${_al#*|}"
		_armin="${_al%%|*}"; _al="${_al#*|}"
		_arpk="${_al%%|*}";  _al="${_al#*|}"
		_asz="${_al%%|*}"
		_ade="${_al#*|}"
		# jmeno balicku musi mit tecku - poskozeny radek (jedno slovo bez "|")
		# by jinak proslo jako platny balicek a WebUI by hlasilo cizi stav
		case "$_apkg" in ''|*[!A-Za-z0-9._]*) _apkg="" ;; esac
		case "$_apkg" in *.*) ;; *) _apkg="" ;; esac
		case "$_at" in ''|*[!0-9]*) _at=null ;; esac
	fi
	J="$J,\"app\":{"
	if [ -n "$_apkg" ]; then
		J="$J\"active\":\"$_apkg\",\"since\":$_at,"
		J="$J\"saved\":{\"refresh_min\":\"$_armin\",\"refresh_peak\":\"$_arpk\",\"display_size\":\"$_asz\",\"density\":\"$_ade\"},"
	else
		J="$J\"active\":null,\"since\":null,\"saved\":null,"
	fi
	J="$J\"rules\":["
	_first=1
	for _f in "$APPDIR"/*.conf; do
		[ -f "$_f" ] || continue
		_n="${_f##*/}"
		_n="${_n%.conf}"
		case "$_n" in ''|*[!A-Za-z0-9._-]*) continue ;; esac
		[ "$_first" -eq 1 ] || J="$J,"
		_first=0
		J="$J\"$_n\""
	done
	J="$J]}"

	print -r -- "$J}"
}
cmd_status() {
	case "$1" in
		"")     status_text ;;
		--json) status_json ;;
		*)      warn "pxtune: pouziti: pxtune status [--json]"; exit 1 ;;
	esac
}

# ---------------------------------------------------------------------------
# selftest
# ---------------------------------------------------------------------------
st_row() {
	# st_row <cesta> <poznamka> [opt]   - "opt" = chybejici polozka neni chyba
	# Vlastni prefix _st*, protoze se vola uvnitr cizich smycek (napr. for _p in ...).
	_stp="$1"; _stn="$2"; _sto="$3"
	if [ -e "$_stp" ]; then _ste="ano"; else _ste="NE"; fi
	if [ -w "$_stp" ]; then _stw="ano"; else _stw="ne"; fi
	if [ -d "$_stp" ]; then
		_stv="<adresar>"
	elif [ -e "$_stp" ]; then
		_stv=$(rd "$_stp" 2>/dev/null) || _stv="<necitelne>"
		[ -n "$_stv" ] || _stv="<prazdne>"
	else
		_stv="-"
	fi
	case "$_stv" in
		?????????????????????????????????*) _stv="$(print -rn -- "$_stv" | cut -c1-30)..." ;;
	esac
	printf '%-52s %-4s %-5s %-34s %s\n' "$_stp" "$_ste" "$_stw" "$_stv" "$_stn"
	if [ "$_ste" = "NE" ] && [ "$_sto" != "opt" ]; then
		ST_MISSING=$((ST_MISSING + 1))
	fi
	return 0
}

st_hdr() {
	printf '\n== %s ==\n' "$1"
	printf '%-52s %-4s %-5s %-34s %s\n' "CESTA" "EXI" "ZAP" "HODNOTA" "POZNAMKA"
}

cmd_selftest() {
	ST_MISSING=0
	printf 'pxtune %s selftest - %s\n' "$PXTUNE_VERSION" "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
	printf 'uid=%s  skript=%s\n' "$(id -u 2>/dev/null)" "$SELF"

	st_hdr "Stav modulu"
	st_row "$STATE_DIR" ""
	st_row "$PROFILE_DIR" ""
	st_row "$STOCK_CONF" "$(if stock_valid; then printf 'validni'; else printf 'CHYBI/POSKOZENY -> fallback na SPEC'; fi)"
	st_row "$ACTIVE_FILE" "" opt
	st_row "$OVERRIDE_FILE" "volitelne: uzivatel zamkl profil" opt
	st_row "$AUTO_FILE" "volitelne: on|off (chybi = on)" opt
	st_row "$DISABLE_FILE" "volitelne: existuje = modul vypnuty" opt
	st_row "$BOOTCNT_FILE" "volitelne: >=3 => DISABLE" opt
	st_row "$RESPEND_FILE" "volitelne: ceka na 'res confirm'" opt
	st_row "$DISPSTATE_FILE" "cache displeje pro --json (bez binderu)" opt
	st_row "$LOG_FILE" "rotace nad 512 kB"

	st_hdr "CPU cpufreq (scaling_max_freq je 0444 - zapis NELZE)"
	for _p in policy0 policy4 policy8; do
		st_row "$CPUFREQ/$_p/scaling_cur_freq" "read-only"
		st_row "$CPUFREQ/$_p/scaling_max_freq" "ocekavano NEzapisovatelne"
		st_row "$CPUFREQ/$_p/scaling_governor" "sched_pixel - NEMENIT"
	done

	st_hdr "Cooling devices (vlastnik thermal HAL, jen cteme)"
	for _c in "$CDEV_P0" "$CDEV_P4" "$CDEV_P8" "$CDEV_GPU"; do
		st_row "$THERMAL/cooling_device$_c/type" ""
		st_row "$THERMAL/cooling_device$_c/cur_state" "HAL prepisuje ~7 s"
		st_row "$THERMAL/cooling_device$_c/max_state" ""
	done

	st_hdr "uclamp cgroups (HLAVNI PAKA)"
	for _g in $UCLAMP_GROUPS; do
		st_row "$CPUCTL/$_g/cpu.uclamp.min" ""
		st_row "$CPUCTL/$_g/cpu.uclamp.max" ""
	done
	st_row "/proc/sys/kernel/sched_util_clamp_min" "stock 1024 - NESAHAT"

	st_hdr "GPU Mali"
	st_row "$MALI/scaling_max_freq" "bezpecna paka, drzi"
	st_row "$MALI/scaling_min_freq" ""
	st_row "$MALI/hint_max_freq" ""
	st_row "$MALI/power_policy" "coarse_demand|adaptive|always_on"
	st_row "$MALI/cur_freq" ""
	st_row "$MALI/utilization" ""

	st_hdr "Thermal zony"
	for _z in $THERMAL_ZONES; do
		st_row "$THERMAL/thermal_zone${_z##*:}/temp" "${_z%%:*}"
	done
	st_row "/dev/thermal/tz-by-name/quiet_therm/temp" "skin pro 'thermal explain' (stabilni symlink)" opt
	printf '%-52s %-4s %-5s %-34s %s\n' "dumpsys thermalservice" "-" "-" "-" \
		"NEPOUZIVA SE (pod su visi na binderu)"

	st_hdr "Nabijeni a baterie"
	st_row "$CHARGER/charge_stop_level" "root zapsat MUZE"
	st_row "$CHARGER/charge_start_level" ""
	st_row "$CHARGER/bd_trigger_temp" ""
	st_row "$CHARGER/bd_trigger_time" ""
	st_row "$CHARGER/bd_recharge_soc" ""
	st_row "$CHARGER/bd_temp_enable" ""
	st_row "$BATT/capacity" ""
	st_row "$BATT/status" ""
	st_row "$BATT/temp" "desetiny C"
	st_row "$BATT/cycle_count" ""
	st_row "$BATT/current_now" ""

	st_hdr "Pamet"
	st_row "$ZRAM/disksize" "menit jen v post-fs-data.sh"
	st_row "$ZRAM/comp_algorithm" "lz77eh (HW Emerald Hill) - NEMENIT"
	st_row "$ZRAM/mm_stat" ""
	st_row "$ZRAM/idle" "zram writeback: oznaceni necinnych (write-only)" opt
	st_row "$ZRAM/writeback" "zram writeback: spousteni (write-only)" opt
	st_row "$ZRAM/writeback_limit" "zram writeback: strop ve strankach" opt
	st_row "$ZRAM/writeback_limit_enable" "zram writeback: 1 = strop aktivni" opt
	st_row "$ZRAM/bd_stat" "zram writeback: statistika backing device" opt
	st_row "/proc/sys/vm/swappiness" ""
	st_row "/proc/sys/vm/dirty_ratio" ""
	st_row "/proc/sys/vm/dirty_background_ratio" ""
	st_row "/proc/sys/vm/vfs_cache_pressure" ""
	st_row "/proc/sys/vm/page-cluster" "0 = optimalni pro zram"

	st_hdr "I/O"
	for _d in $IO_DEVS; do
		st_row "/sys/block/$_d/queue/read_ahead_kb" ""
	done

	st_hdr "Externi prikazy"
	for _b in settings cmd pm getprop setprop id date tail sed tr wc cut basename nohup sleep; do
		if command -v "$_b" >/dev/null 2>&1; then
			_s="ano"
		else
			_s="NE"
			ST_MISSING=$((ST_MISSING + 1))
		fi
		printf '%-52s %-4s\n' "$_b" "$_s"
	done

	st_hdr "Kontrola JSON kontraktu"
	if status_json > /dev/null 2>&1; then
		printf '%-52s %s\n' "status --json" "vygenerovan bez chyby"
	else
		printf '%-52s %s\n' "status --json" "SELHAL"
		ST_MISSING=$((ST_MISSING + 1))
	fi

	printf '\nChybejicich/nedostupnych polozek: %s\n' "$ST_MISSING"
	log INFO "selftest: chybejicich polozek = $ST_MISSING"
	[ "$ST_MISSING" -gt 0 ] && return 2
	return 0
}

# ---------------------------------------------------------------------------
# usage
# ---------------------------------------------------------------------------
usage() {
	cat <<EOF
pxtune $PXTUNE_VERSION - kernel manager pro Pixel 8a (Tensor G3)

  pxtune status [--json]        stav: profil, teploty, frekvence, uclamp, zram, nabijeni
                                --json cte VYHRADNE sysfs (zadny binder)
  pxtune profile list           seznam profilu
  pxtune profile current        jmeno aktivniho profilu
  pxtune profile <name>         prepnout profil (nastavi manual_override)
  pxtune profile <name> --auto  prepnout profil bez dotyku na manual_override (pro demona)
  pxtune profile auto           zrusit manual_override, vratit rizeni automatu
  pxtune revert                 vratit VSE na stock z backup/stock.conf
  pxtune res <preset|confirm|reset|list>
                                presety: $(res_preset_names)
  pxtune charge <1-100|off>     charge_stop_level (off = 100)
  pxtune game <package> [mode]  obalka nad 'cmd game'
  pxtune zram writeback [sek]   odsun necinnych zram stranek na disk (vychozi 3600 s)
  pxtune dexopt <package>       pm compile -m speed -f <pkg> (plna AOT kompilace)
  pxtune thermal explain        skin vs. prahy VIRTUAL-SKIN (co se stane pri prekroceni)
  pxtune app <list|show|set|rm|sync|json>
                                per-app profily (bin/pxtune-perapp)
                                'app enter <pkg>' / 'app leave' jsou INTERNI (demon)
  pxtune auto <on|off|status>   adaptivni demon (nezavisle na manual_override)
  pxtune log [-n N]             vypis logu (vychozi 50 radku)
  pxtune selftest               overi vsechny cesty ze SPEC

Stav: $STATE_DIR
Log : $LOG_FILE
Exit: 0 = OK, 1 = chyba argumentu, 2 = chyba behu
EOF
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------
main() {
	# "status --json" bezi pod root shellem WebUI kazdych 5 s -> zadny binder.
	if [ "$1" = "status" ] && [ "$2" = "--json" ]; then
		FRAMEWORK_OK=0
	fi
	# `tweak json` vola WebUI pri otevreni zalozky. V registru je 7 tweaku
	# s mechanismem `settings`, coz jsou BINDER volani - kazde az 10 s
	# timeoutu. Namereno: `tweak json` trvalo 25 s a WebUI kvuli tomu
	# zamrzalo. Binder se tu proto zakazuje VZDY, i pro --live; polozky
	# s mech=settings pak hlasi ulozenou hodnotu misto zive.
	if [ "$1" = "tweak" ] && [ "$2" = "json" ]; then
		FRAMEWORK_OK=0
	fi
	# totez pro `app json`
	if [ "$1" = "app" ] && [ "$2" = "json" ]; then
		FRAMEWORK_OK=0
	fi

	ensure_dirs

	# "nativni" hustota = uzivateluv stock override (353), ne HW 420
	NATIVE_DPI=$(native_dpi)

	# interni: watchdog rozliseni (bezi na pozadi)
	if [ "$1" = "__dpi_watchdog" ]; then
		shift
		dpi_watchdog "$1" "$2"
		exit 0
	fi
	if [ "$1" = "__res_watchdog" ]; then
		shift
		res_watchdog "$1"
		exit 0
	fi

	# Per-app profily jsou v samostatnem skriptu (bin/pxtune-perapp) a deleguji
	# se HNED, jeste pred snapshot_stock/seed_profiles.
	# Duvod pro rane odbočeni: "app enter"/"app leave" vola demon pri kazde
	# zmene popredi a "app json" vola WebUI v polling smycce - snapshot ani
	# seedovani profilu k tomu nejsou potreba a stoji forky navic.
	# exec, ne volani: setri jeden fork a chybovy kod probublá primo.
	if [ "$1" = "app" ]; then
		shift
		if [ -x "$PERAPP" ]; then
			exec "$PERAPP" "$@"
		fi
		if [ -f "$PERAPP" ]; then
			# modul rozbaleny bez prav x (nekteri spravci to delaji)
			exec /system/bin/sh "$PERAPP" "$@"
		fi
		warn "pxtune: bin/pxtune-perapp nenalezen ($PERAPP)"
		log ERROR "app: $PERAPP neexistuje"
		exit 2
	fi

	snapshot_stock
	seed_profiles

	_cmd="$1"
	[ "$#" -ge 1 ] && shift

	case "$_cmd" in
		status)            cmd_status "$@" ;;
		profile)           cmd_profile "$@" ;;
		revert)            cmd_revert ;;
		res)               cmd_res "$@" ;;
		dpi)               cmd_dpi "$@" ;;
		charge)            cmd_charge "$@" ;;
		game)              cmd_game "$@" ;;
		zram)              cmd_zram "$@" ;;
		dexopt)            cmd_dexopt "$@" ;;
		thermal)           cmd_thermal "$@" ;;
		auto)              cmd_auto "$@" ;;
		# per-app profily a tweaky jsou v samostatnych skriptech.
		# exec, ne volani: setri jeden fork a chybovy kod probublá primo.
		app)
			_pa="$(dirname "$0")/pxtune-perapp"
			[ -x "$_pa" ] || _pa=/data/adb/modules/pixel_tune/bin/pxtune-perapp
			if [ -x "$_pa" ]; then
				exec "$_pa" "$@"
			fi
			warn "pxtune: bin/pxtune-perapp nenalezen"
			exit 2
			;;
		tweak)
			# pxtune-tweaks NENI samostatny program, je to knihovna: definuje
			# cmd_tweak() a pouziva zdejsi wr()/rdv()/log()/warn(). Proto se
			# SOURCUJE, ne spousti. Deje se to LINE - jen kdyz uzivatel opravdu
			# sahne na tweaky - aby 1500 radku navic nezdrzovalo kazde spusteni
			# (parsovani skriptu je merene ~4 ms na kB).
			_tw="$(dirname "$0")/pxtune-tweaks"
			[ -f "$_tw" ] || _tw=/data/adb/modules/pixel_tune/bin/pxtune-tweaks
			if [ ! -f "$_tw" ]; then
				warn "pxtune: bin/pxtune-tweaks nenalezen"
				exit 2
			fi
			SELF="$0"
			# shellcheck disable=SC1090
			. "$_tw"
			cmd_tweak "$@"
			;;
		log)               cmd_log "$@" ;;
		selftest)          cmd_selftest ;;
		-h|--help|help|"") usage; [ -z "$_cmd" ] && exit 1; exit 0 ;;
		-v|--version)      printf 'pxtune %s\n' "$PXTUNE_VERSION" ;;
		*)                 warn "pxtune: neznamy prikaz '$_cmd'"; usage >&2; exit 1 ;;
	esac
}

main "$@"
exit $?
