# The three CPU cooling devices for THERMAL_CDEV_BYPASS (user_vote_bypass). Stock 0.
CDEV_BYPASS_NODES="/dev/thermal/cdev-by-name/thermal-cpufreq-0/user_vote_bypass
/dev/thermal/cdev-by-name/thermal-cpufreq-1/user_vote_bypass
/dev/thermal/cdev-by-name/thermal-cpufreq-2/user_vote_bypass"

