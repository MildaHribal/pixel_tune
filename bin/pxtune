# Resolution presets: "name:W:H:DPI" (the names are binding for the WebUI)
RES_PRESETS="native:1080:2400:420 900x2000:900:2000:350 810x1800:810:1800:315 720x1600:720:1600:280"
NATIVE_W=1080
NATIVE_H=2400
# The physical panel density is 420, but the user has their own override (353,
# stored in secure display_density_forced and captured in stock.conf).
# "Return to native" must therefore restore the USER'S density, not 420 -
# otherwise every res reset (including the 60 s safeguard) would enlarge the
# whole UI in one jump.
# native_dpi() reads stock.conf, falling back to 420 when the backup does not exist.
NATIVE_DPI_HW=420
native_dpi() {
	stock_getv STOCK_DISPLAY_DENSITY_FORCED ""; _nd="$SV"
	if is_int "$_nd" && [ "$_nd" -ge 200 ] && [ "$_nd" -le 600 ]; then
		print -rn -- "$_nd"
	else
		print -rn -- "$NATIVE_DPI_HW"
	fi
}
# The real value is filled in in main(), after stock_get/is_int are defined
# (mksh evaluates top-down, they are not available here yet).
NATIVE_DPI=420
RES_TIMEOUT=60

WR_OK=0
WR_FAIL=0
VAL_FAIL=0

# FRAMEWORK_OK=0 => calling anything over binder (settings/cmd/dumpsys) is
# forbidden. Set for "status --json" and for the internal watchdog check.
FRAMEWORK_OK=1

# ---------------------------------------------------------------------------
# Basics: reading, logging
# ---------------------------------------------------------------------------

# rd <path> -> the first line of the file on stdout, return code 1 when it cannot be read
rd() {
	_rd=""
	[ -f "$1" ] || return 1
	[ -r "$1" ] || return 1
	# CAUTION: `IFS= read -r x < file` returns only the FIRST CHARACTER on
	# /proc/sys/*. Procfs reports st_size=0, so mksh reads byte by byte and stops.
	# Verified on the device:
	#     /proc/sys/vm/swappiness            cat=40    read="4"
	#     /proc/sys/kernel/sched_util_clamp_min  cat=1024  read="1"
	#     /sys/class/thermal/.../temp        cat=63000 read=63000  (OK)
	# A fork (head) is however necessary ONLY for /proc/sys/* - elsewhere we use
	# the read builtin (0 forks). That is essential for performance: status --json
	# reads ~80 values and on a throttled phone a fork per read cost over 10 s
	# (which made the WebUI look frozen).
	case "$1" in
		/proc/sys/*)
			_rd=$(head -n1 "$1" 2>/dev/null) || return 1
			;;
		*)
			IFS= read -r _rd < "$1" 2>/dev/null || return 1
			;;
	esac
	print -rn -- "$_rd"
	return 0
}

# rd_def <path> <default>
rd_def() {
	_rdd=$(rd "$1") || _rdd=""
	[ -n "$_rdd" ] || _rdd="$2"
	print -rn -- "$_rdd"
}

# bracket <string> -> the contents of the [brackets], otherwise the whole string
# (comp_algorithm / power_policy have the form "a [b] c")
bracket() {
	case "$1" in
		*\[*\]*) print -rn -- "$1" | sed -n 's/.*\[\([^]]*\)\].*/\1/p' ;;
		*)         print -rn -- "$1" ;;
	esac
}

is_int() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

is_snum() {
	_isn="$1"
	case "$_isn" in -*) _isn=${_isn#-} ;; esac
	is_int "$_isn"
}

LOG_N=0
log_rotate() {
	[ -f "$LOG_FILE" ] || return 0
	# CAUTION: the variable names in log()/log_rotate() have to be unique - it is
	# called from inside other functions and overwriting one of their variables
	# would be silently fatal.
	#
	# PERFORMANCE: `wc -c` is a fork. Applying a profile writes ~40 lines, so the
	# original version forked 40 times just to check the size. We therefore only
	# check every 50th write - the log is capped at 512 kB and one line is on the
	# order of 100 B, so 50 extra lines are ~5 kB, i.e. 1 % of overshoot.
	# Negligible.
	LOG_N=$((LOG_N + 1))
	[ "$((LOG_N % 50))" -eq 1 ] || return 0
	_logsz=$(wc -c < "$LOG_FILE" 2>/dev/null)
	is_int "$_logsz" || return 0
	[ "$_logsz" -gt "$LOG_MAX" ] || return 0
	mv -f "$LOG_FILE" "$LOG_FILE.old" 2>/dev/null
	{ : > "$LOG_FILE"; } 2>/dev/null
	chmod 0640 "$LOG_FILE" 2>/dev/null
}

# log <LEVEL> <message...>
LOG_TS=""
log() {
	_loglvl="$1"
	shift
	log_rotate
	# PERFORMANCE: date = a fork+exec per line; applying a profile writes ~40
	# lines and on a throttled phone that cost several seconds. The timestamp is
	# therefore computed only ONCE per process run - the lines of one run share
	# the start time, which is sufficient granularity for this log.
	[ -n "$LOG_TS" ] || LOG_TS=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
	# print is a builtin, printf is /system/bin/printf (a fork, ~17 ms).
	{ print -r -- "[$LOG_TS] [$_loglvl] $*" >> "$LOG_FILE"; } 2>/dev/null
}

msg()  { print -r -- "$*"; }
warn() { print -r -- "$*" >&2; }
die()  { _c="$1"; shift; warn "pxtune: $*"; log ERROR "$*"; exit "$_c"; }

# vfail <message> - a rejected (invalid) value; the script carries on
vfail() {
	VAL_FAIL=$((VAL_FAIL + 1))
	warn "pxtune: $*"
	log ERROR "$*"
	return 1
}

# ---------------------------------------------------------------------------
# wr - THE ONLY path for writing into sysfs.
# Verifies existence, verifies writability, logs "old -> new".
# On an error it logs and CARRIES ON (it never takes the script down).
# ---------------------------------------------------------------------------
WR_QUIET=0
# WR_CHANGED counts only writes that ACTUALLY happened (WR_OK also counts skipped
# ones where the value was already correct). `reapply` uses it to tell whether it
# had anything to restore.
WR_CHANGED=0

wr() {
	_wp="$1"
	_wv="$2"

	if [ -z "$_wp" ]; then
		log ERROR "wr: empty path"
		WR_FAIL=$((WR_FAIL + 1))
		return 1
	fi
	if [ ! -e "$_wp" ]; then
		log ERROR "wr: does not exist: $_wp (the value '$_wv' was dropped)"
		WR_FAIL=$((WR_FAIL + 1))
		return 1
	fi
	if [ ! -w "$_wp" ]; then
		log ERROR "wr: not writable: $_wp (the value '$_wv' was dropped)"
		WR_FAIL=$((WR_FAIL + 1))
		return 1
	fi

	# PERFORMANCE: read via rdv() (the global V), not via $(rd ...). Every $() is
	# a fork and wr() is called ~40 times per profile switch - that made over 80
	# forks just to read the old and new value.
	rdv "$_wp" "?"
	_wold="$V"

	# When the value is already correct, we do not write. Some sysfs nodes reject
	# even a write of their own current value and would report a pointless error.
	# A real case from this device: google,charger/charge_start_level rejects a
	# write of '0' even when '0' is already there -> the revert reported an error
	# even though the state was fine.
	if [ "$_wold" = "$_wv" ]; then
		WR_OK=$((WR_OK + 1))
		return 0
	fi

	# MIND the redirection order: `> file 2>/dev/null` does not suppress a file
	# OPEN error (it is evaluated left to right), so "Permission denied" escapes
	# to stderr - during the boot phase all the way into the boot log. We
	# therefore wrap the whole block.
	if { print -r -- "$_wv" > "$_wp"; } 2>/dev/null; then
		rdv "$_wp" "?"
		# WR_QUIET=1: the caller logs a single summary itself. `reapply` uses this;
		# it runs after every screen wake, and a line per write would rotate the log
		# several times a day and drown out everything else.
		[ "$WR_QUIET" = "1" ] || log INFO "wr: $_wp: '$_wold' -> '$_wv' (read back: '$V')"
		WR_OK=$((WR_OK + 1))
		WR_CHANGED=$((WR_CHANGED + 1))
		return 0
	fi

	log ERROR "wr: the write failed: $_wp <- '$_wv' (old: '$_wold')"
	WR_FAIL=$((WR_FAIL + 1))
	return 1
}

# ---------------------------------------------------------------------------
# State / directories
# ---------------------------------------------------------------------------
ensure_dirs() {
	[ -d "$STATE_DIR" ]   || mkdir -p "$STATE_DIR"   2>/dev/null
	[ -d "$PROFILE_DIR" ] || mkdir -p "$PROFILE_DIR" 2>/dev/null
	[ -d "$BACKUP_DIR" ]  || mkdir -p "$BACKUP_DIR"  2>/dev/null
	[ -d "$APPDIR" ]      || mkdir -p "$APPDIR"      2>/dev/null
	[ -f "$LOG_FILE" ]    || : > "$LOG_FILE" 2>/dev/null
	chmod 0700 "$STATE_DIR" 2>/dev/null
}

active_profile() {
	_ap=$(rd "$ACTIVE_FILE") || _ap=""
	[ -n "$_ap" ] || _ap="unknown"
	print -rn -- "$_ap"
}

auto_state() {
	_as=$(rd "$AUTO_FILE") || _as=""
	case "$_as" in
		off|OFF|0|false) print -rn -- 'off' ;;
		*) print -rn -- 'on' ;;
	esac
}

# ---------------------------------------------------------------------------
# Working with KEY=VALUE files (profiles and stock.conf).
# We DO NOT SOURCE them - a corrupted/planted file must not execute anything.
# ---------------------------------------------------------------------------
# kv_get <file> <key>
kv_get() {
	[ -f "$1" ] || return 1
	sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" 2>/dev/null \
		| tail -n 1 \
		| sed -e 's/^"\([^"]*\)".*$/\1/;t' \
		      -e "s/^'\([^']*\)'.*\$/\1/;t" \
		      -e 's/[[:space:]]*#.*$//' \
		      -e 's/[[:space:]]*$//'
}

# has_key <file> <key>
has_key() {
	grep -q "^[[:space:]]*$2[[:space:]]*=" "$1" 2>/dev/null
}

# stock.conf is usable only when it exists, has the magic and contains nothing but KEY=VALUE lines
stock_valid() {
	[ -f "$STOCK_CONF" ] || return 1
	grep -q '^STOCK_MAGIC=' "$STOCK_CONF" 2>/dev/null || return 1
	if grep -qv -e '^[[:space:]]*#' -e '^[[:space:]]*$' -e '^[A-Z0-9_]\{1,\}=.*$' "$STOCK_CONF" 2>/dev/null; then
		return 1
	fi
	return 0
}

# stock_get <key> <default> -> the value from stock.conf, otherwise the SPEC default
# --- loading KEY=VALUE files into variables (fork-free) --------------------
#
# PERFORMANCE: kv_get() is `sed | tail | sed` = 3 forks per read. A profile
# switch reads 20 times from stock.conf (the reset) and 21 times from the profile
# = over 120 forks. On a throttled phone that took 13 s per click in the WebUI.
# We load each file ONCE into prefixed variables and only read from those
# afterwards.
#
# Safety: only [A-Za-z0-9_] keys pass, and the value is assigned via
# `eval "PREFIX_$k=\$_v"` - that is an assignment FROM A VARIABLE, not a
# re-evaluation of the content, so neither `$(...)` nor a backtick in the value
# is executed.

# kvload <file> <prefix> - fills the <prefix>_<KEY> variables
kvload() {
	[ -f "$1" ] || return 1
	while IFS='=' read -r _kl_k _kl_v; do
		case "$_kl_k" in
			''|\#*)          continue ;;
			*[!A-Za-z0-9_]*) continue ;;
		esac
		_kl_v="${_kl_v%%#*}"
		# trim trailing spaces
		while :; do
			case "$_kl_v" in
				*' '|*"	") _kl_v="${_kl_v%?}" ;;
				*) break ;;
			esac
		done
		# trim the quotes
		case "$_kl_v" in
			\"*\") _kl_v="${_kl_v#\"}"; _kl_v="${_kl_v%\"}" ;;
			\'*\') _kl_v="${_kl_v#\'}"; _kl_v="${_kl_v%\'}" ;;
		esac
		eval "$2_$_kl_k=\$_kl_v"
	done < "$1"
	return 0
}

STOCK_LOADED=0
stock_load() {
	[ "$STOCK_LOADED" = "1" ] && return 0
	STOCK_LOADED=1
	stock_valid || return 0
	kvload "$STOCK_CONF" SC
	return 0
}

# stock_getv <key> <default> -> the global SV. Fork-free, unlike
# $(stock_get ...), which is a subshell (~7.7 ms). cmd_revert had 19 of them.
stock_getv() {
	stock_load
	eval "SV=\${SC_$1:-}"
	[ -n "$SV" ] || SV="$2"
}

stock_get() {
	stock_load
	eval "_sv=\${SC_$1:-}"
	if [ -z "$_sv" ]; then
		print -rn -- "$2"
	else
		print -rn -- "$_sv"
	fi
}

# uclamp_keyv <group> -> UK. `tr` was a fork; the set of groups is small and fixed.
uclamp_keyv() {
	case "$1" in
		top-app)           UK=TOP_APP ;;
		foreground)        UK=FOREGROUND ;;
		background)        UK=BACKGROUND ;;
		system-background) UK=SYSTEM_BACKGROUND ;;
		camera-daemon)     UK=CAMERA_DAEMON ;;
		nnapi-hal)         UK=NNAPI_HAL ;;
		*)                 UK=$(print -rn -- "$1" | tr 'a-z-' 'A-Z_') ;;
	esac
}

uclamp_key() {
	uclamp_keyv "$1"
	print -rn -- "$UK"
}

# ---------------------------------------------------------------------------
# The framework (binder) - settings. It must NEVER be called during "status --json".
# ---------------------------------------------------------------------------
FW_CHECKED=0
FW_RESULT=1
framework_ok() {
	[ "$FRAMEWORK_OK" = "1" ] || return 1
	# An explicit opt-out for callers in the early boot phase (uninstall.sh):
	[ "${PXTUNE_NO_FRAMEWORK:-0}" = "1" ] && return 1
	# PERFORMANCE: both `command -v` and `getprop` are forks (~8-17 ms) and
	# framework_ok is called once per tweak with the `settings` mechanism. The
	# result cannot change during a single run, so we determine it only once.
	if [ "$FW_CHECKED" = "0" ]; then
		FW_CHECKED=1
		FW_RESULT=1
		if command -v settings >/dev/null 2>&1 &&
		   [ "$(getprop sys.boot_completed 2>/dev/null)" = "1" ]; then
			FW_RESULT=0
		fi
	fi
	return "$FW_RESULT"
}

# settings_get <namespace> <key>  ("null" -> empty)
settings_get() {
	framework_ok || return 1
	if command -v timeout >/dev/null 2>&1; then
		timeout 10 settings get "$1" "$2" 2>/dev/null | sed -e 's/^null$//' -e 's/[[:space:]]*$//'
	else
		settings get "$1" "$2" 2>/dev/null | sed -e 's/^null$//' -e 's/[[:space:]]*$//'
	fi
}

# settings_run <action> <namespace> <key> [value] - a write via `settings`
# ALWAYS with a timeout. `settings` is a binder call; without a timeout a hung
# system_server (or an early boot phase running during an uninstall) would block
# the whole script - and in the post-fs-data context the whole boot.
settings_run() {
	framework_ok || return 1
	if command -v timeout >/dev/null 2>&1; then
		timeout 10 settings "$@" >/dev/null 2>&1
	else
		settings "$@" >/dev/null 2>&1
	fi
}

# ---------------------------------------------------------------------------
# A snapshot of the stock values - created ONCE, never overwritten.
# ---------------------------------------------------------------------------
snapshot_stock() {
	if [ -f "$STOCK_CONF" ]; then
		stock_fill_display
		return 0
	fi

	if framework_ok; then
		_dsz=$(settings_get global display_size_forced)
		_dds=$(settings_get secure display_density_forced)
		_dcap=1
	else
		# without binder the display values are filled in on the first run that may call the framework
		_dsz=""
		_dds=""
		_dcap=0
	fi

	_tmp="$STOCK_CONF.tmp.$$"
	{
		printf '# pixel_tune - a snapshot of the stock values\n'
		printf '# Created: %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
		printf '# DO NOT EDIT BY HAND. Deleting it = the snapshot is recreated from the CURRENT values.\n'
		printf 'STOCK_MAGIC="pixel_tune-stock-v1"\n'

		for _g in $UCLAMP_GROUPS; do
			uclamp_keyv "$_g"; _k="$UK"
			printf 'STOCK_UCLAMP_%s_MIN="%s"\n' "$_k" "$(rd_def "$CPUCTL/$_g/cpu.uclamp.min" "")"
			printf 'STOCK_UCLAMP_%s_MAX="%s"\n' "$_k" "$(rd_def "$CPUCTL/$_g/cpu.uclamp.max" "")"
		done

		printf 'STOCK_GPU_MAX_FREQ="%s"\n'      "$(rd_def "$MALI/scaling_max_freq" "$DEF_GPU_MAX")"
		printf 'STOCK_GPU_MIN_FREQ="%s"\n'      "$(rd_def "$MALI/scaling_min_freq" "$DEF_GPU_MIN")"
		printf 'STOCK_GPU_HINT_MAX_FREQ="%s"\n' "$(rd_def "$MALI/hint_max_freq" "")"
		printf 'STOCK_GPU_POWER_POLICY="%s"\n'  "$(bracket "$(rd_def "$MALI/power_policy" "$DEF_GPU_POLICY")")"

		printf 'STOCK_VM_SWAPPINESS="%s"\n'         "$(rd_def /proc/sys/vm/swappiness "$DEF_SWAPPINESS")"
		printf 'STOCK_VM_DIRTY_RATIO="%s"\n'        "$(rd_def /proc/sys/vm/dirty_ratio "$DEF_DIRTY_RATIO")"
		printf 'STOCK_VM_DIRTY_BG_RATIO="%s"\n'     "$(rd_def /proc/sys/vm/dirty_background_ratio "$DEF_DIRTY_BG_RATIO")"
		printf 'STOCK_VM_VFS_CACHE_PRESSURE="%s"\n' "$(rd_def /proc/sys/vm/vfs_cache_pressure "$DEF_VFS_CACHE_PRESSURE")"
		printf 'STOCK_VM_PAGE_CLUSTER="%s"\n'       "$(rd_def /proc/sys/vm/page-cluster "$DEF_PAGE_CLUSTER")"

		printf 'STOCK_CHARGE_STOP_LEVEL="%s"\n'  "$(rd_def "$CHARGER/charge_stop_level" "$DEF_CHARGE_STOP")"
		printf 'STOCK_CHARGE_START_LEVEL="%s"\n' "$(rd_def "$CHARGER/charge_start_level" "$DEF_CHARGE_START")"

		for _d in $IO_DEVS; do
			_k=$(print -rn -- "$_d" | tr 'a-z' 'A-Z')
			printf 'STOCK_IO_READAHEAD_%s="%s"\n' "$_k" "$(rd_def "/sys/block/$_d/queue/read_ahead_kb" "")"
		done

		printf 'STOCK_THERMAL_PROFILE_CPU_MID="%s"\n'  "$(getprop "vendor.thermal.$THERMAL_SENSOR_MID.profile" 2>/dev/null)"
		printf 'STOCK_THERMAL_PROFILE_CPU_HIGH="%s"\n' "$(getprop "vendor.thermal.$THERMAL_SENSOR_HIGH.profile" 2>/dev/null)"

		printf 'STOCK_DISPLAY_CAPTURED="%s"\n'       "$_dcap"
		printf 'STOCK_DISPLAY_SIZE_FORCED="%s"\n'    "$_dsz"
		printf 'STOCK_DISPLAY_DENSITY_FORCED="%s"\n' "$_dds"

		# For information only - zram is NOT CHANGED at runtime (a swapoff is dangerous, SPEC).
		printf 'STOCK_ZRAM_DISKSIZE="%s"\n'        "$(rd_def "$ZRAM/disksize" "")"
		printf 'STOCK_ZRAM_ALGORITHM="%s"\n'       "$(bracket "$(rd_def "$ZRAM/comp_algorithm" "")")"
		printf 'STOCK_SCHED_UTIL_CLAMP_MIN="%s"\n' "$(rd_def /proc/sys/kernel/sched_util_clamp_min "")"

		# contract v2 - the stock values of the new nodes (for the revert). A fresh
		# install captures them from the current (= stock) state; on an old snapshot
		# they are missing and the revert then uses the DEF_V2_* fallback.
		for _e in $V2_TABLE; do
			_vk="${_e%%:*}"; _vrest="${_e#*:}"; _vp="${_vrest%:*}"
			printf 'STOCK_%s="%s"\n' "$_vk" "$(rd_def "$_vp" "")"
		done
	} > "$_tmp" 2>/dev/null

	if [ -s "$_tmp" ]; then
		mv -f "$_tmp" "$STOCK_CONF" 2>/dev/null
		chmod 0600 "$STOCK_CONF" 2>/dev/null
		log INFO "stock.conf created: $STOCK_CONF (display captured=$_dcap)"
	else
		rm -f "$_tmp" 2>/dev/null
		log ERROR "stock.conf could not be created"
	fi
}

# When the snapshot was created without binder, fill in the display values at the first opportunity.
stock_fill_display() {
	framework_ok || return 0
	stock_valid || return 0
	[ "$(kv_get "$STOCK_CONF" STOCK_DISPLAY_CAPTURED)" = "0" ] || return 0

	_dsz=$(settings_get global display_size_forced)
	_dds=$(settings_get secure display_density_forced)
	_t="$STOCK_CONF.tmp.$$"
	sed -e "s|^STOCK_DISPLAY_CAPTURED=.*|STOCK_DISPLAY_CAPTURED=\"1\"|" \
	    -e "s|^STOCK_DISPLAY_SIZE_FORCED=.*|STOCK_DISPLAY_SIZE_FORCED=\"$_dsz\"|" \
	    -e "s|^STOCK_DISPLAY_DENSITY_FORCED=.*|STOCK_DISPLAY_DENSITY_FORCED=\"$_dds\"|" \
	    "$STOCK_CONF" > "$_t" 2>/dev/null
	if [ -s "$_t" ]; then
		mv -f "$_t" "$STOCK_CONF" 2>/dev/null
		chmod 0600 "$STOCK_CONF" 2>/dev/null
		log INFO "stock.conf: the display values were filled in (size='$_dsz' density='$_dds')"
	else
		rm -f "$_t" 2>/dev/null
	fi
}

# balanced.conf is a verbatim copy of the example from SPEC.md (the profile
# format contract). No other profiles are generated - their values are not in the
# SPEC.
seed_profiles() {
	[ -d "$PROFILE_DIR" ] || return 0
	[ -f "$PROFILE_DIR/balanced.conf" ] && return 0
	for _f in "$PROFILE_DIR"/*.conf; do
		[ -f "$_f" ] && return 0
	done
	cat > "$PROFILE_DIR/balanced.conf" 2>/dev/null <<'EOF'
# mandatory
PROFILE_NAME="balanced"
PROFILE_DESC="Balanced - stock behaviour"

# uclamp (0-100, or "max"; empty = leave it alone)
UCLAMP_TOPAPP_MIN=""
UCLAMP_TOPAPP_MAX=""
UCLAMP_FG_MIN=""
UCLAMP_FG_MAX=""
UCLAMP_BG_MIN=""
UCLAMP_BG_MAX=""
UCLAMP_SYSBG_MIN=""
UCLAMP_SYSBG_MAX=""

# GPU (kHz, must come from the allowed list; empty = leave it alone)
GPU_MAX_FREQ=""
GPU_MIN_FREQ=""
GPU_POWER_POLICY=""

# thermal HAL profile ("game" | "camera" | "" = default)
THERMAL_PROFILE_CPU_MID=""
THERMAL_PROFILE_CPU_HIGH=""

# vm
VM_SWAPPINESS=""
VM_DIRTY_RATIO=""
VM_DIRTY_BG_RATIO=""
VM_VFS_CACHE_PRESSURE=""

# I/O
IO_READAHEAD_KB=""

# charging
CHARGE_STOP_LEVEL=""
EOF
	[ -f "$PROFILE_DIR/balanced.conf" ] && log INFO "the default profile balanced.conf was created"
	return 0
}

# ---------------------------------------------------------------------------
# Conversions
# ---------------------------------------------------------------------------
# nth <index0> <item...>
nth() {
	_ni="$1"
	shift
	_nn=0
	for _ne in "$@"; do
		if [ "$_nn" -eq "$_ni" ]; then
			print -rn -- "$_ne"
			return 0
		fi
		_nn=$((_nn + 1))
	done
	return 1
}

in_list() {
	_il="$1"
	shift
	for _ie in "$@"; do
		[ "$_ie" = "$_il" ] && return 0
	done
	return 1
}

# cdev_cap_khz <cur_state> <frequencies ascending...>
# SPEC: cur_state = N  =>  the cap = the frequency at index (count - 1 - N)
cdev_cap_khz() {
	_cck="$1"
	shift
	is_int "$_cck" || return 1
	_ccn=$#
	_cci=$((_ccn - 1 - _cck))
	[ "$_cci" -lt 0 ] && return 1
	[ "$_cci" -ge "$_ccn" ] && return 1
	nth "$_cci" "$@"
}

khz_to_mhz() {
	is_int "$1" || return 1
	print -rn -- $(($1 / 1000))
}

# mc_to_c <millicelsius> -> "45.6"
mc_to_c() {
	_mc="$1"
	is_snum "$_mc" || return 1
	_sg=""
	case "$_mc" in -*) _sg="-"; _mc=${_mc#-} ;; esac
	printf '%s%d.%d' "$_sg" $((_mc / 1000)) $(((_mc % 1000) / 100))
}

# last_of <list> -> the last item
last_of() {
	# shellcheck disable=SC2086
	set -- $1
	eval "print -rn -- \"\${$#}\""
}

# ---------------------------------------------------------------------------
# JSON helpers
# ---------------------------------------------------------------------------
json_esc() {
	# PERFORMANCE: sed = a fork+exec per string; status --json emits ~30 of them
	# and on a throttled phone that cost seconds. Ordinary values (profile names,
	# states, frequencies) need no escaping at all - the fast path recognises them
	# in pure shell and sed only runs in exceptional cases.
	case "$1" in
		*[!A-Za-z0-9\ _.,:/%+-]*)
			# the order: the backslash first, then the quote, then control characters
			print -rn -- "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/[[:cntrl:]]/ /g'
			;;
		*)
			print -rn -- "$1"
			;;
	esac
}

jstr() { printf '"%s"' "$(json_esc "$1")"; }

# jnum <value> -> a whole number or null
jnum() {
	if is_snum "$1"; then print -rn -- "$1"; else printf 'null'; fi
}

# jnum_f <value> -> a decimal number or null
jnum_f() {
	case "$1" in
		''|*[!0-9.-]*) printf 'null' ;;
		*) print -rn -- "$1" ;;
	esac
}

jbool() {
	if [ "$1" = "1" ]; then printf 'true'; else printf 'false'; fi
}

# jtemp <zone path> -> °C as a decimal number or null
jtemp() {
	_t=$(rd_def "$1" "")
	if is_snum "$_t"; then mc_to_c "$_t"; else printf 'null'; fi
}

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------
valid_uclamp() {
	[ "$1" = "max" ] && return 0
	is_int "$1" || return 1
	[ "$1" -ge 0 ] && [ "$1" -le 100 ]
}

valid_gpu_freq() {
	# shellcheck disable=SC2086
	in_list "$1" $GPU_FREQS_ASC
}

valid_gpu_policy() {
	case "$1" in
		coarse_demand|adaptive|always_on) return 0 ;;
		*) return 1 ;;
	esac
}

valid_thermal_profile() {
	case "$1" in
		game|camera|"") return 0 ;;
		*) return 1 ;;
	esac
}

valid_charge() {
	is_int "$1" || return 1
	[ "$1" -ge 1 ] && [ "$1" -le 100 ]
}

# ---------------------------------------------------------------------------
# Write operations
# ---------------------------------------------------------------------------
set_uclamp() {
	# set_uclamp <group> <min|max> <value>
	[ -n "$3" ] || return 0
	if ! valid_uclamp "$3"; then
		vfail "invalid uclamp value '$3' for $1/$2 (allowed: 0-100 or 'max')"
		return 1
	fi
	wr "$CPUCTL/$1/cpu.uclamp.$2" "$3"
}

set_thermal_profile() {
	# set_thermal_profile <sensor> <profile>
	if ! command -v setprop >/dev/null 2>&1; then
		log ERROR "setprop is not available, the thermal profile $1 was not set"
		return 1
	fi
	_old=$(getprop "vendor.thermal.$1.profile" 2>/dev/null)
	setprop "vendor.thermal.$1.profile" "$2" 2>/dev/null
	log INFO "setprop vendor.thermal.$1.profile: '$_old' -> '$2'"
	return 0
}

set_io_readahead() {
	[ -n "$1" ] || return 0
	if ! is_int "$1"; then
		vfail "invalid IO_READAHEAD_KB '$1' (expected a whole number)"
		return 1
	fi
	for _d in $IO_DEVS; do
		[ -e "/sys/block/$_d/queue/read_ahead_kb" ] || continue
		wr "/sys/block/$_d/queue/read_ahead_kb" "$1"
	done
	return 0
}

set_gpu() {
	# set_gpu <max> <min> <policy>  (empty = leave it alone)
	_gmax="$1"
	_gmin="$2"
	_gpol="$3"

	if [ -n "$_gmax" ]; then
		if valid_gpu_freq "$_gmax"; then
			wr "$MALI/scaling_max_freq" "$_gmax"
		else
			vfail "GPU_MAX_FREQ '$_gmax' is not from the allowed frequency list"
		fi
	fi
	if [ -n "$_gmin" ]; then
		if valid_gpu_freq "$_gmin"; then
			wr "$MALI/scaling_min_freq" "$_gmin"
		else
			vfail "GPU_MIN_FREQ '$_gmin' is not from the allowed frequency list"
		fi
	fi
	# min may have blocked lowering the maximum earlier - after writing min we try max again
	if [ -n "$_gmax" ] && [ -n "$_gmin" ] && valid_gpu_freq "$_gmax"; then
		[ "$(rd_def "$MALI/scaling_max_freq" "")" = "$_gmax" ] || wr "$MALI/scaling_max_freq" "$_gmax"
	fi
	if [ -n "$_gpol" ]; then
		if valid_gpu_policy "$_gpol"; then
			wr "$MALI/power_policy" "$_gpol"
		else
			vfail "GPU_POWER_POLICY '$_gpol' is invalid (coarse_demand|adaptive|always_on)"
		fi
	fi
	return 0
}

# v2_valid <kind> <value> - returns 0 when the value fits the node kind.
v2_valid() {
	case "$1" in
		int)      is_int "$2" ;;
		bool01)   case "$2" in 0|1) return 0 ;; *) return 1 ;; esac ;;
		enum1020) case "$2" in 10|20) return 0 ;; *) return 1 ;; esac ;;
		load)     # a pair of whole numbers "N M"
			case "$2" in
				*[!0-9\ ]*) return 1 ;;
				*' '*) is_int "${2%% *}" && is_int "${2##* }" ;;
				*) return 1 ;;
			esac ;;
		*) return 1 ;;
	esac
}

# set_v2 - deploys the v2 contract keys from PF_* onto the nodes. Empty = leave
# it alone. Called from profile_apply() only AFTER restore_stock_values(), so the
# stock is already restored and an empty key correctly means "keep the stock".
set_v2() {
	_e=""
	for _e in $V2_TABLE; do
		_vk="${_e%%:*}"
		_vrest="${_e#*:}"
		_vp="${_vrest%:*}"
		_vkind="${_vrest##*:}"
		eval "_vv=\$PF_$_vk"
		[ -n "$_vv" ] || continue
		if v2_valid "$_vkind" "$_vv"; then
			wr "$_vp" "$_vv"
		else
			vfail "invalid value '$_vv' for $_vk (kind $_vkind)"
		fi
	done

	# THERMAL_CDEV_BYPASS - risk 3, writes to THREE CPU cooling devices at once.
	# None of the shipped profiles sets it; it only makes sense briefly and with a
	# thermal safeguard of your own. Empty = leave it alone.
	if [ -n "$PF_THERMAL_CDEV_BYPASS" ]; then
		if v2_valid bool01 "$PF_THERMAL_CDEV_BYPASS"; then
			[ "$PF_THERMAL_CDEV_BYPASS" = "1" ] && \
				log WARN "THERMAL_CDEV_BYPASS=1: DISABLING skin-driven CPU throttling on 3 cdevs (risk 3, the phone will get hot)"
			for _bn in $CDEV_BYPASS_NODES; do
				[ -e "$_bn" ] && wr "$_bn" "$PF_THERMAL_CDEV_BYPASS"
			done
		else
			vfail "invalid THERMAL_CDEV_BYPASS '$PF_THERMAL_CDEV_BYPASS' (0|1)"
		fi
	fi
	return 0
}

# set_v2_volatile - writes ONLY the keys from V2_VOLATILE, i.e. those the power
# HAL takes back on a display wake. It does not touch the rest of the profile:
# uclamp, the GPU cap and friends hold by themselves and rewriting them would
# just be extra forking. It expects PF_* to be loaded already (see profile_apply).
set_v2_volatile() {
	_e=""
	for _vk in $V2_VOLATILE; do
		eval "_vv=\$PF_$_vk"
		[ -n "$_vv" ] || continue
		for _e in $V2_TABLE; do
			[ "${_e%%:*}" = "$_vk" ] || continue
			_vrest="${_e#*:}"
			_vp="${_vrest%:*}"
			_vkind="${_vrest##*:}"
			if v2_valid "$_vkind" "$_vv"; then
				wr "$_vp" "$_vv"
			else
				vfail "invalid value '$_vv' for $_vk (kind $_vkind)"
			fi
			break
		done
	done
	return 0
}

# set_vm_one <key> <path> <value>
set_vm_one() {
	[ -n "$3" ] || return 0
	if is_int "$3"; then
		wr "$2" "$3"
		return 0
	fi
	vfail "invalid value '$3' for $1 (expected a whole number)"
	return 1
}

set_vm() {
	set_vm_one VM_SWAPPINESS          /proc/sys/vm/swappiness             "$1"
	set_vm_one VM_DIRTY_RATIO         /proc/sys/vm/dirty_ratio            "$2"
	set_vm_one VM_DIRTY_BG_RATIO      /proc/sys/vm/dirty_background_ratio "$3"
	set_vm_one VM_VFS_CACHE_PRESSURE  /proc/sys/vm/vfs_cache_pressure     "$4"
	return 0
}

# ---------------------------------------------------------------------------
# profile
# ---------------------------------------------------------------------------
cmd_profile() {
	case "$1" in
		""|list) profile_list ;;
		current) active_profile; printf '\n' ;;
		auto)    profile_auto ;;
		*)
			_pname="$1"
			shift
			_pauto=0
			_poverlay=""
			while [ "$#" -gt 0 ]; do
				case "$1" in
					--auto) _pauto=1 ;;
					# --reset is accepted as a NO-OP: the reset to stock happens
					# ALWAYS (restore_stock_values() at the start of
					# profile_apply), so profiles are not sticky. The flag exists
					# for the contract with pxtune-auto, which detects --reset
					# support at runtime - without it, it would fall back to the
					# no-reset mode and warn into the log for nothing.
					--reset) : ;;
					# --overlay <pkg>: before writing, override the profile keys
					# with the APP_OVERLAY_* values from apps/<pkg>.conf. The
					# daemon sends this when an app with a per-app rule is in the
					# foreground.
					--overlay)
						shift
						_poverlay="$1"
						case "$_poverlay" in
							''|.*|*/*|*[!A-Za-z0-9._]*)
								warn "pxtune: --overlay wants a package name, not '$_poverlay'"
								exit 1
								;;
						esac
						;;
					*) warn "pxtune: unknown parameter '$1' (supported: --auto, --reset, --overlay <pkg>)"; exit 1 ;;
				esac
				shift
			done
			profile_apply "$_pname" "$_pauto" "$_poverlay"
			;;
	esac
}

# ---------------------------------------------------------------------------
# reapply - restore only the nodes the power HAL took over
# ---------------------------------------------------------------------------
# The daemon calls this after every screen wake. The measurement-backed reason is
# at V2_VOLATILE: a display wake returns dvfs_headroom and BOTH sched_pixel
# limit_frequency values to stock, which removes powersave's two most effective
# levers.
#
# Why a separate command and not `profile <active>`: that would mean a full
# revert to stock and rewriting ~40 nodes on every unlock of the phone. Here it
# is at most 4 writes and no revert, so it can be called often and cheaply.
cmd_reapply() {
	_roverlay=""
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--overlay)
				shift
				_roverlay="$1"
				case "$_roverlay" in
					''|.*|*/*|*[!A-Za-z0-9._]*)
						warn "pxtune: --overlay wants a package name, not '$_roverlay'"
						exit 1
						;;
				esac
				;;
			*) warn "pxtune: unknown parameter '$1' (supported: --overlay <pkg>)"; exit 1 ;;
		esac
		shift
	done

	rdv "$ACTIVE_FILE" ""
	_ract="$V"
	case "$_ract" in
		''|.*|*/*|*[!A-Za-z0-9._-]*)
			warn "pxtune: I do not know the active profile ($ACTIVE_FILE), there is nothing to restore"
			exit 2
			;;
	esac
	profile_apply "$_ract" 1 "$_roverlay" 1
}

profile_list() {
	# PERFORMANCE: originally 3 forks per profile (basename + $(active_profile) +
	# kv_get, which is itself `sed|tail|sed`). All of it works fork-free: the name
	# via parameter expansion, the active profile read once, the description pulled
	# out by reading the file.
	_found=0
	rdv "$ACTIVE_FILE" "unknown"
	_act="$V"
	for _f in "$PROFILE_DIR"/*.conf; do
		[ -f "$_f" ] || continue
		_found=1
		_n="${_f##*/}"
		_n="${_n%.conf}"
		_mark=" "
		[ "$_n" = "$_act" ] && _mark="*"
		_desc=""
		while IFS='=' read -r _pk _pv || [ -n "$_pk" ]; do
			[ "$_pk" = "PROFILE_DESC" ] || continue
			_pv="${_pv%%#*}"
			while :; do case "$_pv" in *' '|*"	") _pv="${_pv%?}" ;; *) break ;; esac; done
			case "$_pv" in \"*\") _pv="${_pv#\"}"; _pv="${_pv%\"}" ;; esac
			_desc="$_pv"
			break
		done < "$_f"
		# alignment without printf (on Android that is an external binary)
		_pad="$_n"
		while [ "${#_pad}" -lt 14 ]; do _pad="$_pad "; done
		print -r -- "$_mark $_pad $_desc"
	done
	if [ "$_found" -eq 0 ]; then
		warn "pxtune: there are no profiles (*.conf) in $PROFILE_DIR"
		return 2
	fi
	return 0
}

profile_auto() {
	if [ -f "$OVERRIDE_FILE" ]; then
		rm -f "$OVERRIDE_FILE" 2>/dev/null
		log INFO "manual_override cleared, profile control handed back to the daemon"
	fi
	# The manual base held by the daemon during a per-app episode makes no sense without the override.
	rm -f "$STATE_DIR/manual_base" 2>/dev/null
	# The daemon would only notice the change at the next event (an app switch).
	# SIGHUP tells it to re-evaluate the state at once - otherwise the right
	# profile might only be applied minutes later.
	auto_signal HUP
	msg "manual_override cleared - the daemon controls the profile (auto=$(auto_state))"
	return 0
}

# auto_signal <signal> - sends a signal to the running daemon, if it is running.
# It never fails in a way that takes the caller down.
auto_signal() {
	_apid=$(rd "$AUTOD_PID" 2>/dev/null | tr -dc '0-9')
	[ -n "$_apid" ] || return 0
	[ -d "/proc/$_apid" ] || return 0
	if kill -"$1" "$_apid" 2>/dev/null; then
		log INFO "SIG$1 sent to the daemon (pid $_apid)"
	fi
	return 0
}

# skin_mc_v -> V = the skin temperature (quiet_therm) in millicelsius, "" when
# unreadable. It reads via the stable symlink /dev/thermal/tz-by-name (zone
# indices shift, see resolve_thermal_ids); the fallback is the resolved skin:
# index from THERMAL_ZONES. Fork-free (rdv sets the global V).
skin_mc_v() {
	rdv "/dev/thermal/tz-by-name/quiet_therm/temp" ""
	[ -n "$V" ] && return 0
	_skmi=""
	for _skz in $THERMAL_ZONES; do
		case "$_skz" in skin:*) _skmi="${_skz#skin:}"; break ;; esac
	done
	[ -n "$_skmi" ] && rdv "$THERMAL/thermal_zone$_skmi/temp" ""
	return 0
}

# profile_apply <name> <0|1 = called by the daemon>
profile_apply() {
	_name="$1"
	_auto="$2"
	_overlay="$3"
	# _volonly=1: the `pxtune reapply` mode. The profile is loaded exactly the same
	# way (including the overlay), but only the keys from V2_VOLATILE are written.
	# No revert, no write into 'active', no touching manual_override - the profile
	# state does not change, only what the power HAL overwrote in the meantime is
	# forced back.
	_volonly="$4"
	case "$_name" in
		*/*|.*|"") die 1 "invalid profile name: '$_name'" ;;
	esac
	_pf="$PROFILE_DIR/$_name.conf"
	if [ ! -f "$_pf" ]; then
		warn "pxtune: profile '$_name' does not exist ($_pf)"
		warn "        available:"
		profile_list 1>&2
		exit 1
	fi

	if [ "$_volonly" = "1" ]; then
		WR_QUIET=1
	elif [ "$_auto" = "1" ]; then
		log INFO "=== applying profile '$_name' (daemon, manual_override unchanged) ==="
	else
		log INFO "=== applying profile '$_name' (manual) ==="
	fi
	WR_OK=0
	WR_FAIL=0
	VAL_FAIL=0

	# Everything back to stock first, so the profile does not inherit values from
	# the previous one. Without that, empty keys ("leave it alone") would mean the
	# previous profile is only partly overlaid - see the comment at
	# restore_stock_values().
	[ "$_volonly" = "1" ] || restore_stock_values

	# The profile is loaded ONCE into the PF_* variables (fork-free). We zero them
	# all first, so no old value is left hanging from the previous profile.
	# shellcheck disable=SC2086
	for _pk in $PROFILE_KEYS; do
		eval "PF_$_pk="
		eval "PFSET_$_pk=0"
	done
	# PFSET_* distinguishes "the key is missing from the profile" from "the key is
	# empty" - which matters for THERMAL_PROFILE_* (an empty value = return to the
	# default).
	while IFS='=' read -r _pk _pv; do
		case "$_pk" in
			''|\#*)          continue ;;
			*[!A-Za-z0-9_]*) continue ;;
		esac
		_pv="${_pv%%#*}"
		while :; do
			case "$_pv" in
				*' '|*"	") _pv="${_pv%?}" ;;
				*) break ;;
			esac
		done
		case "$_pv" in
			\"*\") _pv="${_pv#\"}"; _pv="${_pv%\"}" ;;
			\'*\') _pv="${_pv#\'}"; _pv="${_pv%\'}" ;;
		esac
		eval "PF_$_pk=\$_pv"
		eval "PFSET_$_pk=1"
	done < "$_pf"

	# --- PER-APP LAYER 2: the overlay ---------------------------------------
	# APP_OVERLAY_<key> from apps/<pkg>.conf overrides the profile key of the same
	# name, and ONLY while that package is in the foreground.
	#
	# Why it is done RIGHT HERE: the profile is already loaded into PF_*, but
	# nothing has been written yet. The overlay therefore goes through exactly the
	# same validation (set_uclamp, set_gpu, set_vm, ...) as the values from the
	# profile - no second write path appears and `wr()` remains the only place
	# that writes into sysfs.
	#
	# THE RESTORE IS FREE: restore_stock_values() above has already run and will
	# run again on every further profile_apply(). The overlay therefore cannot get
	# "stuck" - which is exactly why layer 2 is built on profiles rather than on
	# state of its own.
	_ovn=0
	if [ -n "$_overlay" ] && [ -f "$APPDIR/$_overlay.conf" ]; then
		while IFS='=' read -r _ok _ov; do
			case "$_ok" in
				APP_OVERLAY_?*) _ok="${_ok#APP_OVERLAY_}" ;;
				*) continue ;;
			esac
			case "$_ok" in *[!A-Za-z0-9_]*) continue ;; esac
			# shellcheck disable=SC2086
			if ! in_list "$_ok" $PROFILE_KEYS; then
				log WARN "overlay $_overlay: '$_ok' is not a profile contract key, ignoring"
				continue
			fi
			_ov="${_ov%%#*}"
			while :; do
				case "$_ov" in
					*' '|*"	") _ov="${_ov%?}" ;;
					*) break ;;
				esac
			done
			case "$_ov" in
				\"*\") _ov="${_ov#\"}"; _ov="${_ov%\"}" ;;
				\'*\') _ov="${_ov#\'}"; _ov="${_ov%\'}" ;;
			esac
			eval "PF_$_ok=\$_ov"
			eval "PFSET_$_ok=1"
			_ovn=$((_ovn + 1))
			[ "$_volonly" = "1" ] || log INFO "overlay $_overlay: $_ok='$_ov' overrides profile '$_name'"
		done < "$APPDIR/$_overlay.conf"
		[ "$_ovn" -eq 0 ] && [ "$_volonly" != "1" ] && log INFO "overlay $_overlay: no APP_OVERLAY_* key"
	elif [ -n "$_overlay" ]; then
		log WARN "overlay: no rule for '$_overlay' ($APPDIR/$_overlay.conf), profile '$_name' is applied unchanged"
	fi

	# The reapply mode ends here: the profile and the overlay are loaded, and only
	# the nodes the HAL has taken back in the meantime are written.
	if [ "$_volonly" = "1" ]; then
		WR_CHANGED=0
		set_v2_volatile
		WR_QUIET=0
		if [ "$WR_CHANGED" -gt 0 ]; then
			log INFO "reapply: $WR_CHANGED of ${WR_OK} volatile nodes of profile '$_name'${_overlay:+ (overlay $_overlay)} restored (the power HAL had overwritten them)"
			msg "reapply: restored $WR_CHANGED volatile nodes of profile '$_name'."
		else
			msg "reapply: nothing to restore, all $WR_OK volatile nodes of profile '$_name' match."
		fi
		[ "$WR_FAIL" -gt 0 ] && return 2
		[ "$VAL_FAIL" -gt 0 ] && return 2
		return 0
	fi

	set_uclamp top-app            min "$PF_UCLAMP_TOPAPP_MIN"
	set_uclamp top-app            max "$PF_UCLAMP_TOPAPP_MAX"
	set_uclamp foreground         min "$PF_UCLAMP_FG_MIN"
	set_uclamp foreground         max "$PF_UCLAMP_FG_MAX"
	set_uclamp background         min "$PF_UCLAMP_BG_MIN"
	set_uclamp background         max "$PF_UCLAMP_BG_MAX"
	set_uclamp system-background  min "$PF_UCLAMP_SYSBG_MIN"
	set_uclamp system-background  max "$PF_UCLAMP_SYSBG_MAX"

	set_gpu "$PF_GPU_MAX_FREQ" "$PF_GPU_MIN_FREQ" "$PF_GPU_POWER_POLICY"

	# Caution: the prop is also set by the system (e.g. "camera" while the camera
	# runs). An empty value = "leave it alone" (the profile contract); the default
	# is not enforced.
	_tm="$PF_THERMAL_PROFILE_CPU_MID"
	_th="$PF_THERMAL_PROFILE_CPU_HIGH"

	# --- THERMAL_PROFILE_MAX_SKIN (°C) - the "gaming in the sun" safeguard ----
	# game.conf sets the thermal prop to "game", which DISABLES CPU thermal
	# throttling from 2 of the 4 skin sensors (SPEC: "Mode":"game" -> cdev
	# Disabled). When THERMAL_PROFILE_MAX_SKIN is non-empty and the skin
	# (quiet_therm) is already ABOVE that temperature, the value "game" is NOT
	# DEPLOYED - otherwise we would cook the phone while it is hot. The other
	# values ("camera", "" = default) are not dangerous and the safeguard lets
	# them through. An empty key = the safeguard is off.
	# Runtime supervision is the daemon's job (therm_prop_maxskin_guard); this is
	# the check at the moment the profile is APPLIED.
	_skin_over=0
	if [ -n "$PF_THERMAL_PROFILE_MAX_SKIN" ] && is_int "$PF_THERMAL_PROFILE_MAX_SKIN"; then
		skin_mc_v
		if is_int "$V" && [ "$V" -gt "$((PF_THERMAL_PROFILE_MAX_SKIN * 1000))" ]; then
			_skin_over=1
		fi
	fi

	if [ "$PFSET_THERMAL_PROFILE_CPU_MID" = "1" ] && [ -n "$_tm" ]; then
		if [ "$_skin_over" = "1" ] && [ "$_tm" = "game" ]; then
			log WARN "THERMAL_PROFILE_CPU_MID='game' NOT DEPLOYED: the skin is above THERMAL_PROFILE_MAX_SKIN=${PF_THERMAL_PROFILE_MAX_SKIN} C (otherwise CPU thermal throttling would stay OFF while hot)"
		elif valid_thermal_profile "$_tm"; then
			set_thermal_profile "$THERMAL_SENSOR_MID" "$_tm"
		else
			vfail "invalid THERMAL_PROFILE_CPU_MID '$_tm' (game|camera|empty)"
		fi
	fi
	if [ "$PFSET_THERMAL_PROFILE_CPU_HIGH" = "1" ] && [ -n "$_th" ]; then
		if [ "$_skin_over" = "1" ] && [ "$_th" = "game" ]; then
			log WARN "THERMAL_PROFILE_CPU_HIGH='game' NOT DEPLOYED: the skin is above THERMAL_PROFILE_MAX_SKIN=${PF_THERMAL_PROFILE_MAX_SKIN} C (otherwise CPU thermal throttling would stay OFF while hot)"
		elif valid_thermal_profile "$_th"; then
			set_thermal_profile "$THERMAL_SENSOR_HIGH" "$_th"
		else
			vfail "invalid THERMAL_PROFILE_CPU_HIGH '$_th' (game|camera|empty)"
		fi
	fi

	set_vm "$PF_VM_SWAPPINESS" \
	       "$PF_VM_DIRTY_RATIO" \
	       "$PF_VM_DIRTY_BG_RATIO" \
	       "$PF_VM_VFS_CACHE_PRESSURE"

	set_io_readahead "$PF_IO_READAHEAD_KB"

	_cs="$PF_CHARGE_STOP_LEVEL"
	if [ -n "$_cs" ]; then
		if valid_charge "$_cs"; then
			wr "$CHARGER/charge_stop_level" "$_cs"
		else
			vfail "invalid CHARGE_STOP_LEVEL '$_cs' (allowed 1-100)"
		fi
	fi

	# The v2 contract keys (vendor_sched, sched_pixel/limit+down_rate, devfreq,
	# cpupm residency, GPU dvfs_period, cdev bypass). Empty = leave them alone.
	set_v2

	print -r -- "$_name" > "$ACTIVE_FILE" 2>/dev/null

	if [ "$_auto" = "1" ]; then
		log INFO "profile '$_name' applied by the daemon (ok=$WR_OK errors=$WR_FAIL invalid=$VAL_FAIL)"
		msg "Profile '$_name' applied (daemon). Writes OK: $WR_OK, errors: $WR_FAIL, invalid values: $VAL_FAIL."
	else
		: > "$OVERRIDE_FILE" 2>/dev/null
		log INFO "profile '$_name' applied manually (ok=$WR_OK errors=$WR_FAIL invalid=$VAL_FAIL), manual_override set"
		msg "Profile '$_name' applied. Writes OK: $WR_OK, errors: $WR_FAIL, invalid values: $VAL_FAIL."
		msg "manual_override set (the daemon has no say in the profile). Clear it with: pxtune profile auto"
	fi

	[ "$WR_FAIL" -gt 0 ] && return 2
	[ "$VAL_FAIL" -gt 0 ] && return 2
	return 0
}

# ---------------------------------------------------------------------------
# revert
# ---------------------------------------------------------------------------
cmd_revert() {
	WR_OK=0
	WR_FAIL=0

	if stock_valid; then
		msg "Restoring the stock values from $STOCK_CONF"
		log INFO "=== revert from stock.conf ==="
	else
		warn "pxtune: stock.conf is missing or corrupted - using the default values from the SPEC"
		log WARN "=== revert: stock.conf unusable, falling back to the SPEC defaults ==="
	fi

	# uclamp
	for _g in $UCLAMP_GROUPS; do
		uclamp_keyv "$_g"; _k="$UK"
		if [ "$_g" = "nnapi-hal" ]; then
			_dmin="$DEF_UCLAMP_MIN_NNAPI"
		else
			_dmin="$DEF_UCLAMP_MIN"
		fi
		stock_getv "STOCK_UCLAMP_${_k}_MIN" "$_dmin"; _vmin="$SV"
		stock_getv "STOCK_UCLAMP_${_k}_MAX" "$DEF_UCLAMP_MAX"; _vmax="$SV"
		[ -n "$_vmin" ] && wr "$CPUCTL/$_g/cpu.uclamp.min" "$_vmin"
		[ -n "$_vmax" ] && wr "$CPUCTL/$_g/cpu.uclamp.max" "$_vmax"
	done

	# GPU: min down first, then max up (so they do not block each other)
	stock_getv STOCK_GPU_MIN_FREQ "$DEF_GPU_MIN"; _gmin="$SV"
	stock_getv STOCK_GPU_MAX_FREQ "$DEF_GPU_MAX"; _gmax="$SV"
	stock_getv STOCK_GPU_POWER_POLICY "$DEF_GPU_POLICY"; _gpol="$SV"
	valid_gpu_freq "$_gmin"   || _gmin="$DEF_GPU_MIN"
	valid_gpu_freq "$_gmax"   || _gmax="$DEF_GPU_MAX"
	valid_gpu_policy "$_gpol" || _gpol="$DEF_GPU_POLICY"
	wr "$MALI/scaling_min_freq" "$_gmin"
	wr "$MALI/scaling_max_freq" "$_gmax"
	# hint_max_freq is backed up in snapshot_stock, so we restore it as well
	stock_getv STOCK_GPU_HINT_MAX_FREQ ""; _ghint="$SV"
	if [ -n "$_ghint" ] && valid_gpu_freq "$_ghint"; then
		wr "$MALI/hint_max_freq" "$_ghint"
	fi
	wr "$MALI/power_policy" "$_gpol"

	# vm
	stock_getv STOCK_VM_SWAPPINESS "$DEF_SWAPPINESS"; _v="$SV";                 is_int "$_v" || _v="$DEF_SWAPPINESS";         wr /proc/sys/vm/swappiness "$_v"
	stock_getv STOCK_VM_DIRTY_RATIO "$DEF_DIRTY_RATIO"; _v="$SV";               is_int "$_v" || _v="$DEF_DIRTY_RATIO";        wr /proc/sys/vm/dirty_ratio "$_v"
	stock_getv STOCK_VM_DIRTY_BG_RATIO "$DEF_DIRTY_BG_RATIO"; _v="$SV";         is_int "$_v" || _v="$DEF_DIRTY_BG_RATIO";     wr /proc/sys/vm/dirty_background_ratio "$_v"
	stock_getv STOCK_VM_VFS_CACHE_PRESSURE "$DEF_VFS_CACHE_PRESSURE"; _v="$SV"; is_int "$_v" || _v="$DEF_VFS_CACHE_PRESSURE"; wr /proc/sys/vm/vfs_cache_pressure "$_v"
	stock_getv STOCK_VM_PAGE_CLUSTER "$DEF_PAGE_CLUSTER"; _v="$SV";             is_int "$_v" || _v="$DEF_PAGE_CLUSTER";       wr /proc/sys/vm/page-cluster "$_v"

	# charging
	stock_getv STOCK_CHARGE_STOP_LEVEL "$DEF_CHARGE_STOP"; _v="$SV";   valid_charge "$_v" || _v="$DEF_CHARGE_STOP"
	wr "$CHARGER/charge_stop_level" "$_v"
	stock_getv STOCK_CHARGE_START_LEVEL "$DEF_CHARGE_START"; _v="$SV"; is_int "$_v" || _v="$DEF_CHARGE_START"
	wr "$CHARGER/charge_start_level" "$_v"

	# I/O readahead
	for _d in $IO_DEVS; do
		[ -e "/sys/block/$_d/queue/read_ahead_kb" ] || continue
		_k=$(print -rn -- "$_d" | tr 'a-z' 'A-Z')
		stock_getv "STOCK_IO_READAHEAD_$_k" ""; _v="$SV"
		[ -n "$_v" ] && is_int "$_v" && wr "/sys/block/$_d/queue/read_ahead_kb" "$_v"
	done

	# thermal HAL profiles
	stock_getv STOCK_THERMAL_PROFILE_CPU_MID "$DEF_THERMAL_PROFILE"; _v="$SV"
	valid_thermal_profile "$_v" || _v="$DEF_THERMAL_PROFILE"
	set_thermal_profile "$THERMAL_SENSOR_MID" "$_v"
	stock_getv STOCK_THERMAL_PROFILE_CPU_HIGH "$DEF_THERMAL_PROFILE"; _v="$SV"
	valid_thermal_profile "$_v" || _v="$DEF_THERMAL_PROFILE"
	set_thermal_profile "$THERMAL_SENSOR_HIGH" "$_v"

	# contract v2 - restore the new nodes to stock. From stock.conf, otherwise
	# DEF_V2_* (an old snapshot from before v2 does not have these keys). Nodes
	# that do not exist on this build are skipped ([ -e ]).
	for _e in $V2_TABLE; do
		_vk="${_e%%:*}"; _vrest="${_e#*:}"; _vp="${_vrest%:*}"; _vkind="${_vrest##*:}"
		eval "_vdef=\$DEF_V2_$_vk"
		stock_getv "STOCK_$_vk" "$_vdef"; _v="$SV"
		[ -n "$_v" ] || _v="$_vdef"
		v2_valid "$_vkind" "$_v" || _v="$_vdef"
		[ -n "$_v" ] && [ -e "$_vp" ] && wr "$_vp" "$_v"
	done
	# THERMAL_CDEV_BYPASS: a revert always DISABLES it (0) - the safe direction,
	# whoever set it. The stock value is 0.
	for _bn in $CDEV_BYPASS_NODES; do
		[ -e "$_bn" ] && wr "$_bn" "0"
	done

	# When used as a "reset before a profile" we stop here: neither the resolution
	# nor the state files may be touched, that is the business of a full revert.
	if [ "${RESTORE_ONLY:-0}" = "1" ]; then
		return 0
	fi

	# --- PER-APP LAYER 3: take it down BEFORE we write the stock display ----
	# "Restore EVERYTHING to stock" includes layer 3 deployed by a per-app rule
	# (refresh rate, resolution). `app leave` is IDEMPOTENT, so it may be called
	# blindly - when nothing is deployed it quietly exits with code 0.
	# This is the 6th of the SIX independent paths that must call it; the other
	# five are in the daemon and in service.sh. The list and the reasons are in
	# the comment at cmd_leave() in bin/pxtune-perapp.
	# The order matters: leave writes the old display values, so it has to run
	# BEFORE res_write_settings() below - otherwise it would overwrite the stock
	# value.
	if [ -x "$PERAPP" ]; then
		"$PERAPP" leave >/dev/null 2>&1
	elif [ -f "$APPMODE" ]; then
		log ERROR "$PERAPP is not executable - deleting appmode.active without restoring layer 3 (the resolution/refresh rate may be left over from a per-app rule)"
		rm -f "$APPMODE" 2>/dev/null
	fi

	# display
	stock_getv STOCK_DISPLAY_SIZE_FORCED "$DEF_DISPLAY_SIZE"; _size="$SV"
	stock_getv STOCK_DISPLAY_DENSITY_FORCED "$DEF_DISPLAY_DENSITY"; _dens="$SV"
	res_write_settings "$_size" "$_dens"
	rm -f "$RESPEND_FILE" 2>/dev/null

	# state
	# Deliberately EMPTY, not "stock": profiles/stock.conf does not exist and
	# service.sh would log ERROR "profile 'stock' does not exist" on every boot.
	# It already handles empty as "apply nothing".
	{ : > "$ACTIVE_FILE"; } 2>/dev/null
	: > "$OVERRIDE_FILE" 2>/dev/null
	# The manual base of a per-app episode is part of "everything to stock" -
	# otherwise the daemon would restore it after the revert instead of the freshly
	# pinned state.
	rm -f "$STATE_DIR/manual_base" 2>/dev/null

	log INFO "revert finished (writes ok=$WR_OK errors=$WR_FAIL)"
	msg "Revert finished. Writes OK: $WR_OK, errors: $WR_FAIL."
	msg "manual_override was set so the daemon does not immediately write another profile."
	msg "NOTE: zram is not changed at runtime (a swapoff is dangerous) - changes only in post-fs-data.sh."
	[ "$WR_FAIL" -gt 0 ] && return 2
	return 0
}

# restore_stock_values - returns all profile-controlled values to stock, but
# DOES NOT TOUCH the resolution or the state files.
#
# Why it exists: an empty value in a profile means "leave it alone" (the profile
# contract). Without this reset the profiles would be "sticky" - after switching
# from powersave to balanced (which has all keys empty) the values from powersave
# would remain and balanced would not restore stock as it promises.
# Verified on the device: switching powersave -> balanced left top-app
# uclamp.max at 60 instead of 'max'.
restore_stock_values() {
	_rsv_ok="$WR_OK"
	_rsv_fail="$WR_FAIL"
	RESTORE_ONLY=1
	cmd_revert >/dev/null 2>&1
	RESTORE_ONLY=0
	# writes from the reset do not count towards the profile statistics
	WR_OK="$_rsv_ok"
	WR_FAIL="$_rsv_fail"
	return 0
}

# ---------------------------------------------------------------------------
# res - resolution / DPI
# ---------------------------------------------------------------------------
# res_split <item> -> sets _pn _pw _ph _pd
res_split() {
	_pn=${1%%:*}
	_pr=${1#*:}
	_pw=${_pr%%:*}
	_pr=${_pr#*:}
	_ph=${_pr%%:*}
	_pd=${_pr##*:}
}

# res_lookup <name|WxH|W> -> "W H DPI"
res_lookup() {
	for _p in $RES_PRESETS; do
		res_split "$_p"
		if [ "$1" = "$_pn" ] || [ "$1" = "${_pw}x${_ph}" ] || [ "$1" = "$_pw" ]; then
			printf '%s %s %s' "$_pw" "$_ph" "$_pd"
			return 0
		fi
	done
	return 1
}

# res_preset_names -> "native 900x2000 810x1800 720x1600"
res_preset_names() {
	_out=""
	for _p in $RES_PRESETS; do
		res_split "$_p"
		_out="$_out $_pn"
	done
	print -rn -- "${_out# }"
}

# display_state_write <W> <H> <DPI> - a cache for status --json (no binder)
display_state_write() {
	printf '%s %s %s\n' "$1" "$2" "$3" > "$DISPSTATE_FILE" 2>/dev/null
}

# display_state_read -> "W H DPI"; the fallback is native + the density from stock.conf/getprop
display_state_read() {
	_ds=$(rd "$DISPSTATE_FILE") || _ds=""
	if [ -n "$_ds" ]; then
		print -rn -- "$_ds"
		return 0
	fi
	stock_getv STOCK_DISPLAY_DENSITY_FORCED ""; _d="$SV"
	if ! is_int "$_d"; then
		_d=$(getprop ro.sf.lcd_density 2>/dev/null)
		is_int "$_d" || _d="$NATIVE_DPI"
	fi
	printf '%s %s %s' "$NATIVE_W" "$NATIVE_H" "$_d"
}

# res_write_settings <"W,H" | ""> <dpi | "">
res_write_settings() {
	_sz="$1"
	_dp="$2"
	if ! framework_ok; then
		warn "pxtune: the 'settings' command is not available (or the framework is disabled)"
		log ERROR "settings unavailable, the resolution was not changed"
		return 2
	fi

	if [ -z "$_sz" ]; then
		settings_run delete global display_size_forced \
			|| settings_run put global display_size_forced ""
		log INFO "settings global display_size_forced -> (deleted/empty)"
	else
		settings_run put global display_size_forced "$_sz"
		log INFO "settings global display_size_forced -> '$_sz'"
	fi

	if [ -n "$_dp" ]; then
		settings_run put secure display_density_forced "$_dp"
		log INFO "settings secure display_density_forced -> '$_dp'"
	else
		settings_run delete secure display_density_forced \
			|| settings_run put secure display_density_forced ""
		log INFO "settings secure display_density_forced -> (deleted/empty)"
	fi

	# a cache for status --json
	if [ -z "$_sz" ]; then
		_cw="$NATIVE_W"; _ch="$NATIVE_H"
	else
		_cw=${_sz%%,*}; _ch=${_sz##*,}
	fi
	if [ -n "$_dp" ]; then
		_cd="$_dp"
	else
		_cd=$(getprop ro.sf.lcd_density 2>/dev/null)
		is_int "$_cd" || _cd="$NATIVE_DPI"
	fi
	display_state_write "$_cw" "$_ch" "$_cd"
	return 0
}

# res_pending_seconds -> how many seconds remain until the automatic revert (0 = nothing is running)
res_pending_seconds() {
	if [ ! -f "$RESPEND_FILE" ]; then
		printf '0'
		return 0
	fi
	_tok=$(rd "$RESPEND_FILE") || _tok=""
	_start=${_tok%%-*}
	_now=$(date '+%s' 2>/dev/null)
	if ! is_int "$_start" || ! is_int "$_now"; then
		printf '0'
		return 0
	fi
	_left=$((RES_TIMEOUT - (_now - _start)))
	[ "$_left" -lt 0 ] && _left=0
	[ "$_left" -gt "$RES_TIMEOUT" ] && _left="$RES_TIMEOUT"
	print -rn -- "$_left"
}

res_current() {
	_s=$(settings_get global display_size_forced)
	_d=$(settings_get secure display_density_forced)
	[ -n "$_s" ] || _s="(empty = native ${NATIVE_W}x${NATIVE_H})"
	[ -n "$_d" ] || _d="(empty)"
	msg "display_size_forced   : $_s"
	msg "display_density_forced: $_d"
	if [ -f "$RESPEND_FILE" ]; then
		msg "res_pending           : YES - $(res_pending_seconds) s left to run 'pxtune res confirm'"
	else
		msg "res_pending           : no"
	fi
}

res_apply_native() {
	res_write_settings "$NATIVE_W,$NATIVE_H" "$NATIVE_DPI"
}

cmd_res() {
	case "$1" in
		""|status|current)
			res_current
			return 0
			;;
		list)
			msg "Available presets:"
			for _p in $RES_PRESETS; do
				res_split "$_p"
				printf '  %-10s %sx%s @ %s dpi\n' "$_pn" "$_pw" "$_ph" "$_pd"
			done
			return 0
			;;
		confirm)
			if [ -f "$RESPEND_FILE" ]; then
				rm -f "$RESPEND_FILE" 2>/dev/null
				log INFO "res confirm - the resolution change was confirmed, the watchdog was cancelled"
				msg "The resolution was confirmed, the automatic revert was cancelled."
			else
				msg "Nothing to confirm (res_pending does not exist)."
			fi
			return 0
			;;
		reset)
			rm -f "$RESPEND_FILE" 2>/dev/null
			log INFO "res reset - a blind return to native ${NATIVE_W}x${NATIVE_H} @ ${NATIVE_DPI}dpi"
			res_apply_native || return 2
			msg "Set to native ${NATIVE_W}x${NATIVE_H} @ ${NATIVE_DPI} dpi."
			return 0
			;;
	esac

	if ! _r=$(res_lookup "$1"); then
		warn "pxtune: unknown resolution preset '$1'"
		warn "        use: pxtune res list  (presets: $(res_preset_names))"
		exit 1
	fi
	# shellcheck disable=SC2086
	set -- $_r
	_w="$1"; _h="$2"; _d="$3"

	log INFO "res: setting ${_w}x${_h} @ ${_d}dpi"
	res_write_settings "$_w,$_h" "$_d" || return 2

	if [ "$_w" = "$NATIVE_W" ] && [ "$_h" = "$NATIVE_H" ] && [ "$_d" = "$NATIVE_DPI" ]; then
		rm -f "$RESPEND_FILE" 2>/dev/null
		msg "Set to native ${_w}x${_h} @ ${_d} dpi (no safeguard)."
		return 0
	fi

	# THE SAFEGUARD: res_pending + a delayed return to native after RES_TIMEOUT
	# seconds. The token = "<creation epoch>-<pid>"; res_pending_seconds is
	# computed from that epoch too.
	_tok="$(date '+%s' 2>/dev/null)-$$"
	print -r -- "$_tok" > "$RESPEND_FILE" 2>/dev/null
	res_arm_watchdog "$_tok"

	msg "Set to ${_w}x${_h} @ ${_d} dpi."
	msg "SAFEGUARD: if you do not run 'pxtune res confirm' within ${RES_TIMEOUT} s,"
	msg "           the resolution returns to native ${NATIVE_W}x${NATIVE_H} @ ${NATIVE_DPI} dpi."
	return 0
}

res_arm_watchdog() {
	_tok="$1"
	if [ -x "$SELF" ]; then
		if command -v nohup >/dev/null 2>&1; then
			nohup "$SELF" __res_watchdog "$_tok" >/dev/null 2>&1 &
		else
			"$SELF" __res_watchdog "$_tok" >/dev/null 2>&1 &
		fi
	else
		if command -v nohup >/dev/null 2>&1; then
			nohup /system/bin/sh "$SELF" __res_watchdog "$_tok" >/dev/null 2>&1 &
		else
			/system/bin/sh "$SELF" __res_watchdog "$_tok" >/dev/null 2>&1 &
		fi
	fi
	log INFO "res watchdog armed (token=$_tok, timeout=${RES_TIMEOUT}s)"
}

res_watchdog() {
	_tok="$1"
	sleep "$RES_TIMEOUT"
	if [ ! -f "$RESPEND_FILE" ]; then
		log INFO "res watchdog ($_tok): confirmed, doing nothing"
		return 0
	fi
	_cur=$(rd "$RESPEND_FILE") || _cur=""
	if [ "$_cur" != "$_tok" ]; then
		log INFO "res watchdog ($_tok): a newer change arrived in the meantime ($_cur), exiting"
		return 0
	fi
	log WARN "res watchdog ($_tok): no confirmation arrived, restoring the native resolution"
	res_apply_native
	rm -f "$RESPEND_FILE" 2>/dev/null
	return 0
}

# ---------------------------------------------------------------------------
# dpi - changing the display density on its own (independently of the resolution)
#
# THE MECHANISM (verified on the device 2026-08-07):
#   `wm density <n>`  -> Override density: n  AND AT THE SAME TIME writes
#                        settings secure display_density_forced = n
#   `wm density reset` -> clears the override
#
#   CAUTION: `settings put secure display_density_forced` on its own HAS NO
#   EFFECT. Verified: writing 380 left the Override at 353. WindowManager has to
#   apply the value, and that is exactly what the `wm` command does. The settings
#   key is only where WM stores it for the next boot.
#
# VALUES
#   The physical panel density is 420 (ro.sf.lcd_density).
#   The user has their own override of 353 (lower = more content on screen).
#   The 280-560 range is deliberately conservative: below 280 the UI starts to be
#   illegibly small and system dialogs break, above 560 the buttons do not fit.
#
# THE SAFEGUARD
#   The same as for the resolution: after a change it waits for
#   `pxtune dpi confirm`. Without a confirmation the original value is restored
#   within DPI_TIMEOUT seconds - so even if the UI becomes unusable, it fixes
#   itself.
#   A blind restore from anywhere:  su -c "pxtune dpi reset"
# ---------------------------------------------------------------------------
DPI_MIN=280
DPI_MAX=560
DPI_TIMEOUT=60
DPIPEND_FILE="$STATE_DIR/dpi_pending"

# dpi_current -> the current effective density (the Override, otherwise the physical one)
dpi_current() {
	stock_getv STOCK_DISPLAY_DENSITY_FORCED ""
	_dc="$SV"
	rdv "$DISPSTATE_FILE" ""
	if [ -n "$V" ]; then
		# shellcheck disable=SC2086
		set -- $V
		[ -n "${3:-}" ] && _dc="$3"
	fi
	if framework_ok; then
		_q=$(settings_get secure display_density_forced)
		[ -n "$_q" ] && _dc="$_q"
	fi
	[ -n "$_dc" ] || _dc="$NATIVE_DPI_HW"
	printf '%s' "$_dc"
}

dpi_apply() {
	# dpi_apply <value|reset>
	if ! framework_ok; then
		warn "pxtune: the 'wm' command is not available (has the system finished booting?)"
		return 2
	fi
	if [ "$1" = "reset" ]; then
		if command -v timeout >/dev/null 2>&1; then
			timeout 10 wm density reset >/dev/null 2>&1
		else
			wm density reset >/dev/null 2>&1
		fi
		log INFO "wm density reset"
	else
		if command -v timeout >/dev/null 2>&1; then
			timeout 10 wm density "$1" >/dev/null 2>&1
		else
			wm density "$1" >/dev/null 2>&1
		fi
		log INFO "wm density $1"
	fi
	return 0
}

dpi_watchdog() {
	_tok="$1"
	_old="$2"
	sleep "$DPI_TIMEOUT"
	[ -f "$DPIPEND_FILE" ] || { log INFO "dpi watchdog ($_tok): confirmed"; return 0; }
	_cur=$(rd "$DPIPEND_FILE") || _cur=""
	case "$_cur" in
		"$_tok"*) ;;
		*) log INFO "dpi watchdog ($_tok): a newer change arrived, exiting"; return 0 ;;
	esac
	log WARN "dpi watchdog ($_tok): no confirmation arrived, restoring $_old"
	dpi_apply "$_old"
	rm -f "$DPIPEND_FILE" 2>/dev/null
	return 0
}

cmd_dpi() {
	case "${1:-}" in
		""|show|current)
			msg "current density  : $(dpi_current) dpi"
			msg "physical panel   : $NATIVE_DPI_HW dpi"
			msg "allowed range    : $DPI_MIN - $DPI_MAX"
			if [ -f "$DPIPEND_FILE" ]; then
				msg "CAUTION: waiting for confirmation - 'pxtune dpi confirm' (otherwise it reverts)"
			fi
			return 0
			;;
		confirm)
			if [ -f "$DPIPEND_FILE" ]; then
				rm -f "$DPIPEND_FILE" 2>/dev/null
				msg "Confirmed, the density of $(dpi_current) dpi stays."
			else
				msg "Nothing to confirm."
			fi
			return 0
			;;
		reset)
			# a blind restore - it works even when the user cannot see the display
			stock_getv STOCK_DISPLAY_DENSITY_FORCED ""
			_rd="$SV"
			if is_int "$_rd"; then
				dpi_apply "$_rd"
				msg "Restored to the stored density of $_rd dpi."
			else
				dpi_apply reset
				msg "The override was cleared, the physical density of $NATIVE_DPI_HW dpi applies."
			fi
			rm -f "$DPIPEND_FILE" 2>/dev/null
			return 0
			;;
	esac

	_nd="$1"
	if ! is_int "$_nd"; then
		warn "pxtune: usage: pxtune dpi <$DPI_MIN-$DPI_MAX | show | confirm | reset>"
		exit 1
	fi
	if [ "$_nd" -lt "$DPI_MIN" ] || [ "$_nd" -gt "$DPI_MAX" ]; then
		warn "pxtune: $_nd is outside the safe range $DPI_MIN-$DPI_MAX"
		warn "        Outside it the UI becomes unusable."
		exit 1
	fi

	_old=$(dpi_current)
	dpi_apply "$_nd" || return 2

	_tok="$(date '+%s' 2>/dev/null)-$$"
	print -r -- "$_tok $_old" > "$DPIPEND_FILE" 2>/dev/null
	if [ -x "$SELF" ]; then
		nohup "$SELF" __dpi_watchdog "$_tok" "$_old" >/dev/null 2>&1 &
	else
		nohup /system/bin/sh "$SELF" __dpi_watchdog "$_tok" "$_old" >/dev/null 2>&1 &
	fi
	log INFO "dpi $_old -> $_nd (watchdog $_tok, timeout ${DPI_TIMEOUT}s)"

	msg "The density was set to $_nd dpi (it was $_old)."
	msg "SAFEGUARD: run 'pxtune dpi confirm' within ${DPI_TIMEOUT} s,"
	msg "           otherwise it reverts to $_old by itself."
	return 0
}

# ---------------------------------------------------------------------------
# charge
# ---------------------------------------------------------------------------
cmd_charge() {
	_node="$CHARGER/charge_stop_level"
	case "$1" in
		"")
			msg "charge_stop_level : $(rd_def "$_node" "?")"
			msg "charge_start_level: $(rd_def "$CHARGER/charge_start_level" "?")"
			msg "capacity          : $(rd_def "$BATT/capacity" "?") %"
			return 0
			;;
		off|OFF) _val="$DEF_CHARGE_STOP" ;;
		*)       _val="$1" ;;
	esac

	if ! valid_charge "$_val"; then
		warn "pxtune: invalid value '$1' - allowed 1-100 or 'off'"
		exit 1
	fi

	if wr "$_node" "$_val"; then
		msg "charge_stop_level was set to $_val %."
		return 0
	fi
	warn "pxtune: writing charge_stop_level failed (see the log)"
	return 2
}

# ---------------------------------------------------------------------------
# game - a wrapper around 'cmd game'
# ---------------------------------------------------------------------------
cmd_game() {
	case "${1:-}" in
		''|*[!A-Za-z0-9._]*)
			warn "pxtune: invalid package name '${1:-}'"
			exit 1 ;;
	esac
	_pkg="$1"
	_mode="$2"
	[ "$#" -ge 1 ] && shift
	[ "$#" -ge 1 ] && shift

	if [ -z "$_pkg" ]; then
		warn "pxtune: usage: pxtune game <package> <1|2|3|4|standard|performance|battery|custom>"
		warn "               pxtune game <package>            # list the modes and configs"
		warn "                 pxtune game <package> <mode> [--fps N] [--downscale 0.5..0.9|disable]"
		exit 1
	fi
	if ! command -v cmd >/dev/null 2>&1; then
		warn "pxtune: the 'cmd' command is not available"
		return 2
	fi

	if [ -z "$_mode" ]; then
		msg "--- list-modes $_pkg ---"
		cmd game list-modes "$_pkg" 2>&1
		msg "--- list-configs $_pkg ---"
		cmd game list-configs "$_pkg" 2>&1
		return 0
	fi

	case "$_mode" in
		1|2|3|4|standard|performance|battery|custom) ;;
		*)
			warn "pxtune: invalid mode '$_mode' (1|2|3|4|standard|performance|battery|custom)"
			exit 1
			;;
	esac

	cmd game mode "$_mode" "$_pkg" 2>&1
	_rc=$?
	log INFO "cmd game mode $_mode $_pkg -> rc=$_rc"

	_fps=""
	_ds=""
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--fps)
				shift
				_fps="$1"
				is_int "$_fps" || { warn "pxtune: --fps wants a whole number"; exit 1; }
				;;
			--downscale)
				shift
				_ds="$1"
				case "$_ds" in
					disable|0.[5-9]|0.[5-9]0) ;;
					*) warn "pxtune: --downscale wants 0.5..0.9 or 'disable' (below 0.5 touch input breaks in games)"; exit 1 ;;
				esac
				;;
			*)
				warn "pxtune: unknown parameter '$1'"
				exit 1
				;;
		esac
		shift
	done
	[ -n "$_fps" ] && { cmd game set --fps "$_fps" "$_pkg" 2>&1; log INFO "cmd game set --fps $_fps $_pkg"; }
	[ -n "$_ds" ]  && { cmd game set --downscale "$_ds" "$_pkg" 2>&1; log INFO "cmd game set --downscale $_ds $_pkg"; }

	[ "$_rc" -eq 0 ] || return 2
	return 0
}

# ---------------------------------------------------------------------------
# zram - ACTIONS on zram0 (not a profile)
#
# `pxtune zram writeback [seconds]` - moves compressed pages that have been idle
# for >= <seconds> (default 3600 = 1 h) onto the backing device (loop50) and
# thereby frees RAM. It is an ACTION, not a setting (like wake_lock), hence a CLI
# command and not a profile key.
#
# UFS safety: writeback_limit_enable=1 + writeback_limit caps the number of
# written pages at 65536 (at 4 KiB each = ~256 MiB per run), so repeated runs do
# not wear the flash needlessly. The idle/writeback nodes are write-only
# (permissions 220), so wr() cannot read the old value from them (it logs '?') -
# that is fine, it simply always writes. bd_stat is readable, so we log it
# before/after.
#
# This is NOT dangerous like a swapoff (SPEC): writeback only moves pages to
# disk, swap stays active. It may therefore run at runtime, unlike zram size
# changes.
# ---------------------------------------------------------------------------
zram_writeback() {
	_age="${1:-3600}"
	if ! is_int "$_age"; then
		warn "pxtune: zram writeback <seconds> wants a whole number (the idle age), the default is 3600"
		exit 1
	fi
	if [ ! -d "$ZRAM" ]; then
		warn "pxtune: $ZRAM does not exist"
		return 2
	fi
	if [ ! -e "$ZRAM/writeback" ]; then
		warn "pxtune: zram writeback is not supported (missing $ZRAM/writeback - is backing_dev not set?)"
		log ERROR "zram writeback: $ZRAM/writeback does not exist"
		return 2
	fi

	WR_OK=0
	WR_FAIL=0

	_bd_before=$(rd_def "$ZRAM/bd_stat" "n/a")
	log INFO "=== zram writeback (age >= ${_age}s) === bd_stat before: $_bd_before"

	# The cap for this run: 65536 pages of 4 KiB = ~256 MiB. Conservative, so that
	# repeated calls do not wear the UFS needlessly.
	wr "$ZRAM/writeback_limit_enable" 1
	wr "$ZRAM/writeback_limit" 65536
	# idle and writeback are WRITE-ONLY (0220). wr() reads them before writing
	# (rdv), which on a write-only node throws "Permission denied" to stderr. We
	# therefore write directly, with the correct redirection order (2>/dev/null
	# inside {}). Success is judged from bd_stat before/after, not from a read
	# back.
	if { print -r -- "$_age" > "$ZRAM/idle"; } 2>/dev/null; then
		WR_OK=$((WR_OK + 1))
		log INFO "wr: $ZRAM/idle <- '$_age' (write-only, no read back)"
	else
		WR_FAIL=$((WR_FAIL + 1))
		log ERROR "wr: the write into $ZRAM/idle failed (age $_age)"
	fi
	if { print -r -- idle > "$ZRAM/writeback"; } 2>/dev/null; then
		WR_OK=$((WR_OK + 1))
		log INFO "wr: $ZRAM/writeback <- 'idle' (write-only, no read back)"
	else
		WR_FAIL=$((WR_FAIL + 1))
		log ERROR "wr: the write into $ZRAM/writeback failed"
	fi

	_bd_after=$(rd_def "$ZRAM/bd_stat" "n/a")
	log INFO "=== zram writeback done (ok=$WR_OK errors=$WR_FAIL) === bd_stat after: $_bd_after"

	msg "zram writeback: pages idle for >= ${_age}s were marked and written to the backing device."
	msg "  cap for this run : 65536 pages (~256 MiB)"
	msg "  bd_stat before   : $_bd_before"
	msg "  bd_stat after    : $_bd_after"
	msg "  (bd_stat = 'bd_count bd_reads bd_writes' in 4KiB pages)"
	[ "$WR_FAIL" -gt 0 ] && return 2
	return 0
}

cmd_zram() {
	case "${1:-}" in
		writeback)
			shift
			zram_writeback "$@"
			;;
		""|*)
			warn "pxtune: usage: pxtune zram writeback [seconds]   (the default is 3600 = 1 h)"
			exit 1
			;;
	esac
}

# ---------------------------------------------------------------------------
# dexopt - a wrapper around `pm compile -m speed -f <pkg>`
#
# Recompiles a package to full AOT (speed), which speeds up execution at the cost
# of space and a one-off burst of CPU/heat. `pm` is a BINDER client -> always with
# a timeout and only once the framework is up. NEVER call it from the daemon
# (a blocking, forking binder call).
# ---------------------------------------------------------------------------
cmd_dexopt() {
	_pkg="${1:-}"
	case "$_pkg" in
		''|*[!A-Za-z0-9._]*)
			warn "pxtune: dexopt wants a valid package name, not '${_pkg}'"
			warn "        usage: pxtune dexopt <package>"
			exit 1
			;;
	esac
	if ! command -v pm >/dev/null 2>&1; then
		warn "pxtune: the 'pm' command is not available"
		return 2
	fi
	if ! framework_ok; then
		warn "pxtune: the framework is not up yet (pm is binder) - try later"
		log ERROR "dexopt $_pkg: the framework is unavailable"
		return 2
	fi

	log INFO "dexopt: pm compile -m speed -f $_pkg"
	if command -v timeout >/dev/null 2>&1; then
		_out=$(timeout 600 pm compile -m speed -f "$_pkg" 2>&1)
	else
		_out=$(pm compile -m speed -f "$_pkg" 2>&1)
	fi
	_rc=$?
	[ -n "$_out" ] && msg "$_out"
	log INFO "dexopt $_pkg -> rc=$_rc: $_out"
	if [ "$_rc" -ne 0 ]; then
		warn "pxtune: pm compile exited with code $_rc"
		return 2
	fi
	return 0
}

# ---------------------------------------------------------------------------
# thermal - explains the current skin state against the VIRTUAL-SKIN thresholds
#
# A HOT PATH (the WebUI may call it): accumulate into a variable, print with a
# SINGLE print, no printf/mc_to_c (forks). The thresholds come from
# SPEC/probe-analysis (mC):
#   LIGHT-ODPM 37/39 | CPU-MID 39/41 | CPU-HIGH 41/43/52 | GPU 43/45/46.5/52
#   hysteresis 1.9 C (HotHysteresis)
# ---------------------------------------------------------------------------
thermal_explain() {
	skin_mc_v
	if ! is_int "$V"; then
		warn "pxtune: the skin (quiet_therm) could not be read"
		return 2
	fi
	_sk="$V"
	# the skin is positive => a fork-free conversion to °C with one decimal place
	_skc="$((_sk / 1000)).$(( (_sk % 1000) / 100 ))"

	# the nearest threshold ABOVE the current skin
	_next=""
	for _t in 37000 39000 41000 43000 45000 46500 52000; do
		if [ "$_t" -gt "$_sk" ]; then _next="$_t"; break; fi
	done

	_o="=== pxtune thermal explain ==="
	_o="$_o
skin (quiet_therm): $_skc C   (this decides the throttling, not the junction)"

	if [ -z "$_next" ]; then
		_o="$_o
The skin is above the highest threshold of 52.0 C - both CPU-HIGH and GPU are throttling CRITICALLY."
		print -r -- "$_o"
		return 0
	fi

	# how many °C remain to the next threshold
	_d=$((_next - _sk))
	_dc="$((_d / 1000)).$(( (_d % 1000) / 100 ))"
	_nc="$((_next / 1000)).$(( (_next % 1000) / 100 ))"

	case "$_next" in
		37000) _lbl="VIRTUAL-SKIN-CPU-LIGHT-ODPM (1st step)"; _cool="CPU cooling (thermal-cpufreq-0/1/2)" ;;
		39000) _lbl="VIRTUAL-SKIN-CPU-MID (1) + LIGHT-ODPM (2)"; _cool="CPU cooling (thermal-cpufreq-0/1/2)" ;;
		41000) _lbl="VIRTUAL-SKIN-CPU-MID (2) + CPU-HIGH (1)"; _cool="CPU cooling, a tighter cap (thermal-cpufreq-0/1/2)" ;;
		43000) _lbl="VIRTUAL-SKIN-CPU-HIGH (2) + GPU (1)"; _cool="CPU (thermal-cpufreq-0/1/2) + GPU (thermal-gpufreq-0)" ;;
		45000) _lbl="VIRTUAL-SKIN-GPU (2)"; _cool="GPU cooling (thermal-gpufreq-0)" ;;
		46500) _lbl="VIRTUAL-SKIN-GPU (3)"; _cool="GPU cooling (thermal-gpufreq-0)" ;;
		52000) _lbl="VIRTUAL-SKIN-CPU-HIGH (3) + GPU (4)"; _cool="CPU + GPU, CRITICAL throttling" ;;
	esac

	_o="$_o
next threshold    : $_nc C  ($_dc C to go)
  triggers sensor : $_lbl
  will throttle   : $_cool
hysteresis        : 1.9 C (throttling is released only ~1.9 C below the threshold)"
	print -r -- "$_o"
	return 0
}

cmd_thermal() {
	case "${1:-}" in
		explain) thermal_explain ;;
		""|*)
			warn "pxtune: usage: pxtune thermal explain"
			exit 1
			;;
	esac
}

# ---------------------------------------------------------------------------
# auto - the adaptive daemon switch (INDEPENDENT of manual_override)
# ---------------------------------------------------------------------------
cmd_auto() {
	case "$1" in
		on)
			printf 'on\n' > "$AUTO_FILE" 2>/dev/null
			log INFO "auto enabled"
			# The file alone does not start the daemon - it has to be launched.
			if [ -x "$AUTOD" ]; then
				"$AUTOD" start >/dev/null 2>&1 \
					&& msg "Adaptive daemon: ENABLED (daemon started)" \
					|| msg "Adaptive daemon: ENABLED (the daemon could not be started, see the log)"
			else
				msg "Adaptive daemon: ENABLED (the daemon $AUTOD was not found)"
			fi
			;;
		off)
			printf 'off\n' > "$AUTO_FILE" 2>/dev/null
			log INFO "auto disabled"
			if [ -x "$AUTOD" ]; then
				"$AUTOD" stop >/dev/null 2>&1
			fi
			msg "Adaptive daemon: DISABLED"
			;;
		""|status)
			msg "auto            : $(auto_state)"
			if [ -x "$AUTOD" ]; then
				_apid=$(rd "$AUTOD_PID" 2>/dev/null | tr -dc '0-9')
				if [ -n "$_apid" ] && [ -d "/proc/$_apid" ]; then
					msg "daemon          : running (pid $_apid)"
				else
					msg "daemon          : not running"
				fi
			fi
			if [ -f "$OVERRIDE_FILE" ]; then
				msg "manual_override : YES (the user pinned the profile by hand)"
			else
				msg "manual_override : no"
			fi
			msg "active profile  : $(active_profile)"
			;;
		*)
			warn "pxtune: usage: pxtune auto <on|off|status>"
			exit 1
			;;
	esac
	return 0
}

# ---------------------------------------------------------------------------
# log
# ---------------------------------------------------------------------------
cmd_log() {
	_n=50
	if [ "$1" = "-n" ]; then
		shift
		is_int "$1" || { warn "pxtune: -n wants a whole number"; exit 1; }
		_n="$1"
	elif [ -n "$1" ]; then
		warn "pxtune: usage: pxtune log [-n N]"
		exit 1
	fi
	if [ ! -f "$LOG_FILE" ]; then
		warn "pxtune: the log does not exist: $LOG_FILE"
		return 2
	fi
	tail -n "$_n" "$LOG_FILE"
	return 0
}

# ---------------------------------------------------------------------------
# status - the shared reads
# ---------------------------------------------------------------------------
# zram_stat -> "orig compr mem_used"
zram_stat() {
	_mm=$(rd "$ZRAM/mm_stat") || _mm=""
	[ -n "$_mm" ] || return 1
	# shellcheck disable=SC2086
	set -- $_mm
	printf '%s %s %s' "${1:-}" "${2:-}" "${3:-}"
}

# policy_cap_khz <cdev_id> <frequency list> -> the current thermal cap in kHz
policy_cap_khz() {
	_cs=$(rd_def "$THERMAL/cooling_device$1/cur_state" "")
	# shellcheck disable=SC2086
	cdev_cap_khz "$_cs" $2
}

status_text() {
	msg "=== pxtune $PXTUNE_VERSION ==="
	msg "profile         : $(active_profile)"
	if [ -f "$OVERRIDE_FILE" ]; then msg "manual_override : YES"; else msg "manual_override : no"; fi
	msg "auto            : $(auto_state)"
	[ -f "$DISABLE_FILE" ] && msg "DISABLE         : YES (the module is off)"
	[ -f "$RESPEND_FILE" ] && msg "res_pending     : YES ($(res_pending_seconds) s left)"
	msg ""

	msg "--- Temperatures (kernel sysfs zones) ---"
	for _z in $THERMAL_ZONES; do
		_zn=${_z%%:*}
		_zi=${_z##*:}
		_t=$(rd_def "$THERMAL/thermal_zone$_zi/temp" "")
		if is_snum "$_t"; then
			printf '  %-10s (zone%-2s) %6s C\n' "$_zn" "$_zi" "$(mc_to_c "$_t")"
		else
			printf '  %-10s (zone%-2s) %6s\n' "$_zn" "$_zi" "n/a"
		fi
	done
	msg "  VIRTUAL-SKIN*: skipped (dumpsys thermalservice hangs on binder under su)"
	msg ""

	msg "--- CPU (the sched_pixel governor; scaling_max_freq is 0444 = read-only) ---"
	status_cpu_line policy0 "Little 4xA510" "$FREQ_P0" "$CDEV_P0"
	status_cpu_line policy4 "Big 4xA715"    "$FREQ_P4" "$CDEV_P4"
	status_cpu_line policy8 "Prime 1xX3"    "$FREQ_P8" "$CDEV_P8"
	msg ""

	msg "--- Cooling devices (controlled by the thermal HAL, we only read) ---"
	status_cdev_line "$CDEV_P0"  "thermal-cpufreq-0" policy0 "$FREQ_P0"
	status_cdev_line "$CDEV_P4"  "thermal-cpufreq-1" policy4 "$FREQ_P4"
	status_cdev_line "$CDEV_P8"  "thermal-cpufreq-2" policy8 "$FREQ_P8"
	status_cdev_line "$CDEV_GPU" "thermal-gpufreq-0" GPU     "$GPU_FREQS_ASC"
	msg ""

	msg "--- GPU Mali ---"
	printf '  cur_freq        %s kHz\n'  "$(rd_def "$MALI/cur_freq" "n/a")"
	printf '  scaling_max     %s kHz\n'  "$(rd_def "$MALI/scaling_max_freq" "n/a")"
	printf '  scaling_min     %s kHz\n'  "$(rd_def "$MALI/scaling_min_freq" "n/a")"
	printf '  hint_max        %s kHz\n'  "$(rd_def "$MALI/hint_max_freq" "n/a")"
	printf '  power_policy    %s\n'      "$(bracket "$(rd_def "$MALI/power_policy" "n/a")")"
	printf '  utilization     %s\n'      "$(rd_def "$MALI/utilization" "n/a")"
	msg ""

	msg "--- uclamp (/dev/cpuctl) ---"
	for _g in $UCLAMP_GROUPS; do
		printf '  %-18s min=%-7s max=%s\n' "$_g" \
			"$(rd_def "$CPUCTL/$_g/cpu.uclamp.min" "n/a")" \
			"$(rd_def "$CPUCTL/$_g/cpu.uclamp.max" "n/a")"
	done
	printf '  %-18s %s (stock 1024, NESAHAT)\n' "sched_util_clamp_min" \
		"$(rd_def /proc/sys/kernel/sched_util_clamp_min "n/a")"
	msg ""

	msg "--- Thermal HAL profiles (setprop) ---"
	printf '  %-24s %s\n' "$THERMAL_SENSOR_MID"  "$(getprop "vendor.thermal.$THERMAL_SENSOR_MID.profile" 2>/dev/null)"
	printf '  %-24s %s\n' "$THERMAL_SENSOR_HIGH" "$(getprop "vendor.thermal.$THERMAL_SENSOR_HIGH.profile" 2>/dev/null)"
	msg ""

	msg "--- Memory ---"
	_dsz=$(rd_def "$ZRAM/disksize" "")
	if is_int "$_dsz"; then
		# hundredths of a GiB (3969961984 B = 3.70 GiB = 3.97 GB).
		# MIND mksh's 32-bit arithmetic: _dsz * 100 overflows already at the stock
		# zram size. That is why we divide down to MiB first.
		_gh=$(( ( (_dsz / 1048576) * 100 + 512 ) / 1024 ))
		printf '  zram disksize   %s B (%s MiB / %s.%02d GiB)\n' \
			"$_dsz" $((_dsz / 1048576)) $((_gh / 100)) $((_gh % 100))
	else
		printf '  zram disksize   n/a\n'
	fi
	printf '  zram algorithm  %s (HW Emerald Hill - DO NOT CHANGE)\n' "$(bracket "$(rd_def "$ZRAM/comp_algorithm" "n/a")")"
	if _zs=$(zram_stat); then
		# shellcheck disable=SC2086
		set -- $_zs
		printf '  zram data       orig=%s B compr=%s B mem_used=%s B\n' "$1" "$2" "$3"
	fi
	printf '  swappiness      %s\n' "$(rd_def /proc/sys/vm/swappiness "n/a")"
	printf '  dirty_ratio     %s / bg %s\n' "$(rd_def /proc/sys/vm/dirty_ratio "n/a")" "$(rd_def /proc/sys/vm/dirty_background_ratio "n/a")"
	printf '  vfs_cache_press %s\n' "$(rd_def /proc/sys/vm/vfs_cache_pressure "n/a")"
	printf '  page-cluster    %s\n' "$(rd_def /proc/sys/vm/page-cluster "n/a")"
	msg ""

	msg "--- Battery / charging ---"
	printf '  capacity        %s %%\n' "$(rd_def "$BATT/capacity" "n/a")"
	printf '  status          %s\n'    "$(rd_def "$BATT/status" "n/a")"
	_bt=$(rd_def "$BATT/temp" "")
	if is_snum "$_bt"; then
		printf '  temp            %s C\n' "$(mc_to_c "$((_bt * 100))")"
	else
		printf '  temp            n/a\n'
	fi
	printf '  cycle_count     %s\n'    "$(rd_def "$BATT/cycle_count" "n/a")"
	printf '  current_now     %s uA\n' "$(rd_def "$BATT/current_now" "n/a")"
	printf '  stop_level      %s\n'    "$(rd_def "$CHARGER/charge_stop_level" "n/a")"
	printf '  start_level     %s\n'    "$(rd_def "$CHARGER/charge_start_level" "n/a")"
	msg ""

	msg "--- Display ---"
	res_current
	return 0
}

status_cpu_line() {
	_p="$1"; _lbl="$2"; _list="$3"; _cd="$4"
	_cap=$(policy_cap_khz "$_cd" "$_list") || _cap="n/a"
	printf '  %-8s %-14s cur=%-9s cap=%-9s hw_max=%s kHz\n' \
		"$_p" "$_lbl" "$(rd_def "$CPUFREQ/$_p/scaling_cur_freq" "n/a")" "$_cap" "$(last_of "$_list")"
}

status_cdev_line() {
	_id="$1"; _typ="$2"; _who="$3"; _list="$4"
	_d="$THERMAL/cooling_device$_id"
	_cs=$(rd_def "$_d/cur_state" "")
	_ms=$(rd_def "$_d/max_state" "")
	_cap="n/a"
	# shellcheck disable=SC2086
	if is_int "$_cs" && _capk=$(cdev_cap_khz "$_cs" $_list); then
		_cap="$(khz_to_mhz "$_capk") MHz"
	fi
	printf '  cd%-3s %-18s %-8s cur_state=%-3s max_state=%-3s cap=%s\n' \
		"$_id" "$_typ" "$_who" "${_cs:-n/a}" "${_ms:-n/a}" "$_cap"
}

# ---------------------------------------------------------------------------
# status --json
#
# A BINDING CONTRACT for the WebUI. It reads sysfs + the state files in
# $STATE_DIR EXCLUSIVELY. No dumpsys, no cmd, no settings -> no binder, it cannot
# hang.
# Units: thermal.* = °C (decimal), cpu/gpu = kHz, mem.zram_* = bytes,
#        battery.temp = °C.
# ---------------------------------------------------------------------------
# ----- fork-free helpers for status --json ---------------------------------
# PERFORMANCE: the original emitter made ~120 subshells ($(...) = a fork). On a
# phone that happens to be thermally throttled, one run cost 10-25 s and the
# synchronous WebUI bridge then looked frozen. These helpers read with the read
# builtin into the global variable V - zero forks (the exception: /proc/sys/*
# needs head, see the comment in rd()).

# rdv <path> <default> -> V
rdv() {
	V="$2"
	[ -f "$1" ] && [ -r "$1" ] || return 0
	case "$1" in
		/proc/sys/*) V=$(head -n1 "$1" 2>/dev/null) || V="$2" ;;
		*)           IFS= read -r V < "$1" 2>/dev/null || V="$2" ;;
	esac
	[ -n "$V" ] || V="$2"
}

# nv - normalise V into a JSON number (invalid/empty -> null)
nv() {
	case "$V" in
		''|*[!0-9.-]*) V=null ;;
		-|.|*-*-*) V=null ;;
	esac
}

# tempv <path> -> V as °C with one decimal place, or null
tempv() {
	rdv "$1" ""
	case "$V" in
		''|*[!0-9-]*) V=null; return 0 ;;
	esac
	if [ "$V" -lt 0 ]; then
		V="-$(( (0 - V) / 1000 )).$(( ((0 - V) % 1000) / 100 ))"
	else
		V="$(( V / 1000 )).$(( (V % 1000) / 100 ))"
	fi
}

# capv <cdev_id> <freq list ascending> -> V = the effective cap in kHz, or null
# (cur_state = N => index pocet-1-N ve vzestupnem seznamu; overeno na zarizeni
# na trech nezavislych bodech: 8/9->610000, 10/14->910000, 12/14->1164000)
capv() {
	rdv "$THERMAL/cooling_device$1/cur_state" ""
	case "$V" in ''|*[!0-9]*) V=null; return 0 ;; esac
	_cs="$V"
	# shellcheck disable=SC2086
	set -- $2
	_i=$(( $# - _cs ))
	if [ "$_i" -lt 1 ] || [ "$_i" -gt $# ]; then V=null; return 0; fi
	shift $(( _i - 1 ))
	V="$1"
}

json_policy() {
	# json_policy <policy> <seznam frekvenci> <cdev_id> - pripoji do $J
	_jp="$1"; _jl="$2"; _jc="$3"
	# shellcheck disable=SC2086
	set -- $_jl
	_jhw=""
	while [ $# -gt 0 ]; do _jhw="$1"; shift; done
	rdv "$THERMAL/cooling_device$_jc/cur_state" ""; nv; _jcs="$V"
	rdv "$CPUFREQ/$_jp/scaling_cur_freq" ""; nv; _jcur="$V"
	capv "$_jc" "$_jl"
	if [ "$V" = "null" ]; then rdv "$CPUFREQ/$_jp/scaling_max_freq" ""; nv; fi
	J="$J\"$_jp\":{\"cur\":$_jcur,\"max\":$V,\"hw_max\":$_jhw,\"cdev_cur_state\":$_jcs}"
}

# bracketv - normalizuj V z tvaru "a [b] c" na "b" (bez forku)
bracketv() {
	case "$V" in
		*\[*\]*)
			V="${V#*\[}"
			V="${V%%\]*}"
			;;
	esac
}

# strv <path> - reads V and wraps it in a JSON string (a fast path without sed;
# sed runs only when the value contains something that needs escaping)
strv() {
	rdv "$1" ""
	case "$V" in
		*[!A-Za-z0-9\ _.,:/%+-]*) V="\"$(json_esc "$V")\"" ;;
		*)                        V="\"$V\"" ;;
	esac
}

# status_json - A BINDING CONTRACT for the WebUI.
#
# PERFORMANCE: this function is called from the WebUI every ~5 s over a
# synchronous ksu.exec. The original version had 29 substitutions (many nested,
# i.e. ~50 forks) and on a thermally throttled phone (Little at 610 MHz out of
# 1704) it took over 9 s - the WebView froze on it and the user reported it as
# "the module is stuck". That is why it is written entirely with the helpers
# rdv/nv/tempv/capv/bracketv/strv, which read with the read builtin into the
# global V. No $(...) inside.
# If you add something here, stick to that convention.
status_json() {
	# We accumulate into a single variable and print with a SINGLE print. The
	# reason is backed by measurement: `printf` is NOT a builtin on this system, it
	# is /system/bin/printf, i.e. a fork of ~17 ms. The original version had 46
	# printf calls = ~800 ms just to print. `print` and `echo` are builtins, and
	# accumulating into a variable is free.
	J='{'

	# --- profile ---
	rdv "$ACTIVE_FILE" "unknown"
	case "$V" in *[!A-Za-z0-9_.-]*|'') V="unknown" ;; esac
	J="$J\"profile\":{\"active\":\"$V\",\"manual_override\":"
	if [ -f "$OVERRIDE_FILE" ]; then J="${J}true"; else J="${J}false"; fi
	J="$J,\"available\":["
	_first=1
	for _f in "$PROFILE_DIR"/*.conf; do
		[ -f "$_f" ] || continue
		[ "$_first" -eq 1 ] || J="$J,"
		_first=0
		_n="${_f##*/}"
		J="$J\"${_n%.conf}\""
	done
	J="$J]},"

	# --- auto (independent of manual_override) ---
	rdv "$AUTO_FILE" "on"
	case "$V" in
		off|OFF|0|false) J="$J\"auto\":{\"enabled\":false}," ;;
		*)               J="$J\"auto\":{\"enabled\":true}," ;;
	esac

	# --- thermal (°C) ---
	J="$J\"thermal\":{"
	_first=1
	for _z in $THERMAL_ZONES; do
		[ "$_first" -eq 1 ] || J="$J,"
		_first=0
		tempv "$THERMAL/thermal_zone${_z##*:}/temp"
		J="$J\"${_z%%:*}\":$V"
	done
	J="$J},"

	# --- cpu (kHz) ---
	J="$J\"cpu\":{"
	json_policy policy0 "$FREQ_P0" "$CDEV_P0"
	J="$J,"
	json_policy policy4 "$FREQ_P4" "$CDEV_P4"
	J="$J,"
	json_policy policy8 "$FREQ_P8" "$CDEV_P8"
	J="$J},"

	# --- gpu (kHz) ---
	J="$J\"gpu\":{"
	rdv "$MALI/cur_freq"         ""; nv; J="$J\"cur\":$V,"
	rdv "$MALI/scaling_max_freq" ""; nv; J="$J\"max\":$V,"
	rdv "$MALI/scaling_min_freq" ""; nv; J="$J\"min\":$V,"
	rdv "$MALI/utilization"      ""; nv; J="$J\"util\":$V,"
	rdv "$MALI/power_policy"     ""; bracketv
	J="$J\"power_policy\":\"$V\"},"

	# --- mem (bajty) ---
	J="$J\"mem\":{"
	rdv "$ZRAM/disksize" ""; nv; J="$J\"zram_disksize\":$V,"
	rdv "$ZRAM/comp_algorithm" ""; bracketv
	J="$J\"zram_algorithm\":\"$V\","
	# mm_stat: orig_data_size compr_data_size mem_used_total ...
	_zorig=null; _zused=null
	rdv "$ZRAM/mm_stat" ""
	if [ -n "$V" ]; then
		# shellcheck disable=SC2086
		set -- $V
		_zorig="${1:-null}"; _zused="${3:-null}"
		case "$_zorig" in ''|*[!0-9]*) _zorig=null ;; esac
		case "$_zused" in ''|*[!0-9]*) _zused=null ;; esac
	fi
	J="$J\"zram_used\":$_zused,\"zram_orig\":$_zorig,"
	rdv /proc/sys/vm/swappiness ""; nv
	J="$J\"swappiness\":$V},"

	# --- battery ---
	J="$J\"battery\":{"
	rdv "$BATT/capacity" ""; nv; J="$J\"capacity\":$V,"
	strv "$BATT/status";         J="$J\"status\":$V,"
	# temp je v desetinach °C (napr. 378 = 37,8 °C)
	rdv "$BATT/temp" ""
	case "$V" in
		''|*[!0-9-]*) J="$J\"temp\":null," ;;
		-*)           J="$J\"temp\":-$(( (0 - V) / 10 )).$(( (0 - V) % 10 ))," ;;
		*)            J="$J\"temp\":$(( V / 10 )).$(( V % 10 ))," ;;
	esac
	rdv "$BATT/cycle_count" ""; nv;          J="$J\"cycle_count\":$V,"
	rdv "$CHARGER/charge_stop_level" ""; nv; J="$J\"charge_stop_level\":$V,"
	rdv "$CHARGER/charge_start_level" ""; nv
	J="$J\"charge_start_level\":$V},"

	# --- display (from the cache, no binder) ---
	_dw="$NATIVE_W"; _dh="$NATIVE_H"; _dd="$NATIVE_DPI"
	rdv "$DISPSTATE_FILE" ""
	if [ -n "$V" ]; then
		# shellcheck disable=SC2086
		set -- $V
		[ -n "${1:-}" ] && _dw="$1"
		[ -n "${2:-}" ] && _dh="$2"
		[ -n "${3:-}" ] && _dd="$3"
	fi
	J="$J\"display\":{\"width\":$_dw,\"height\":$_dh,\"density\":$_dd,\"presets\":["
	_first=1
	for _p in $RES_PRESETS; do
		[ "$_first" -eq 1 ] || J="$J,"
		_first=0
		J="$J\"${_p%%:*}\""
	done
	J="$J],\"res_pending\":"
	if [ -f "$RESPEND_FILE" ]; then J="${J}true"; else J="${J}false"; fi
	J="$J,\"res_pending_seconds\":$(res_pending_seconds)}"

	# --- per-app (layer 3) - EXCLUSIVELY from files, no binder --------------
	# appmode.active has a single line:
	#   <pkg>|<epoch>|<old_min_refresh>|<old_peak_refresh>|<old_size>|<old_density>
	# The sentinels: "-" = it was not set (restore = delete), "=" = we did not
	# touch it.
	# Parsed with ${x%%|*} / ${x#*|} = zero forks (the rdv/nv/bracketv convention).
	_apkg=""; _at=null; _armin="="; _arpk="="; _asz="="; _ade="="
	rdv "$APPMODE" ""
	if [ -n "$V" ]; then
		_al="$V"
		_apkg="${_al%%|*}"; _al="${_al#*|}"
		_at="${_al%%|*}";   _al="${_al#*|}"
		_armin="${_al%%|*}"; _al="${_al#*|}"
		_arpk="${_al%%|*}";  _al="${_al#*|}"
		_asz="${_al%%|*}"
		_ade="${_al#*|}"
		# the package name must contain a dot - otherwise a corrupted line (a single
		# word without "|") would pass as a valid package and the WebUI would report
		# somebody else's state
		case "$_apkg" in ''|*[!A-Za-z0-9._]*) _apkg="" ;; esac
		case "$_apkg" in *.*) ;; *) _apkg="" ;; esac
		case "$_at" in ''|*[!0-9]*) _at=null ;; esac
	fi
	J="$J,\"app\":{"
	if [ -n "$_apkg" ]; then
		J="$J\"active\":\"$_apkg\",\"since\":$_at,"
		J="$J\"saved\":{\"refresh_min\":\"$_armin\",\"refresh_peak\":\"$_arpk\",\"display_size\":\"$_asz\",\"density\":\"$_ade\"},"
	else
		J="$J\"active\":null,\"since\":null,\"saved\":null,"
	fi
	J="$J\"rules\":["
	_first=1
	for _f in "$APPDIR"/*.conf; do
		[ -f "$_f" ] || continue
		_n="${_f##*/}"
		_n="${_n%.conf}"
		case "$_n" in ''|*[!A-Za-z0-9._-]*) continue ;; esac
		[ "$_first" -eq 1 ] || J="$J,"
		_first=0
		J="$J\"$_n\""
	done
	J="$J]}"

	print -r -- "$J}"
}
cmd_status() {
	case "$1" in
		"")     status_text ;;
		--json) status_json ;;
		*)      warn "pxtune: usage: pxtune status [--json]"; exit 1 ;;
	esac
}

# ---------------------------------------------------------------------------
# selftest
# ---------------------------------------------------------------------------
st_row() {
	# st_row <path> <note> [opt]   - "opt" = a missing item is not an error
	# Its own _st* prefix, because it is called inside other loops (e.g. for _p in ...).
	_stp="$1"; _stn="$2"; _sto="$3"
	if [ -e "$_stp" ]; then _ste="yes"; else _ste="NO"; fi
	if [ -w "$_stp" ]; then _stw="yes"; else _stw="no"; fi
	if [ -d "$_stp" ]; then
		_stv="<directory>"
	elif [ -e "$_stp" ]; then
		_stv=$(rd "$_stp" 2>/dev/null) || _stv="<unreadable>"
		[ -n "$_stv" ] || _stv="<empty>"
	else
		_stv="-"
	fi
	case "$_stv" in
		?????????????????????????????????*) _stv="$(print -rn -- "$_stv" | cut -c1-30)..." ;;
	esac
	printf '%-52s %-4s %-5s %-34s %s\n' "$_stp" "$_ste" "$_stw" "$_stv" "$_stn"
	if [ "$_ste" = "NO" ] && [ "$_sto" != "opt" ]; then
		ST_MISSING=$((ST_MISSING + 1))
	fi
	return 0
}

st_hdr() {
	printf '\n== %s ==\n' "$1"
	printf '%-52s %-4s %-5s %-34s %s\n' "PATH" "EXI" "WRT" "VALUE" "NOTE"
}

cmd_selftest() {
	ST_MISSING=0
	printf 'pxtune %s selftest - %s\n' "$PXTUNE_VERSION" "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
	printf 'uid=%s  script=%s\n' "$(id -u 2>/dev/null)" "$SELF"

	st_hdr "Module state"
	st_row "$STATE_DIR" ""
	st_row "$PROFILE_DIR" ""
	st_row "$STOCK_CONF" "$(if stock_valid; then printf 'valid'; else printf 'MISSING/CORRUPTED -> falling back to the SPEC'; fi)"
	st_row "$ACTIVE_FILE" "" opt
	st_row "$OVERRIDE_FILE" "optional: the user pinned a profile" opt
	st_row "$AUTO_FILE" "optional: on|off (missing = on)" opt
	st_row "$DISABLE_FILE" "optional: exists = the module is off" opt
	st_row "$BOOTCNT_FILE" "optional: >=3 => DISABLE" opt
	st_row "$RESPEND_FILE" "optional: waiting for 'res confirm'" opt
	st_row "$DISPSTATE_FILE" "a display cache for --json (no binder)" opt
	st_row "$LOG_FILE" "rotates above 512 kB"

	st_hdr "CPU cpufreq (scaling_max_freq is 0444 - writing is IMPOSSIBLE)"
	for _p in policy0 policy4 policy8; do
		st_row "$CPUFREQ/$_p/scaling_cur_freq" "read-only"
		st_row "$CPUFREQ/$_p/scaling_max_freq" "expected to be NON-writable"
		st_row "$CPUFREQ/$_p/scaling_governor" "sched_pixel - DO NOT CHANGE"
	done

	st_hdr "Cooling devices (owned by the thermal HAL, we only read)"
	for _c in "$CDEV_P0" "$CDEV_P4" "$CDEV_P8" "$CDEV_GPU"; do
		st_row "$THERMAL/cooling_device$_c/type" ""
		st_row "$THERMAL/cooling_device$_c/cur_state" "the HAL rewrites it every ~7 s"
		st_row "$THERMAL/cooling_device$_c/max_state" ""
	done

	st_hdr "uclamp cgroups (THE MAIN LEVER)"
	for _g in $UCLAMP_GROUPS; do
		st_row "$CPUCTL/$_g/cpu.uclamp.min" ""
		st_row "$CPUCTL/$_g/cpu.uclamp.max" ""
	done
	st_row "/proc/sys/kernel/sched_util_clamp_min" "stock 1024 - DO NOT TOUCH"

	st_hdr "GPU Mali"
	st_row "$MALI/scaling_max_freq" "a safe lever, it holds"
	st_row "$MALI/scaling_min_freq" ""
	st_row "$MALI/hint_max_freq" ""
	st_row "$MALI/power_policy" "coarse_demand|adaptive|always_on"
	st_row "$MALI/cur_freq" ""
	st_row "$MALI/utilization" ""

	st_hdr "Thermal zones"
	for _z in $THERMAL_ZONES; do
		st_row "$THERMAL/thermal_zone${_z##*:}/temp" "${_z%%:*}"
	done
	st_row "/dev/thermal/tz-by-name/quiet_therm/temp" "the skin for 'thermal explain' (a stable symlink)" opt
	printf '%-52s %-4s %-5s %-34s %s\n' "dumpsys thermalservice" "-" "-" "-" \
		"NOT USED (it hangs on binder under su)"

	st_hdr "Charging and battery"
	st_row "$CHARGER/charge_stop_level" "root CAN write it"
	st_row "$CHARGER/charge_start_level" ""
	st_row "$CHARGER/bd_trigger_temp" ""
	st_row "$CHARGER/bd_trigger_time" ""
	st_row "$CHARGER/bd_recharge_soc" ""
	st_row "$CHARGER/bd_temp_enable" ""
	st_row "$BATT/capacity" ""
	st_row "$BATT/status" ""
	st_row "$BATT/temp" "tenths of a degree C"
	st_row "$BATT/cycle_count" ""
	st_row "$BATT/current_now" ""

	st_hdr "Memory"
	st_row "$ZRAM/disksize" "change only in post-fs-data.sh"
	st_row "$ZRAM/comp_algorithm" "lz77eh (HW Emerald Hill) - DO NOT CHANGE"
	st_row "$ZRAM/mm_stat" ""
	st_row "$ZRAM/idle" "zram writeback: marking idle pages (write-only)" opt
	st_row "$ZRAM/writeback" "zram writeback: triggering it (write-only)" opt
	st_row "$ZRAM/writeback_limit" "zram writeback: the cap in pages" opt
	st_row "$ZRAM/writeback_limit_enable" "zram writeback: 1 = the cap is active" opt
	st_row "$ZRAM/bd_stat" "zram writeback: backing device statistics" opt
	st_row "/proc/sys/vm/swappiness" ""
	st_row "/proc/sys/vm/dirty_ratio" ""
	st_row "/proc/sys/vm/dirty_background_ratio" ""
	st_row "/proc/sys/vm/vfs_cache_pressure" ""
	st_row "/proc/sys/vm/page-cluster" "0 = optimal for zram"

	st_hdr "I/O"
	for _d in $IO_DEVS; do
		st_row "/sys/block/$_d/queue/read_ahead_kb" ""
	done

	st_hdr "External commands"
	for _b in settings cmd pm getprop setprop id date tail sed tr wc cut basename nohup sleep; do
		if command -v "$_b" >/dev/null 2>&1; then
			_s="yes"
		else
			_s="NO"
			ST_MISSING=$((ST_MISSING + 1))
		fi
		printf '%-52s %-4s\n' "$_b" "$_s"
	done

	st_hdr "JSON contract check"
	if status_json > /dev/null 2>&1; then
		printf '%-52s %s\n' "status --json" "generated without error"
	else
		printf '%-52s %s\n' "status --json" "FAILED"
		ST_MISSING=$((ST_MISSING + 1))
	fi

	printf '\nMissing/unavailable items: %s\n' "$ST_MISSING"
	log INFO "selftest: missing items = $ST_MISSING"
	[ "$ST_MISSING" -gt 0 ] && return 2
	return 0
}

# ---------------------------------------------------------------------------
# usage
# ---------------------------------------------------------------------------
usage() {
	cat <<EOF
pxtune $PXTUNE_VERSION - a kernel manager for the Pixel 8a (Tensor G3)

  pxtune status [--json]        state: profile, temperatures, frequencies, uclamp, zram, charging
                                --json reads sysfs EXCLUSIVELY (no binder)
  pxtune profile list           list the profiles
  pxtune profile current        the name of the active profile
  pxtune profile <name>         switch profile (sets manual_override)
  pxtune profile <name> --auto  switch profile without touching manual_override (for the daemon)
  pxtune profile auto           clear manual_override, hand control back to the daemon
  pxtune reapply [--overlay P]  restore the nodes the power HAL overwrote (dvfs_headroom,
                                sched_pixel limit_frequency); the daemon calls it on screen wake
  pxtune revert                 restore EVERYTHING to stock from backup/stock.conf
  pxtune res <preset|confirm|reset|list>
                                presets: $(res_preset_names)
  pxtune charge <1-100|off>     charge_stop_level (off = 100)
  pxtune game <package> [mode]  a wrapper around 'cmd game'
  pxtune zram writeback [sec]   push idle zram pages out to disk (default 3600 s)
  pxtune dexopt <package>       pm compile -m speed -f <pkg> (full AOT compilation)
  pxtune thermal explain        skin vs. the VIRTUAL-SKIN thresholds (what happens when crossed)
  pxtune app <list|show|set|rm|sync|json>
                                per-app profiles (bin/pxtune-perapp)
                                'app enter <pkg>' / 'app leave' are INTERNAL (the daemon)
  pxtune auto <on|off|status>   the adaptive daemon (independent of manual_override)
  pxtune log [-n N]             print the log (default 50 lines)
  pxtune selftest               verify all the paths from the SPEC

State: $STATE_DIR
Log  : $LOG_FILE
Exit : 0 = OK, 1 = argument error, 2 = runtime error
EOF
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------
main() {
	# "status --json" runs under the WebUI's root shell every 5 s -> no binder.
	if [ "$1" = "status" ] && [ "$2" = "--json" ]; then
		FRAMEWORK_OK=0
	fi
	# The WebUI calls `tweak json` when the tab is opened. The registry has 7
	# tweaks with the `settings` mechanism, which are BINDER calls - each with up
	# to a 10 s timeout. Measured: `tweak json` took 25 s and the WebUI froze
	# because of it. Binder is therefore ALWAYS disabled here, including for
	# --live; items with mech=settings then report the stored value instead of the
	# live one.
	if [ "$1" = "tweak" ] && [ "$2" = "json" ]; then
		FRAMEWORK_OK=0
	fi
	# the same for `app json`
	if [ "$1" = "app" ] && [ "$2" = "json" ]; then
		FRAMEWORK_OK=0
	fi

	ensure_dirs

	# the "native" density = the user's stock override (353), not the HW 420
	NATIVE_DPI=$(native_dpi)

	# internal: the resolution watchdog (runs in the background)
	if [ "$1" = "__dpi_watchdog" ]; then
		shift
		dpi_watchdog "$1" "$2"
		exit 0
	fi
	if [ "$1" = "__res_watchdog" ]; then
		shift
		res_watchdog "$1"
		exit 0
	fi

	# Per-app profiles live in a separate script (bin/pxtune-perapp) and are
	# delegated IMMEDIATELY, before snapshot_stock/seed_profiles.
	# The reason for branching this early: "app enter"/"app leave" are called by
	# the daemon on every foreground change and "app json" is called by the WebUI
	# in a polling loop - neither the snapshot nor seeding profiles is needed for
	# that, and both cost extra forks.
	# exec rather than a call: it saves one fork and the exit code bubbles up
	# directly.
	if [ "$1" = "app" ]; then
		shift
		if [ -x "$PERAPP" ]; then
			exec "$PERAPP" "$@"
		fi
		if [ -f "$PERAPP" ]; then
			# the module unpacked without the x permission (some managers do that)
			exec /system/bin/sh "$PERAPP" "$@"
		fi
		warn "pxtune: bin/pxtune-perapp not found ($PERAPP)"
		log ERROR "app: $PERAPP does not exist"
		exit 2
	fi

	snapshot_stock
	seed_profiles

	_cmd="$1"
	[ "$#" -ge 1 ] && shift

	case "$_cmd" in
		status)            cmd_status "$@" ;;
		profile)           cmd_profile "$@" ;;
		reapply)           cmd_reapply "$@" ;;
		revert)            cmd_revert ;;
		res)               cmd_res "$@" ;;
		dpi)               cmd_dpi "$@" ;;
		charge)            cmd_charge "$@" ;;
		game)              cmd_game "$@" ;;
		zram)              cmd_zram "$@" ;;
		dexopt)            cmd_dexopt "$@" ;;
		thermal)           cmd_thermal "$@" ;;
		auto)              cmd_auto "$@" ;;
		# per-app profiles and tweaks live in separate scripts.
		# exec rather than a call: it saves one fork and the exit code bubbles up
		# directly.
		metrics)
			_pm="$(dirname "$0")/pxtune-metrics"
			[ -x "$_pm" ] || _pm=/data/adb/modules/pixel_tune/bin/pxtune-metrics
			if [ -x "$_pm" ]; then
				exec "$_pm" "$@"
			fi
			warn "pxtune: bin/pxtune-metrics not found"
			exit 2
			;;
		app)
			_pa="$(dirname "$0")/pxtune-perapp"
			[ -x "$_pa" ] || _pa=/data/adb/modules/pixel_tune/bin/pxtune-perapp
			if [ -x "$_pa" ]; then
				exec "$_pa" "$@"
			fi
			warn "pxtune: bin/pxtune-perapp not found"
			exit 2
			;;
		tweak)
			# pxtune-tweaks is NOT a standalone program, it is a library: it defines
			# cmd_tweak() and uses the wr()/rdv()/log()/warn() from here. That is why
			# it is SOURCED rather than executed. It happens LAZILY - only when the
			# user actually touches the tweaks - so that 1500 extra lines do not slow
			# down every run (parsing a script measures at ~4 ms per kB).
			_tw="$(dirname "$0")/pxtune-tweaks"
			[ -f "$_tw" ] || _tw=/data/adb/modules/pixel_tune/bin/pxtune-tweaks
			if [ ! -f "$_tw" ]; then
				warn "pxtune: bin/pxtune-tweaks not found"
				exit 2
			fi
			SELF="$0"
			# shellcheck disable=SC1090
			. "$_tw"
			cmd_tweak "$@"
			;;
		log)               cmd_log "$@" ;;
		selftest)          cmd_selftest ;;
		-h|--help|help|"") usage; [ -z "$_cmd" ] && exit 1; exit 0 ;;
		-v|--version)      printf 'pxtune %s\n' "$PXTUNE_VERSION" ;;
		*)                 warn "pxtune: unknown command '$_cmd'"; usage >&2; exit 1 ;;
	esac
}

main "$@"
exit $?
