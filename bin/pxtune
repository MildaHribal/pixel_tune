# Fyzicka hustota panelu je 420, ale uzivatel ma vlastni override (353,
# ulozeny v secure display_density_forced a zachyceny ve stock.conf).
# "Navrat na nativni" proto musi vratit UZIVATELOVU hustotu, ne 420 -
# jinak by kazdy res reset (i 60s pojistka) skokove zvetsil cele UI.
# native_dpi() cte stock.conf, fallback 420 kdyz zaloha neexistuje.
NATIVE_DPI_HW=420
native_dpi() {
	stock_getv STOCK_DISPLAY_DENSITY_FORCED ""; _nd="$SV"
	if is_int "$_nd" && [ "$_nd" -ge 200 ] && [ "$_nd" -le 600 ]; then
		print -rn -- "$_nd"
	else
		print -rn -- "$NATIVE_DPI_HW"
	fi
}
# Skutecna hodnota se doplni v main() az po definici stock_get/is_int
# (mksh vyhodnocuje top-down, tady jeste nejsou k dispozici).
