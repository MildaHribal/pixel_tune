#!/system/bin/sh
#
# pxtune - the CLI core of the pixel_tune kernel manager
# Google Pixel 8a "akita" / Tensor G3 "zuma" / Android 16 / KernelSU-Next
#
# POSIX sh (toybox/mksh). NO bashisms.
# Exit codes: 0 = OK, 1 = argument error, 2 = runtime error.
#
# All paths and values come from SPEC.md. Nothing here is guessed.
#
# IMPORTANT: "status --json" reads sysfs EXCLUSIVELY. No dumpsys, no cmd, no
# settings - i.e. no binder. The WebUI calls it via ksu.exec (a root shell)
# every 5 s, and dumpsys under su hangs on binder on this device.

PXTUNE_VERSION="1.3.0"

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
STATE_DIR="/data/adb/pixel_tune"
PROFILE_DIR="$STATE_DIR/profiles"
BACKUP_DIR="$STATE_DIR/backup"
STOCK_CONF="$BACKUP_DIR/stock.conf"
ACTIVE_FILE="$STATE_DIR/active"
OVERRIDE_FILE="$STATE_DIR/manual_override"
AUTO_FILE="$STATE_DIR/auto"
DISABLE_FILE="$STATE_DIR/DISABLE"
BOOTCNT_FILE="$STATE_DIR/boot_count"
RESPEND_FILE="$STATE_DIR/res_pending"
DISPSTATE_FILE="$STATE_DIR/display_state"
LOG_FILE="$STATE_DIR/pxtune.log"
LOG_MAX=524288

# The adaptive daemon (bin/pxtune-auto). The path is derived from the location
# of this script so it works even when the module is somewhere other than
# /data/adb/modules. The fallback is necessary: in PATH, pxtune is a symlink
# /data/adb/ksu/bin/pxtune, so `dirname "$0"` returns ksu/bin, where
# pxtune-auto is not. Without the fallback, `pxtune auto on|off` neither started
# nor stopped the daemon and merely reported success silently (measured
# 2026-08-11). The same pattern as for PERAPP below.
AUTOD_PID="$STATE_DIR/pxtune-auto.pid"

# Per-app profiles (bin/pxtune-perapp). The path is derived the same way as for
# AUTOD. Why it is a separate file rather than another function here: the WebUI
# calls "status --json" every 5 s over a synchronous bridge, so every extra line
# in this script costs time even when per-app profiles are not used at all.
PERAPP="$(dirname "$0")/pxtune-perapp"
[ -x "$PERAPP" ] || PERAPP="/data/adb/modules/pixel_tune/bin/pxtune-perapp"
APPDIR="$STATE_DIR/apps"
APPMODE="$STATE_DIR/appmode.active"

CPUCTL="/dev/cpuctl"
MALI="/sys/class/misc/mali0/device"
CHARGER="/sys/devices/platform/google,charger"
BATT="/sys/class/power_supply/battery"
ZRAM="/sys/block/zram0"
THERMAL="/sys/class/thermal"
CPUFREQ="/sys/devices/system/cpu/cpufreq"

# the absolute path to ourselves (for the background res watchdog)
case "$0" in
	/*) SELF="$0" ;;
	*)  SELF="$PWD/$0" ;;
esac

# ---------------------------------------------------------------------------
# Verified HW data (SPEC.md -> "VERIFIED HARDWARE FACTS")
# CPU frequencies ascending, kHz.
# ---------------------------------------------------------------------------
FREQ_P0="324000 610000 820000 955000 1098000 1197000 1328000 1425000 1548000 1704000"
FREQ_P4="402000 578000 697000 712000 910000 1065000 1221000 1328000 1418000 1572000 1836000 1945000 2130000 2245000 2367000"
FREQ_P8="500000 880000 1164000 1298000 1557000 1745000 1885000 2049000 2147000 2294000 2363000 2556000 2687000 2850000 2914000"

# GPU frequencies - the SPEC lists them descending; the ascending variant is for the cdev conversion.
GPU_FREQS_ASC="150000 302000 337000 376000 419000 467000 521000 580000 649000 723000 807000 850000 890000"

# --- Cooling device -> policy and thermal zone bindings --------------------
#
# CAUTION: the numeric cooling_deviceN and thermal_zoneN indices are NOT stable
# across reboots. Verified on the device: after a restart thermal-cpufreq-1
# moved from cooling_device10 to 9, thermal-cpufreq-2 from 12 to 11, soc_therm
# from zone11 to zone13 and battery from zone16 to zone12.
# Hard-coded indices would therefore read a COMPLETELY DIFFERENT sensor after a
# restart.
#
# The indices are therefore resolved at runtime by the `type` field. The numbers
# below are only a fallback in case the scan fails.
CDEV_P0=8
CDEV_P4=10
CDEV_P8=12
CDEV_GPU=24

THERMAL_ZONES="big:0 mid:1 little:2 g3d:3 skin:8 soc:11 charger:12 display:13 battery:16"

# resolve_thermal_ids - converts zone/cdev names into current indices.
#
# PERFORMANCE: the original version scanned all ~54 nodes via $(cat) = ~350
# forks on EVERY pxtune run. On a phone throttled to 610 MHz that took 20+ s per
# run and the WebUI looked frozen (a synchronous ksu.exec). This version reads
# the /dev/thermal/*-by-name symlinks (1 readlink per item, 13 forks in total)
# and additionally caches the result per boot in a file, so the second and every
# further run costs 1 fork (cat of the cache).
IDS_CACHE="$STATE_DIR/.thermal_ids"

# _link_idx <symlink> <prefix> - the index from a symlink target, empty on error
_link_idx() {
	_li=$(readlink "$1" 2>/dev/null) || return 1
	case "$_li" in
		*"$2"*) print -rn -- "${_li##*"$2"}"; return 0 ;;
	esac
	return 1
}

# A slow fallback in case /dev/thermal does not exist (it should not happen, the
# directory is created by vendor.thermal.symlinks on every boot).
_scan_idx() {
	for _n in "$2"*; do
		[ -r "$_n/type" ] || continue
		if [ "$(cat "$_n/type" 2>/dev/null)" = "$1" ]; then
			print -rn -- "${_n##*"$3"}"
			return 0
		fi
	done
	return 1
}

resolve_thermal_ids() {
	# 1) try the cache from this boot (btime changes across a reboot)
	#
	# CAUTION: btime alone is NOT ENOUGH. It was verified on the device that the
	# zones get renumbered even DURING a single boot - quiet_therm was on
	# thermal_zone8 at 04:06 and three hours later (the same boot, uptime
	# 11094 s) already on thermal_zone9. We therefore always verify the cache
	# with a single type read (a "sentinel"): when the zone we have stored as the
	# skin is no longer quiet_therm, we discard the cache and resolve again. That
	# costs 1 read (~0.2 ms) and protects us from silently reading a COMPLETELY
	# DIFFERENT sensor.
	_bt=$(sed -n 's/^btime //p' /proc/stat 2>/dev/null)
	if [ -f "$IDS_CACHE" ]; then
		_cl=$(head -n1 "$IDS_CACHE" 2>/dev/null)
		case "$_cl" in
			"$_bt "*)
				set -- $_cl
				# A corrupted/truncated cache must not take the script down:
				# `shift 4` on a shorter list is a fatal error in the shell. The
				# length is therefore checked first and only then is the cache used.
				# (`break` cannot be used - we are not inside a loop.)
				if [ "$#" -ge 6 ]; then
				shift   # btime
				_c0="$1"; _c4="$2"; _c8="$3"; _cg="$4"
				shift 4
				_zl="$*"
				# sentinel: find the stored skin index and verify its type
				_sidx=""
				for _p in $_zl; do
					case "$_p" in skin:*) _sidx="${_p#skin:}"; break ;; esac
				done
				if [ -n "$_sidx" ] && [ -r "/sys/class/thermal/thermal_zone$_sidx/type" ]; then
					IFS= read -r _styp < "/sys/class/thermal/thermal_zone$_sidx/type" 2>/dev/null
					if [ "$_styp" = "quiet_therm" ]; then
						CDEV_P0="$_c0"; CDEV_P4="$_c4"; CDEV_P8="$_c8"; CDEV_GPU="$_cg"
						THERMAL_ZONES="$_zl"
						return 0
					fi
				fi
				else
					# the cache is truncated -> discard it and resolve again
					rm -f "$IDS_CACHE" 2>/dev/null
				fi
				;;
		esac
	fi

	# 2) the fast path: readlink on the stable symlinks
	_t=$(_link_idx /dev/thermal/cdev-by-name/thermal-cpufreq-0 cooling_device) \
		|| _t=$(_scan_idx thermal-cpufreq-0 /sys/class/thermal/cooling_device cooling_device)
	[ -n "$_t" ] && CDEV_P0="$_t"
	_t=$(_link_idx /dev/thermal/cdev-by-name/thermal-cpufreq-1 cooling_device) \
		|| _t=$(_scan_idx thermal-cpufreq-1 /sys/class/thermal/cooling_device cooling_device)
	[ -n "$_t" ] && CDEV_P4="$_t"
	_t=$(_link_idx /dev/thermal/cdev-by-name/thermal-cpufreq-2 cooling_device) \
		|| _t=$(_scan_idx thermal-cpufreq-2 /sys/class/thermal/cooling_device cooling_device)
	[ -n "$_t" ] && CDEV_P8="$_t"
	_t=$(_link_idx /dev/thermal/cdev-by-name/thermal-gpufreq-0 cooling_device) \
		|| _t=$(_scan_idx thermal-gpufreq-0 /sys/class/thermal/cooling_device cooling_device)
	[ -n "$_t" ] && CDEV_GPU="$_t"

	# key:type  ->  key:index  (the keys match the JSON contract for the WebUI)
	_zl=""
	for _pair in big:BIG mid:MID little:LITTLE g3d:G3D skin:quiet_therm \
	             soc:soc_therm charger:charger_therm display:display_therm \
	             battery:battery; do
		_key="${_pair%%:*}"
		_typ="${_pair#*:}"
		_idx=$(_link_idx "/dev/thermal/tz-by-name/$_typ" thermal_zone) \
			|| _idx=$(_scan_idx "$_typ" /sys/class/thermal/thermal_zone thermal_zone)
		if [ -n "$_idx" ]; then
			_zl="$_zl $_key:$_idx"
		fi
	done
	# The fallback constants are used only when the scan found nothing at all.
	[ -n "$_zl" ] && THERMAL_ZONES="${_zl# }"

	# 3) store the cache for further runs during this boot
	if [ -n "$_bt" ] && [ -d "$STATE_DIR" ]; then
		{ print -r -- "$_bt $CDEV_P0 $CDEV_P4 $CDEV_P8 $CDEV_GPU $THERMAL_ZONES" > "$IDS_CACHE"; } 2>/dev/null
	fi
	return 0
}
resolve_thermal_ids

# uclamp cgroup groups
UCLAMP_GROUPS="top-app foreground background system-background camera-daemon nnapi-hal"

# The profile contract keys (SPEC.md -> "CONTRACT: profile format").
# Used by profile_apply() to zero PF_*/PFSET_* and to validate the per-app
# overlay (APP_OVERLAY_<key>), so that the list lives in ONE place.
PROFILE_KEYS="UCLAMP_TOPAPP_MIN UCLAMP_TOPAPP_MAX UCLAMP_FG_MIN UCLAMP_FG_MAX
UCLAMP_BG_MIN UCLAMP_BG_MAX UCLAMP_SYSBG_MIN UCLAMP_SYSBG_MAX
GPU_MAX_FREQ GPU_MIN_FREQ GPU_POWER_POLICY
THERMAL_PROFILE_CPU_MID THERMAL_PROFILE_CPU_HIGH THERMAL_PROFILE_MAX_SKIN
VM_SWAPPINESS VM_DIRTY_RATIO VM_DIRTY_BG_RATIO VM_VFS_CACHE_PRESSURE
IO_READAHEAD_KB CHARGE_STOP_LEVEL
VS_DVFS_HEADROOM VS_BG_UCLAMP_MAX VS_TA_UCLAMP_MIN VS_FG_UCLAMP_MIN VS_TA_PREFER_IDLE
SCHED_LIMIT_FREQ_LITTLE SCHED_LIMIT_FREQ_MID SCHED_LIMIT_FREQ_BIG
SCHED_DOWN_RATE_MID SCHED_DOWN_RATE_BIG
DEVFREQ_MIF_TARGET_LOAD DEVFREQ_MIF_MIN DEVFREQ_DSU_MIN
CPUPM_CL1_RESIDENCY CPUPM_CL2_RESIDENCY
GPU_DVFS_PERIOD MEM_LRU_MIN_TTL THERMAL_CDEV_BYPASS"

# --- CONTRACT v2: key -> node -> kind ------------------------------------
# The table for set_v2()/snapshot/revert. Token format: KEY:PATH:KIND,
# space-separated (paths contain neither a space nor a colon). KINDS:
#   int      - a whole number (is_int); for limit_frequency the kernel rounds to
#              the nearest valid OPP, and wr() does not treat that as an error
#              (it only logs it).
#   bool01   - 0 or 1 (the node converts it to false/true - verified on the device)
#   load     - a pair of whole numbers "N M" (devfreq interactive/target_load)
#   enum1020 - 10 or 20 (mali dvfs_period)
# THERMAL_CDEV_BYPASS is not in the table - it is written to THREE nodes and is
# handled separately.
#
# OWNERSHIP - RE-MEASURED 2026-08-12, revising the conclusion from 2026-08-08.
#
# The test from 08-08 launched apps while the screen was ALREADY ON and
# concluded from that that limit_frequency holds. That is true - except the
# trigger is not an app start but a DISPLAY WAKE. A snapshot of all 24 nodes
# before and after `input keyevent KEYCODE_SLEEP` + `KEYCODE_WAKEUP` (without a
# single app being touched) showed that the power HAL returns exactly these
# three to stock:
#
#   /proc/vendor_sched/dvfs_headroom                  1024    -> 1100
#   policy4/sched_pixel/limit_frequency               1418000 -> 1836000
#   policy8/sched_pixel/limit_frequency               1557000 -> 2363000
#
# Everything else (uclamp, mali scaling_max_freq, mif target_load, min_ttl_ms,
# cpupm residency, down_rate_limit_us) holds.
#
# IMPACT: until this was worked out, BOTH powersave clock caps - by the
# profile's own comment "the most effective single value" - were dead from the
# first unlock of the phone. Hence V2_VOLATILE + `pxtune reapply`, which the
# daemon calls on every screen wake.
V2_TABLE="VS_DVFS_HEADROOM:/proc/vendor_sched/dvfs_headroom:int
VS_BG_UCLAMP_MAX:/proc/vendor_sched/groups/bg/uclamp_max:int
VS_TA_UCLAMP_MIN:/proc/vendor_sched/groups/ta/uclamp_min:int
VS_FG_UCLAMP_MIN:/proc/vendor_sched/groups/fg/uclamp_min:int
VS_TA_PREFER_IDLE:/proc/vendor_sched/groups/ta/prefer_idle:bool01
SCHED_LIMIT_FREQ_LITTLE:$CPUFREQ/policy0/sched_pixel/limit_frequency:int
SCHED_LIMIT_FREQ_MID:$CPUFREQ/policy4/sched_pixel/limit_frequency:int
SCHED_LIMIT_FREQ_BIG:$CPUFREQ/policy8/sched_pixel/limit_frequency:int
SCHED_DOWN_RATE_MID:$CPUFREQ/policy4/sched_pixel/down_rate_limit_us:int
SCHED_DOWN_RATE_BIG:$CPUFREQ/policy8/sched_pixel/down_rate_limit_us:int
DEVFREQ_MIF_TARGET_LOAD:/sys/class/devfreq/17000010.devfreq_mif/interactive/target_load:load
DEVFREQ_MIF_MIN:/sys/devices/platform/17000010.devfreq_mif/devfreq/17000010.devfreq_mif/min_freq:int
DEVFREQ_DSU_MIN:/sys/devices/platform/17000090.devfreq_dsu/devfreq/17000090.devfreq_dsu/min_freq:int
CPUPM_CL1_RESIDENCY:/sys/devices/platform/cpupm/cpupm/cpd_cl1_target_residency:int
CPUPM_CL2_RESIDENCY:/sys/devices/platform/cpupm/cpupm/cpd_cl2_target_residency:int
GPU_DVFS_PERIOD:$MALI/dvfs_period:enum1020
MEM_LRU_MIN_TTL:/sys/kernel/mm/lru_gen/min_ttl_ms:int"

# The subset of V2_TABLE the power HAL takes back on every display wake (see the
# measurement in the comment above). They are rewritten by `pxtune reapply` - a
# cheap path without a revert and without the rest of the profile, so it can be
# called often.
V2_VOLATILE="VS_DVFS_HEADROOM SCHED_LIMIT_FREQ_LITTLE SCHED_LIMIT_FREQ_MID SCHED_LIMIT_FREQ_BIG"

# The measured stock values of the v2 nodes (probe 2026-08-07,
# akita:16/CP1A.260505.005). They serve as a fallback during a revert when
# stock.conf does not have these keys yet (an old snapshot from before v2). The
# same pattern as DEF_GPU_MAX and friends.
DEF_V2_VS_DVFS_HEADROOM="1100"
DEF_V2_VS_BG_UCLAMP_MAX="130"
DEF_V2_VS_TA_UCLAMP_MIN="1"
DEF_V2_VS_FG_UCLAMP_MIN="0"
DEF_V2_VS_TA_PREFER_IDLE="0"
DEF_V2_SCHED_LIMIT_FREQ_LITTLE="1328000"
DEF_V2_SCHED_LIMIT_FREQ_MID="1836000"
DEF_V2_SCHED_LIMIT_FREQ_BIG="2363000"
DEF_V2_SCHED_DOWN_RATE_MID="500"
DEF_V2_SCHED_DOWN_RATE_BIG="500"
DEF_V2_DEVFREQ_MIF_TARGET_LOAD="20 40"
DEF_V2_DEVFREQ_MIF_MIN="421000"
DEF_V2_DEVFREQ_DSU_MIN="324000"
DEF_V2_CPUPM_CL1_RESIDENCY="10000"
DEF_V2_CPUPM_CL2_RESIDENCY="10000"
