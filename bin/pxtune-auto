#!/system/bin/sh
#
# pxtune-auto - the adaptive, event-driven daemon for pixel_tune
#               Google Pixel 8a "akita" / Tensor G3 "zuma" / Android 16 / KernelSU-Next
#
# ===========================================================================
# DESIGN PRINCIPLES (see SPEC.md and the hard constraints of the brief)
# ===========================================================================
#
#  1. NO POLLING OF THE SYSTEM. No dumpsys, no binder, no `cmd`. The process
#     hangs blocked on a read() from a FIFO. When nothing happens, nothing runs.
#
#  2. NEVER PREVENT DEEP SLEEP. The single timer (the ticker) runs ONLY while
#     the screen is on and is killed the moment it goes off. The watchdog uses
#     `sleep` = nanosleep(CLOCK_MONOTONIC), which does not advance during
#     suspend, so it generates not a single wakeup.
#
#  3. NO accessibility service. Everything comes from logd's binary event
#     buffer.
#
#  4. POSIX sh (/system/bin/sh = mksh). No bashisms.
#
#  5. The daemon DOES NOT WRITE to sysfs. All writes go through `wr()` in
#     bin/pxtune. THE ONLY EXCEPTION is described at prop_guard() - returning
#     the thermal profile from "game" to the default is cleaning up after our
#     own intervention, not tuning.
#
# ===========================================================================
# EVENT SOURCES (verified against AOSP android17-release, i.e. valid for A16)
# ===========================================================================
#   frameworks/base/services/core/java/com/android/server/wm/EventLogTags.logtags
#     30007 wm_resume_activity (User|1|5),(Token|1|5),(Task ID|1|5),(Component Name|3)
#        -> NOTE: since Android R the tag is called wm_resume_activity, NOT
#           am_resume_activity. The daemon looks the name up at runtime in
#           /system/etc/event-log-tags and adapts.
#   frameworks/base/services/core/java/com/android/server/EventLogTags.logtags
#     2728 power_screen_state (offOrOn|1|5),(becauseOfUser|1|5),...
#        -> offOrOn: 0 = the screen went off, 1 = it came on.
#
# ===========================================================================
# REQUIREMENTS ON bin/pxtune - DELIBERATELY NOT IMPLEMENTED HERE
# (bin/pxtune is being edited by somebody else; see the task output)
# ===========================================================================
#
#  R1 (CRITICAL)  `pxtune profile <name> --auto --reset`
#     --reset = before applying the profile, restore ALL contract keys to the
#     values from backup/stock.conf, and only then load the profile.
#     REASON (the known "sticky profiles" problem): an empty value in a profile
#     means "leave it alone", so the transition
#        game -> balanced   LEAVES  THERMAL_PROFILE_CPU_MID/HIGH="game"
#                                   (= in the HAL config the CPU cdev bindings
#                                    have "Disabled": true, i.e. CPU thermal
#                                    throttling is OFF), UCLAMP_BG_MAX=30,
#                                   UCLAMP_SYSBG_MAX=40
#        night -> balanced  LEAVES  CHARGE_STOP_LEVEL=80, the UCLAMP_* values
#                                   from night, GPU_MAX_FREQ=419000
#     The daemon DETECTS --reset support AT RUNTIME (see apply_via_cli): when
#     pxtune does not understand it, it falls back to calling without --reset
#     and logs that. Once R1 is done, the daemon starts using it WITHOUT any
#     code change.
#
#  R2  `pxtune profile <name> --auto` must do nothing and exit with code 0 when
#     manual_override EXISTS. Today profile_apply() does not test
#     manual_override at all - only the daemon checks, which is a race (the
#     user presses a profile in the WebUI at the exact moment an event arrives).
#
#  R3  `pxtune auto on|off` should additionally start / stop
#     `pxtune-auto start|stop`.
#
#  R4  `pxtune profile auto` should delete manual_override AND send the daemon
#     SIGHUP. (already implemented via auto_signal HUP - just confirming the
#     contract)
#
#  R5 (optional)  `pxtune profile-keys <name>` = print the keys a given profile
#     actually sets. The daemon parses that itself today (prof_keys).
#
# ===========================================================================
# USAGE
#   pxtune-auto start | stop | restart | status | reload | run
#     run = runs in the foreground (debug), start = detaches via setsid
#
# SIGNALS
#   SIGHUP  - reload auto.conf and re-evaluate the state immediately
#   SIGUSR1 - dump the complete internal state to the log
#   SIGTERM - a clean exit (restores a neutral profile, see cleanup)
# ===========================================================================

# ---------------------------------------------------------------- paths

STATE=/data/adb/pixel_tune
PXTUNE=/data/adb/modules/pixel_tune/bin/pxtune

case "$0" in
    /*) SELF="$0" ;;
    *)  SELF="$PWD/$0" ;;
esac
# When the daemon does not run from /data/adb/modules (a test from another
# directory), look for pxtune next to it.
[ -x "$PXTUNE" ] || { _s="${SELF%/*}/pxtune"; [ -x "$_s" ] && PXTUNE="$_s"; }

LOG="$STATE/pxtune.log"
PIDF="$STATE/pxtune-auto.pid"
LOCKD="$STATE/pxtune-auto.lock"
FIFO="$STATE/pxtune-auto.fifo"
EXITF="$STATE/pxtune-auto.exiting"   # exists = the exit is intentional, the watchdog must not restart
ALIVEF="$STATE/pxtune-auto.alive"    # mtime = the last processed event (diagnostics)
APPSTATS="$STATE/appstats"
OVERRIDES="$STATE/appstats.override"
MANUAL="$STATE/manual_override"
MBASE="$STATE/manual_base"           # the manual base held for the duration of a per-app episode above manual_override (see apply_profile)
ACTIVE="$STATE/active"
AUTOF="$STATE/auto"                  # on|off, missing = on (a contract shared with pxtune)
CONF="$STATE/auto.conf"
PROFDIR="$STATE/profiles"
APPDIR="$STATE/apps"                 # per-app rules, one file per package
APPMODE="$STATE/appmode.active"      # layer 3 state (read only, written by pxtune-perapp)

# ===========================================================================
# TUNABLES
#
# EVERYTHING below can be overridden in /data/adb/pixel_tune/auto.conf without
# editing the code. auto.conf is NOT SOURCED (see conf_load) and every numeric
# value is additionally clamped (cfg_clamp_all) so that a typo like TICK_SEC=0
# cannot turn the daemon into a busy loop that eats the battery.
#
# Every constant states what it rests on. Where I have no measured data, it is
# written as NOT MEASURED.
# ===========================================================================

# ---------------------------------------------------------------- temperature: skin
#
# MEASURED BASELINE DATA (a 150 s load test on 9 cores):
#   steady state ........ skin 40.5 C, junction 58 C
#   junction peak ....... 81 C in the first ~40 s
#   recovery ............ MaxReleaseStep=1 => ~84 s; 60 s after the load ended
#                         not a single cluster had been released
#   while IDLE at skin 44.6 C the phone was already throttled to
#                         Little 610 / Big 910 / Prime 1164 MHz, GPU 376 MHz
#
# THERM_WARN_MC = 40000  (level 1)
#   RESEARCH-2026-08 part C: the threshold is set JUST BELOW the
#   VIRTUAL-SKIN-CPU-MID threshold (41.0 C), where the HAL starts its PID
#   control. The measured 40.5 C is the CEILING OF SELF-HEATING (the phone could
#   not get more out of itself under stock control at full load on all 9 cores),
#   so level 1 fires right at the edge of what the device handles natively -
#   before the HAL starts throttling by CPU-MID.
#   (Previously 41000; moved to 40.0 per the research - 41000 was already ABOVE
#    the CPU-MID threshold and the daemon therefore only reacted once the HAL
#    had started throttling.)
THERM_WARN_MC=40000
#
# THERM_HOT_MC = 43000  (level 2)
#   = the 3rd VIRTUAL-SKIN-CPU-HIGH threshold (43.0 C). Above it the HAL
#   throttles hard. Level 2 also UNCONDITIONALLY removes the "game" thermal prop
#   (see therm_prop_maxskin_guard below) - above MAX_SKIN, CPU thermal throttling
#   must not stay disabled. 43 C is now the second of four steps.
THERM_HOT_MC=43000
#
# THERM_CRIT_MC = 45000
#   Above the measured 44.6 C, where the phone was throttled ALREADY WHILE IDLE.
#   Above this point the HAL has no margin left and our intervention is cheaper
#   than what it will do.
THERM_CRIT_MC=45000
#
# THERM_OK_MC = 38100  (level 1 -> 0)
#   A HYSTERESIS of 1.9 C below level 1 (40000 - 1900 = 38100). Return to level 0
#   only once the skin is really down, not right below the threshold. 1.9 C is
#   DELIBERATELY THE SAME value the thermal HAL uses (HotHysteresis in the
#   /vendor config for all four VIRTUAL-SKIN sensors) - thanks to which our
#   daemon does not oscillate against its decisions. (Previously 40000, i.e. a
#   hysteresis of only 1.0 C against the then WARN of 41000.)
THERM_OK_MC=38100

# ---------------------------------------------------------------- temperature: junction
#
# Skin is a slow integrator. Junction (BIG/MID/LITTLE/G3D) rises tens of seconds
# earlier - it is the fast prediction channel.
# TWO MEASURED POINTS: sustained load in the steady state 58 C, an unmitigated
# peak of 81 C in the first 40 s.
#
# JUNC_WARN_MC = 70000
#   NOT A DIRECTLY MEASURED BOUNDARY - it is an interpolation roughly halfway
#   between the two measured points. The semantics: 58 C is "normal sustained
#   load and MUST NOT raise an alarm", 81 C is "the trajectory of an
#   uncontrolled rise".
JUNC_WARN_MC=70000
#
# JUNC_HOT_MC = 78000  (just below the measured peak of 81 C)
JUNC_HOT_MC=78000
#
# Junction by itself NEVER raises level 3 (crit) - crit is defined on the skin,
# because that is what burns the user's hand and what the HAL regulates.
JUNC_MAX_LEVEL=2

# ---------------------------------------------------------------- prediction
#
# THERM_HORIZON_SEC = 60
#   Derived from MEASUREMENT: MaxReleaseStep=1 => returning from state 12 takes
#   ~84 s, and 60 s after the load ended NOT A SINGLE cluster had been released.
#   The cost of intervening late is therefore on the order of a minute of extra
#   hard throttling. The prediction horizon has to be comparable to that time
#   constant. I pick 60 s = the lower bound of the measured "nothing was
#   released" interval. A longer horizon (84 s) would raise the number of false
#   alarms, because the error of a linear extrapolation grows with the horizon.
THERM_HORIZON_SEC=60
#
# SLOPE_MIN_DT = 15   a shorter base is not used for the derivative (noise)
# SLOPE_MAX_DT = 300  an older sample is no longer related (there was a suspend
#                     in between, the ticker was stopped) => the slope is
#                     discarded, not extrapolated
# SLOPE_NOISE  = 100  a noise gate in mC/100 s (0.1 C per 100 s).
#                     NOT MEASURED: I did not measure the noise and granularity
#                     of quiet_therm. Chosen so that 1 LSB (100 mC) over a 100 s
#                     base does not yet pass as a "trend".
SLOPE_MIN_DT=15
SLOPE_MAX_DT=300
SLOPE_NOISE=100

# ---------------------------------------------------------------- confirmation and hysteresis
#
# THERM_CONFIRM = 2
#   How many consecutive evaluations must agree before the level changes BASED
#   ON PREDICTION or JUNCTION. At TICK_BUSY_SEC=20 that is 40 s of evidence -
#   exactly the length of the measured ramp-up phase after which junction fell
#   from 81 C to 58 C. In other words: the measured stress test WOULD NOT PASS
#   this filter (and rightly so - the HAL dealt with it by itself). Only a load
#   that has not settled after 40 s passes.
#   An ABSOLUTE skin crossing is not confirmed - that is not a prediction, that
#   is a fact.
THERM_CONFIRM=2
#
# THERM_HOLD_SEC = 90
#   MEASURED: releasing from state 12 at MaxReleaseStep=1 takes ~84 s. Easing
#   off sooner than 90 s makes no sense - the HAL is still the limiting element
#   and we would only let the load back into a SoC that has not cooled down yet.
THERM_HOLD_SEC=90
#
# De-escalation is ALWAYS BY ONE STEP ONLY. That deliberately mirrors the HAL's
# MaxReleaseStep=1: when it releases one step at a time, we have no reason to
# jump.
# The path crit -> ok therefore takes ~4.5 min, which is of the same order as the measured 84 s/step.

# ---------------------------------------------------------------- the ticker
#
# The single timer. The period changes with the situation - the quieter the
# operation, the fewer wakeups.
#
# TICK_BUSY_SEC = 20  (level != 0, class game/heavy, or a switch is pending)
#   The thermal HAL regulates every ~7 s (SPEC) - sampling much faster makes no
#   sense and we would be cutting across its control. The junction peak happened
#   in the first ~40 s, so at 20 s we have 2 samples in that window = the minimum
#   for determining a slope and at the same time exactly THERM_CONFIRM=2.
TICK_BUSY_SEC=20
#
# TICK_SEC = 30  (screen on, normal use)
TICK_SEC=30
#
# TICK_IDLE_SEC = 90  (screen on, a light app, cool)
#   NOT MEASURED: chosen as 3x TICK_SEC. Skin is a slow integrator, and over a
#   90 s base the trend is still legible. Saves ~2/3 of the wakeups while reading
#   or scrolling.
TICK_IDLE_SEC=90
#
# TICK_IDLE_MARGIN_MC = 3000  (idle mode only when the skin is >= 3 C below WARN)
TICK_IDLE_MARGIN_MC=3000

# ---------------------------------------------------------------- anti-flapping
#
# MIN_SWITCH_SEC = 30
#   Longer than the burst of activity transitions during an app start (splash ->
#   main activity, typically 2-5 events over ~2 s), longer than the 7 s control
#   period of the thermal HAL (we do not want to cut across it) and at the same
#   time shorter than the usual length of app use, so it has time to take effect.
MIN_SWITCH_SEC=30
#
# A safeguard against pathological switching (broken classification, an app
# firing resume events). Once it is exceeded, only thermal interventions are
# allowed for SWLOCK_SEC, so that forking pxtune does not eat the battery.
# NOT MEASURED: 40/h = a switch every ~90 s, which no normal use reaches.
MAX_SWITCH_HOUR=40
SWLOCK_SEC=900

# ---------------------------------------------------------------- per-app
#
# THE ANTI-FLAPPING IS DELIBERATELY ASYMMETRIC. Entry is DELAYED, exit is LAZY.
#
# APP_MIN_FG_DEF = 8   (entry is delayed)
#   After a foreground event, "@APPARM <pkg>" is scheduled into the FIFO that
#   many seconds later, and ON PROCESSING it is verified that CUR_PKG is still
#   the same. An app start produces 2-5 events over ~2 s (splash -> main
#   activity), so flicking quickly through apps triggers NOTHING AT ALL - not one
#   binder call, not one extra fork.
#   Overridable per app with the APP_MIN_FG_SEC key.
APP_MIN_FG_DEF=8
#
# APP_STICKY_DEF = 25  (exit is lazy)
#   After leaving an app, "@APPLEAVE" is scheduled that many seconds later.
#   Returning to THE SAME package sooner = the event is dropped. An alt-tab to
#   messages and back therefore costs not a single binder call. It is
#   deliberately NOT longer than MIN_SWITCH_SEC - layer 3 comes down before a
#   profile switch could happen.
#   Overridable per app with the APP_STICKY_SEC key.
APP_STICKY_DEF=25
#
# 1 = per-app rules are in service. 0 = the daemon ignores them entirely
# (layers 1 and 2 stay, because those are held by the system and the profile
# respectively; layer 3 comes down at the first opportunity when disabled).
APP_RULES=1

# ---------------------------------------------------------------- CPU sampling
SAMPLE_MIN_SEC=25          # shorter visits to an app are not counted
STATS_MAX_SAMPLES=20       # after 20 samples the EWMA has long settled
STATS_MAX_LINES=300        # a cap on the number of appstats lines
STATS_MAX_BYTES=65536      # a hard size cap (protection against corruption)

# ---------------------------------------------------------------- classification
# The unit = percent of ONE core (the sum of the threads of the app's main
# process). The SoC has 9 cores, so the theoretical maximum is 900.
CPU_GAME=150               # ~1.5 cores sustained
SESS_GAME=90               # + an average session length >= 90 s
CPU_HEAVY=80
CPU_NORMAL=20
CLASS_MIN_SAMPLES=2        # until we have 2 samples, an app is CLASS_DEFAULT
CLASS_DEFAULT=normal

# ---------------------------------------------------------------- class -> profile mapping
# The order PROF_LIGHT < PROF_NORMAL < PROF_HEAVY < PROF_GAME forms a "ladder"
# that is capped along when it is hot or the battery is low (rank_of / prof_of_rank).
PROF_LIGHT=powersave
PROF_NORMAL=balanced
PROF_HEAVY=performance
PROF_GAME=game
PROF_NIGHT=night           # the screen went off
PROF_HOT=powersave         # thermal level 2
PROF_CRIT=powersave        # thermal level 3 (see "UNRESOLVED" in the task output)
PROF_SAFE=balanced         # a neutral profile on a clean exit / on a fault

# The profiles the daemon may use (for the startup stickiness audit).
AUTO_PROFILES="powersave balanced performance game night"

# ---------------------------------------------------------------- battery
#
# BATT_TEMP_WARN_DC = 400 (40.0 C; the unit is 0.1 C as in sysfs)
#   ANCHORED IN DATA: on this device Google itself sets bd_trigger_temp=350 -
#   i.e. 35.0 C is the line from which IT ITSELF starts dealing with the
#   "battery defender". 40.0 C is safely above the value the manufacturer
#   considers worth reacting to, so it is not excessively cautious.
BATT_TEMP_WARN_DC=400
#
# BATT_LOW_PCT / BATT_CRIT_PCT
#   NOT MEASURED. The reasoning: the battery has 602 cycles (SPEC) => increased
#   internal resistance => at a low SoC, a bigger voltage drop under peak draw
#   and a higher risk of a sudden shutdown. Does not apply while charging.
BATT_LOW_PCT=20            # cap at PROF_NORMAL
BATT_CRIT_PCT=10           # cap at PROF_LIGHT
BATT_RESPECT_CHARGING=1    # 1 = SoC-based caps are ignored while charging

# ---------------------------------------------------------------- camera
# SPEC: the prop vendor.thermal.*.profile is switched by the system itself
# (during the probe it was already on "camera"). The daemon must not cut across
# that. Should the prop stay stuck, we ignore it after CAMERA_HOLD_MAX seconds.
THERM_PROP_MID=vendor.thermal.VIRTUAL-SKIN-CPU-MID.profile
THERM_PROP_HIGH=vendor.thermal.VIRTUAL-SKIN-CPU-HIGH.profile
CAMERA_HOLD_MAX=600
CAMERA_PKGS="com.google.android.GoogleCamera com.android.camera com.google.android.apps.camera"

# ---------------------------------------------------------------- other
# Packages that are not reacted to (a transient foreground during unlocking etc.)
IGNORE_PKGS="com.android.systemui android com.google.android.permissioncontroller"

# 1 = the daemon may return the thermal prop from "game" to the default
#     (prop_guard, therm_prop_maxskin_guard).
THERMAL_PROP_CLEAR=1

# THERM_GAME_MAXSKIN_MC = 41000
#   A skin above this temperature => the "game" thermal prop is UNCONDITIONALLY
#   removed (therm_prop_maxskin_guard), even when a per-app APP_THERMAL_CAP=1
#   otherwise holds the "game" profile. It mirrors THERMAL_PROFILE_MAX_SKIN in
#   game.conf (41 C = the upper VIRTUAL-SKIN-CPU-MID threshold) and the
#   identically named check on application in bin/pxtune (profile_apply).
#   game.conf uses "game" to disable CPU throttling from 2 of the 4 skin sensors;
#   above MAX_SKIN that is dangerous ("gaming in the sun") and the skin safeguard
#   becomes the module's responsibility.
#   NOTE: the value is kept in sync with THERMAL_PROFILE_MAX_SKIN in game.conf by hand.
THERM_GAME_MAXSKIN_MC=41000

# 1 = try `pxtune profile X --auto --reset` (requirement R1). When the CLI does
# not support it, the daemon notices by itself and switches to calling without --reset.
AUTO_RESET=1

# When pxtune is unavailable, retry it after this many seconds (instead of
# disabling switching permanently, as the previous version did).
PXTUNE_RETRY_SEC=300

# Watchdog: how often to check that the main process is alive. At least 60 s.
# `sleep` = nanosleep(CLOCK_MONOTONIC), which does not advance during suspend =>
# no wakeups while the screen is off.
WD_SEC=300

# How many consecutive skin sensor read failures are allowed before the thermal
# limits are lifted as a safeguard. Fail-open is right here: the thermal HAL does
# its job independently of us and our blind sensor must not leave the phone
# permanently throttled.
THERM_READ_FAIL_MAX=5

AUTO_DEBUG=0

# ===========================================================================
# STATE (global)
# ===========================================================================

NOW=0
SCREEN=1

THERM_LEVEL=0          # 0 ok / 1 warm / 2 hot / 3 crit
THERM_SINCE=0          # NOW at the last level transition
THERM_UPC=0            # consecutive evaluations calling for an increase
THERM_DOWNC=0          # -"- after a decrease
THERM_RDFAIL=0

SKIN_MC=0
SKIN_PREV_MC=-1
SKIN_PREV_T=0
SKIN_SLOPE=0           # mC per 100 s (positive = rising)
SKIN_PRED=0
JUNC_MC=0
JUNC_SRC=""

BATT_PCT=-1
BATT_CHG=0
BATT_TEMP_DC=-1000

CUR_PKG=""
CUR_CLASS="$CLASS_DEFAULT"
APPLIED=""
APPLIED_OVL=""         # the package whose APP_OVERLAY_* is CURRENTLY written into the nodes
PENDING=""
LAST_SWITCH=0

SW_WIN=0
SW_CNT=0
SW_LOCK_UNTIL=0

SUP_PID=""
TICK_PID=""
TICK_CUR=0
WD_PID=""

FG_TAG=""
SCR_TAG=""
LOGN=0
RDFAIL=0
CAMERA_SINCE=0
PXTUNE_FAIL_AT=0
RESET_MODE=1           # 1 = we try --reset, 0 = the CLI does not support it
OVERLAY_MODE=1         # 1 = we try --overlay <pkg>, 0 = the CLI does not support it

# --- per-app state ---
AR_OK=0                # 1 = a valid, enabled rule exists for AR_PKG
AR_PKG=""
AR_APP_PROFILE=""
AR_APP_MIN_FG_SEC=$APP_MIN_FG_DEF
AR_APP_STICKY_SEC=$APP_STICKY_DEF
AR_APP_THERMAL_CAP=0
APPMODE_PKG=""         # the package layer 3 is CURRENTLY deployed for
APPMODE_STICKY=$APP_STICKY_DEF
APPARM_PID=""          # the delayed-entry scheduler
APPLV_PID=""           # the lazy-exit scheduler
GREPLB=""
SHELL_FILTER=0

LOG_LAST=""
LOG_REP=0

# sensors (directories, resolved at startup)
Z_SKIN=""
Z_BIG=""
Z_MID=""
Z_LIT=""
Z_G3D=""
BATTDIR=/sys/class/power_supply/battery

# the sampling window
SMP_PKG=""
SMP_PID=""
SMP_J=0
SMP_T=0

# ===========================================================================
# UTILITY
# ===========================================================================

# Monotonic time without a fork. /proc/uptime uses CLOCK_BOOTTIME, so it counts
# the time spent in suspend as well - exactly what we want for cooldowns.
#
# A TRAP FROM THE BRIEF: `read -r v < /proc/sys/...` returns only the FIRST
# CHARACTER, because procfs sysctl reports st_size=0 (swappiness 40 -> "4"). On
# /proc/uptime, /proc/<pid>/stat and on /sys/ it works correctly - and the daemon
# reads no other files. Should /proc/sys/* ever be needed, head -n1 MUST be used.
tick_now() {
    read -r _up _idle < /proc/uptime 2>/dev/null || { NOW=$((NOW + 1)); return 0; }
    NOW=${_up%.*}
    case "$NOW" in ''|*[!0-9]*) NOW=0 ;; esac
    return 0
}

log_rotate() {
    _sz=$(stat -c %s "$LOG" 2>/dev/null)
    case "$_sz" in ''|*[!0-9]*) return 0 ;; esac
    if [ "$_sz" -gt 524288 ]; then
        mv -f "$LOG" "$LOG.old" 2>/dev/null
        : > "$LOG" 2>/dev/null
    fi
    return 0
}

log_emit() {
    printf '[%s] [%s] [auto] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" "$2" >> "$LOG" 2>/dev/null
    LOGN=$((LOGN + 1))
    [ "$((LOGN % 25))" -eq 0 ] && log_rotate
    return 0
}

# Suppression of repeated identical messages. Without it, a fault that repeats
# every 20 s (pxtune unavailable, an unreadable sensor) would fill the log
# overnight and the rotation would delete the useful history.
log() {
    _lvl=$1
    shift
    _m="$*"
    if [ "$_lvl$_m" = "$LOG_LAST" ]; then
        LOG_REP=$((LOG_REP + 1))
        [ "$((LOG_REP % 100))" -eq 0 ] && log_emit "$_lvl" "$_m (repeated ${LOG_REP}x)"
        return 0
    fi
    if [ "$LOG_REP" -gt 0 ]; then
        log_emit INFO "the previous message repeated another ${LOG_REP}x"
        LOG_REP=0
    fi
    LOG_LAST="$_lvl$_m"
    log_emit "$_lvl" "$_m"
    return 0
}

dbg() {
    [ "$AUTO_DEBUG" = "1" ] || return 0
    log DEBUG "$@"
}

in_list() {
    # in_list <needle> <space-separated list>
    _n=$1
    for _i in $2; do
        [ "$_n" = "$_i" ] && return 0
    done
    return 1
}

# ===========================================================================
# LOADING auto.conf
#
# auto.conf MUST NOT be sourced: a syntax error would take the daemon down
# before it even wrote its first log line, and anything in the file would run as
# root. We read it with our own parser: only KEY=value lines, the key in upper
# case, the value free of shell metacharacters. (The same reason as for zram.conf
# in post-fs-data.sh.)
# ===========================================================================

conf_load() {
    [ -f "$CONF" ] || return 0
    _drop=0
    while IFS='=' read -r _ck _cv; do
        case "$_ck" in
            ''|\#*) continue ;;
            *[!A-Z0-9_]*) continue ;;    # only a KEY of upper case letters/digits/underscores
        esac
        # strip the surrounding quotes, keep the inside (lists contain spaces)
        _cv=${_cv%\"}
        _cv=${_cv#\"}
        case "$_cv" in
            *[!A-Za-z0-9_.:/,+\ -]*) _drop=$((_drop + 1)); continue ;;
        esac
        eval "$_ck=\$_cv"
    done < "$CONF"
    [ "$_drop" -gt 0 ] && log WARN "auto.conf: $_drop lines dropped (the value contains disallowed characters)"
    return 0
}

# cfg_int <variable name> <min> <max> <default>
# Clamps a numeric value. Without it, a typo like TICK_SEC=0 or WD_SEC=1 would
# turn the daemon into a busy loop that eats the battery.
cfg_int() {
    eval "_cv=\${$1}"
    case "$_cv" in
        ''|*[!0-9]*) _cv=$4 ;;
    esac
    [ "$_cv" -lt "$2" ] && _cv=$2
    [ "$_cv" -gt "$3" ] && _cv=$3
    eval "$1=\$_cv"
    return 0
}

cfg_bool() {
    eval "_cb=\${$1}"
    case "$_cb" in
        1|on|ON|true|yes) _cb=1 ;;
        *) _cb=0 ;;
    esac
    eval "$1=\$_cb"
    return 0
}

cfg_clamp_all() {
    cfg_int THERM_WARN_MC        20000   90000    40000
    cfg_int THERM_HOT_MC         20000   95000    43000
    cfg_int THERM_CRIT_MC        20000   99000    45000
    cfg_int THERM_OK_MC          15000   90000    38100
    cfg_int THERM_GAME_MAXSKIN_MC 20000  90000    41000
    cfg_int JUNC_WARN_MC         30000  110000    70000
    cfg_int JUNC_HOT_MC          30000  115000    78000
    cfg_int JUNC_MAX_LEVEL           0       3        2
    cfg_int THERM_HORIZON_SEC       10     600       60
    cfg_int SLOPE_MIN_DT             5     120       15
    cfg_int SLOPE_MAX_DT            60    3600      300
    cfg_int SLOPE_NOISE              0   10000      100
    cfg_int THERM_CONFIRM            1      10        2
    cfg_int THERM_HOLD_SEC          10    3600       90
    cfg_int TICK_BUSY_SEC           10    3600       20
    cfg_int TICK_SEC                10    3600       30
    cfg_int TICK_IDLE_SEC           10    3600       90
    cfg_int TICK_IDLE_MARGIN_MC      0   20000     3000
    cfg_int MIN_SWITCH_SEC           5    3600       30
    cfg_int MAX_SWITCH_HOUR          4    1000       40
    cfg_int APP_MIN_FG_DEF           1     600        8
    cfg_int APP_STICKY_DEF           0    3600       25
    cfg_int SWLOCK_SEC              60   86400      900
    cfg_int SAMPLE_MIN_SEC           5    3600       25
    cfg_int STATS_MAX_SAMPLES        1    1000       20
    cfg_int STATS_MAX_LINES         10   10000      300
    cfg_int STATS_MAX_BYTES       4096 1048576    65536
    cfg_int CPU_GAME                10     900      150
    cfg_int SESS_GAME               10   86400       90
    cfg_int CPU_HEAVY                5     900       80
    cfg_int CPU_NORMAL               1     900       20
    cfg_int CLASS_MIN_SAMPLES        1     100        2
    cfg_int BATT_TEMP_WARN_DC      200     800      400
    cfg_int BATT_LOW_PCT             0     100       20
    cfg_int BATT_CRIT_PCT            0     100       10
    cfg_int CAMERA_HOLD_MAX         30   86400      600
    cfg_int PXTUNE_RETRY_SEC        30   86400      300
    cfg_int WD_SEC                  60   86400      300
    cfg_int THERM_READ_FAIL_MAX      1     100        5
    cfg_bool THERMAL_PROP_CLEAR
    cfg_bool AUTO_RESET
    cfg_bool BATT_RESPECT_CHARGING
    cfg_bool APP_RULES
    cfg_bool AUTO_DEBUG

    # Mutual consistency of the thresholds. If someone set them the wrong way
    # round, the daemon would get stuck at one level - better to fix them up and
    # say so.
    if [ "$THERM_OK_MC" -ge "$THERM_WARN_MC" ]; then
        THERM_OK_MC=$((THERM_WARN_MC - 1000))
        log WARN "THERM_OK_MC >= THERM_WARN_MC, corrected to $THERM_OK_MC"
    fi
    if [ "$THERM_HOT_MC" -le "$THERM_WARN_MC" ]; then
        THERM_HOT_MC=$((THERM_WARN_MC + 1000))
        log WARN "THERM_HOT_MC <= THERM_WARN_MC, corrected to $THERM_HOT_MC"
    fi
    if [ "$THERM_CRIT_MC" -le "$THERM_HOT_MC" ]; then
        THERM_CRIT_MC=$((THERM_HOT_MC + 1000))
        log WARN "THERM_CRIT_MC <= THERM_HOT_MC, corrected to $THERM_CRIT_MC"
    fi
    if [ "$JUNC_HOT_MC" -le "$JUNC_WARN_MC" ]; then
        JUNC_HOT_MC=$((JUNC_WARN_MC + 2000))
        log WARN "JUNC_HOT_MC <= JUNC_WARN_MC, corrected to $JUNC_HOT_MC"
    fi
    return 0
}

# ===========================================================================
# SENSOR RESOLUTION
#
# CAUTION (verified on the device): thermal_zoneN indices are NOT stable across
# reboots - soc_therm moved from zone11 to zone13, battery from zone16 to
# zone12, thermal-cpufreq-2 from cd12 to cd11. A hard-coded index = a bug.
# The search order: the stable symlink /dev/thermal/tz-by-name -> a scan by the
# `type` field. NO fallback to a number: when a sensor is not found, we would
# rather not have it at all (an empty variable) than read a random other one.
# ===========================================================================

resolve_zone() {
    if [ -r "/dev/thermal/tz-by-name/$1/temp" ]; then
        print -rn -- "/dev/thermal/tz-by-name/$1"
        return 0
    fi
    for _z in /sys/class/thermal/thermal_zone*; do
        [ -r "$_z/type" ] || continue
        read -r _ty < "$_z/type" 2>/dev/null || continue
        if [ "$_ty" = "$1" ]; then
            print -rn -- "$_z"
            return 0
        fi
    done
    return 1
}

resolve_sensors() {
    Z_SKIN=$(resolve_zone quiet_therm) || Z_SKIN=""
    Z_BIG=$(resolve_zone BIG)          || Z_BIG=""
    Z_MID=$(resolve_zone MID)          || Z_MID=""
    Z_LIT=$(resolve_zone LITTLE)       || Z_LIT=""
    Z_G3D=$(resolve_zone G3D)          || Z_G3D=""

    [ -n "$Z_SKIN" ] || log ERROR "the quiet_therm (skin) sensor was NOT FOUND - thermal protection will run from the junction sensors only"
    _j=""
    [ -n "$Z_BIG" ] && _j="$_j BIG"
    [ -n "$Z_MID" ] && _j="$_j MID"
    [ -n "$Z_LIT" ] && _j="$_j LITTLE"
    [ -n "$Z_G3D" ] && _j="$_j G3D"
    [ -n "$_j" ] || log ERROR "no junction sensor found - the fast prediction channel is out of service"
    log INFO "sensors: skin='${Z_SKIN:-?}' junction='${_j# }'"
    [ -d "$BATTDIR" ] || log WARN "$BATTDIR does not exist - the battery state will not be taken into account"
    return 0
}

zread() {
    # zread <zone directory> -> ZT (millicelsius); 1 on an error or a nonsense value
    [ -n "$1" ] || return 1
    read -r ZT < "$1/temp" 2>/dev/null || return 1
    case "$ZT" in
        ''|*[!0-9-]*) return 1 ;;
    esac
    # A disconnected sensor reports 0 or a negative number; above 150 C it is a fault.
    [ "$ZT" -le 0 ] && return 1
    [ "$ZT" -gt 150000 ] && return 1
    return 0
}

# ===========================================================================
# SENSOR READOUT + DERIVATIVE
# ===========================================================================

sense() {
    # ---- skin ------------------------------------------------------------
    if zread "$Z_SKIN"; then
        THERM_RDFAIL=0
        _new=$ZT
        if [ "$SKIN_PREV_MC" -lt 0 ]; then
            SKIN_PREV_MC=$_new
            SKIN_PREV_T=$NOW
            SKIN_SLOPE=0
        else
            _dt=$((NOW - SKIN_PREV_T))
            if [ "$_dt" -lt 0 ] || [ "$_dt" -gt "$SLOPE_MAX_DT" ]; then
                # There was a gap between samples (suspend, a stopped ticker).
                # The old slope would be extrapolated from unrelated points -> discard.
                SKIN_SLOPE=0
                SKIN_PREV_MC=$_new
                SKIN_PREV_T=$NOW
            elif [ "$_dt" -ge "$SLOPE_MIN_DT" ]; then
                _s=$(( (_new - SKIN_PREV_MC) * 100 / _dt ))
                # An EWMA with alpha = 0.5 in integer arithmetic. It damps a
                # one-off sensor jump but still reacts within two samples.
                SKIN_SLOPE=$(( (SKIN_SLOPE + _s) / 2 ))
                SKIN_PREV_MC=$_new
                SKIN_PREV_T=$NOW
            fi
            # _dt < SLOPE_MIN_DT => the sample is too close, the slope is left unchanged
        fi
        SKIN_MC=$_new
    else
        THERM_RDFAIL=$((THERM_RDFAIL + 1))
        if [ "$THERM_RDFAIL" -ge "$THERM_READ_FAIL_MAX" ] && [ "$THERM_LEVEL" -gt 0 ]; then
            log ERROR "the skin sensor has been unreadable ${THERM_RDFAIL}x in a row - LIFTING the thermal limits (fail-open, the HAL keeps cooling by itself)"
            THERM_LEVEL=0
            THERM_UPC=0
            THERM_DOWNC=0
            THERM_SINCE=$NOW
        fi
    fi

    # ---- junction (the maximum of the four) ------------------------------
    JUNC_MC=0
    JUNC_SRC=""
    for _p in "BIG:$Z_BIG" "MID:$Z_MID" "LITTLE:$Z_LIT" "G3D:$Z_G3D"; do
        _nm=${_p%%:*}
        _dir=${_p#*:}
        [ -n "$_dir" ] || continue
        if zread "$_dir" && [ "$ZT" -gt "$JUNC_MC" ]; then
            JUNC_MC=$ZT
            JUNC_SRC=$_nm
        fi
    done

    # ---- prediction ------------------------------------------------------
    if [ "$SKIN_SLOPE" -gt "$SLOPE_NOISE" ]; then
        SKIN_PRED=$(( SKIN_MC + SKIN_SLOPE * THERM_HORIZON_SEC / 100 ))
    else
        # A falling or noise-level slope is NOT EXTRAPOLATED. A prediction may
        # only bring an intervention forward, never postpone it - extrapolating
        # downwards would silence a genuine threshold crossing.
        SKIN_PRED=$SKIN_MC
    fi

    # ---- battery ---------------------------------------------------------
    BATT_PCT=-1
    BATT_CHG=0
    BATT_TEMP_DC=-1000
    if [ -d "$BATTDIR" ]; then
        if read -r _c < "$BATTDIR/capacity" 2>/dev/null; then
            case "$_c" in
                ''|*[!0-9]*) : ;;
                *) [ "$_c" -le 100 ] && BATT_PCT=$_c ;;
            esac
        fi
        if read -r _s < "$BATTDIR/status" 2>/dev/null; then
            case "$_s" in
                Charging|Full) BATT_CHG=1 ;;
            esac
        fi
        if read -r _bt < "$BATTDIR/temp" 2>/dev/null; then
            case "$_bt" in
                ''|*[!0-9-]*) : ;;
                *) BATT_TEMP_DC=$_bt ;;
            esac
        fi
    fi
    return 0
}

# ===========================================================================
# THE THERMAL STATE MACHINE (PREDICTIVE)
#
# Four levels: 0 ok / 1 warm / 2 hot / 3 crit.
# The level is the MAXIMUM of four independent channels:
#
#   A) ABSOLUTE SKIN - a fact, not an estimate. Applied IMMEDIATELY without
#      confirmation.
#        >= THERM_CRIT_MC -> 3,  >= THERM_HOT_MC -> 2,  >= THERM_WARN_MC -> 1
#
#   B) PREDICTED SKIN = skin + slope * horizon. Applied only after
#      THERM_CONFIRM matching evaluations. This is the predictive part: with a
#      rise of 3 C/min and a skin of 39.5 C, the prediction 60 s ahead comes out
#      at 42.5 C -> level 1 right now, still below the absolute threshold.
#
#   C) JUNCTION - the fastest channel, rising tens of seconds before the skin.
#      Also confirmed, and capped at JUNC_MAX_LEVEL (2), because I only have
#      measurements for level 3 on the skin.
#
#   D) BATTERY TEMPERATURE >= BATT_TEMP_WARN_DC -> at least level 1.
#
# ESCALATION may be by any number of steps at once (once it is late, climbing
# one step at a time makes no sense). DE-ESCALATION IS ALWAYS BY ONE STEP and
# only after THERM_HOLD_SEC - mirroring the HAL's MaxReleaseStep=1 and the
# measured ~84 s per release.
#
# Return value: 0 = the level changed, 1 = unchanged.
# ===========================================================================

therm_level_from() {
    if   [ "$1" -ge "$THERM_CRIT_MC" ]; then TL=3
    elif [ "$1" -ge "$THERM_HOT_MC" ];  then TL=2
    elif [ "$1" -ge "$THERM_WARN_MC" ]; then TL=1
    else                                     TL=0
    fi
    return 0
}

therm_eval() {
    therm_level_from "$SKIN_MC"
    _abs=$TL
    therm_level_from "$SKIN_PRED"
    _pre=$TL

    _jun=0
    if   [ "$JUNC_MC" -ge "$JUNC_HOT_MC" ];  then _jun=2
    elif [ "$JUNC_MC" -ge "$JUNC_WARN_MC" ]; then _jun=1
    fi
    [ "$_jun" -gt "$JUNC_MAX_LEVEL" ] && _jun=$JUNC_MAX_LEVEL

    _bat=0
    [ "$BATT_TEMP_DC" -ge "$BATT_TEMP_WARN_DC" ] && _bat=1

    # the confirmed part (prediction + junction + battery)
    _soft=$_pre
    [ "$_jun" -gt "$_soft" ] && _soft=$_jun
    [ "$_bat" -gt "$_soft" ] && _soft=$_bat

    _want=$_abs
    [ "$_soft" -gt "$_want" ] && _want=$_soft

    _old=$THERM_LEVEL

    if [ "$_abs" -gt "$THERM_LEVEL" ]; then
        # Measured reality crossed the threshold - no waiting for confirmation.
        THERM_LEVEL=$_abs
        THERM_SINCE=$NOW
        THERM_UPC=0
        THERM_DOWNC=0
        log WARN "TEMPERATURE level $_old -> $THERM_LEVEL (skin ${SKIN_MC}mC crossed the threshold; junction ${JUNC_MC}mC/${JUNC_SRC:-?})"
    elif [ "$_want" -gt "$THERM_LEVEL" ]; then
        THERM_UPC=$((THERM_UPC + 1))
        THERM_DOWNC=0
        if [ "$THERM_UPC" -ge "$THERM_CONFIRM" ]; then
            THERM_LEVEL=$_want
            THERM_SINCE=$NOW
            THERM_UPC=0
            log WARN "TEMPERATURE level $_old -> $THERM_LEVEL PREDICTIVELY (skin ${SKIN_MC}mC, slope ${SKIN_SLOPE}mC/100s, prediction ${THERM_HORIZON_SEC}s ahead ${SKIN_PRED}mC, junction ${JUNC_MC}mC/${JUNC_SRC:-?}, battery ${BATT_TEMP_DC}dC) - confirmed ${THERM_CONFIRM}x"
        else
            dbg "temperature: candidate for level $_want ($THERM_UPC/$THERM_CONFIRM), skin ${SKIN_MC} pred ${SKIN_PRED} junc ${JUNC_MC}"
        fi
    elif [ "$_want" -lt "$THERM_LEVEL" ]; then
        THERM_UPC=0
        if [ "$THERM_LEVEL" -eq 1 ] && [ "$SKIN_MC" -gt "$THERM_OK_MC" ]; then
            # Down to level 0 only once the skin is really low, not just below WARN.
            THERM_DOWNC=0
            dbg "temperature: holding level 1, skin ${SKIN_MC} > THERM_OK_MC ${THERM_OK_MC}"
        elif [ "$((NOW - THERM_SINCE))" -lt "$THERM_HOLD_SEC" ]; then
            dbg "temperature: level $THERM_LEVEL held for another $((THERM_HOLD_SEC - (NOW - THERM_SINCE)))s (the HAL releases over ~84s)"
        else
            THERM_DOWNC=$((THERM_DOWNC + 1))
            if [ "$THERM_DOWNC" -ge "$THERM_CONFIRM" ]; then
                THERM_LEVEL=$((THERM_LEVEL - 1))      # by one step only
                THERM_SINCE=$NOW
                THERM_DOWNC=0
                log INFO "TEMPERATURE level $_old -> $THERM_LEVEL (skin ${SKIN_MC}mC, slope ${SKIN_SLOPE}mC/100s, junction ${JUNC_MC}mC)"
            fi
        fi
    else
        THERM_UPC=0
        THERM_DOWNC=0
    fi

    [ "$THERM_LEVEL" != "$_old" ] && return 0
    return 1
}

# ===========================================================================
# TAG DETECTION
# ===========================================================================

# /system/etc/event-log-tags is a generated file of "number name (description)".
have_tag() {
    grep -q "^[0-9][0-9]* $1 " /system/etc/event-log-tags 2>/dev/null
}

detect_tags() {
    FG_TAG=""
    SCR_TAG=""
    if [ ! -r /system/etc/event-log-tags ]; then
        log WARN "/system/etc/event-log-tags is not readable, using the verified default tag names"
        FG_TAG=wm_resume_activity
        SCR_TAG=power_screen_state
        return 0
    fi
    for _t in wm_resume_activity am_resume_activity wm_on_resume_called am_on_resume_called; do
        if have_tag "$_t"; then FG_TAG=$_t; break; fi
    done
    for _t in power_screen_state screen_toggled; do
        if have_tag "$_t"; then SCR_TAG=$_t; break; fi
    done

    if [ -z "$FG_TAG" ]; then
        log ERROR "event-log-tags contains no known foreground tag - app tracking WILL NOT work"
    else
        log INFO "foreground tag: $FG_TAG"
    fi
    if [ -z "$SCR_TAG" ]; then
        log ERROR "event-log-tags contains neither power_screen_state nor screen_toggled - the screen state WILL NOT be detected (CAUTION: without it the ticker is never stopped)"
    else
        log INFO "screen tag: $SCR_TAG"
    fi
    return 0
}

# ===========================================================================
# EVENT PARSING
#
# A line from the binary buffer looks like this:
#   08-07 12:34:56.789  1000  2345  2345 I wm_resume_activity: [0,141688585,73,com.foo/.Main]
#   08-07 12:34:56.789  1000  1200  1200 I power_screen_state: [0,3,0,0,0]
# ===========================================================================

ev_payload() {
    _p=${1#*: [}
    [ "$_p" = "$1" ] && { EVP=""; return 1; }
    EVP=${_p%]*}
    [ -n "$EVP" ] || return 1
    return 0
}

ev_pkg() {
    EVPKG=""
    case "$FG_TAG" in
        *_on_resume_called)
            # (User),(Component Name),(Reason) -> the component is the 2nd field
            _rest=${EVP#*,}
            _comp=${_rest%%,*}
            ;;
        *)
            # (User),(Token),(Task ID),(Component Name) -> the component is the last
            _comp=${EVP##*,}
            ;;
    esac
    _comp=${_comp# }
    EVPKG=${_comp%%/*}
    case "$EVPKG" in
        ''|*[!A-Za-z0-9._]*) EVPKG="" ; return 1 ;;
    esac
    return 0
}

# ===========================================================================
# APP STATISTICS
# ===========================================================================

# A corrupted appstats (binary garbage, a truncated write, a full /data) must
# not throw the daemon off or send it into the wrong class.
stats_sanity() {
    [ -f "$APPSTATS" ] || return 0
    _sz=$(stat -c %s "$APPSTATS" 2>/dev/null)
    case "$_sz" in ''|*[!0-9]*) _sz=0 ;; esac
    if [ "$_sz" -gt "$STATS_MAX_BYTES" ]; then
        log WARN "appstats is $_sz B (> $STATS_MAX_BYTES) - moving it to .bad and starting over"
        mv -f "$APPSTATS" "$APPSTATS.bad" 2>/dev/null
        return 0
    fi
    _tot=0
    _bad=0
    while IFS= read -r _l; do
        _tot=$((_tot + 1))
        # shellcheck disable=SC2086
        set -- $_l
        if [ $# -lt 6 ]; then _bad=$((_bad + 1)); continue; fi
        case "$3$4$5$6" in *[!0-9]*) _bad=$((_bad + 1)) ;; esac
    done < "$APPSTATS"
    if [ "$_tot" -gt 0 ] && [ "$((_bad * 2))" -gt "$_tot" ]; then
        log ERROR "appstats is corrupted ($_bad of $_tot lines do not fit) - moving it to .bad and starting over"
        mv -f "$APPSTATS" "$APPSTATS.bad" 2>/dev/null
    elif [ "$_bad" -gt 0 ]; then
        log WARN "appstats: $_bad of $_tot lines are faulty, they will be ignored"
    fi
    return 0
}

stats_get() {
    # stats_get <pkg> -> S_CLASS S_N S_CPU S_FG S_SEEN
    S_CLASS=""; S_N=0; S_CPU=0; S_FG=0; S_SEEN=0
    [ -f "$APPSTATS" ] || return 0
    _line=$(grep -m1 "^$1 " "$APPSTATS" 2>/dev/null)
    [ -z "$_line" ] && return 0
    # shellcheck disable=SC2086
    set -- $_line
    [ $# -ge 6 ] || return 0
    case "$3$4$5$6" in *[!0-9]*) return 0 ;; esac
    case "$2" in
        game|heavy|normal|light) S_CLASS=$2 ;;
        *) return 0 ;;
    esac
    S_N=$3; S_CPU=$4; S_FG=$5; S_SEEN=$6
    return 0
}

classify() {
    # classify <n> <ewma_cpu> <total_fg_sec> -> echo the class
    _n=$1; _c=$2; _f=$3
    if [ "$_n" -lt "$CLASS_MIN_SAMPLES" ]; then echo "$CLASS_DEFAULT"; return 0; fi
    _avg=$((_f / _n))
    if [ "$_c" -ge "$CPU_GAME" ] && [ "$_avg" -ge "$SESS_GAME" ]; then echo game; return 0; fi
    if [ "$_c" -ge "$CPU_HEAVY" ]; then echo heavy; return 0; fi
    if [ "$_c" -ge "$CPU_NORMAL" ]; then echo normal; return 0; fi
    echo light
    return 0
}

app_class() {
    # app_class <pkg> -> echo the class (a manual override takes precedence)
    if [ -f "$OVERRIDES" ]; then
        _o=$(grep -m1 "^$1 " "$OVERRIDES" 2>/dev/null)
        if [ -n "$_o" ]; then
            _o=${_o#* }
            _o=${_o%% *}
            case "$_o" in
                game|heavy|normal|light) echo "$_o"; return 0 ;;
            esac
        fi
    fi
    stats_get "$1"
    if [ -n "$S_CLASS" ]; then echo "$S_CLASS"; else echo "$CLASS_DEFAULT"; fi
    return 0
}

stats_update() {
    # stats_update <pkg> <cpu_pct> <dur_sec>
    _p=$1; _cpu=$2; _dur=$3
    stats_get "$_p"
    _n=$((S_N + 1))
    if [ "$S_N" -eq 0 ]; then
        _e=$_cpu
    else
        # EWMA, alpha = 0.3 in integer arithmetic
        _e=$(((S_CPU * 7 + _cpu * 3) / 10))
    fi
    _fg=$((S_FG + _dur))
    _cls=$(classify "$_n" "$_e" "$_fg")
    _seen=$(date +%s 2>/dev/null)
    case "$_seen" in ''|*[!0-9]*) _seen=0 ;; esac

    {
        [ -f "$APPSTATS" ] && grep -v "^$_p " "$APPSTATS" 2>/dev/null
        printf '%s %s %s %s %s %s\n' "$_p" "$_cls" "$_n" "$_e" "$_fg" "$_seen"
    } > "$APPSTATS.tmp" 2>/dev/null

    if [ -s "$APPSTATS.tmp" ]; then
        mv -f "$APPSTATS.tmp" "$APPSTATS" 2>/dev/null
    else
        rm -f "$APPSTATS.tmp" 2>/dev/null
        log WARN "writing appstats failed (an empty temporary file) - the $_p sample was dropped"
        return 0
    fi

    _lines=$(wc -l < "$APPSTATS" 2>/dev/null)
    case "$_lines" in ''|*[!0-9]*) _lines=0 ;; esac
    if [ "$_lines" -gt "$STATS_MAX_LINES" ]; then
        if sort -k6 -n -r "$APPSTATS" 2>/dev/null | head -n "$STATS_MAX_LINES" > "$APPSTATS.tmp" 2>/dev/null; then
            [ -s "$APPSTATS.tmp" ] && mv -f "$APPSTATS.tmp" "$APPSTATS" 2>/dev/null
        fi
        rm -f "$APPSTATS.tmp" 2>/dev/null
    fi

    if [ "$_cls" != "$S_CLASS" ]; then
        log INFO "classification $_p: ${S_CLASS:-?} -> $_cls (cpu ewma ${_e}%, samples $_n, foreground total ${_fg}s)"
    else
        dbg "sample $_p: cpu ${_cpu}% over ${_dur}s, ewma ${_e}%, n=$_n, class $_cls"
    fi
    # The class is only overwritten when it is the CURRENT foreground app. The
    # previous version overwrote CUR_CLASS always, so closing the window of a
    # departing app overwrote the class of the new one.
    [ "$_p" = "$CUR_PKG" ] && CUR_CLASS=$_cls
    return 0
}

# ===========================================================================
# CPU SAMPLING
# ===========================================================================

pkg_pid() {
    PP=$(pidof -s "$1" 2>/dev/null)
    case "$PP" in ''|*[!0-9]*) PP="" ; return 1 ;; esac
    return 0
}

proc_jiffies() {
    # proc_jiffies <pid> -> PJ = utime + stime (in ticks, USER_HZ = 100)
    _pid=$1
    [ -r "/proc/$_pid/stat" ] || return 1
    read -r _st < "/proc/$_pid/stat" 2>/dev/null || return 1
    _r=${_st#*") "}
    [ "$_r" = "$_st" ] && return 1
    # shellcheck disable=SC2086
    set -- $_r
    [ $# -ge 13 ] || return 1
    _u=${12}; _s=${13}
    case "$_u$_s" in *[!0-9]*) return 1 ;; esac
    PJ=$((_u + _s))
    return 0
}

sample_start() {
    # Measured ONLY while the screen is on and only until we have enough data about the app.
    SMP_PKG=""; SMP_PID=""; SMP_J=0; SMP_T=0
    [ "$SCREEN" = "1" ] || return 0
    [ -n "$1" ] || return 0
    stats_get "$1"
    [ "$S_N" -ge "$STATS_MAX_SAMPLES" ] && return 0
    pkg_pid "$1" || return 0
    proc_jiffies "$PP" || return 0
    SMP_PKG=$1; SMP_PID=$PP; SMP_J=$PJ; SMP_T=$NOW
    return 0
}

sample_finish() {
    [ -n "$SMP_PKG" ] || return 0
    _dur=$((NOW - SMP_T))
    _pkg=$SMP_PKG; _pid=$SMP_PID; _j0=$SMP_J
    SMP_PKG=""; SMP_PID=""; SMP_J=0; SMP_T=0
    [ "$_dur" -ge "$SAMPLE_MIN_SEC" ] || return 0
    # A window longer than an hour means something happened in between (suspend,
    # a frozen ticker) - an average over such a window says nothing.
    [ "$_dur" -gt 3600 ] && return 0
    proc_jiffies "$_pid" || return 0      # the process died in the meantime -> drop the sample
    _dj=$((PJ - _j0))
    [ "$_dj" -lt 0 ] && return 0
    # percent of one core = delta_ticks / delta_seconds (100 ticks = 1 core-second)
    _cpu=$((_dj / _dur))
    [ "$_cpu" -gt 900 ] && _cpu=900
    stats_update "$_pkg" "$_cpu" "$_dur"
    return 0
}

# ===========================================================================
# CAMERA
# ===========================================================================

camera_active() {
    # SPEC: the system thermal HAL sets the "camera" profile by itself.
    # While that is active, we do not intervene in the control.
    if [ -n "$CUR_PKG" ] && in_list "$CUR_PKG" "$CAMERA_PKGS"; then
        return 0
    fi
    _a=$(getprop "$THERM_PROP_MID" 2>/dev/null)
    _b=$(getprop "$THERM_PROP_HIGH" 2>/dev/null)
    if [ "$_a" = "camera" ] || [ "$_b" = "camera" ]; then
        [ "$CAMERA_SINCE" -eq 0 ] && CAMERA_SINCE=$NOW
        if [ "$((NOW - CAMERA_SINCE))" -gt "$CAMERA_HOLD_MAX" ]; then
            log WARN "the thermal profile prop has been stuck on 'camera' for $((NOW - CAMERA_SINCE)) s - ignoring it and continuing"
            return 1
        fi
        return 0
    fi
    CAMERA_SINCE=0
    return 1
}

# ===========================================================================
# PROFILES: READING, THE STICKINESS AUDIT, THE THERMAL PROP SAFEGUARD
# ===========================================================================

# prof_val <file> <key> -> echo the value without quotes (empty when missing)
# The profile is DELIBERATELY not sourced - sourcing would overwrite the
# daemon's variables (PROFILE_NAME, UCLAMP_*) and run whatever is in the file.
prof_val() {
    [ -f "$1" ] || return 0
    _l=$(grep -m1 "^$2=" "$1" 2>/dev/null) || return 0
    _v=${_l#*=}
    _v=${_v%\"}
    _v=${_v#\"}
    print -rn -- "$_v"
    return 0
}

# prof_keys <file> -> the keys the profile ACTUALLY sets (a non-empty value)
prof_keys() {
    [ -f "$1" ] || return 0
    grep -E '^[A-Z][A-Z0-9_]*=' "$1" 2>/dev/null | while IFS= read -r _l; do
        _k=${_l%%=*}
        case "$_k" in PROFILE_NAME|PROFILE_DESC) continue ;; esac
        _v=${_l#*=}
        _v=${_v%\"}
        _v=${_v#\"}
        [ -n "$_v" ] && printf '%s ' "$_k"
    done
    return 0
}

# The startup profile stickiness audit.
#
# STATUS: requirement R1 is DONE in the CLI. `profile_apply()` calls
# `restore_stock_values()` as its very first step, so all contract keys are
# restored to stock before every profile application. An empty key in a profile
# therefore no longer means "the value from the previous profile stays" but "the
# STOCK value stays" - which is exactly the intent of the contract.
#
# Verified on the device (the worst cases):
#   game  -> balanced:  thermal prop [game] -> [], uclamp.min 30 -> 0, bg 30 -> max
#   night -> balanced:  charge_stop 80 -> 100, gpu 419000 -> 890000
#
# The audit therefore runs only as DIAGNOSTICS at INFO level, and only when the
# CLI does not support the --reset flag (RESET_MODE=0). The original WARN report
# was no longer true and was confusing in the log.
audit_sticky() {
    if [ "$RESET_MODE" = "1" ]; then
        log INFO "stickiness audit: the CLI resets to stock before every profile (R1 done), audit skipped"
        return 0
    fi
    _union=""
    for _p in $AUTO_PROFILES; do
        _f="$PROFDIR/$_p.conf"
        [ -f "$_f" ] || { log WARN "profile '$_p' from AUTO_PROFILES does not exist ($_f)"; continue; }
        for _k in $(prof_keys "$_f"); do
            in_list "$_k" "$_union" || _union="$_union $_k"
        done
    done
    _union=${_union# }
    [ -n "$_union" ] || return 0

    _any=0
    for _p in $AUTO_PROFILES; do
        _f="$PROFDIR/$_p.conf"
        [ -f "$_f" ] || continue
        _has=$(prof_keys "$_f")
        _miss=""
        for _k in $_union; do
            in_list "$_k" "$_has" || _miss="$_miss $_k"
        done
        if [ -n "$_miss" ]; then
            _any=1
            log WARN "sticky keys: profile '$_p' DOES NOT set:$_miss (after switching to it the values from the previous profile remain)"
        fi
    done
    if [ "$_any" = "1" ]; then
        log WARN "stickiness is only fully solved by requirement R1 (pxtune profile <name> --auto --reset). Until then the daemon at least guards the thermal prop (prop_guard)."
    else
        log INFO "stickiness audit: all profiles in the rotation set the same set of keys"
    fi
    return 0
}

# THE ONLY EXCEPTION TO THE "the daemon does not write" RULE.
#
# game.conf sets THERMAL_PROFILE_CPU_MID/HIGH="game". In the "game" HAL profile,
# per the SPEC, the CPU cdev bindings have "Disabled": true, i.e. CPU thermal
# throttling is OFF. Because an empty value in another profile means "leave it
# alone", the prop would stay on "game" even after leaving the game - the phone
# would have its CPU thermal protection permanently disabled. That is no longer
# a "sticky profile", that is a safety problem, and it is the exact opposite of
# what this daemon is for.
#
# The daemon therefore cleans up after itself: when leaving a profile that set
# the prop to "game" and the new profile does not set it, it returns it to the
# default. It NEVER touches the value "camera" - that one is the system's.
prop_guard() {
    [ "$THERMAL_PROP_CLEAR" = "1" ] || return 0
    _new=$1
    _f="$PROFDIR/$_new.conf"
    _pm=$(prof_val "$_f" THERMAL_PROFILE_CPU_MID)
    _ph=$(prof_val "$_f" THERMAL_PROFILE_CPU_HIGH)

    for _pp in "$THERM_PROP_MID|$_pm" "$THERM_PROP_HIGH|$_ph"; do
        _prop=${_pp%%|*}
        _want=${_pp#*|}
        [ -n "$_want" ] && continue          # the new profile sets it itself
        _cur=$(getprop "$_prop" 2>/dev/null)
        if [ "$_cur" = "game" ]; then
            if setprop "$_prop" "" 2>/dev/null; then
                log WARN "$_prop returned from 'game' to the default (profile '$_new' does not set it; otherwise CPU thermal throttling would stay OFF)"
            else
                log ERROR "$_prop is 'game' and cannot be returned to the default - CPU thermal throttling stays off"
            fi
        fi
    done
    return 0
}

# therm_prop_maxskin_guard - a skin-triggered safeguard above THERM_GAME_MAXSKIN_MC.
#
# The second (and only other) exception to the "the daemon does not write" rule,
# justified exactly like prop_guard: it is cleaning up after OUR OWN game.conf,
# not tuning. game.conf sets the thermal prop to "game" and thereby disables CPU
# thermal throttling from 2 of the 4 skin sensors. prop_guard only handles a
# switch to another profile - BUT a per-app rule with APP_THERMAL_CAP=1
# (typically a game in direct sunlight) holds the "game" profile even at thermal
# level 1, so above MAX_SKIN the prop would stay stuck and the phone would cook.
# This safeguard removes it regardless of the active profile as soon as the skin
# crosses MAX_SKIN. It NEVER touches "camera" - that one is the system's.
#
# Fork-free while the skin is below the threshold: getprop (a fork) is only
# called ABOVE MAX_SKIN, which is a rare state. Called from on_tick() after
# sense(), i.e. in the thermal loop. It works together with point 1: SKIN_MC has
# already been filled in by sense().
therm_prop_maxskin_guard() {
    [ "$THERMAL_PROP_CLEAR" = "1" ] || return 0
    [ "$SKIN_MC" -gt 0 ] || return 0
    [ "$SKIN_MC" -ge "$THERM_GAME_MAXSKIN_MC" ] || return 0
    for _mgp in "$THERM_PROP_MID" "$THERM_PROP_HIGH"; do
        _mgc=$(getprop "$_mgp" 2>/dev/null)
        if [ "$_mgc" = "game" ]; then
            if setprop "$_mgp" "" 2>/dev/null; then
                log WARN "$_mgp taken off 'game' (skin ${SKIN_MC}mC >= ${THERM_GAME_MAXSKIN_MC}mC MAX_SKIN; otherwise CPU thermal throttling would stay OFF while hot)"
            else
                log ERROR "$_mgp is 'game' above MAX_SKIN and cannot be removed - CPU thermal throttling stays off while hot"
            fi
        fi
    done
    return 0
}

# ===========================================================================
# PER-APP RULES
#
# A HOT PATH. apprule_load() is called on EVERY foreground event, including when
# flicking quickly through apps. That is why there is NOT A SINGLE FORK here:
#   - looking a rule up is `[ -f "$APPDIR/$pkg.conf" ]` (hence one file per
#     package rather than one shared file - that would mean a grep = a fork =
#     7.7 ms),
#   - parsing is `while IFS='=' read` in the current shell (redirecting input
#     from a file does not create a subshell),
#   - ONLY the keys the daemon really needs are read. The rest (GAME_*,
#     APP_OVERLAY_*, APP_REFRESH_*, APP_RES*) is the business of
#     bin/pxtune-perapp and bin/pxtune; the daemon never reads them.
#
# The file is DELIBERATELY NOT SOURCED: sourcing would overwrite the daemon's
# variables and run whatever is in the file. Assignment goes through
# `eval "AR_$k=\$_arv"` = an assignment FROM A VARIABLE, not a re-evaluation of
# the content.
# ===========================================================================

apprule_load() {
    # apprule_load <pkg> -> AR_OK, AR_PKG, AR_APP_*
    AR_OK=0
    AR_PKG=""
    AR_APP_PROFILE=""
    AR_APP_MIN_FG_SEC=$APP_MIN_FG_DEF
    AR_APP_STICKY_SEC=$APP_STICKY_DEF
    AR_APP_THERMAL_CAP=0
    _arens=1

    [ "$APP_RULES" = "1" ] || return 1
    [ -n "$1" ] || return 1
    case "$1" in
        *[!A-Za-z0-9._]*) return 1 ;;
    esac
    [ -f "$APPDIR/$1.conf" ] || return 1

    while IFS='=' read -r _ark _arv; do
        case "$_ark" in
            APP_ENABLED|APP_PROFILE|APP_MIN_FG_SEC|APP_STICKY_SEC|APP_THERMAL_CAP) ;;
            *) continue ;;
        esac
        _arv=${_arv%%#*}
        while :; do
            case "$_arv" in
                *' '|*"	") _arv=${_arv%?} ;;
                *) break ;;
            esac
        done
        case "$_arv" in
            \"*\") _arv=${_arv#\"}; _arv=${_arv%\"} ;;
            \'*\') _arv=${_arv#\'}; _arv=${_arv%\'} ;;
        esac
        case "$_arv" in
            *[!A-Za-z0-9._-]*) continue ;;
        esac
        case "$_ark" in
            APP_ENABLED)
                case "$_arv" in 0|off|OFF|false|no) _arens=0 ;; esac
                ;;
            *) eval "AR_$_ark=\$_arv" ;;
        esac
    done < "$APPDIR/$1.conf"

    [ "$_arens" = "1" ] || return 1

    case "$AR_APP_MIN_FG_SEC" in ''|*[!0-9]*) AR_APP_MIN_FG_SEC=$APP_MIN_FG_DEF ;; esac
    case "$AR_APP_STICKY_SEC" in ''|*[!0-9]*) AR_APP_STICKY_SEC=$APP_STICKY_DEF ;; esac
    [ "$AR_APP_MIN_FG_SEC" -lt 1 ]    && AR_APP_MIN_FG_SEC=1
    [ "$AR_APP_MIN_FG_SEC" -gt 600 ]  && AR_APP_MIN_FG_SEC=600
    [ "$AR_APP_STICKY_SEC" -gt 3600 ] && AR_APP_STICKY_SEC=3600
    case "$AR_APP_THERMAL_CAP" in
        1|on|ON|true|yes) AR_APP_THERMAL_CAP=1 ;;
        *) AR_APP_THERMAL_CAP=0 ;;
    esac
    case "$AR_APP_PROFILE" in
        ''|*[!A-Za-z0-9_-]*) AR_APP_PROFILE="" ;;
    esac

    AR_PKG=$1
    AR_OK=1
    return 0
}

# app_sched <seconds> <message> -> a scheduler into the FIFO; the pid lands in
# APP_SCHED_PID. The only fork in the whole per-app path, and only when a rule
# really exists.
APP_SCHED_GEN=0
app_sched() {
    # The same problem as with the ticker: `kill` of the scheduler ended up as a
    # SIGTERM to the main process and took the daemon down (verified on the
    # device). The solution is the same - generations instead of killing.
    APP_SCHED_GEN=$((APP_SCHED_GEN + 1))
    _asg=$APP_SCHED_GEN
    (
        trap - TERM INT HUP USR1
        sleep "$1"
        echo "$2 #$_asg" >&3 2>/dev/null
    ) &
    APP_SCHED_PID=$!
}

# app_unsched <name of the variable holding the pid> - cancel a scheduler.
# It is the subshell that gets killed, not its `sleep`. An orphaned sleep runs
# out by itself (at most APP_STICKY_SEC) and writes nothing - its parent, which
# was to write into the FIFO, no longer exists. A group kill CANNOT be used here:
# the subshell is not a process group leader, so `kill -PID` would hit the whole
# daemon's group.
app_unsched() {
    # NO kill - see the comment at app_sched. We invalidate the generation; the
    # orphaned scheduler runs out its sleep, writes a tick with a foreign
    # generation and that gets discarded.
    APP_SCHED_GEN=$((APP_SCHED_GEN + 1))
    eval "$1="
    return 0
}

# apprule_on_foreground - called from on_foreground() AFTER CUR_PKG is set.
#
# DELAYED ENTRY / LAZY EXIT:
#   - a new package with a rule -> cancel the scheduled exit, schedule @APPARM
#     in AR_APP_MIN_FG_SEC; on processing it is verified that CUR_PKG is still it
#   - a return to the package that already holds layer 3 -> just cancel the
#     scheduled exit (zero binder calls)
#   - leaving for somewhere else -> schedule @APPLEAVE in APPMODE_STICKY
apprule_on_foreground() {
    apprule_load "$CUR_PKG"

    if [ -n "$APPMODE_PKG" ] && [ "$APPMODE_PKG" = "$CUR_PKG" ]; then
        app_unsched APPLV_PID
        app_unsched APPARM_PID
        dbg "per-app: a return to $CUR_PKG inside the sticky window, nothing changes"
        return 0
    fi

    app_unsched APPARM_PID

    if [ -n "$APPMODE_PKG" ] && [ -z "$APPLV_PID" ]; then
        app_sched "$APPMODE_STICKY" "@APPLEAVE"
        APPLV_PID=$APP_SCHED_PID
        dbg "per-app: the exit from $APPMODE_PKG scheduled in ${APPMODE_STICKY}s"
    fi

    if [ "$AR_OK" = "1" ]; then
        app_sched "$AR_APP_MIN_FG_SEC" "@APPARM $CUR_PKG"
        APPARM_PID=$APP_SCHED_PID
        dbg "per-app: a rule for $CUR_PKG, entry scheduled in ${AR_APP_MIN_FG_SEC}s"
    fi
    return 0
}

# apprule_leave_now <reason> - an immediate and IDEMPOTENT restore of layer 3.
# It never fails in a way that takes the caller down.
apprule_leave_now() {
    app_unsched APPARM_PID
    app_unsched APPLV_PID
    if [ -x "$PXTUNE" ]; then
        "$PXTUNE" app leave >/dev/null 2>&1
    else
        rm -f "$APPMODE" 2>/dev/null
    fi
    [ -n "$APPMODE_PKG" ] && log INFO "per-app: layer 3 taken down after '$APPMODE_PKG' ($1)"
    APPMODE_PKG=""
    APPMODE_STICKY=$APP_STICKY_DEF
    return 0
}

# ===========================================================================
# PROFILE DECISION MAKING
# ===========================================================================

rank_of() {
    case "$1" in
        "$PROF_LIGHT")  RANK=0 ;;
        "$PROF_NORMAL") RANK=1 ;;
        "$PROF_HEAVY")  RANK=2 ;;
        "$PROF_GAME")   RANK=3 ;;
        *)              RANK=1 ;;
    esac
    return 0
}

prof_of_rank() {
    case "$1" in
        0) print -rn -- "$PROF_LIGHT" ;;
        1) print -rn -- "$PROF_NORMAL" ;;
        2) print -rn -- "$PROF_HEAVY" ;;
        *) print -rn -- "$PROF_GAME" ;;
    esac
    return 0
}

target_profile() {
    # 1) The screen went off -> night. Nothing else is considered: with the
    #    screen off the daemon deliberately does not sample (principle #2) and
    #    "night" is the most restrictive profile we have.
    #    MEASUREMENT backs up that this breaks nothing: uclamp.max=50 gives, per
    #    the table, Little 1349 / Big 1418 / Prime 1600 MHz, which is ample for
    #    a call, navigation or music playback. UCLAMP_BG_MAX=17 in night matches
    #    exactly the measured boundary "uclamp.max <= 17.8 -> the task stays on
    #    the small cores", i.e. the background is pinned to the A510s.
    if [ "$SCREEN" = "0" ]; then
        print -rn -- "$PROF_NIGHT"
        return 0
    fi

    # 2) Heat takes precedence over everything else.
    [ "$THERM_LEVEL" -ge 3 ] && { print -rn -- "$PROF_CRIT"; return 0; }
    [ "$THERM_LEVEL" -eq 2 ] && { print -rn -- "$PROF_HOT"; return 0; }

    # 3) The basic choice by app class.
    case "$CUR_CLASS" in
        game)   _want=$PROF_GAME ;;
        heavy)  _want=$PROF_HEAVY ;;
        light)  _want=$PROF_LIGHT ;;
        *)      _want=$PROF_NORMAL ;;
    esac
    # 3b) A PER-APP RULE overrides the choice by class.
    #
    # THE PRIORITY ORDER is HARD-CODED, not configurable:
    #
    #     manual override  >  thermal/battery cap
    #                      >  per-app rule  >  adaptive daemon
    #
    # manual_override is handled in apply_profile() (the daemon does not switch
    # at all). Thermal level >= 2 is handled in step 2 above, i.e. BEFORE this
    # block - so a rule never gets near it. What remains is level 1 and the
    # battery caps below, which apply to a per-app choice exactly as they do to
    # the daemon's own. A per-app rule therefore overrides only the daemon,
    # nothing more.
    #
    # The APPMODE_PKG condition: a rule only applies once it has PASSED the
    # anti-flapping (@APPARM after APP_MIN_FG_SEC and a check that the package is
    # still in the foreground). Flicking through an app does not switch the
    # profile.
    if [ "$APP_RULES" = "1" ] && [ -n "$APPMODE_PKG" ] && [ "$APPMODE_PKG" = "$CUR_PKG" ] &&
       [ "$AR_OK" = "1" ] && [ -n "$AR_APP_PROFILE" ]; then
        if [ -f "$PROFDIR/$AR_APP_PROFILE.conf" ]; then
            _want=$AR_APP_PROFILE
            dbg "per-app: profile '$_want' from the rule for $CUR_PKG"
        else
            log ERROR "the per-app rule for $CUR_PKG wants profile '$AR_APP_PROFILE', which does not exist in $PROFDIR - using the daemon's own choice"
        fi
    fi

    rank_of "$_want"
    _r=$RANK
    _cap=3

    # 4) Thermal level 1 = "stop contributing to the heat". Capped at
    #    PROF_NORMAL (balanced = pure stock). Important above all for games:
    #    game.conf disables CPU thermal throttling via
    #    vendor.thermal.*.profile=game, which is exactly what we do not want
    #    while the temperature is rising. At the same time this is still NOT a
    #    slowdown below stock - a false alarm at level 1 therefore cannot cost
    #    the user more than the loss of a boost.
    #
    #    APP_THERMAL_CAP=1 in a rule may DISABLE this cap - but ONLY for
    #    level 1. Level >= 2 never gets here (step 2 above returns
    #    PROF_HOT/PROF_CRIT straight away), and even if the order ever changed,
    #    the test is deliberately `-eq 1`, not `-ge 1`. Without this safeguard a
    #    user would cook their phone in PoGO: the game runs for hours, often in
    #    direct sunlight, and the measured ceiling of SELF-heating is 40.5 C -
    #    everything above that is external heat that reducing the load can do
    #    nothing about.
    if [ "$THERM_LEVEL" -ge 1 ]; then
        if [ "$THERM_LEVEL" -eq 1 ] && [ "$AR_OK" = "1" ] &&
           [ "$AR_APP_THERMAL_CAP" = "1" ] && [ "$APPMODE_PKG" = "$CUR_PKG" ]; then
            dbg "per-app: $CUR_PKG has APP_THERMAL_CAP=1, thermal level 1 is ignored"
        else
            _cap=1
        fi
    fi

    # 5) Battery. While charging, the SoC-based caps do not apply.
    if [ "$BATT_PCT" -ge 0 ]; then
        if [ "$BATT_RESPECT_CHARGING" = "1" ] && [ "$BATT_CHG" = "1" ]; then
            :
        elif [ "$BATT_PCT" -le "$BATT_CRIT_PCT" ]; then
            _cap=0
        elif [ "$BATT_PCT" -le "$BATT_LOW_PCT" ]; then
            [ "$_cap" -gt 1 ] && _cap=1
        fi
    fi

    [ "$_r" -gt "$_cap" ] && _r=$_cap
    prof_of_rank "$_r"
    return 0
}

# ===========================================================================
# APPLYING A PROFILE
# ===========================================================================

auto_enabled() {
    [ -f "$AUTOF" ] || return 0
    read -r _au < "$AUTOF" 2>/dev/null || return 0
    case "$_au" in
        off|OFF|0|false) return 1 ;;
    esac
    return 0
}

# The CLI call, including detection of --reset support (requirement R1).
# When pxtune does not support --reset, it reports an argument error (exit 1)
# BEFORE applying anything - the probe is therefore safe and happens at most
# once per process lifetime.
#
# --overlay <pkg> (per-app layer 2): APP_OVERLAY_* from apps/<pkg>.conf override
# the profile keys. Support is detected at runtime exactly like --reset - when
# pxtune does not support it, it reports an argument error (exit 1) BEFORE
# applying anything, so the probe is safe and happens at most once per process
# lifetime. Without the overlay the profile is applied normally, just without the
# per-app fine-tuning.
# ovl_want -> sets OVL_WANT to the package whose overlay SHOULD be deployed right
# now (empty = none). Builtins only, no fork - it is called from apply_profile on
# every evaluation. The condition lives in ONE place deliberately, because both
# the "switch" decision and the CLI call itself rest on it.
ovl_want() {
    OVL_WANT=""
    if [ "$APP_RULES" = "1" ] && [ "$OVERLAY_MODE" = "1" ] &&
       [ -n "$APPMODE_PKG" ] && [ "$APPMODE_PKG" = "$CUR_PKG" ] && [ "$AR_OK" = "1" ]; then
        OVL_WANT=$APPMODE_PKG
    fi
}

# reapply_volatile - restore the nodes the power HAL took over on display wake.
#
# This is not a profile switch: neither 'active', manual_override nor APPLIED
# changes, so it may run even when a profile is pinned manually. Should the CLI
# not support `reapply` (an older module), the mode is disabled with a single
# logged warning so it is not retried on every unlock.
REAPPLY_MODE=1

# After a display wake the power HAL keeps writing into limit_frequency for
# another ~600 ms after the daemon receives the screen-on event (measured by
# sampling every ~150 ms: 1418000 -> 1328000 -> 1836000 -> settled). An immediate
# reapply therefore sometimes loses that race. The fix is to repeat it once more
# after a delay; 3 s is comfortably past the end of the HAL's writes and still
# sooner than the user can notice.
REAPPLY_DELAY_SEC=3

reapply_sched() {
    (
        trap - TERM INT HUP USR1
        sleep "$REAPPLY_DELAY_SEC"
        echo "@REAPPLY" >&3 2>/dev/null
    ) &
}

reapply_volatile() {
    [ "$REAPPLY_MODE" = "1" ] || return 0
    [ -x "$PXTUNE" ] || return 0
    if [ -n "$APPLIED_OVL" ]; then
        CLI_OUT=$("$PXTUNE" reapply --overlay "$APPLIED_OVL" 2>&1)
    else
        CLI_OUT=$("$PXTUNE" reapply 2>&1)
    fi
    CLI_RC=$?
    if [ "$CLI_RC" -eq 1 ]; then
        REAPPLY_MODE=0
        log WARN "pxtune does not support 'reapply' yet - the volatile nodes (dvfs_headroom, limit_frequency) will stay at stock after a display wake"
        return 0
    fi
    dbg "reapply after screen on: rc=$CLI_RC ${CLI_OUT}"
    return 0
}

apply_via_cli() {
    _t=$1
    # The overlay is only sent when the rule has PASSED the anti-flapping
    # (APPMODE_PKG) and it is still the app in the foreground.
    ovl_want
    _ovl=$OVL_WANT

    _rst=""
    [ "$AUTO_RESET" = "1" ] && [ "$RESET_MODE" = "1" ] && _rst="--reset"

    if [ -n "$_ovl" ] && [ -n "$_rst" ]; then
        CLI_OUT=$("$PXTUNE" profile "$_t" --auto --reset --overlay "$_ovl" 2>&1)
    elif [ -n "$_ovl" ]; then
        CLI_OUT=$("$PXTUNE" profile "$_t" --auto --overlay "$_ovl" 2>&1)
    elif [ -n "$_rst" ]; then
        CLI_OUT=$("$PXTUNE" profile "$_t" --auto --reset 2>&1)
    else
        CLI_OUT=$("$PXTUNE" profile "$_t" --auto 2>&1)
    fi
    CLI_RC=$?

    # Exit 1 = an argument error, i.e. BEFORE anything was applied. Only here do
    # we find out which flag the CLI does not support, and repeat the call
    # without it.
    if [ "$CLI_RC" -eq 1 ]; then
        _degr=0
        if [ -n "$_ovl" ]; then
            case "$CLI_OUT" in
                *"--overlay"*)
                    OVERLAY_MODE=0
                    _ovl=""
                    _degr=1
                    log WARN "pxtune does not support --overlay yet - the per-app overlay (APP_OVERLAY_*) will not be used, profiles run without per-app fine-tuning"
                    ;;
            esac
        fi
        if [ -n "$_rst" ]; then
            case "$CLI_OUT" in
                *unknown*|*neznamy*|*"--reset"*)
                    RESET_MODE=0
                    _rst=""
                    _degr=1
                    log WARN "pxtune does not support --auto --reset yet (requirement R1) - switching to calls without the reset; profiles will stay sticky"
                    ;;
            esac
        fi
        if [ "$_degr" = "1" ]; then
            if [ -n "$_ovl" ]; then
                CLI_OUT=$("$PXTUNE" profile "$_t" --auto --overlay "$_ovl" 2>&1)
            elif [ -n "$_rst" ]; then
                CLI_OUT=$("$PXTUNE" profile "$_t" --auto --reset 2>&1)
            else
                CLI_OUT=$("$PXTUNE" profile "$_t" --auto 2>&1)
            fi
            CLI_RC=$?
        fi
    fi
    # Which overlay ACTUALLY went to the CLI (after any degradation above).
    # apply_profile reads this and stores it in APPLIED_OVL.
    CLI_OVL=$_ovl
    return 0
}

# A safeguard against pathological switching. Thermal interventions (bypass) always pass.
switch_allowed() {
    [ "$1" = "1" ] && return 0
    [ "$SW_LOCK_UNTIL" -gt "$NOW" ] && return 1
    if [ "$((NOW - SW_WIN))" -ge 3600 ]; then
        SW_WIN=$NOW
        SW_CNT=0
    fi
    if [ "$SW_CNT" -ge "$MAX_SWITCH_HOUR" ]; then
        SW_LOCK_UNTIL=$((NOW + SWLOCK_SEC))
        log ERROR "profile switches $SW_CNT/h exceeded the cap of $MAX_SWITCH_HOUR - for ${SWLOCK_SEC}s only thermal interventions are allowed"
        return 1
    fi
    return 0
}

apply_profile() {
    # apply_profile <profile> <bypass 0|1> <reason>
    _t=$1; _bp=$2; _why=$3
    [ -n "$_t" ] || return 0

    # pxtune auto off -> we only observe, we do not switch (the CLI reads the same file)
    if ! auto_enabled; then
        dbg "auto=off, not switching (I wanted $_t, reason: $_why)"
        PENDING=""
        return 0
    fi

    # manual_override = the user pinned a profile by hand; neither the daemon
    # nor the temperature may overwrite it. THE ONLY EXCEPTION: a per-app rule
    # for the package currently in the foreground. The user set that explicitly
    # too and it is TEMPORARY (it is restored on leaving the app), so it
    # OVERRIDES the manual pin. We store the manual base in MBASE and force it
    # back on exit; the manual_override file stays untouched the whole time, so
    # after the game we return to exactly what was there.
    if [ ! -e "$MANUAL" ]; then
        # Without an override, MBASE makes no sense (e.g. the user has since run 'profile auto').
        [ -e "$MBASE" ] && rm -f "$MBASE" 2>/dev/null
    else
        _perapp=0
        if [ "$APP_RULES" = "1" ] && [ -n "$APPMODE_PKG" ] && [ "$APPMODE_PKG" = "$CUR_PKG" ] &&
           [ "$AR_OK" = "1" ] && [ -n "$AR_APP_PROFILE" ] && [ "$_t" = "$AR_APP_PROFILE" ]; then
            _perapp=1
        fi
        if [ "$_perapp" = "1" ]; then
            # A per-app profile over an override: remember the manual base (only
            # once, while we have not started overwriting yet) and fall through
            # to applying it.
            if [ ! -e "$MBASE" ]; then
                _mb=""
                [ -f "$ACTIVE" ] && read -r _mb < "$ACTIVE" 2>/dev/null
                case "$_mb" in
                    ''|*[!A-Za-z0-9._-]*) _mb="" ;;
                esac
                if [ -n "$_mb" ] && [ "$_mb" != "$_t" ]; then
                    print -r -- "$_mb" > "$MBASE" 2>/dev/null
                    dbg "per-app over an override: the manual base '$_mb' stored, it will be restored on exit"
                fi
            fi
        elif [ -e "$MBASE" ]; then
            # Leaving a per-app episode: ignore the target chosen by the daemon
            # and force a return to the stored manual base. MBASE is deleted only
            # once the base is really active (so it survives the anti-flap
            # delay).
            _mb=""
            read -r _mb < "$MBASE" 2>/dev/null
            case "$_mb" in
                ''|*[!A-Za-z0-9._-]*) rm -f "$MBASE" 2>/dev/null; PENDING=""; return 0 ;;
            esac
            if [ ! -f "$PROFDIR/$_mb.conf" ]; then
                rm -f "$MBASE" 2>/dev/null
                PENDING=""
                return 0
            fi
            _act=""
            [ -f "$ACTIVE" ] && read -r _act < "$ACTIVE" 2>/dev/null && [ -n "$_act" ] && APPLIED=$_act
            if [ "$_mb" = "$APPLIED" ]; then
                rm -f "$MBASE" 2>/dev/null   # the return to the manual base is done
                PENDING=""
                return 0
            fi
            _t="$_mb"
            dbg "per-app exit: forcing a return to the manual base '$_mb' (the override stays)"
        else
            # FIX 2026-08-12. MBASE is only created when the per-app profile is
            # NAMED differently from the manual base. Except the rules for both
            # PoGO and Instagram have APP_PROFILE="powersave", and the manually
            # pinned profile was powersave too - the same name, so MBASE was
            # never created, leaving the app fell through to here and the overlay
            # was NEVER removed. Measured: after leaving PoGO its GPU cap of
            # 723000 and Instagram's uclamp of 55 instead of 60 held for another
            # 16 minutes, until something else moved the profile.
            #
            # Changing the OVERLAY ALONE on an ALREADY ACTIVE profile is not a
            # profile switch - the manual pin stays exactly what it was - so
            # there is no reason for the override to block it. Anything that
            # would change the NAME of the profile falls through to the original
            # branch and stays forbidden.
            ovl_want
            _act=""
            if [ -f "$ACTIVE" ]; then
                read -r _act < "$ACTIVE" 2>/dev/null && [ -n "$_act" ] && APPLIED=$_act
            fi
            if [ "$_t" != "$APPLIED" ] || [ "$OVL_WANT" = "$APPLIED_OVL" ]; then
                dbg "manual_override exists, not switching (I wanted $_t, reason: $_why)"
                PENDING=""
                return 0
            fi
            dbg "override: changing only the overlay ('${APPLIED_OVL:-none}' -> '${OVL_WANT:-none}') on the active profile $_t, letting it through ($_why)"
        fi
    fi

    # Resync against reality - somebody outside may have switched the profile (WebUI, CLI).
    if [ -f "$ACTIVE" ]; then
        read -r _act < "$ACTIVE" 2>/dev/null && [ -n "$_act" ] && APPLIED=$_act
    fi
    # The same profile NAME does not yet mean the same RESULT: the per-app
    # overlay (APP_OVERLAY_*) overwrites profile keys, so "powersave + the
    # Instagram overlay" and "bare powersave" are two different node states.
    #
    # FIX 2026-08-08 (measured live): the earlier test on the name alone was
    # wrong in both directions. On LEAVING an app the overlay stayed stuck
    # forever (Instagram: top-app uclamp.max 55 instead of 60 for minutes after
    # leaving, until something else changed the profile). On ENTERING, by
    # contrast, the overlay was NOT DEPLOYED at all when the profile the rule
    # wants happened to be running already. We therefore compare the pair
    # (profile, overlay).
    ovl_want
    if [ "$_t" = "$APPLIED" ] && [ "$OVL_WANT" = "$APPLIED_OVL" ]; then
        PENDING=""
        return 0
    fi

    # Changing the OVERLAY ALONE while the profile is UNCHANGED is not a profile
    # switch - it is only a reparametrisation of what is already running. It must
    # therefore not go through the anti-flapping (MIN_SWITCH_SEC=30 s), otherwise
    # on entering an app the overlay would be postponed beyond the sticky window
    # and NOT be deployed at all (measured). There is no risk of abuse: the
    # per-app path has its own brakes - APP_MIN_FG_SEC on entry and
    # APP_STICKY_SEC on exit. For the same reason it counts neither towards
    # SW_CNT nor moves LAST_SWITCH.
    if [ ! -f "$PROFDIR/$_t.conf" ]; then
        log ERROR "profile '$_t' does not exist in $PROFDIR - using '$PROF_SAFE'"
        _t=$PROF_SAFE
        [ -f "$PROFDIR/$_t.conf" ] || { PENDING=""; return 0; }
        [ "$_t" = "$APPLIED" ] && [ "$OVL_WANT" = "$APPLIED_OVL" ] && { PENDING=""; return 0; }
    fi

    # COMPUTED ONLY HERE, after any fall back to PROF_SAFE - otherwise the
    # decision would be based on a profile that no longer applies.
    _ovlonly=0
    if [ "$_t" = "$APPLIED" ]; then
        _ovlonly=1
    fi

    if [ "$_bp" != "1" ] && [ "$_ovlonly" != "1" ] && [ "$((NOW - LAST_SWITCH))" -lt "$MIN_SWITCH_SEC" ]; then
        PENDING=$_t
        dbg "anti-flap: $_t postponed by $((MIN_SWITCH_SEC - (NOW - LAST_SWITCH))) s ($_why)"
        return 0
    fi

    if [ "$_ovlonly" != "1" ] && ! switch_allowed "$_bp"; then
        PENDING=$_t
        return 0
    fi

    if camera_active; then
        PENDING=$_t
        log INFO "the camera is running, the switch to $_t is postponed (we do not interfere with the system's camera control)"
        return 0
    fi

    if [ ! -x "$PXTUNE" ]; then
        if [ "$((NOW - PXTUNE_FAIL_AT))" -ge "$PXTUNE_RETRY_SEC" ]; then
            PXTUNE_FAIL_AT=$NOW
            log ERROR "$PXTUNE does not exist or is not executable - I will retry in ${PXTUNE_RETRY_SEC}s at the earliest"
        fi
        PENDING=$_t
        return 0
    fi

    apply_via_cli "$_t"
    if [ "$CLI_RC" -eq 0 ]; then
        prop_guard "$_t"
        APPLIED=$_t
        APPLIED_OVL=$CLI_OVL
        PENDING=""
        PXTUNE_FAIL_AT=0
        if [ "$_ovlonly" = "1" ]; then
            log INFO "profile $_t reparametrised (overlay '${CLI_OVL:-none}', $_why)"
        else
            LAST_SWITCH=$NOW
            SW_CNT=$((SW_CNT + 1))
            log INFO "profile -> $_t ($_why)"
        fi
    else
        # pxtune returns 2 even when only SOME of the writes failed - while it
        # has already loaded the profile and written it into 'active'. We must
        # therefore not discard the state blindly (the previous version did and
        # the daemon then did not know what was set).
        if [ -f "$ACTIVE" ]; then
            read -r _act < "$ACTIVE" 2>/dev/null && [ -n "$_act" ] && APPLIED=$_act
        fi
        if [ "$APPLIED" = "$_t" ]; then
            prop_guard "$_t"
            APPLIED_OVL=$CLI_OVL
            LAST_SWITCH=$NOW
            PENDING=""
            SW_CNT=$((SW_CNT + 1))
            log WARN "pxtune profile $_t exited with code $CLI_RC, but the profile IS active (some writes failed): $CLI_OUT"
        else
            PENDING=$_t
            PXTUNE_FAIL_AT=$NOW
            log ERROR "pxtune profile $_t --auto exited with code $CLI_RC and the profile is NOT active: $CLI_OUT"
        fi
    fi
    return 0
}

evaluate() {
    # evaluate <reason> [bypass]
    apply_profile "$(target_profile)" "${2:-0}" "$1"
    ticker_sync
    return 0
}

# ===========================================================================
# THE TICKER
#
# The only timer in the whole daemon. It runs ONLY while the screen is on; when
# the screen goes off it is killed immediately, so there is no alarm at all
# during suspend.
# (In addition: a pending CLOCK_MONOTONIC timer neither prevents entering
#  suspend nor wakes from it - suspend is governed by wakelocks. Stopping it is
#  here for safety and for economy.)
# ===========================================================================

tick_period() {
    if [ "$SCREEN" != "1" ]; then
        printf '0'
        return 0
    fi
    if [ "$THERM_LEVEL" -gt 0 ] || [ -n "$PENDING" ] ||
       [ "$CUR_CLASS" = "game" ] || [ "$CUR_CLASS" = "heavy" ]; then
        print -rn -- "$TICK_BUSY_SEC"
        return 0
    fi
    if [ "$CUR_CLASS" = "light" ] && [ "$SKIN_MC" -gt 0 ] &&
       [ "$SKIN_MC" -lt "$((THERM_WARN_MC - TICK_IDLE_MARGIN_MC))" ]; then
        print -rn -- "$TICK_IDLE_SEC"
        return 0
    fi
    print -rn -- "$TICK_SEC"
    return 0
}

# A TICKER WITHOUT KILLING
#
# Originally the old ticker was terminated with `kill "$TICK_PID"`. Measured on
# the device: the daemon then received a SIGTERM ~2 s after every period change
# and exited (log: "cleanup invoked: reason='SIGTERM'" right after "ticker:
# period Ns"). Resetting the traps inside the subshell did not solve it, so the
# signal ended up at the main process - probably via the process group the daemon
# leads (it runs under setsid).
#
# The kill-free solution: every ticker gets a GENERATION. It writes
# "@TICK <gen>" into the FIFO and the main loop discards ticks with a foreign
# generation. The old ticker also exits by itself as soon as it finds it is no
# longer current. No signal, no risk.
TICK_GEN=0
GENF="$STATE/pxtune-auto.tickgen"
ticker_stop() {
    # We only invalidate the generation. The old subshell runs out its sleep,
    # writes a tick, that gets discarded, and the subshell exits by itself when
    # it checks the generation.
    TICK_GEN=$((TICK_GEN + 1))
    TICK_PID=""
    TICK_CUR=0
    return 0
}

ticker_sync() {
    _p=$(tick_period)
    if [ "$_p" = "0" ]; then
        if [ -n "$TICK_PID" ]; then
            dbg "ticker stopped"
            ticker_stop
        fi
        return 0
    fi
    [ "$_p" = "$TICK_CUR" ] && [ -n "$TICK_PID" ] && return 0
    ticker_stop
    _gen=$TICK_GEN
    (
        # The subshell inherits the main process's traps (including
        # `trap cleanup TERM`), so we reset them to be safe - even though nobody
        # kills it any more.
        trap - TERM INT HUP USR1
        while :; do
            sleep "$_p"
            # The generation is sent with the tick; the main loop discards foreign ticks.
            echo "@TICK $_gen" >&3 2>/dev/null || exit 0
            # When we are no longer the current ticker, we exit by ourselves.
            [ -f "$GENF" ] && { IFS= read -r _g < "$GENF" 2>/dev/null; [ "$_g" = "$_gen" ] || exit 0; }
        done
    ) &
    TICK_PID=$!
    TICK_CUR=$_p
    { print -r -- "$_gen" > "$GENF"; } 2>/dev/null
    dbg "ticker: period ${_p}s gen $_gen (pid $TICK_PID)"
    return 0
}

# ===========================================================================
# A WATCHDOG OVER ITSELF
#
# A child of the main process. When the main process disappears WITHOUT creating
# the EXITF marker (i.e. it crashed, got SIGKILL, was taken by the LMK), the
# watchdog cleans up the lock and starts a new instance. On a clean exit it
# inherits the group kill from cleanup() and dies with it.
#
# `sleep` = nanosleep(CLOCK_MONOTONIC) does not advance during suspend => the
# watchdog generates not a single wakeup while suspended. WD_SEC is clamped to at
# least 60 s.
#
# WHAT THE WATCHDOG CANNOT DO (and why): tell a stuck daemon from an idle one.
# Idleness is the NORMAL and desired state (a blocking read on the FIFO), so
# "it has done nothing for a long time" must not be a reason to restart. The
# heartbeat in $ALIVEF is therefore only for diagnostics (`pxtune-auto status`),
# not for decisions.
# ===========================================================================

watchdog() {
    _parent=$1
    while :; do
        sleep "$WD_SEC"
        [ -e "$EXITF" ] && exit 0
        [ -d "/proc/$_parent" ] && continue
        log ERROR "watchdog: the main process (pid $_parent) disappeared without cleaning up - starting a new instance"
        rm -f "$PIDF" "$FIFO" 2>/dev/null
        rmdir "$LOCKD" 2>/dev/null
        if command -v setsid >/dev/null 2>&1; then
            setsid "$SELF" run >/dev/null 2>&1 &
        else
            "$SELF" run >/dev/null 2>&1 &
        fi
        exit 0
    done
}

# ===========================================================================
# EVENT HANDLING
# ===========================================================================

on_screen() {
    # on_screen <0|1>
    _s=$1
    [ "$_s" = "$SCREEN" ] && return 0
    if [ "$_s" = "0" ]; then
        sample_finish            # the foreground session ends when the screen goes off
        SCREEN=0
        # The 2nd of the SIX paths that must call `app leave` (the list and the
        # reasons are in the comment at cmd_leave() in bin/pxtune-perapp). With
        # the screen off the user can no longer see the app and another
        # foreground event may never arrive - without this they would stay locked
        # at 60 Hz / someone else's resolution quite possibly until the next
        # reboot.
        apprule_leave_now "the screen went off"
        # The derivative MUST be invalidated: we have no samples across the
        # suspend and the old slope would be extrapolated from unrelated points
        # after the wake.
        SKIN_PREV_MC=-1
        SKIN_SLOPE=0
        log INFO "the screen went off -> $PROF_NIGHT (sampling stopped, no alarms)"
        evaluate "screen off" 1
    else
        SCREEN=1
        SKIN_PREV_MC=-1
        SKIN_SLOPE=0
        sense
        therm_eval
        log INFO "the screen is on (foreground ${CUR_PKG:-?}/$CUR_CLASS, skin ${SKIN_MC}mC, level $THERM_LEVEL)"
        # On every display wake the power HAL returns dvfs_headroom and BOTH
        # sched_pixel limit_frequency values to stock (measured 2026-08-12 with a
        # snapshot of 24 nodes across a SLEEP/WAKEUP cycle). Without this the
        # profiles' clock caps were dead from the first unlock of the phone.
        # `reapply` writes only these volatile nodes - no revert, at most 4
        # writes.
        #
        # Twice on purpose: immediately (often enough and with no delay) and once
        # more after REAPPLY_DELAY_SEC, because the HAL keeps writing after the
        # screen-on event reaches us. The call is idempotent - when things already
        # match, the second run writes nothing.
        reapply_volatile
        reapply_sched
        # Layer 3 was taken down when the screen went off. When the user returns
        # to the same package it has to be SCHEDULED again (not deployed at
        # once) - otherwise a flick of the screen would bypass the whole
        # anti-flapping.
        apprule_on_foreground
        evaluate "screen on" 1
        sample_start "$CUR_PKG"
    fi
    return 0
}

on_foreground() {
    # on_foreground <pkg>
    _p=$1
    [ -n "$_p" ] || return 0
    in_list "$_p" "$IGNORE_PKGS" && return 0
    [ "$_p" = "$CUR_PKG" ] && return 0

    sample_finish                 # close the window of the previous app
    CUR_PKG=$_p
    CUR_CLASS=$(app_class "$_p")
    dbg "foreground: $_p ($CUR_CLASS)"
    # The per-app rule: loading it is fork-free (`[ -f ]` + the read builtin), so
    # this costs nothing even when flicking quickly through apps. The actual
    # intervention is ONLY SCHEDULED - entry is delayed, exit is lazy. See
    # apprule_load().
    apprule_on_foreground
    sense
    therm_eval
    evaluate "foreground $_p/$CUR_CLASS" 0
    sample_start "$_p"
    return 0
}

on_tick() {
    sense
    # A skin-triggered safeguard: above MAX_SKIN remove the "game" thermal prop,
    # even when a per-app APP_THERMAL_CAP otherwise holds the game profile (see
    # the function above).
    therm_prop_maxskin_guard
    if therm_eval; then
        # The level changed -> intervene without waiting for the anti-flap. Given
        # the HAL will take 84 s to release us, there is no point adding a delay
        # of our own.
        evaluate "temperature level $THERM_LEVEL (skin ${SKIN_MC}mC slope ${SKIN_SLOPE}mC/100s prediction ${SKIN_PRED}mC junction ${JUNC_MC}mC)" 1
        return 0
    fi
    dbg "tick: skin ${SKIN_MC}mC slope ${SKIN_SLOPE} pred ${SKIN_PRED} junc ${JUNC_MC}/${JUNC_SRC:-?} level $THERM_LEVEL bat ${BATT_PCT}% chg $BATT_CHG pending '${PENDING}'"
    if [ -n "$PENDING" ]; then
        evaluate "postponed switch" 0
    else
        evaluate "tick" 0
    fi
    return 0
}

handle_line() {
    _l=$1
    case "$_l" in
        '@TICK'|'@TICK '*)
            on_tick
            return 0
            ;;
        '@RESTART '*)
            log WARN "logcat crashed, restarting in ${_l#@RESTART } s"
            return 0
            ;;
        '@UP')
            dbg "logcat is running"
            return 0
            ;;
        '@REAPPLY')
            # The delayed second attempt after screen on (see reapply_sched).
            # The generation is deliberately not checked: reapply is idempotent,
            # so neither a duplicate nor a late event can break anything. The
            # only condition is that the screen is still on - with it off, night
            # is applied anyway and the HAL has no say in it.
            [ "$SCREEN" = "1" ] || return 0
            reapply_volatile
            return 0
            ;;
        '@APPARM '*)
            # DELAYED ENTRY. Scheduled in apprule_on_foreground()
            # APP_MIN_FG_SEC seconds ago. ONLY NOW is it verified that the
            # package is still in the foreground - an app start produces 2-5
            # events over ~2 s (splash -> main activity) and flicking quickly
            # through apps never gets this far.
            APPARM_PID=""
            _ap=${_l#@APPARM }
            # The scheduler appends " #<generation>" (see app_sched) - we just
            # cut it off. The generation is DELIBERATELY NOT CHECKED here: every
            # scheduling increments it, so a pending event would invalidate
            # itself (measured - the rule was loaded but never deployed). The
            # real safeguard is the test below that the package is STILL in the
            # foreground; that filters out quick flicking through apps reliably
            # and without side effects.
            case "$_ap" in
                *" #"*) _ap=${_ap%" #"*} ;;
            esac
            if [ "$_ap" != "$CUR_PKG" ]; then
                dbg "per-app: @APPARM $_ap discarded, the foreground is already ${CUR_PKG:-?}"
                return 0
            fi
            [ "$APPMODE_PKG" = "$_ap" ] && return 0
            apprule_load "$_ap" || return 0
            # Layer 3 is written by pxtune-perapp (binder!), not by the daemon.
            # The daemon only forks the CLI - `cmd`/`settings` never run in this
            # process.
            if [ -x "$PXTUNE" ]; then
                "$PXTUNE" app enter "$_ap" >/dev/null 2>&1
            else
                log ERROR "$PXTUNE is not executable - layer 3 for $_ap was not deployed"
                return 0
            fi
            APPMODE_PKG=$_ap
            APPMODE_STICKY=$AR_APP_STICKY_SEC
            log INFO "per-app: $_ap deployed (layer 3; profile='${AR_APP_PROFILE:-daemon}' thermal_cap=$AR_APP_THERMAL_CAP sticky=${APPMODE_STICKY}s)"
            evaluate "per-app $_ap" 1
            return 0
            ;;
        '@APPLEAVE'|'@APPLEAVE '*)
            # the scheduler appends " #<generation>" - discard a tick from an invalidated one
            case "$_l" in
                *" #"*)
                    _alg=${_l##*" #"}
                    if [ "$_alg" != "$APP_SCHED_GEN" ]; then
                        dbg "per-app: @APPLEAVE discarded (old generation $_alg)"
                        return 0
                    fi
                    ;;
            esac
            # LAZY EXIT. Scheduled APPMODE_STICKY seconds ago. If the user has
            # returned in the meantime, apprule_on_foreground() has already
            # cancelled the scheduler; this is only a second safeguard against a
            # race.
            APPLV_PID=""
            [ -n "$APPMODE_PKG" ] || return 0
            if [ "$CUR_PKG" = "$APPMODE_PKG" ]; then
                dbg "per-app: a return to $APPMODE_PKG, the exit was cancelled"
                return 0
            fi
            apprule_leave_now "left the app"
            apprule_load "$CUR_PKG"
            evaluate "per-app exit" 0
            return 0
            ;;
        '@SRCFAIL')
            # The event source cannot be kept alive. We must not stay stuck in a
            # restrictive profile just because we can no longer see what is
            # happening.
            if [ "$APPLIED" != "$PROF_SAFE" ] && [ "$THERM_LEVEL" -eq 0 ]; then
                log ERROR "the event source keeps crashing - restoring the neutral profile $PROF_SAFE so the phone does not stay throttled blindly"
                apply_profile "$PROF_SAFE" 1 "event source failure"
            fi
            return 0
            ;;
    esac

    if [ -n "$SCR_TAG" ]; then
        case "$_l" in
            *" $SCR_TAG: ["*)
                ev_payload "$_l" || return 0
                case "${EVP%%,*}" in
                    0) on_screen 0 ;;
                    1) on_screen 1 ;;
                esac
                return 0
                ;;
        esac
    fi

    if [ -n "$FG_TAG" ]; then
        case "$_l" in
            *" $FG_TAG: ["*)
                ev_payload "$_l" || return 0
                ev_pkg || return 0
                on_foreground "$EVPKG"
                return 0
                ;;
        esac
    fi
    return 0
}

# ===========================================================================
# THE EVENT SOURCE
# ===========================================================================

grep_re() {
    _re=""
    [ -n "$FG_TAG" ] && _re="$FG_TAG"
    if [ -n "$SCR_TAG" ]; then
        if [ -n "$_re" ]; then _re="$_re|$SCR_TAG"; else _re="$SCR_TAG"; fi
    fi
    [ -z "$_re" ] && _re="wm_resume_activity|power_screen_state"
    printf ' (%s): \\[' "$_re"
}

probe_grep() {
    # toybox grep supports --line-buffered, but we do not rely on that blindly:
    # without line buffering the events would pile up in the pipe (up to 4 kB)
    # and the reaction to the screen going off would arrive minutes late.
    if printf 'x\n' | grep --line-buffered x >/dev/null 2>&1; then
        GREPLB="--line-buffered"
        SHELL_FILTER=0
    else
        GREPLB=""
        SHELL_FILTER=1
        log WARN "grep does not support --line-buffered, filtering in the shell instead (more wakeups while the screen is on)"
    fi
    return 0
}

supervisor() {
    # A blocking reader. When logcat dies it is restarted with exponential
    # backoff. No polling - it hangs on the pipe until logcat ends.
    _bo=1
    _fails=0
    _re=$(grep_re)
    while :; do
        tick_now; _t0=$NOW
        echo "@UP" >&3 2>/dev/null || return 0
        if [ "$SHELL_FILTER" = "1" ]; then
            logcat -b events -v threadtime -T 1 2>/dev/null >&3
        else
            logcat -b events -v threadtime -T 1 2>/dev/null |
                grep -E $GREPLB "$_re" >&3
        fi
        tick_now
        if [ "$((NOW - _t0))" -ge 60 ]; then
            _bo=1
            _fails=0
        else
            _bo=$((_bo * 2))
            [ "$_bo" -gt 300 ] && _bo=300
            _fails=$((_fails + 1))
            # 5 crashes in a row, each within 60 s => logcat does not work on
            # this system. Tell the main process so it does not stay stuck in a
            # restrictive profile blindly.
            [ "$_fails" -eq 5 ] && echo "@SRCFAIL" >&3 2>/dev/null
        fi
        echo "@RESTART $_bo" >&3 2>/dev/null || return 0
        sleep "$_bo"
    done
}

# ===========================================================================
# THE INITIAL STATE
#
# A one-off load at startup - it happens exactly once, it is not polling.
# dumpsys is DELIBERATELY NOT USED: the SPEC warns that it hangs on binder under su.
# ===========================================================================

prime_state() {
    _dump=$(logcat -b events -v threadtime -d -t 600 2>/dev/null)

    if [ -n "$SCR_TAG" ]; then
        _l=$(print -r -- "$_dump" | grep -E " $SCR_TAG: \[" 2>/dev/null | tail -n 1)
        if [ -n "$_l" ] && ev_payload "$_l"; then
            case "${EVP%%,*}" in
                0) SCREEN=0 ;;
                1) SCREEN=1 ;;
            esac
        fi
    fi

    if [ -n "$FG_TAG" ]; then
        _l=$(print -r -- "$_dump" | grep -E " $FG_TAG: \[" 2>/dev/null | tail -n 1)
        if [ -n "$_l" ] && ev_payload "$_l" && ev_pkg; then
            if ! in_list "$EVPKG" "$IGNORE_PKGS"; then
                CUR_PKG=$EVPKG
                CUR_CLASS=$(app_class "$EVPKG")
            fi
        fi
    fi

    # The 4th of the SIX paths that must call `app leave`. The previous instance
    # may have died mid-episode (SIGKILL, LMK, a crash) leaving layer 3 deployed
    # - appmode.active in /data survives that, but no in-memory state does. We
    # therefore start from a clean floor; when the app is still in the
    # foreground, it is redeployed after APP_MIN_FG_SEC on the first event.
    APPMODE_PKG=""
    if [ -f "$APPMODE" ]; then
        log WARN "found $APPMODE from the life of a previous instance - restoring layer 3 to its default state"
        apprule_leave_now "a new instance starting"
    fi
    apprule_load "$CUR_PKG"

    sense
    therm_eval
    if [ -f "$ACTIVE" ]; then
        read -r APPLIED < "$ACTIVE" 2>/dev/null
    fi

    # Cleanup after a possible crash: when the thermal prop is stuck on "game"
    # but the active profile does not report a game, the phone would have CPU
    # thermal throttling disabled.
    if [ -n "$APPLIED" ] && [ "$APPLIED" != "$PROF_GAME" ]; then
        camera_active || prop_guard "$APPLIED"
    fi

    log INFO "initial state: screen=$SCREEN foreground=${CUR_PKG:-?} class=$CUR_CLASS skin=${SKIN_MC}mC junction=${JUNC_MC}mC level=$THERM_LEVEL battery=${BATT_PCT}%/chg=$BATT_CHG/${BATT_TEMP_DC}dC profile=${APPLIED:-?}"
    return 0
}

# ===========================================================================
# LIFECYCLE
# ===========================================================================

cleanup() {
    log WARN "cleanup invoked: reason='${1:-unknown}' (diagnostics)"
    trap '' TERM INT HUP USR1
    : > "$EXITF" 2>/dev/null          # watchdog: this exit is intentional

    # The 3rd of the SIX paths that must call `app leave`. After SIGTERM nobody
    # else would take layer 3 down - and unlike the profile (layer 2, restored
    # for free via restore_stock_values), the refresh rate and resolution would
    # stay stuck. It has to come BEFORE the group kill below, otherwise the CLI
    # fork would not survive.
    apprule_leave_now "a clean daemon shutdown"

    # DEADMAN: do not leave the phone in a restrictive profile when nobody is
    # watching it any more. We do this only when the profile was driven by the
    # daemon (no manual_override) and only when it is not actually PROF_SAFE
    # already.
    if [ -x "$PXTUNE" ] && [ ! -e "$MANUAL" ] && auto_enabled; then
        if [ -n "$APPLIED" ] && [ "$APPLIED" != "$PROF_SAFE" ]; then
            log INFO "exiting - restoring the neutral profile $PROF_SAFE (it was '$APPLIED')"
            "$PXTUNE" profile "$PROF_SAFE" --auto >/dev/null 2>&1
            prop_guard "$PROF_SAFE"
        else
            prop_guard "${APPLIED:-$PROF_SAFE}"
        fi
    fi

    log INFO "exiting (pid $$)"
    ticker_stop
    [ -n "$WD_PID" ]  && kill "$WD_PID"  2>/dev/null
    [ -n "$SUP_PID" ] && kill "$SUP_PID" 2>/dev/null
    # The group kill finishes off logcat/grep/sleep. It only works when we are
    # the process group leader (i.e. when `start` launched us via setsid);
    # otherwise a group with pgid == $$ does not exist and the kill merely
    # returns an error. Safe - a pgid always equals the leader's pid, so a
    # foreign group cannot be hit.
    kill -TERM "-$$" 2>/dev/null
    exec 3>&- 2>/dev/null
    rm -f "$FIFO" "$PIDF" "$APPSTATS.tmp" 2>/dev/null
    rmdir "$LOCKD" 2>/dev/null
    exit 0
}

on_hup() {
    tick_now
    conf_load
    cfg_clamp_all
    sense
    therm_eval
    log INFO "SIGHUP - auto.conf reloaded, re-evaluating the state"
    evaluate "sighup" 1
    return 0
}

on_usr1() {
    tick_now
    log INFO "STATE: screen=$SCREEN foreground=${CUR_PKG:-?} class=$CUR_CLASS profile=${APPLIED:-?} pending=${PENDING:-'-'}"
    log INFO "STATE: skin=${SKIN_MC}mC slope=${SKIN_SLOPE}mC/100s prediction=${SKIN_PRED}mC junction=${JUNC_MC}mC/${JUNC_SRC:-?} level=$THERM_LEVEL (up=$THERM_UPC down=$THERM_DOWNC held $((NOW - THERM_SINCE))s)"
    log INFO "STATE: battery=${BATT_PCT}% charging=$BATT_CHG temperature=${BATT_TEMP_DC}dC | switches $SW_CNT/h lock=$SW_LOCK_UNTIL | ticker=${TICK_CUR}s(${TICK_PID:-'-'}) | reset_mode=$RESET_MODE overlay_mode=$OVERLAY_MODE | tags $FG_TAG/$SCR_TAG"
    log INFO "STATE: per-app rule=${AR_PKG:-'-'}(ok=$AR_OK profile=${AR_APP_PROFILE:-'-'} thermal_cap=$AR_APP_THERMAL_CAP min_fg=${AR_APP_MIN_FG_SEC}s sticky=${AR_APP_STICKY_SEC}s) | layer3 on=${APPMODE_PKG:-'-'} | schedulers arm=${APPARM_PID:-'-'} leave=${APPLV_PID:-'-'}"
    return 0
}

acquire_lock() {
    if mkdir "$LOCKD" 2>/dev/null; then
        return 0
    fi
    # the lock exists - is its owner still alive?
    if [ -f "$PIDF" ]; then
        read -r _op < "$PIDF" 2>/dev/null
        case "$_op" in
            ''|*[!0-9]*) _op="" ;;
        esac
        if [ -n "$_op" ] && [ -d "/proc/$_op" ]; then
            _cl=$(tr '\0' ' ' < "/proc/$_op/cmdline" 2>/dev/null)
            case "$_cl" in
                *pxtune-auto*) return 1 ;;
            esac
        fi
        # The owner is dead. Its children (logcat, grep, sleep) may still be
        # alive though, hanging on a write into the old FIFO. It was the process
        # group leader, so pgid == its pid -> we clear the whole group at once.
        [ -n "$_op" ] && kill -TERM "-$_op" 2>/dev/null
    fi
    log WARN "removing an orphaned lock"
    rm -f "$PIDF" 2>/dev/null
    rmdir "$LOCKD" 2>/dev/null
    mkdir "$LOCKD" 2>/dev/null || return 1
    return 0
}

do_run() {
    if ! acquire_lock; then
        echo "pxtune-auto is already running (pid $(cat "$PIDF" 2>/dev/null))" >&2
        exit 1
    fi
    echo $$ > "$PIDF"
    rm -f "$EXITF" 2>/dev/null

    trap 'cleanup SIGTERM' TERM
    trap 'cleanup SIGINT' INT
    trap on_hup HUP
    trap on_usr1 USR1

    log INFO "start (pid $$)"
    tick_now
    conf_load
    cfg_clamp_all
    resolve_sensors
    stats_sanity
    detect_tags
    probe_grep
    audit_sticky

    if [ ! -d "$PROFDIR" ]; then
        log ERROR "$PROFDIR does not exist - the daemon has nothing to switch, exiting"
        cleanup "PROFDIR missing"
    fi

    rm -f "$FIFO" 2>/dev/null
    if ! mkfifo "$FIFO" 2>/dev/null; then
        log ERROR "cannot create the FIFO $FIFO"
        cleanup "mkfifo failed"
    fi
    # <> keeps the pipe permanently open for both reading and writing => read never gets EOF
    exec 3<> "$FIFO" || { log ERROR "cannot open the FIFO"; cleanup "cannot open the FIFO"; }

    prime_state
    evaluate "start" 1
    sample_start "$CUR_PKG"

    supervisor &
    SUP_PID=$!
    watchdog $$ &
    WD_PID=$!
    log INFO "supervisor pid $SUP_PID, watchdog pid $WD_PID (period ${WD_SEC}s)"

    # The main loop: a blocking read. Between events this process DOES NOT RUN.
    while :; do
        if IFS= read -r _line <&3; then
            RDFAIL=0
            tick_now
            : > "$ALIVEF" 2>/dev/null      # a heartbeat for diagnostics (no fork)
            handle_line "$_line"
        else
            # the read was interrupted by a signal (the trap has already run) - EOF cannot happen, we hold fd 3 <>
            RDFAIL=$((RDFAIL + 1))
            if [ "$RDFAIL" -gt 20 ]; then
                log WARN "the read failed ${RDFAIL}x in a row, pausing 1 s"
                sleep 1
                RDFAIL=0
            fi
        fi
    done
}

do_start() {
    if [ -f "$PIDF" ]; then
        read -r _op < "$PIDF" 2>/dev/null
        if [ -n "$_op" ] && [ -d "/proc/$_op" ]; then
            _cl=$(tr '\0' ' ' < "/proc/$_op/cmdline" 2>/dev/null)
            case "$_cl" in
                *pxtune-auto*) echo "already running (pid $_op)"; exit 0 ;;
            esac
        fi
    fi
    # CLEANUP AFTER PREVIOUS RUNS - without this TWO instances appear.
    #
    # Measured: when the supervisor or the watchdog of a killed/crashed daemon
    # survives, it starts a new instance. At startup that one does `rm -f FIFO;
    # mkfifo FIFO` - which pulls the pipe out from under the FIRST instance: its
    # FD 3 points at a deleted inode, `read` gets EOF and the main loop ends. In
    # the log it looked like "exiting" WITHOUT "cleanup invoked", accompanied by
    # the "the previous message repeated" line (both instances logged the same
    # thing).
    #
    # The PID file does not catch this, because it belongs to an already dead
    # owner. We therefore look for all foreign pxtune-auto processes by their
    # command line.
    _self=$$
    for _p in /proc/[0-9]*; do
        _pp="${_p##*/}"
        [ "$_pp" = "$_self" ] && continue
        _cl=$(tr '␀' ' ' < "$_p/cmdline" 2>/dev/null) || continue
        # CAUTION: match only "pxtune-auto run" - that is the mode the DAEMON
        # runs in. If just "pxtune-auto" were matched, this cleanup would also
        # kill the shell that is calling `pxtune-auto start` (it has that in its
        # cmdline) and therefore itself. Verified: it happened, the adb session
        # ended with code 137.
        case "$_cl" in
            *pxtune-auto*run*) kill -KILL "$_pp" 2>/dev/null ;;
        esac
    done
    # orphaned logcats left behind by them
    for _lp in $(pidof logcat 2>/dev/null); do
        if grep -qs -e 'wm_resume_activity' -e 'power_screen_state' "/proc/$_lp/cmdline" 2>/dev/null; then
            kill -KILL "$_lp" 2>/dev/null
        fi
    done
    rm -f "$PIDF" "$FIFO" 2>/dev/null
    rmdir "$LOCKD" 2>/dev/null

    rm -f "$EXITF" 2>/dev/null
    # setsid => our own process group, so the whole tree (logcat, grep, sleep,
    # watchdog) can be killed with a single `kill -TERM -PID`
    if command -v setsid >/dev/null 2>&1; then
        setsid "$SELF" run >/dev/null 2>&1 &
    else
        "$SELF" run >/dev/null 2>&1 &
    fi
    sleep 1
    do_status
    return 0
}

do_stop() {
    : > "$EXITF" 2>/dev/null          # the watchdog must not restart us
    [ -f "$PIDF" ] || { echo "not running"; exit 0; }
    read -r _op < "$PIDF" 2>/dev/null
    case "$_op" in
        ''|*[!0-9]*) rm -f "$PIDF"; echo "not running (a broken pid file)"; exit 0 ;;
    esac
    kill -TERM "$_op" 2>/dev/null
    _i=0
    while [ "$_i" -lt 10 ]; do
        [ -d "/proc/$_op" ] || break
        sleep 1
        _i=$((_i + 1))
    done
    if [ -d "/proc/$_op" ]; then
        kill -KILL "-$_op" 2>/dev/null
        kill -KILL "$_op" 2>/dev/null
        echo "stopped by force (pid $_op)"
    else
        echo "stopped (pid $_op)"
    fi

    # Cleanup of orphaned `logcat` children.
    # Verified on the device: after a `stop` a logcat from the dead daemon stayed
    # hanging around (pid 7082 under the no-longer-existing 7069). It happens
    # when the daemon gets TERM before it manages to kill its pipe - the child
    # then survives, because it is no longer in the same process group. We find
    # them by their parent no longer existing OR being our just-killed pid, and
    # by them being our logcats.
    for _lp in $(pidof logcat 2>/dev/null); do
        [ -r "/proc/$_lp/stat" ] || continue
        read -r _lx _lc _ls _lppid _rest < "/proc/$_lp/stat" 2>/dev/null
        # the parent is init (orphaned) or our just-killed daemon itself
        if [ "$_lppid" = "1" ] || [ "$_lppid" = "$_op" ]; then
            # make sure it is ours: it reads the events buffer with our filter
            if grep -qs -e 'wm_resume_activity' -e 'power_screen_state' "/proc/$_lp/cmdline" 2>/dev/null; then
                kill -KILL "$_lp" 2>/dev/null
                log INFO "cleaned up an orphaned logcat pid $_lp"
            fi
        fi
    done

    rm -f "$PIDF" "$FIFO" 2>/dev/null
    rmdir "$LOCKD" 2>/dev/null
    return 0
}

do_status() {
    if [ -f "$PIDF" ]; then
        read -r _op < "$PIDF" 2>/dev/null
        if [ -n "$_op" ] && [ -d "/proc/$_op" ]; then
            echo "running (pid $_op)"
            [ -f "$ACTIVE" ] && echo "profile: $(cat "$ACTIVE" 2>/dev/null)"
            [ -e "$MANUAL" ] && echo "manual_override: YES (the daemon does not switch)"
            if [ -f "$ALIVEF" ]; then
                echo "last event: $(date -r "$ALIVEF" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
                echo "  (idleness is NORMAL - the daemon hangs on a blocking read)"
            fi
            kill -USR1 "$_op" 2>/dev/null
            echo "the detailed state was written to $LOG"
            return 0
        fi
    fi
    echo "not running"
    return 1
}

do_reload() {
    [ -f "$PIDF" ] || { echo "not running"; return 1; }
    read -r _op < "$PIDF" 2>/dev/null
    case "$_op" in
        ''|*[!0-9]*) echo "not running"; return 1 ;;
    esac
    kill -HUP "$_op" 2>/dev/null && echo "SIGHUP sent (pid $_op)"
    return 0
}

# ---------------------------------------------------------------- entry point

[ -d "$STATE" ] || mkdir -p "$STATE" 2>/dev/null

case "${1:-run}" in
    run)     do_run ;;
    start)   do_start ;;
    stop)    do_stop ;;
    restart) do_stop; sleep 1; do_start ;;
    status)  do_status ;;
    reload)  do_reload ;;
    *)
        echo "usage: pxtune-auto {run|start|stop|restart|status|reload}" >&2
        exit 1
        ;;
esac
