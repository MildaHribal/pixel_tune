#!/system/bin/sh
#
# pxtune-perapp - per-app profiles for pixel_tune
#                 Google Pixel 8a "akita" / Tensor G3 "zuma" / Android 16 / KernelSU-Next
#
# POSIX sh (toybox/mksh, 32-bit). No bashisms.
# Exit codes: 0 = OK, 1 = argument error, 2 = runtime error.
#
# Called from `pxtune app <subcommand>` (dispatch in bin/pxtune) and directly
# from the daemon (`pxtune app enter <pkg>` / `pxtune app leave`).
#
# ===========================================================================
# THREE LAYERS - THE CORE OF THE DESIGN
# ===========================================================================
#
#   layer | what                                        | per-app? | restore
#   ------+---------------------------------------------+----------+---------------------
#     1   | Android Game Mode (`cmd game set/mode`)      | YES      | not needed, the system keeps it
#     2   | pxtune profile (uclamp, GPU, vm, thermal)    | no       | FREE - profile_apply()
#         |                                             |          | calls restore_stock_values()
#     3   | refresh rate, resolution (settings/binder)   | no       | MUST BE RESTORED EXPLICITLY
#
# Layer 3 is deliberately small precisely because it is the only one that needs
# restoring. Layer 2 is NOT APPLIED from here - that is done by
# `pxtune profile <name> --auto --overlay <pkg>`, which the daemon calls (see
# target_profile step 3b). The exception: when the daemon is not running,
# `app enter` applies it itself, otherwise APP_PROFILE would never do anything
# with `auto=off`.
#
# ===========================================================================
# RULE FORMAT
# ===========================================================================
#
# One file per package: /data/adb/pixel_tune/apps/<package>.conf, KEY=VALUE.
# An empty value = LEAVE IT ALONE. The file is NOT SOURCED (a dedicated parser)
# - a corrupted or planted file must not be able to execute anything.
#
# WHY ONE FILE PER PACKAGE: looking a rule up is
# `[ -f "$APPDIR/$pkg.conf" ]`, i.e. ZERO forks per foreground event. A single
# shared file would mean a grep (a fork = 7.7 ms measured) on every app switch.
#
# ===========================================================================
# PERFORMANCE (measured on this device)
# ===========================================================================
#   fork ................. ~7.7 ms
#   builtin read from sysfs  0.44 ms
#   write to sysfs ....... 27-31 ms
# The WebUI calls the module over a synchronous bridge, so every saved fork
# shows. The convention is taken from bin/pxtune: the helpers rdv/nv/bracketv
# set the global V and do not fork. There must not be a single pointless fork in
# the daemon's hot path (every foreground event) - which is why the daemon
# parses the rule itself (apprule_load) and only calls this script when
# something really changes.
#
# ===========================================================================
# TRAPS (measured)
# ===========================================================================
#   1. `read < /proc/sys/*` returns only the FIRST CHARACTER -> use head -n1 there
#   2. `> file 2>/dev/null` DOES NOT suppress an open error -> { ... } 2>/dev/null
#   3. mksh is 32-bit
#   4. settings/cmd are binder -> always timeout 10
#   5. thermal_zoneN/cooling_deviceN indices are not stable across reboots
#

PERAPP_VERSION="1.0.0"

# ---------------------------------------------------------------------------
# Paths (mirrors bin/pxtune)
# ---------------------------------------------------------------------------
STATE_DIR="/data/adb/pixel_tune"
APPDIR="$STATE_DIR/apps"
PROFILE_DIR="$STATE_DIR/profiles"
APPMODE="$STATE_DIR/appmode.active"
APPWARN="$STATE_DIR/appmode.warn"        # "once per session" for WARN messages
APPGSTAMP="$STATE_DIR/appmode.gamestamp" # rate limit for GAME_APPLY=enter
RESPEND_FILE="$STATE_DIR/res_pending"
AUTOD_PID="$STATE_DIR/pxtune-auto.pid"
LOG_FILE="$STATE_DIR/pxtune.log"
LOG_MAX=524288

case "$0" in
	/*) SELF="$0" ;;
	*)  SELF="$PWD/$0" ;;
esac
PXTUNE="${SELF%/*}/pxtune"
[ -x "$PXTUNE" ] || PXTUNE="/data/adb/modules/pixel_tune/bin/pxtune"

# ===========================================================================
# HARD SAFEGUARDS (deliberately in the CODE, not in the configuration)
# ===========================================================================
#
# APP_RES_ENABLE_DEFAULT = 0
#   CHANGING THE RESOLUTION IS FORBIDDEN FOR NOW. The APP_RES key is
#   implemented, but without an explicit APP_RES_ENABLE=1 in the rule it is
#   IGNORED. A missing key = 0, not 1. The template has it at 0 as well, but
#   THIS is what decides - the template is only documentation, whereas the user
#   can write a conf by hand.
APP_RES_ENABLE_DEFAULT=0
#
# REFRESH_VERIFIED = 1  -- VERIFIED ON THE DEVICE 2026-08-07
#   Both the key names and the fact that the write really takes effect are
#   verified:
#     settings get system peak_refresh_rate   -> 120
#     settings get system min_refresh_rate    -> 60
#     settings put system peak_refresh_rate 120
#       -> dumpsys display: "mode 2, renderFrameRate 120.00001"
#   The `global` namespace also has keys of the same name (values 120.0/60.0),
#   but `system` is what decides - after writing into it the display
#   demonstrably switched.
#
#   CAUTION: writing peak_refresh_rate is GLOBAL. Per-app only works by setting
#   it on entering the app and RESTORING it on leaving. That is why the restore
#   (`app leave`) is called from six independent places - if it were missed, the
#   phone would stay locked at a lower refresh rate.
REFRESH_VERIFIED=1
REFRESH_NS="system"
REFRESH_KEY_MIN="min_refresh_rate"
REFRESH_KEY_PEAK="peak_refresh_rate"
#
# Allowed refresh rate values. SPEC: the panel is adaptive 60-120 Hz, mode 2 =
# 120 Hz. Nothing outside this list is written.
REFRESH_ALLOWED="60 90 120"
#
# Resolution presets - MIRRORS RES_PRESETS in bin/pxtune. When something is
# added there, it has to be added here too (APP_RES validation).
RES_PRESET_NAMES="native 900x2000 810x1800 720x1600"

# Anti-flapping defaults (the daemon has the same, see APP_MIN_FG_DEF/APP_STICKY_DEF)
DEF_MIN_FG_SEC=8
DEF_STICKY_SEC=25
DEF_PRIORITY=50

# GAME_APPLY=enter: the shortest interval between two binder re-applications of
# layer 1 to the same package. Without it an app firing resume events could
# hammer `cmd game`.
GAME_REAPPLY_MIN_SEC=300

S_TIMEOUT=10

# ---------------------------------------------------------------------------
# Basics
# ---------------------------------------------------------------------------
HAVE_TIMEOUT=0
command -v timeout >/dev/null 2>&1 && HAVE_TIMEOUT=1

msg()  { printf '%s\n' "$*"; }
warn() { printf '%s\n' "$*" >&2; }

LOG_TS=""
LOG_N=0
log_rotate() {
	[ -f "$LOG_FILE" ] || return 0
	LOG_N=$((LOG_N + 1))
	[ "$((LOG_N % 50))" -eq 1 ] || return 0
	_lsz=$(wc -c < "$LOG_FILE" 2>/dev/null)
	case "$_lsz" in ''|*[!0-9]*) return 0 ;; esac
	[ "$_lsz" -gt "$LOG_MAX" ] || return 0
	mv -f "$LOG_FILE" "$LOG_FILE.old" 2>/dev/null
	{ : > "$LOG_FILE"; } 2>/dev/null
	chmod 0640 "$LOG_FILE" 2>/dev/null
}

# log <LEVEL> <message...>  - the timestamp is computed ONCE per process run
# (date = a fork; see the identically solved log() in bin/pxtune)
log() {
	_llvl="$1"
	shift
	log_rotate
	[ -n "$LOG_TS" ] || LOG_TS=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
	printf '[%s] [%s] [app] %s\n' "$LOG_TS" "$_llvl" "$*" >> "$LOG_FILE" 2>/dev/null
}

die() { _dc="$1"; shift; warn "pxtune app: $*"; log ERROR "$*"; exit "$_dc"; }

is_int() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

in_list() {
	_ilx="$1"
	shift
	for _ile in $*; do
		[ "$_ile" = "$_ilx" ] && return 0
	done
	return 1
}

# rdv <path> <default> -> V (no fork; /proc/sys/* needs head, see trap 1)
rdv() {
	V="$2"
	[ -f "$1" ] && [ -r "$1" ] || return 0
	case "$1" in
		/proc/sys/*) V=$(head -n1 "$1" 2>/dev/null) || V="$2" ;;
		*)           IFS= read -r V < "$1" 2>/dev/null || V="$2" ;;
	esac
	[ -n "$V" ] || V="$2"
}

# wrf <path> <content> - write to a file; trap 2: wrap the whole block
wrf() {
	{ printf '%s\n' "$2" > "$1"; } 2>/dev/null
}

json_esc() {
	case "$1" in
		*[!A-Za-z0-9\ _.,:/%+-]*)
			printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/[[:cntrl:]]/ /g'
			;;
		*) printf '%s' "$1" ;;
	esac
}
# PERFORMANCE: `printf` is NOT a builtin on Android (it is /system/bin/printf,
# a fork of ~17 ms) and `$(jstr ...)` is another fork on top. The helpers
# therefore DO NOT PRINT but append to the global variable J. The same
# convention as in bin/pxtune.
jstr() {
	case "$1" in
		''|*[!A-Za-z0-9\ _.,:/%+-]*) J="$J\"$(json_esc "$1")\"" ;;
		*)                           J="$J\"$1\"" ;;
	esac
}
jnum() { if is_int "$1"; then J="$J$1"; else J="${J}null"; fi; }
jbool() { if [ "$1" = "1" ]; then J="${J}true"; else J="${J}false"; fi; }

valid_pkg() {
	case "$1" in
		''|.*|*/*) return 1 ;;
		*[!A-Za-z0-9._]*) return 1 ;;
	esac
	# it has to look like a package (at least one dot) - guards against a typo
	case "$1" in *.*) return 0 ;; esac
	return 1
}

# ---------------------------------------------------------------------------
# The framework (binder). ALWAYS with a timeout - trap 4.
# ---------------------------------------------------------------------------
framework_ok() {
	[ "${PXTUNE_NO_FRAMEWORK:-0}" = "1" ] && return 1
	command -v settings >/dev/null 2>&1 || return 1
	[ "$(getprop sys.boot_completed 2>/dev/null)" = "1" ] || return 1
	return 0
}

# st_get <namespace> <key> -> SV ("" when null/empty/unavailable)
st_get() {
	SV=""
	framework_ok || return 1
	if [ "$HAVE_TIMEOUT" = "1" ]; then
		SV=$(timeout "$S_TIMEOUT" settings get "$1" "$2" 2>/dev/null)
	else
		SV=$(settings get "$1" "$2" 2>/dev/null)
	fi
	case "$SV" in
		null|Null|NULL) SV="" ;;
	esac
	SV=${SV%%[!-0-9A-Za-z._,]*}
	return 0
}

st_put() {
	framework_ok || return 1
	if [ "$HAVE_TIMEOUT" = "1" ]; then
		timeout "$S_TIMEOUT" settings put "$1" "$2" "$3" >/dev/null 2>&1
	else
		settings put "$1" "$2" "$3" >/dev/null 2>&1
	fi
}

st_del() {
	framework_ok || return 1
	if [ "$HAVE_TIMEOUT" = "1" ]; then
		timeout "$S_TIMEOUT" settings delete "$1" "$2" >/dev/null 2>&1
	else
		settings delete "$1" "$2" >/dev/null 2>&1
	fi
}

# gamecmd <arguments...> - `cmd game`, binder, always with a timeout
gamecmd() {
	command -v cmd >/dev/null 2>&1 || return 1
	if [ "$HAVE_TIMEOUT" = "1" ]; then
		timeout "$S_TIMEOUT" cmd game "$@" 2>&1
	else
		cmd game "$@" 2>&1
	fi
}

daemon_alive() {
	rdv "$AUTOD_PID" ""
	case "$V" in ''|*[!0-9]*) return 1 ;; esac
	[ -d "/proc/$V" ] || return 1
	return 0
}

# warn_once <key> <message> - WARN at most once per session (a session = one
# appmode episode; the marker is deleted in app leave)
warn_once() {
	rdv "$APPWARN" ""
	case " $V " in
		*" $1 "*) return 0 ;;
	esac
	wrf "$APPWARN" "$V $1"
	log WARN "$2"
	return 0
}

# ===========================================================================
# THE RULE PARSER (nothing is sourced)
#
# Safety: a key only passes if it is on the whitelist (or has the APP_OVERLAY_
# prefix), and the value is assigned via `eval "R_$k=\$_rv"` - that is an
# assignment FROM A VARIABLE, not a re-evaluation of the content, so neither
# $(...) nor a backtick inside the value is executed.
# ===========================================================================

RULE_KEYS="APP_PKG APP_DESC APP_ENABLED GAME_MODE GAME_FPS GAME_DOWNSCALE GAME_APPLY APP_PROFILE APP_REFRESH_MIN APP_REFRESH_PEAK APP_RES APP_RES_ENABLE APP_MIN_FG_SEC APP_STICKY_SEC APP_THERMAL_CAP APP_PRIORITY"

rule_clear() {
	for _rk in $RULE_KEYS; do
		eval "R_$_rk="
	done
	for _rk in $R_OVERLAY_KEYS; do
		eval "R_$_rk="
	done
	R_OVERLAY_KEYS=""
	RL_OK=0
	RL_PKG=""
	RL_FILE=""
}
R_OVERLAY_KEYS=""
rule_clear

# rule_load <pkg> -> R_* variables, RL_OK=1 when the file exists
rule_load() {
	rule_clear
	valid_pkg "$1" || return 1
	RL_PKG="$1"
	RL_FILE="$APPDIR/$1.conf"
	[ -f "$RL_FILE" ] || return 1
	while IFS='=' read -r _rk _rv; do
		case "$_rk" in
			''|\#*) continue ;;
			*[!A-Za-z0-9_]*) continue ;;
		esac
		case "$_rk" in
			APP_OVERLAY_*) ;;
			*) in_list "$_rk" "$RULE_KEYS" || continue ;;
		esac
		_rv="${_rv%%#*}"
		while :; do
			case "$_rv" in
				*' '|*"	") _rv="${_rv%?}" ;;
				*) break ;;
			esac
		done
		case "$_rv" in
			\"*\") _rv="${_rv#\"}"; _rv="${_rv%\"}" ;;
			\'*\') _rv="${_rv#\'}"; _rv="${_rv%\'}" ;;
		esac
		# APP_DESC may contain spaces and diacritics, the other keys may not
		if [ "$_rk" != "APP_DESC" ]; then
			case "$_rv" in
				*[!A-Za-z0-9._-]*) log WARN "$1.conf: key $_rk has disallowed characters, ignoring"; continue ;;
			esac
		else
			case "$_rv" in
				*'"'*|*'`'*|*'$'*) _rv="" ;;
			esac
		fi
		case "$_rk" in
			APP_OVERLAY_*) in_list "$_rk" "$R_OVERLAY_KEYS" || R_OVERLAY_KEYS="$R_OVERLAY_KEYS $_rk" ;;
		esac
		eval "R_$_rk=\$_rv"
	done < "$RL_FILE"
	R_OVERLAY_KEYS="${R_OVERLAY_KEYS# }"
	RL_OK=1
	return 0
}

# rule_defaults - fills in defaults where a key is missing
rule_defaults() {
	[ -n "$R_APP_PKG" ] || R_APP_PKG="$RL_PKG"
	case "$R_APP_ENABLED" in
		0|off|OFF|false|no) R_APP_ENABLED=0 ;;
		*) R_APP_ENABLED=1 ;;
	esac
	case "$R_GAME_APPLY" in
		enter) ;;
		*) R_GAME_APPLY="once" ;;
	esac
	is_int "$R_APP_MIN_FG_SEC" || R_APP_MIN_FG_SEC="$DEF_MIN_FG_SEC"
	is_int "$R_APP_STICKY_SEC" || R_APP_STICKY_SEC="$DEF_STICKY_SEC"
	is_int "$R_APP_PRIORITY"   || R_APP_PRIORITY="$DEF_PRIORITY"
	[ "$R_APP_PRIORITY" -gt 100 ] && R_APP_PRIORITY=100
	[ "$R_APP_MIN_FG_SEC" -lt 1 ] && R_APP_MIN_FG_SEC=1
	[ "$R_APP_MIN_FG_SEC" -gt 600 ] && R_APP_MIN_FG_SEC=600
	[ "$R_APP_STICKY_SEC" -lt 0 ] && R_APP_STICKY_SEC=0
	[ "$R_APP_STICKY_SEC" -gt 3600 ] && R_APP_STICKY_SEC=3600
	case "$R_APP_THERMAL_CAP" in
		1|on|ON|true|yes) R_APP_THERMAL_CAP=1 ;;
		*) R_APP_THERMAL_CAP=0 ;;
	esac
	# HARD SAFEGUARD: a missing key = 0. Never 1.
	case "$R_APP_RES_ENABLE" in
		1|on|ON|true|yes) R_APP_RES_ENABLE=1 ;;
		*) R_APP_RES_ENABLE="$APP_RES_ENABLE_DEFAULT" ;;
	esac
	return 0
}

# ---------------------------------------------------------------------------
# Validation of individual keys (used by both `app set` and `app show`)
# validate_key <key> <value> -> 0 OK, 1 error (the reason lands in VERR)
# ---------------------------------------------------------------------------
validate_key() {
	VERR=""
	_vk="$1"
	_vv="$2"
	[ -z "$_vv" ] && return 0        # an empty value = leave it alone, always OK
	case "$_vk" in
		APP_PKG)
			valid_pkg "$_vv" || VERR="invalid package name" ;;
		APP_DESC)
			: ;;
		APP_ENABLED|APP_THERMAL_CAP|APP_RES_ENABLE)
			case "$_vv" in 0|1|on|off|true|false|yes|no) ;; *) VERR="expected 0 or 1" ;; esac ;;
		GAME_MODE)
			case "$_vv" in 1|2|3|4|standard|performance|battery|custom) ;; *) VERR="1|2|3|4|standard|performance|battery|custom" ;; esac ;;
		GAME_FPS)
			if is_int "$_vv"; then
				[ "$_vv" -gt 240 ] && VERR="FPS outside the range 0-240"
			else
				VERR="expected a whole number"
			fi ;;
		GAME_DOWNSCALE)
			# ALLOWED 0.3..0.9 (at the user's explicit request 2026-08-09).
			# WARNING: below 0.5 the GameManager can break touch mapping/smoothness
			# in Unity games (PoGO) (stuck input) as well as dialog legibility.
			# 0.3/0.35/0.4/0.45 are therefore at your own risk - test the touch input.
			case "$_vv" in disable|0.[3-9]|0.[3-9][05]) ;; *) VERR="0.3..0.9 or 'disable'" ;; esac ;;
		GAME_APPLY)
			case "$_vv" in once|enter) ;; *) VERR="once|enter" ;; esac ;;
		APP_PROFILE)
			if [ ! -f "$PROFILE_DIR/$_vv.conf" ]; then VERR="profile '$_vv' does not exist in $PROFILE_DIR"; fi ;;
		APP_REFRESH_MIN|APP_REFRESH_PEAK)
			in_list "$_vv" "$REFRESH_ALLOWED" || VERR="only allowed: $REFRESH_ALLOWED" ;;
		APP_RES)
			in_list "$_vv" "$RES_PRESET_NAMES" || VERR="the preset must be one of: $RES_PRESET_NAMES" ;;
		APP_MIN_FG_SEC)
			is_int "$_vv" || VERR="expected a whole number (seconds)" ;;
		APP_STICKY_SEC)
			is_int "$_vv" || VERR="expected a whole number (seconds)" ;;
		APP_PRIORITY)
			if is_int "$_vv"; then
				[ "$_vv" -gt 100 ] && VERR="range 0-100"
			else
				VERR="expected a whole number 0-100"
			fi ;;
		APP_OVERLAY_*)
			# The value is validated later by set_uclamp/set_gpu/... in
			# profile_apply, which have the validation in one place (the profile
			# contract). Here we only check that it is a profile contract key and
			# not a typo.
			_vpk="${_vk#APP_OVERLAY_}"
			case "$_vpk" in
				UCLAMP_TOPAPP_MIN|UCLAMP_TOPAPP_MAX|UCLAMP_FG_MIN|UCLAMP_FG_MAX|\
				UCLAMP_BG_MIN|UCLAMP_BG_MAX|UCLAMP_SYSBG_MIN|UCLAMP_SYSBG_MAX|\
				GPU_MAX_FREQ|GPU_MIN_FREQ|GPU_POWER_POLICY|\
				THERMAL_PROFILE_CPU_MID|THERMAL_PROFILE_CPU_HIGH|\
				VM_SWAPPINESS|VM_DIRTY_RATIO|VM_DIRTY_BG_RATIO|VM_VFS_CACHE_PRESSURE|\
				IO_READAHEAD_KB|CHARGE_STOP_LEVEL) ;;
				*) VERR="'$_vpk' is not a profile contract key (see SPEC.md)" ;;
			esac ;;
		*)
			VERR="unknown key" ;;
	esac
	[ -z "$VERR" ] && return 0
	return 1
}

# ===========================================================================
# LAYER 3 STATE - appmode.active
#
# ONE LINE, written BEFORE applying (not after!):
#
#   <pkg>|<epoch>|<old_min_refresh>|<old_peak_refresh>|<old_display_size_forced>|<old_density>
#
# Two sentinels, because "was not set" and "we did not touch it" behave
# DIFFERENTLY on restore:
#     -   the value was not set     -> restore = settings delete
#     =   we did not touch it       -> restore = do nothing
# Without that distinction, a disabled safeguard (APP_RES_ENABLE=0,
# REFRESH_VERIFIED=0) would needlessly delete the user's own
# `display_density_forced` on exit.
#
# WHY IT IS WRITTEN BEFORE APPLYING: if the process died between writing the
# settings and writing the state, the user would be left on someone else's
# resolution / 60 Hz and NOBODY would know what to restore. State without the
# application, in contrast, is harmless - `app leave` just writes back what is
# already there (and a `wr`-style comparison skips it).
# ===========================================================================

AM_PKG=""; AM_T=0; AM_RMIN="="; AM_RPEAK="="; AM_SIZE="="; AM_DENS="="

appmode_read() {
	AM_PKG=""; AM_T=0; AM_RMIN="="; AM_RPEAK="="; AM_SIZE="="; AM_DENS="="
	[ -f "$APPMODE" ] || return 1
	IFS='|' read -r AM_PKG AM_T AM_RMIN AM_RPEAK AM_SIZE AM_DENS < "$APPMODE" 2>/dev/null || return 1
	if ! valid_pkg "$AM_PKG"; then
		log ERROR "appmode.active is corrupted (package='$AM_PKG') - restoring layer 3 blindly to the system default"
		return 2
	fi
	is_int "$AM_T" || AM_T=0
	[ -n "$AM_RMIN" ]  || AM_RMIN="="
	[ -n "$AM_RPEAK" ] || AM_RPEAK="="
	[ -n "$AM_SIZE" ]  || AM_SIZE="="
	[ -n "$AM_DENS" ]  || AM_DENS="="
	return 0
}

appmode_write() {
	# appmode_write <pkg> <rmin> <rpeak> <size> <dens>
	_amt=$(date '+%s' 2>/dev/null)
	is_int "$_amt" || _amt=0
	{ printf '%s|%s|%s|%s|%s|%s\n' "$1" "$_amt" "$2" "$3" "$4" "$5" > "$APPMODE"; } 2>/dev/null
	chmod 0600 "$APPMODE" 2>/dev/null
}

# sentinel: an empty value -> "-", otherwise the value
sent() {
	if [ -z "$1" ]; then printf '%s' '-'; else printf '%s' "$1"; fi
}

# ===========================================================================
# LAYER 1 - Android Game Mode
#
# Written ONLY from `app set` / `app sync` (and from `app enter` when the rule
# explicitly asks for it via GAME_APPLY=enter - that is a safeguard for the case
# where `cmd game set` does not survive a reboot; see OPEN QUESTIONS in the task
# output).
# THE DAEMON NEVER CALLS `cmd` - `cmd` is binder and the daemon has a no-binder
# rule. `app enter` is a separate short-lived process, not the daemon.
# ===========================================================================

game_apply() {
	# game_apply <pkg> - returns 0 when at least something succeeded
	_gp="$1"
	_gany=0
	if ! command -v cmd >/dev/null 2>&1; then
		log ERROR "the 'cmd' command is not available - layer 1 (Game Mode) skipped"
		return 1
	fi
	if [ -n "$R_GAME_MODE" ]; then
		_go=$(gamecmd mode "$R_GAME_MODE" "$_gp")
		log INFO "cmd game mode $R_GAME_MODE $_gp -> ${_go:-ok}"
		_gany=1
	fi
	# CAUTION: `cmd game set` REPLACES the whole intervention configuration, it
	# does not add to it. Two separate calls therefore overwrite each other -
	# verified on the device: `set --fps 30` followed by `set --downscale 0.7`
	# ended up as
	#   Modes: {4=[Scaling:0.7, Fps:]}      <- the fps was lost
	# That is why both flags are sent in a SINGLE call.
	if [ -n "$R_GAME_FPS" ] || [ -n "$R_GAME_DOWNSCALE" ]; then
		set --
		[ -n "$R_GAME_FPS" ]       && set -- "$@" --fps "$R_GAME_FPS"
		[ -n "$R_GAME_DOWNSCALE" ] && set -- "$@" --downscale "$R_GAME_DOWNSCALE"
		_go=$(gamecmd set "$@" "$_gp")
		log INFO "cmd game set $* $_gp -> ${_go:-ok}"
		_gany=1
	fi
	[ "$_gany" = "1" ] || log INFO "$_gp: no GAME_* keys, layer 1 is not set"
	return 0
}

# GAME_APPLY=enter: a rate limit so that an app firing resume events does not
# hammer binder
game_reapply_due() {
	rdv "$APPGSTAMP" ""
	_gsp=${V%% *}
	_gst=${V##* }
	is_int "$_gst" || _gst=0
	_gnow=$(date '+%s' 2>/dev/null)
	is_int "$_gnow" || return 0
	[ "$_gsp" = "$1" ] || return 0
	[ "$((_gnow - _gst))" -ge "$GAME_REAPPLY_MIN_SEC" ] && return 0
	return 1
}

game_stamp() {
	_gnow=$(date '+%s' 2>/dev/null)
	is_int "$_gnow" || _gnow=0
	wrf "$APPGSTAMP" "$1 $_gnow"
}

# ===========================================================================
# LAYER 3 - refresh rate + resolution
# ===========================================================================

refresh_apply() {
	# refresh_apply <min> <peak> - returns the old values via RA_OLDMIN / RA_OLDPEAK
	RA_OLDMIN="="
	RA_OLDPEAK="="
	if [ -z "$1" ] && [ -z "$2" ]; then
		return 0
	fi
	if [ "$REFRESH_VERIFIED" != "1" ]; then
		warn_once refresh "APP_REFRESH_MIN/PEAK is set, but the refresh rate key names are NOT verified on Android 16 (REFRESH_VERIFIED=0 in bin/pxtune-perapp) - the layer 3 refresh rate is NOT APPLIED. The verification commands are in the task output."
		return 0
	fi
	# the old state is ALWAYS read before writing (for the restore)
	st_get "$REFRESH_NS" "$REFRESH_KEY_MIN"  && RA_OLDMIN=$(sent "$SV")
	st_get "$REFRESH_NS" "$REFRESH_KEY_PEAK" && RA_OLDPEAK=$(sent "$SV")
	return 0
}

refresh_commit() {
	# refresh_commit <min> <peak> - the actual write (only AFTER appmode_write)
	[ "$REFRESH_VERIFIED" = "1" ] || return 0
	if [ -n "$1" ]; then
		st_put "$REFRESH_NS" "$REFRESH_KEY_MIN" "$1" \
			&& log INFO "settings $REFRESH_NS $REFRESH_KEY_MIN -> $1"
	fi
	if [ -n "$2" ]; then
		st_put "$REFRESH_NS" "$REFRESH_KEY_PEAK" "$2" \
			&& log INFO "settings $REFRESH_NS $REFRESH_KEY_PEAK -> $2"
	fi
	return 0
}

refresh_restore() {
	# refresh_restore <old_min> <old_peak>
	[ "$REFRESH_VERIFIED" = "1" ] || return 0
	case "$1" in
		'='|'') : ;;
		'-') st_del "$REFRESH_NS" "$REFRESH_KEY_MIN"; log INFO "settings delete $REFRESH_NS $REFRESH_KEY_MIN" ;;
		*)   st_put "$REFRESH_NS" "$REFRESH_KEY_MIN" "$1"; log INFO "settings $REFRESH_NS $REFRESH_KEY_MIN -> $1 (restore)" ;;
	esac
	case "$2" in
		'='|'') : ;;
		'-') st_del "$REFRESH_NS" "$REFRESH_KEY_PEAK"; log INFO "settings delete $REFRESH_NS $REFRESH_KEY_PEAK" ;;
		*)   st_put "$REFRESH_NS" "$REFRESH_KEY_PEAK" "$2"; log INFO "settings $REFRESH_NS $REFRESH_KEY_PEAK -> $2 (restore)" ;;
	esac
	return 0
}

# ===========================================================================
# app enter <pkg>
# ===========================================================================
cmd_enter() {
	_ep="$1"
	valid_pkg "$_ep" || die 1 "invalid package: '$_ep'"

	if ! rule_load "$_ep"; then
		# the rule is gone - if layer 3 is deployed for it, take it down
		appmode_read
		[ "$AM_PKG" = "$_ep" ] && cmd_leave
		return 0
	fi
	rule_defaults
	if [ "$R_APP_ENABLED" != "1" ]; then
		appmode_read
		[ "$AM_PKG" = "$_ep" ] && cmd_leave
		log INFO "$_ep: APP_ENABLED=0, the rule is ignored"
		return 0
	fi

	# --- is somebody already holding layer 3? -----------------------------
	appmode_read
	_ar=$?
	if [ "$_ar" = "2" ]; then
		cmd_leave                     # corrupted state -> blind restore
		appmode_read
	fi
	if [ -n "$AM_PKG" ]; then
		if [ "$AM_PKG" = "$_ep" ]; then
			# Idempotence: entering the same package again changes nothing.
			# (Quickly flicking through apps never gets this far from the daemon,
			#  but the CLI and service.sh can arrive here at any time.)
			log INFO "$_ep: layer 3 is already deployed, changing nothing"
			return 0
		fi
		# APP_PRIORITY: a holder with a higher priority does not let itself be
		# displaced while its sticky window is running. This prevents a
		# notification or a quick reply in messages from taking down the settings
		# of a running game.
		_amprio="$DEF_PRIORITY"
		_amsticky="$DEF_STICKY_SEC"
		_savepkg="$RL_PKG"
		if rule_load "$AM_PKG"; then
			rule_defaults
			_amprio="$R_APP_PRIORITY"
			_amsticky="$R_APP_STICKY_SEC"
		fi
		rule_load "$_savepkg"
		rule_defaults
		_now=$(date '+%s' 2>/dev/null)
		is_int "$_now" || _now=0
		if [ "$R_APP_PRIORITY" -lt "$_amprio" ] && [ "$((_now - AM_T))" -lt "$_amsticky" ]; then
			log INFO "$_ep (priority $R_APP_PRIORITY) does not displace $AM_PKG (priority $_amprio, sticky running) - layer 3 stays"
			return 0
		fi
		cmd_leave
	fi

	# --- layer 1 (only when the rule explicitly asks for it) --------------
	if [ "$R_GAME_APPLY" = "enter" ]; then
		if game_reapply_due "$_ep"; then
			log INFO "$_ep: GAME_APPLY=enter -> redeploying layer 1"
			game_apply "$_ep"
			game_stamp "$_ep"
		fi
	fi

	# --- layer 3: first READ the old state ---------------------------------
	refresh_apply "$R_APP_REFRESH_MIN" "$R_APP_REFRESH_PEAK"
	_oldsize="="
	_olddens="="
	_dores=0
	if [ -n "$R_APP_RES" ]; then
		if [ "$R_APP_RES_ENABLE" = "1" ]; then
			_dores=1
			st_get global display_size_forced     && _oldsize=$(sent "$SV")
			st_get secure display_density_forced  && _olddens=$(sent "$SV")
		else
			# HARD LIMIT: without APP_RES_ENABLE=1, APP_RES is ignored.
			warn_once res "$_ep: APP_RES='$R_APP_RES' is IGNORED, because APP_RES_ENABLE is not 1 (the default is 0 in the code itself). Changing the resolution is forbidden until you explicitly allow it."
		fi
	fi

	# --- the state is written BEFORE applying -------------------------------
	appmode_write "$_ep" "$RA_OLDMIN" "$RA_OLDPEAK" "$_oldsize" "$_olddens"

	# --- and only now is it applied -----------------------------------------
	refresh_commit "$R_APP_REFRESH_MIN" "$R_APP_REFRESH_PEAK"
	if [ "$_dores" = "1" ]; then
		# MANDATORY via `pxtune res <preset>`: it creates res_pending itself and
		# deploys res_arm_watchdog (a 60 s return to native when
		# `pxtune res confirm` does not arrive). We DELIBERATELY do not write the
		# resolution ourselves here - there may be only one safeguard and it
		# already exists.
		if [ -x "$PXTUNE" ]; then
			"$PXTUNE" res "$R_APP_RES" >/dev/null 2>&1
			log WARN "$_ep: resolution '$R_APP_RES' deployed via 'pxtune res' (a 60 s res_pending safeguard is running; confirm with 'pxtune res confirm')"
		else
			log ERROR "$PXTUNE is not executable - the resolution '$R_APP_RES' was not deployed"
		fi
	fi

	# --- layer 2 -----------------------------------------------------------
	# Normally it is deployed by the daemon (target_profile step 3b + --overlay).
	# When the daemon is not running (auto=off, after a crash), do it here -
	# otherwise APP_PROFILE would never do anything.
	if [ -n "$R_APP_PROFILE" ] && ! daemon_alive; then
		if [ -f "$STATE_DIR/manual_override" ]; then
			log INFO "$_ep: manual_override exists, not deploying layer 2 (a manual choice takes precedence)"
		elif [ -x "$PXTUNE" ]; then
			"$PXTUNE" profile "$R_APP_PROFILE" --auto --overlay "$_ep" >/dev/null 2>&1
			log INFO "$_ep: the daemon is not running, layer 2 ('$R_APP_PROFILE') was deployed by app enter"
		fi
	fi

	log INFO "app enter $_ep: layer 3 deployed (refresh min='${R_APP_REFRESH_MIN:-}' peak='${R_APP_REFRESH_PEAK:-}' res='${R_APP_RES:-}' res_allowed=$R_APP_RES_ENABLE)"
	return 0
}

# ===========================================================================
# app leave  - IDEMPOTENT
#
# WHY SIX INDEPENDENT PATHS HAVE TO CALL IT:
#
#   1. a normal exit from the app  - the daemon, the @APPLEAVE branch after
#                                    APP_STICKY_SEC
#   2. the screen turning off      - the daemon, on_screen 0; the user can no
#                                    longer see the app and a foreground event
#                                    may never arrive
#   3. a clean daemon shutdown     - the daemon, cleanup(); after SIGTERM
#                                    nobody else would take layer 3 down
#   4. a new instance starting     - the daemon, prime_state(); the previous
#      after a crash                 instance died mid-episode and the state
#                                    was left behind
#   5. a reboot                    - service.sh; appmode.active survives a
#                                    reboot in /data, but Android has already
#                                    loaded `settings` from its own storage -
#                                    state and reality have to be reconciled
#   6. pxtune revert               - the user said "put EVERYTHING back to
#                                    stock"; layer 3 is part of that
#                                    "everything"
#
# Each of those paths is the only point that particular situation passes
# through - there is no second one. A failure here means the user stays locked
# at 60 Hz or on someone else's resolution with no way out other than by hand in
# Settings (and with the resolution, not even that, if the UI is illegibly
# small/large).
# That is why the function is idempotent: without appmode.active it quietly
# exits with code 0, so anyone may call it blindly, at any time, repeatedly.
# ===========================================================================
cmd_leave() {
	appmode_read
	_lr=$?

	if [ "$_lr" = "1" ]; then
		rm -f "$APPWARN" 2>/dev/null
		return 0                      # nothing deployed = nothing to restore
	fi

	if [ "$_lr" = "2" ]; then
		# Corrupted state. We do not know what we wrote - so we restore layer 3 to
		# the system default. Better a pointless intervention than a locked-out user.
		log ERROR "appmode.active cannot be parsed - blind restore of layer 3 to the default"
		if [ "$REFRESH_VERIFIED" = "1" ]; then
			st_del "$REFRESH_NS" "$REFRESH_KEY_MIN"
			st_del "$REFRESH_NS" "$REFRESH_KEY_PEAK"
		fi
		if [ "$APP_RES_ENABLE_DEFAULT" = "1" ] || [ -f "$RESPEND_FILE" ]; then
			[ -x "$PXTUNE" ] && "$PXTUNE" res reset >/dev/null 2>&1
		fi
		rm -f "$APPMODE" "$APPWARN" 2>/dev/null
		return 0
	fi

	refresh_restore "$AM_RMIN" "$AM_RPEAK"

	if [ "$AM_SIZE" != "=" ] || [ "$AM_DENS" != "=" ]; then
		case "$AM_SIZE" in
			'-') st_del global display_size_forced; log INFO "settings delete global display_size_forced (restore)" ;;
			'=') : ;;
			*)   st_put global display_size_forced "$AM_SIZE"; log INFO "settings global display_size_forced -> $AM_SIZE (restore)" ;;
		esac
		case "$AM_DENS" in
			'-') st_del secure display_density_forced; log INFO "settings delete secure display_density_forced (restore)" ;;
			'=') : ;;
			*)   st_put secure display_density_forced "$AM_DENS"; log INFO "settings secure display_density_forced -> $AM_DENS (restore)" ;;
		esac
		# The safeguard is no longer needed - the resolution is back where it was.
		if [ -f "$RESPEND_FILE" ] && [ -x "$PXTUNE" ]; then
			"$PXTUNE" res confirm >/dev/null 2>&1
		fi
	fi

	rm -f "$APPMODE" "$APPWARN" 2>/dev/null
	log INFO "app leave: layer 3 restored after '$AM_PKG' (refresh min='$AM_RMIN' peak='$AM_RPEAK' size='$AM_SIZE' dens='$AM_DENS')"
	return 0
}

# ===========================================================================
# app list / show / set / rm / sync / json
# ===========================================================================

cmd_list() {
	[ -d "$APPDIR" ] || { msg "No rules ($APPDIR does not exist)."; return 0; }
	appmode_read
	_lany=0
	printf '%-2s %-40s %-4s %-12s %-6s %-6s %s\n' "" "PACKAGE" "ON" "PROFILE" "MODE" "FPS" "DESCRIPTION"
	for _lf in "$APPDIR"/*.conf; do
		[ -f "$_lf" ] || continue
		_lany=1
		_ln="${_lf##*/}"
		_ln="${_ln%.conf}"
		rule_load "$_ln" || continue
		rule_defaults
		_lm=" "
		[ "$_ln" = "$AM_PKG" ] && _lm="*"
		_le="no"
		[ "$R_APP_ENABLED" = "1" ] && _le="yes"
		printf '%-2s %-40s %-4s %-12s %-6s %-6s %s\n' \
			"$_lm" "$_ln" "$_le" "${R_APP_PROFILE:--}" "${R_GAME_MODE:--}" "${R_GAME_FPS:--}" "$R_APP_DESC"
	done
	if [ "$_lany" = "0" ]; then
		msg "No rules in $APPDIR."
		msg "Template: /data/adb/modules/pixel_tune/apps/example.conf.template"
		return 0
	fi
	msg ""
	if [ -n "$AM_PKG" ]; then
		msg "* = layer 3 is currently deployed for this package (since epoch $AM_T)"
	fi
	return 0
}

cmd_show() {
	valid_pkg "$1" || die 1 "invalid package: '$1'"
	if ! rule_load "$1"; then
		warn "pxtune app: no rule for '$1' ($APPDIR/$1.conf)"
		return 2
	fi
	rule_defaults
	appmode_read
	msg "=== $1 ==="
	msg "file              : $RL_FILE"
	msg "APP_DESC          : $R_APP_DESC"
	msg "APP_ENABLED       : $R_APP_ENABLED"
	msg ""
	msg "--- layer 1: Android Game Mode (per-app, system-held, no restore needed) ---"
	msg "GAME_MODE         : ${R_GAME_MODE:-(leave alone)}"
	msg "GAME_FPS          : ${R_GAME_FPS:-(leave alone)}"
	msg "GAME_DOWNSCALE    : ${R_GAME_DOWNSCALE:-(leave alone)}"
	msg "GAME_APPLY        : $R_GAME_APPLY"
	msg ""
	msg "--- layer 2: pxtune profile (global, restore is free via restore_stock_values) ---"
	msg "APP_PROFILE       : ${R_APP_PROFILE:-(leave it to the daemon)}"
	if [ -n "$R_OVERLAY_KEYS" ]; then
		for _sk in $R_OVERLAY_KEYS; do
			eval "_sv=\$R_$_sk"
			[ -n "$_sv" ] && printf '  %-16s: %s\n' "$_sk" "$_sv"
		done
	fi
	msg ""
	msg "--- layer 3: refresh / resolution (global, MUST BE RESTORED) ---"
	if [ "$REFRESH_VERIFIED" = "1" ]; then
		msg "APP_REFRESH_MIN   : ${R_APP_REFRESH_MIN:-(leave alone)}"
		msg "APP_REFRESH_PEAK  : ${R_APP_REFRESH_PEAK:-(leave alone)}"
	else
		msg "APP_REFRESH_MIN   : ${R_APP_REFRESH_MIN:-(leave alone)}   [DISABLED: key names unverified]"
		msg "APP_REFRESH_PEAK  : ${R_APP_REFRESH_PEAK:-(leave alone)}   [DISABLED: key names unverified]"
	fi
	if [ "$R_APP_RES_ENABLE" = "1" ]; then
		msg "APP_RES           : ${R_APP_RES:-(leave alone)}"
	else
		msg "APP_RES           : ${R_APP_RES:-(leave alone)}   [IGNORED: APP_RES_ENABLE=0]"
	fi
	msg "APP_RES_ENABLE    : $R_APP_RES_ENABLE"
	msg ""
	msg "--- anti-flapping and priority ---"
	msg "APP_MIN_FG_SEC    : $R_APP_MIN_FG_SEC s (entry is DELAYED)"
	msg "APP_STICKY_SEC    : $R_APP_STICKY_SEC s (exit is LAZY)"
	msg "APP_THERMAL_CAP   : $R_APP_THERMAL_CAP (1 = may ignore thermal level 1; level >= 2 NEVER)"
	msg "APP_PRIORITY      : $R_APP_PRIORITY"
	msg ""
	if [ "$AM_PKG" = "$1" ]; then
		msg "STATE             : ACTIVE (layer 3 deployed, epoch $AM_T)"
		msg "  saved restore   : refresh_min='$AM_RMIN' refresh_peak='$AM_RPEAK' size='$AM_SIZE' density='$AM_DENS'"
	else
		msg "STATE             : inactive${AM_PKG:+ (layer 3 is held by '$AM_PKG')}"
	fi
	msg ""
	msg "PRIORITY ORDER (hard-coded):"
	msg "  manual override > thermal/battery cap > per-app rule > adaptive daemon"
	return 0
}

# rule_save <pkg> - rewrites the whole conf from the current R_* variables (tmp + mv)
rule_save() {
	_sf="$APPDIR/$1.conf"
	_st="$_sf.tmp.$$"
	[ -d "$APPDIR" ] || mkdir -p "$APPDIR" 2>/dev/null
	{
		printf '# pixel_tune - per-app rule for %s\n' "$1"
		printf '# Generated by `pxtune app set`. An empty value = LEAVE IT ALONE.\n'
		printf '# The file is NOT SOURCED (a dedicated parser in bin/pxtune-perapp).\n'
		printf 'APP_PKG="%s"\n'        "$1"
		printf 'APP_DESC="%s"\n'       "$R_APP_DESC"
		printf 'APP_ENABLED="%s"\n'    "$R_APP_ENABLED"
		printf '\n# --- layer 1: Android Game Mode (genuinely per-app) ---\n'
		printf 'GAME_MODE="%s"\n'      "$R_GAME_MODE"
		printf 'GAME_FPS="%s"\n'       "$R_GAME_FPS"
		printf 'GAME_DOWNSCALE="%s"\n' "$R_GAME_DOWNSCALE"
		printf 'GAME_APPLY="%s"\n'     "$R_GAME_APPLY"
		printf '\n# --- layer 2: pxtune profile (global, restore is free) ---\n'
		printf 'APP_PROFILE="%s"\n'    "$R_APP_PROFILE"
		for _sk in $R_OVERLAY_KEYS; do
			eval "_sv=\$R_$_sk"
			printf '%s="%s"\n' "$_sk" "$_sv"
		done
		printf '\n# --- layer 3: refresh / resolution (global, MUST BE RESTORED) ---\n'
		printf 'APP_REFRESH_MIN="%s"\n'  "$R_APP_REFRESH_MIN"
		printf 'APP_REFRESH_PEAK="%s"\n' "$R_APP_REFRESH_PEAK"
		printf 'APP_RES="%s"\n'          "$R_APP_RES"
		printf 'APP_RES_ENABLE="%s"\n'   "$R_APP_RES_ENABLE"
		printf '\n# --- anti-flapping / priority ---\n'
		printf 'APP_MIN_FG_SEC="%s"\n'  "$R_APP_MIN_FG_SEC"
		printf 'APP_STICKY_SEC="%s"\n'  "$R_APP_STICKY_SEC"
		printf 'APP_THERMAL_CAP="%s"\n' "$R_APP_THERMAL_CAP"
		printf 'APP_PRIORITY="%s"\n'    "$R_APP_PRIORITY"
	} > "$_st" 2>/dev/null
	if [ -s "$_st" ]; then
		mv -f "$_st" "$_sf" 2>/dev/null
		chmod 0600 "$_sf" 2>/dev/null
		return 0
	fi
	rm -f "$_st" 2>/dev/null
	return 1
}

cmd_set() {
	_sp="$1"
	shift
	valid_pkg "$_sp" || die 1 "invalid package: '$_sp'"
	[ "$#" -ge 1 ] || die 1 "usage: pxtune app set <pkg> KEY=VALUE [KEY=VALUE...]"

	rule_load "$_sp"          # when it does not exist, R_* stay empty = a new file
	rule_defaults
	_snew=0
	[ "$RL_OK" = "1" ] || _snew=1

	_serr=0
	_sgame=0
	while [ "$#" -gt 0 ]; do
		case "$1" in
			*=*) ;;
			*) warn "pxtune app: '$1' is not in the form KEY=VALUE"; _serr=1; shift; continue ;;
		esac
		_sk="${1%%=*}"
		_sv="${1#*=}"
		shift
		case "$_sk" in
			*[!A-Za-z0-9_]*) warn "pxtune app: invalid key '$_sk'"; _serr=1; continue ;;
		esac
		if ! validate_key "$_sk" "$_sv"; then
			warn "pxtune app: $_sk='$_sv' - $VERR"
			_serr=1
			continue
		fi
		case "$_sk" in
			APP_OVERLAY_*)
				in_list "$_sk" "$R_OVERLAY_KEYS" || R_OVERLAY_KEYS="${R_OVERLAY_KEYS} $_sk"
				R_OVERLAY_KEYS="${R_OVERLAY_KEYS# }"
				;;
			GAME_MODE|GAME_FPS|GAME_DOWNSCALE) _sgame=1 ;;
			APP_PKG) [ "$_sv" = "$_sp" ] || { warn "pxtune app: APP_PKG must be '$_sp'"; _serr=1; continue; } ;;
		esac
		eval "R_$_sk=\$_sv"
	done

	[ "$_serr" = "0" ] || die 1 "nothing was saved (fix the errors above)"

	rule_defaults
	rule_save "$_sp" || die 2 "writing $APPDIR/$_sp.conf failed"
	if [ "$_snew" = "1" ]; then
		log INFO "created rule $APPDIR/$_sp.conf"
		msg "Created a rule for $_sp."
	else
		log INFO "edited rule $APPDIR/$_sp.conf"
		msg "The rule for $_sp has been edited."
	fi

	# Layer 1 is written ONLY from here and from `app sync` (never from the daemon).
	if [ "$_sgame" = "1" ]; then
		if game_apply "$_sp"; then
			game_stamp "$_sp"
			msg "Layer 1 (Game Mode) deployed via 'cmd game'. Verify with: pxtune app sync $_sp"
		else
			msg "CAUTION: layer 1 (Game Mode) was NOT DEPLOYED - see the log. The GAME_* keys are saved,"
			msg "         try deploying them again: pxtune app sync $_sp"
		fi
	fi

	# When the rule is currently active, a layer 3 change only takes effect on the
	# next entry. We say so out loud so the user does not expect a miracle.
	appmode_read
	if [ "$AM_PKG" = "$_sp" ]; then
		msg "NOTE: layer 3 is currently deployed with the OLD values."
		msg "      It will take effect after leaving and re-entering the app."
	fi
	if [ -n "$R_APP_RES" ] && [ "$R_APP_RES_ENABLE" != "1" ]; then
		msg "CAUTION: APP_RES='$R_APP_RES' is IGNORED (APP_RES_ENABLE=0; the default is 0 in the code itself)."
	fi
	if [ -n "$R_APP_REFRESH_MIN$R_APP_REFRESH_PEAK" ] && [ "$REFRESH_VERIFIED" != "1" ]; then
		msg "CAUTION: APP_REFRESH_* is IGNORED - the refresh rate key names are not verified on Android 16."
		msg "         See REFRESH_VERIFIED in bin/pxtune-perapp and the verification commands in the docs."
	fi
	return 0
}

cmd_rm() {
	valid_pkg "$1" || die 1 "invalid package: '$1'"
	_rf="$APPDIR/$1.conf"
	if [ ! -f "$_rf" ]; then
		warn "pxtune app: no rule for '$1'"
		return 2
	fi
	appmode_read
	[ "$AM_PKG" = "$1" ] && cmd_leave      # take layer 3 down first, then delete
	rm -f "$_rf" 2>/dev/null
	log INFO "deleted rule $_rf"
	msg "The rule for $1 has been deleted."
	msg "NOTE: layer 1 (Game Mode) stays set in the system - Android keeps it."
	msg "      Restore it with: pxtune game $1 standard   (and 'cmd game set --fps 0 --downscale disable $1')"
	return 0
}

cmd_sync() {
	valid_pkg "$1" || die 1 "invalid package: '$1'"
	if ! rule_load "$1"; then
		warn "pxtune app: no rule for '$1'"
		return 2
	fi
	rule_defaults
	game_apply "$1"
	game_stamp "$1"
	msg "--- list-modes $1 ---"
	gamecmd list-modes "$1"
	msg "--- list-configs $1 ---"
	gamecmd list-configs "$1"
	msg ""
	msg "Check that the output matches GAME_MODE=$R_GAME_MODE GAME_FPS=$R_GAME_FPS GAME_DOWNSCALE=$R_GAME_DOWNSCALE."
	msg "When the GameManager does NOT consider this app a game, layer 1 does not work for it and layers 2 and 3 remain."
	return 0
}

# --- json ------------------------------------------------------------------
# The default mode reads FILES ONLY - no binder, so the WebUI may call it in a
# polling loop. `--live` additionally touches `cmd game` (binder, timeout 10) and
# is meant for manual checking, not for polling.
cmd_json() {
	# PERFORMANCE: the whole output is accumulated into $J and printed with a
	# SINGLE `print`. The reason is backed by measurement: `printf` on Android is
	# /system/bin/printf, i.e. a fork of ~17 ms, and every `$(jstr ...)` was
	# another fork on top. The original version made over 40 forks for a single
	# rule and `app json` took 2790 ms - which made the WebUI freeze when the tab
	# was opened. jstr/jnum/jbool therefore print nothing, they only append to $J.
	_jlive=0
	[ "$1" = "--live" ] && _jlive=1

	appmode_read
	_jar=$?

	J='{"version":'
	jstr "$PERAPP_VERSION"
	J="$J,\"gates\":{\"res_enabled\":"
	jbool "$APP_RES_ENABLE_DEFAULT"
	J="$J,\"refresh_verified\":"
	jbool "$REFRESH_VERIFIED"
	J="$J},\"active\":"

	if [ "$_jar" = "0" ] && [ -n "$AM_PKG" ]; then
		_jnow=$(date '+%s' 2>/dev/null)
		is_int "$_jnow" || _jnow=0
		_jage=$((_jnow - AM_T))
		[ "$_jage" -lt 0 ] && _jage=0
		J="$J{\"pkg\":"
		jstr "$AM_PKG"
		J="$J,\"since\":"
		jnum "$AM_T"
		J="$J,\"age_sec\":$_jage,\"saved\":{\"refresh_min\":"
		jstr "$AM_RMIN"
		J="$J,\"refresh_peak\":"
		jstr "$AM_RPEAK"
		J="$J,\"display_size\":"
		jstr "$AM_SIZE"
		J="$J,\"density\":"
		jstr "$AM_DENS"
		J="$J}},"
	elif [ "$_jar" = "2" ]; then
		J="$J{\"pkg\":null,\"error\":\"appmode.active is corrupted\"},"
	else
		J="${J}null,"
	fi

	J="$J\"rules\":["
	_jfirst=1
	if [ -d "$APPDIR" ]; then
		for _jf in "$APPDIR"/*.conf; do
			[ -f "$_jf" ] || continue
			_jn="${_jf##*/}"
			_jn="${_jn%.conf}"
			rule_load "$_jn" || continue
			rule_defaults
			[ "$_jfirst" -eq 1 ] || J="$J,"
			_jfirst=0

			J="$J{\"pkg\":"
			jstr "$_jn"
			J="$J,\"desc\":"
			jstr "$R_APP_DESC"
			J="$J,\"enabled\":"
			jbool "$R_APP_ENABLED"
			J="$J,\"profile\":"
			jstr "$R_APP_PROFILE"

			J="$J,\"game\":{\"mode\":"
			jstr "$R_GAME_MODE"
			J="$J,\"fps\":"
			jnum "$R_GAME_FPS"
			J="$J,\"downscale\":"
			jstr "$R_GAME_DOWNSCALE"
			J="$J,\"apply\":"
			jstr "$R_GAME_APPLY"

			J="$J},\"refresh\":{\"min\":"
			jnum "$R_APP_REFRESH_MIN"
			J="$J,\"peak\":"
			jnum "$R_APP_REFRESH_PEAK"

			J="$J},\"res\":{\"preset\":"
			jstr "$R_APP_RES"
			J="$J,\"enabled\":"
			jbool "$R_APP_RES_ENABLE"

			J="$J},\"min_fg_sec\":"
			jnum "$R_APP_MIN_FG_SEC"
			J="$J,\"sticky_sec\":"
			jnum "$R_APP_STICKY_SEC"
			J="$J,\"thermal_cap\":"
			jbool "$R_APP_THERMAL_CAP"
			J="$J,\"priority\":"
			jnum "$R_APP_PRIORITY"

			J="$J,\"overlay\":{"
			_jo=1
			for _jk in $R_OVERLAY_KEYS; do
				eval "_jv=\$R_$_jk"
				[ -n "$_jv" ] || continue
				[ "$_jo" -eq 1 ] || J="$J,"
				_jo=0
				jstr "${_jk#APP_OVERLAY_}"
				J="$J:"
				jstr "$_jv"
			done
			J="$J},\"active\":"
			if [ "$_jn" = "$AM_PKG" ]; then jbool 1; else jbool 0; fi
			J="$J}"
		done
	fi
	J="$J]"

	if [ "$_jlive" = "1" ]; then
		J="$J,\"live\":{\"framework\":"
		if framework_ok; then J="${J}true"; else J="${J}false"; fi
		if [ -n "$AM_PKG" ]; then
			_jg=$(gamecmd list-modes "$AM_PKG" 2>/dev/null | tr -d '\r' | tr '\n' ' ')
			J="$J,\"game_modes\":"
			jstr "$_jg"
		fi
		J="$J}"
	fi

	print -r -- "$J}"
	return 0
}

# ===========================================================================
# cmd_preset - ready-made templates for common app categories (not just PoGO)
#
# A preset just assembles a sensible set of KEY=VALUE pairs and hands it to
# cmd_set (the same validation and the same write). The user can then fine-tune
# it with `pxtune app set`.
#
# TO BE HONEST: the only genuinely per-app layer is layer 1 (Game Mode - and
# that only applies to what the GameManager considers a game). APP_PROFILE is a
# GLOBAL profile that is merely switched for as long as the app is in the
# foreground and restored on exit. The refresh rate is disabled for now
# (REFRESH_VERIFIED=0), so the presets do not count on it.
# ===========================================================================
cmd_preset() {
	_pp="$1"; [ "$#" -ge 1 ] && shift
	case "$_pp" in
		''|-h|--help|help)
			msg "pxtune app preset <pkg> <kind> [APP_DESC=\"...\"]"
			msg "  kind: game | game-max | video | social | saver"
			msg ""
			msg "  game      a 3D game, performance with a thermal cap (like PoGO)"
			msg "  game-max  full performance without downscaling (short sessions/benchmarks)"
			msg "  video     streaming - a balanced profile, no pointless boost"
			msg "  social    scrolling apps - registration + balanced"
			msg "  saver     throttling a power hog in the foreground (powersave)"
			msg ""
			msg "  Example: pxtune app preset com.instagram.android saver"
			return 0 ;;
	esac
	valid_pkg "$_pp" || die 1 "invalid package: '$_pp'"
	_pk="$1"; [ "$#" -ge 1 ] && shift

	# an optional APP_DESC="..." as a further argument
	_pdesc=""
	while [ "$#" -gt 0 ]; do
		case "$1" in APP_DESC=*) _pdesc="$1" ;; esac
		shift
	done

	case "$_pk" in
		game)
			# 3D games for longer sessions (PoGO, Genshin, CoD): performance with a thermal cap.
			set -- APP_ENABLED=1 APP_PROFILE=game GAME_MODE=performance \
				GAME_FPS=60 GAME_DOWNSCALE=0.7 APP_THERMAL_CAP=1 \
				APP_PRIORITY=90 APP_STICKY_SEC=25 APP_MIN_FG_SEC=8
			[ -n "$_pdesc" ] || _pdesc="APP_DESC=game (preset game)"
			;;
		game-max)
			# short demanding sessions / benchmarks: full performance, no downscaling.
			set -- APP_ENABLED=1 APP_PROFILE=performance GAME_MODE=performance \
				GAME_FPS=0 GAME_DOWNSCALE=disable APP_THERMAL_CAP=1 \
				APP_PRIORITY=95 APP_STICKY_SEC=20 APP_MIN_FG_SEC=8
			[ -n "$_pdesc" ] || _pdesc="APP_DESC=game at full tilt (preset game-max)"
			;;
		video)
			# streaming (YouTube, Netflix): decoding is HW, no boost needed.
			# The biggest saving would be 60 Hz - waiting on the refresh key verification.
			set -- APP_ENABLED=1 APP_PROFILE=balanced \
				APP_PRIORITY=50 APP_STICKY_SEC=20 APP_MIN_FG_SEC=8
			[ -n "$_pdesc" ] || _pdesc="APP_DESC=video/stream (preset video)"
			;;
		social)
			# scrolling apps (Instagram, Chrome, TikTok): just registration + a
			# balanced profile. The levers are limited here, see the note above.
			set -- APP_ENABLED=1 APP_PROFILE=balanced \
				APP_PRIORITY=40 APP_STICKY_SEC=20
			[ -n "$_pdesc" ] || _pdesc="APP_DESC=social/scroll (preset social)"
			;;
		saver)
			# power hogs you want THROTTLED in the foreground (the powersave profile).
			set -- APP_ENABLED=1 APP_PROFILE=powersave \
				APP_PRIORITY=30 APP_STICKY_SEC=15
			[ -n "$_pdesc" ] || _pdesc="APP_DESC=saver (preset saver)"
			;;
		''|-h|--help)
			msg "pxtune app preset <pkg> <kind> [APP_DESC=\"...\"]"
			msg "  kind: game | game-max | video | social | saver"
			msg ""
			msg "  game      a 3D game, performance with a thermal cap (like PoGO)"
			msg "  game-max  full performance without downscaling (short sessions/benchmarks)"
			msg "  video     streaming - a balanced profile, no pointless boost"
			msg "  social    scrolling apps - registration + balanced"
			msg "  saver     throttling a power hog in the foreground (powersave)"
			return 0
			;;
		*)
			die 1 "unknown preset '$_pk' (game|game-max|video|social|saver)"
			;;
	esac

	set -- "$@" "$_pdesc"
	msg "Applying preset '$_pk' to $_pp ..."
	cmd_set "$_pp" "$@"
}

# ===========================================================================
# usage / main
# ===========================================================================
usage() {
	cat <<EOF
pxtune app - per-app profiles (pxtune-perapp $PERAPP_VERSION)

  pxtune app list                     list the rules
  pxtune app show <pkg>               details of a single rule
  pxtune app set <pkg> KEY=VAL ...    create/edit a rule (+ deploy layer 1)
  pxtune app preset <pkg> <kind>      ready-made template: game|game-max|video|social|saver
  pxtune app rm <pkg>                 delete a rule (taking layer 3 down first)
  pxtune app sync <pkg>               redeploy layer 1 and print what the system reports
  pxtune app json [--live]            machine output for the WebUI (no binder without --live)

  pxtune app enter <pkg>              INTERNAL - called by the daemon
  pxtune app leave                    INTERNAL - idempotent, anyone may call it blindly

Rule keys:
  APP_PKG APP_DESC APP_ENABLED
  GAME_MODE GAME_FPS GAME_DOWNSCALE GAME_APPLY(once|enter)
  APP_PROFILE APP_OVERLAY_<profile key>
  APP_REFRESH_MIN APP_REFRESH_PEAK APP_RES APP_RES_ENABLE
  APP_MIN_FG_SEC APP_STICKY_SEC APP_THERMAL_CAP APP_PRIORITY

Rules  : $APPDIR/<package>.conf
L3 state: $APPMODE
EOF
}

main() {
	[ -d "$STATE_DIR" ] || mkdir -p "$STATE_DIR" 2>/dev/null
	[ -d "$APPDIR" ]    || mkdir -p "$APPDIR" 2>/dev/null
	chmod 0700 "$APPDIR" 2>/dev/null

	_c="$1"
	[ "$#" -ge 1 ] && shift
	case "$_c" in
		list)  cmd_list "$@" ;;
		show)  [ -n "$1" ] || die 1 "usage: pxtune app show <pkg>"; cmd_show "$1" ;;
		set)   [ -n "$1" ] || die 1 "usage: pxtune app set <pkg> KEY=VALUE..."; cmd_set "$@" ;;
		preset) cmd_preset "$@" ;;
		rm)    [ -n "$1" ] || die 1 "usage: pxtune app rm <pkg>"; cmd_rm "$1" ;;
		sync)  [ -n "$1" ] || die 1 "usage: pxtune app sync <pkg>"; cmd_sync "$1" ;;
		enter) [ -n "$1" ] || die 1 "usage: pxtune app enter <pkg>"; cmd_enter "$1" ;;
		leave) cmd_leave ;;
		json)  cmd_json "$@" ;;
		-h|--help|help|"") usage; [ -z "$_c" ] && exit 1; exit 0 ;;
		*)     warn "pxtune app: unknown subcommand '$_c'"; usage >&2; exit 1 ;;
	esac
}

main "$@"
exit $?
