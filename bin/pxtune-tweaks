#!/system/bin/sh
#
# pxtune-tweaks - the tweak engine for pixel_tune
# Google Pixel 8a "akita" / Tensor G3 "zuma" / Android 16 / KernelSU-Next
#
# THIS FILE IS SOURCED FROM bin/pxtune ( . "$TWEAKS_LIB" ), it does not run on
# its own. It takes from there: rdv, nv, bracketv, wr, log, warn, msg, is_int,
# framework_ok, settings_get, settings_run, stock_load, STATE_DIR, BACKUP_DIR,
# SELF.
#
# ---------------------------------------------------------------------------
# PERFORMANCE - BINDING, the WebUI calls the module over a SYNCHRONOUS bridge.
#
# Measured on this device:
#   fork ( $(...), sed, grep, head, cut )  ~7.7 ms
#   builtin read from sysfs                 0.44 ms
#   write to sysfs                         27-31 ms  (inherent, kernel)
#
# Hence the rules that must NOT be broken here:
#   1. NO forks in the READ paths (list, info, get, json, categories).
#      The registry is read in a single pass with `while IFS='|' read`, and
#      tweaks.conf and tweaks.stock are loaded once into the variables
#      TWC_* / TWS_*. No grep, no sed, no $(...).
#   2. Descriptions from the registry are emitted into JSON WITHOUT escaping.
#      The registry therefore must not contain a quote or a backslash -
#      `tweak selftest` checks that.
#   3. Values read from the device are only pattern-matched before being put
#      into JSON; when they contain anything unexpected they are replaced with
#      "?". sed is never called.
#   4. Forks are only allowed in the WRITE paths (set/reset/apply-boot), where
#      every sysfs write costs 27-31 ms anyway.
#
# TRAPS (measured, do not "simplify" them away):
#   a) mksh is 32-bit: 3969961984 + 0 = -325005312. The int:MIN:MAX validator
#      therefore USES NO arithmetic at all - it compares numbers as strings
#      (tw_num_le) and rejects anything longer than 10 digits outright.
#   b) `read < /proc/sys/*` returns only the FIRST CHARACTER. rdv() from
#      bin/pxtune handles that by switching to head for /proc/sys/*. Never read
#      procfs directly.
#   c) Nodes of the form "a [b] c" (scheduler, THP, comp_algorithm) are
#      normalised via bracketv before comparison - otherwise wr() would keep
#      seeing a difference and writing over and over at 30 ms a go.
#   d) Redirection order: `> file 2>/dev/null` does not suppress an OPEN error.
#      Always { printf ... > "$p"; } 2>/dev/null.
#   e) settings/cmd are binder -> always via settings_run/settings_get (they
#      have timeout 10) and never from the `status --json` path.
# ---------------------------------------------------------------------------

PXTUNE_TWEAKS_VERSION="1.0.0"

# --- paths -----------------------------------------------------------------
: "${STATE_DIR:=/data/adb/pixel_tune}"
: "${BACKUP_DIR:=$STATE_DIR/backup}"

TWEAKS_CONF="$STATE_DIR/tweaks.conf"
TWEAKS_STOCK="$BACKUP_DIR/tweaks.stock"
TWEAKS_COUNT="$STATE_DIR/tweaks.count"
# A cache of the generated JSON. The registry is a STATIC file in the module
# (27 kB of text), so its JSON only changes when the registry, tweaks.conf or
# tweaks.stock change. Measured on the device: generating it took 21 s and the
# WebUI froze every time the Tweaks tab was opened. From the cache it is one
# read.
TWEAKS_JCACHE="$STATE_DIR/tweaks.json.cache"

# The registry lives in the module (next to bin/), not in the state directory -
# it is code, not state, and it should be replaced when the module is
# reinstalled.
if [ -z "${TWEAKS_DEF:-}" ]; then
	_twb="${SELF:-/data/adb/modules/pixel_tune/bin/pxtune}"
	_twb="${_twb%/*}"
	TWEAKS_DEF="${_twb%/*}/tweaks/registry.def"
	[ -f "$TWEAKS_DEF" ] || TWEAKS_DEF="/data/adb/modules/pixel_tune/tweaks/registry.def"
fi

# The category order is binding for the WebUI.
TW_CATS="cpu gpu mem io batt net ui exp"

TW_MECHS="sysfs proc prop settings cmd bootcfg ro"
TW_FLAGS_KNOWN="boot reapply unverified adv"

# ---------------------------------------------------------------------------
# Output
#
# PERFORMANCE: `printf` is NOT a builtin on this system, it is
# /system/bin/printf, i.e. a fork of ~17 ms (the same finding as with
# status_json in bin/pxtune). `tweak list` has 60 rows of 6 columns, and
# `tweak json` would need over 600 printf calls - that is over 10 seconds just
# to print. Everything is therefore accumulated into a variable and printed
# with a SINGLE `print`, which is a builtin.
#
# Column alignment is therefore not done by printf '%-42s' but by tw_pad() -
# pure parameter expansion, zero forks.
# ---------------------------------------------------------------------------
TW_NL='
'
TW_OUT=""

# o <line> - append a line to the output buffer
o() { TW_OUT="$TW_OUT$1$TW_NL"; }

# oflush - print the whole buffer in one call and empty it
oflush() {
	[ -n "$TW_OUT" ] && print -rn -- "$TW_OUT"
	TW_OUT=""
	return 0
}

# tw_pad <text> <width> -> TW_PAD (padded with spaces on the right)
tw_pad() {
	TW_PAD="$1"
	_tpn=$(( $2 - ${#TW_PAD} ))
	while [ "$_tpn" -ge 8 ]; do TW_PAD="$TW_PAD        "; _tpn=$((_tpn - 8)); done
	while [ "$_tpn" -gt 0 ]; do TW_PAD="$TW_PAD "; _tpn=$((_tpn - 1)); done
}

# col <text> <width> - append an aligned column to TW_ROW
# (the last column of a row is appended directly so no spaces are wasted)
col() { tw_pad "$1" "$2"; TW_ROW="$TW_ROW$TW_PAD "; }

# ---------------------------------------------------------------------------
# Small helpers (all fork-free)
# ---------------------------------------------------------------------------

# tw_cat_name <cat> -> TW_CATNAME
tw_cat_name() {
	case "$1" in
		cpu)  TW_CATNAME="CPU and scheduler" ;;
		gpu)  TW_CATNAME="Graphics" ;;
		mem)  TW_CATNAME="Memory, zram and cache" ;;
		io)   TW_CATNAME="Storage and I/O" ;;
		batt) TW_CATNAME="Battery, charging and power" ;;
		net)  TW_CATNAME="Network" ;;
		ui)   TW_CATNAME="Display, interface and haptics" ;;
		exp)  TW_CATNAME="Experimental (unverified effect)" ;;
		*)    TW_CATNAME="$1" ;;
	esac
}

# tw_risk_name <0-3> -> TW_RISKNAME
tw_risk_name() {
	case "$1" in
		0) TW_RISKNAME="no risk" ;;
		1) TW_RISKNAME="low" ;;
		2) TW_RISKNAME="medium" ;;
		3) TW_RISKNAME="HIGH" ;;
		*) TW_RISKNAME="?" ;;
	esac
}

# tw_hasflag <flag list> <flag>
tw_hasflag() {
	case ",$1," in
		*",$2,"*) return 0 ;;
	esac
	return 1
}

# tw_key <id> -> TW_KEY (dots to underscores so an id can be used as a variable)
tw_key() {
	TW_KEY=""
	_twk="$1"
	while :; do
		case "$_twk" in
			*.*) TW_KEY="$TW_KEY${_twk%%.*}_"; _twk="${_twk#*.}" ;;
			*)   TW_KEY="$TW_KEY$_twk"; break ;;
		esac
	done
}

# tw_num_le <a> <b> -> 0 when a <= b. Both arguments digits only.
#
# WHY NOT $(( )): mksh is 32-bit and even the stock zram size (3969961984)
# overflows into a negative value. A string comparison cannot overflow.
tw_num_le() {
	_tnla="$1"
	_tnlb="$2"
	while :; do case "$_tnla" in 0?*) _tnla="${_tnla#0}" ;; *) break ;; esac; done
	while :; do case "$_tnlb" in 0?*) _tnlb="${_tnlb#0}" ;; *) break ;; esac; done
	[ -n "$_tnla" ] || _tnla=0
	[ -n "$_tnlb" ] || _tnlb=0
	if [ "${#_tnla}" -lt "${#_tnlb}" ]; then return 0; fi
	if [ "${#_tnla}" -gt "${#_tnlb}" ]; then return 1; fi
	# equal length -> a character-by-character lexicographic comparison is also numeric
	while [ -n "$_tnla" ]; do
		_tnlca="${_tnla%"${_tnla#?}"}"
		_tnlcb="${_tnlb%"${_tnlb#?}"}"
		if [ "$_tnlca" != "$_tnlcb" ]; then
			case "0123456789" in
				*"$_tnlca"*"$_tnlcb"*) return 0 ;;
				*) return 1 ;;
			esac
		fi
		_tnla="${_tnla#?}"
		_tnlb="${_tnlb#?}"
	done
	return 0
}

# tw_nth <index from 1> <list> -> TW_NTH
tw_nth() {
	TW_NTH=""
	_tnti=0
	for _tnte in $2; do
		_tnti=$((_tnti + 1))
		if [ "$_tnti" -eq "$1" ]; then
			TW_NTH="$_tnte"
			return 0
		fi
	done
	return 1
}

# tw_count_items <list> -> TW_NITEMS
tw_count_items() {
	TW_NITEMS=0
	for _tci in $1; do
		TW_NITEMS=$((TW_NITEMS + 1))
	done
}

# tw_jsafe <value> -> TW_JS
#
# Values are validated by type, so practically nothing odd flows in here. If it
# did anyway (a corrupted tweaks.conf, an exotic sysfs node), the whole value is
# replaced with a question mark. sed is never called - that is a fork.
#
# Why a loop and not a single case: a space MUST be allowed (the stock of glob
# targets is a list, e.g. "128 1024 1024 1024"), but it cannot be safely put
# into a bracket expression in POSIX sh - `\ ` inside [] also adds a backslash,
# and that is exactly the character that must not get into the JSON. Splitting
# via IFS solves the space and drops tabs and newlines at the same time.
tw_jsafe() {
	TW_JS=""
	for _tjs in $1; do
		case "$_tjs" in
			*[!A-Za-z0-9_.:,+/@%-]*) TW_JS="?"; return 0 ;;
		esac
		TW_JS="$TW_JS $_tjs"
	done
	TW_JS="${TW_JS# }"
	return 0
}

# tw_jstr <value> - append a JSON string to J, or null when the value is empty
tw_jstr() {
	if [ -z "$1" ]; then
		J="${J}null"
	else
		tw_jsafe "$1"
		J="$J\"$TW_JS\""
	fi
}

# tw_jflags <flags> - append the array ["a","b"] to J
tw_jflags() {
	J="${J}["
	_tjf_first=1
	_tjf="$1"
	while [ -n "$_tjf" ]; do
		case "$_tjf" in
			*,*) _tjf_one="${_tjf%%,*}"; _tjf="${_tjf#*,}" ;;
			*)   _tjf_one="$_tjf"; _tjf="" ;;
		esac
		[ -n "$_tjf_one" ] || continue
		[ "$_tjf_first" -eq 1 ] || J="$J,"
		_tjf_first=0
		J="$J\"$_tjf_one\""
	done
	J="$J]"
}

# ---------------------------------------------------------------------------
# Loading the state files into variables (one pass, no forks)
#
# tweaks.conf  -> TWC_<key>   (id=value; the key = the id with dots -> underscores)
# tweaks.stock -> TWS_<key>   (id=stock; append-only, the first write wins)
#
# Safety: the value is assigned via eval "TWC_$k=\$_v", i.e. FROM A VARIABLE.
# The content is not re-evaluated; neither $(...) nor a backtick in the file is
# executed.
# ---------------------------------------------------------------------------
TW_CONF_LOADED=0
TW_CONF_IDS=""
TW_CONF_N=0

tw_conf_load() {
	[ "$TW_CONF_LOADED" = "1" ] && return 0
	TW_CONF_LOADED=1
	TW_CONF_IDS=""
	TW_CONF_N=0
	[ -f "$TWEAKS_CONF" ] || return 0
	while IFS='=' read -r _twcl_k _twcl_v || [ -n "$_twcl_k" ]; do
		case "$_twcl_k" in
			''|\#*)          continue ;;
			*[!a-z0-9._]*)   continue ;;
		esac
		case "$_twcl_v" in
			*[!A-Za-z0-9_.:+-]*)
				log ERROR "tweak: tweaks.conf: disallowed characters in the value of key '$_twcl_k', ignoring"
				continue
				;;
		esac
		tw_key "$_twcl_k"
		eval "TWC_$TW_KEY=\$_twcl_v"
		TW_CONF_IDS="$TW_CONF_IDS $_twcl_k"
		TW_CONF_N=$((TW_CONF_N + 1))
	done < "$TWEAKS_CONF"
	TW_CONF_IDS="${TW_CONF_IDS# }"
	return 0
}

TW_STOCK_LOADED=0
TW_STOCK_EXISTS=0

tw_stock_load() {
	[ "$TW_STOCK_LOADED" = "1" ] && return 0
	TW_STOCK_LOADED=1
	[ -f "$TWEAKS_STOCK" ] || return 0
	TW_STOCK_EXISTS=1
	while IFS='=' read -r _twsl_k _twsl_v || [ -n "$_twsl_k" ]; do
		case "$_twsl_k" in
			''|\#*)        continue ;;
			*[!a-z0-9._]*) continue ;;
		esac
		tw_key "$_twsl_k"
		# the first write wins - a later line with the same id is ignored
		eval "_twsl_h=\${TWS_$TW_KEY+x}"
		[ -n "${_twsl_h:-}" ] && continue
		eval "TWS_$TW_KEY=\$_twsl_v"
	done < "$TWEAKS_STOCK"
	return 0
}

# tw_conf_get <id> -> TW_CVAL, TW_CSET (0/1)
tw_conf_get() {
	tw_conf_load
	tw_key "$1"
	eval "_twcg=\${TWC_$TW_KEY+x}"
	if [ -n "${_twcg:-}" ]; then
		eval "TW_CVAL=\$TWC_$TW_KEY"
		TW_CSET=1
	else
		TW_CVAL=""
		TW_CSET=0
	fi
}

# tw_stock_get <id> -> TW_SVAL, TW_SSET (0/1)
tw_stock_get() {
	tw_stock_load
	tw_key "$1"
	eval "_twsg=\${TWS_$TW_KEY+x}"
	if [ -n "${_twsg:-}" ]; then
		eval "TW_SVAL=\$TWS_$TW_KEY"
		TW_SSET=1
	else
		TW_SVAL=""
		TW_SSET=0
	fi
}

# ---------------------------------------------------------------------------
# Writing the state files (write paths only, forks are OK here)
# ---------------------------------------------------------------------------

# tw_conf_put <id> <value|"" = delete the line>
tw_conf_put() {
	_twcp_t="$TWEAKS_CONF.tmp.$$"
	{
		if [ -f "$TWEAKS_CONF" ]; then
			while IFS= read -r _twcp_l || [ -n "$_twcp_l" ]; do
				case "$_twcp_l" in
					"$1="*) continue ;;
				esac
				print -r -- "$_twcp_l"
			done < "$TWEAKS_CONF"
		fi
		[ "$#" -ge 2 ] && [ -n "${2+x}" ] && [ "$2" != "__DEL__" ] && print -r -- "$1=$2"
	} > "$_twcp_t" 2>/dev/null
	if mv -f "$_twcp_t" "$TWEAKS_CONF" 2>/dev/null; then
		chmod 0600 "$TWEAKS_CONF" 2>/dev/null
		# the cache is no longer valid
		TW_CONF_LOADED=0
		return 0
	fi
	rm -f "$_twcp_t" 2>/dev/null
		log ERROR "tweak: could not rewrite $TWEAKS_CONF"
	return 1
}

# tw_count_write <number of errors>
#
# File format: a single line "<active> <errors> <epoch>".
# `status --json` reads it with one rdv() so the WebUI does not have to parse
# the registry.
tw_count_write() {
	_twcw_n=0
	if [ -f "$TWEAKS_CONF" ]; then
		while IFS= read -r _twcw_l || [ -n "$_twcw_l" ]; do
			case "$_twcw_l" in
				''|\#*) continue ;;
			esac
			_twcw_n=$((_twcw_n + 1))
		done < "$TWEAKS_CONF"
	fi
	_twcw_t=$(date '+%s' 2>/dev/null)
	is_int "$_twcw_t" || _twcw_t=0
	_twcw_e="${1:-0}"
	is_int "$_twcw_e" || _twcw_e=0
	{ print -r -- "$_twcw_n $_twcw_e $_twcw_t" > "$TWEAKS_COUNT"; } 2>/dev/null
	chmod 0600 "$TWEAKS_COUNT" 2>/dev/null
	return 0
}

# ---------------------------------------------------------------------------
# The registry
# ---------------------------------------------------------------------------

# tw_reset_rec - zeroes the fields of the current record
tw_reset_rec() {
	TW_ID=""; TW_KAT=""; TW_MECH=""; TW_CIL=""
	TW_TYP=""; TW_RISK=""; TW_FLAGS=""; TW_NAME=""; TW_DESC=""
}

# tw_find <id> -> fills the TW_* fields, 0 = found
#
# Reads the registry in one pass and STOPS as soon as it is found - for
# tweak get/set that means half the file is read on average. No grep.
tw_find() {
	tw_reset_rec
	[ -f "$TWEAKS_DEF" ] || return 2
	while IFS='|' read -r TW_ID TW_KAT TW_MECH TW_CIL TW_TYP TW_RISK TW_FLAGS TW_NAME TW_DESC || [ -n "$TW_ID" ]; do
		case "$TW_ID" in
			''|\#*|' '*) continue ;;
		esac
		[ "$TW_ID" = "$1" ] && return 0
	done < "$TWEAKS_DEF"
	tw_reset_rec
	return 1
}

# tw_paths <target> -> TW_PATHS (space-separated EXISTING paths), TW_P1 = the first
#
# $1 is deliberately unquoted - that is what expands the glob (e.g. sd[a-d]).
tw_paths() {
	TW_PATHS=""
	TW_P1=""
	for _twp in $1; do
		[ -e "$_twp" ] || continue
		TW_PATHS="$TW_PATHS $_twp"
		[ -n "$TW_P1" ] || TW_P1="$_twp"
	done
	TW_PATHS="${TW_PATHS# }"
	[ -n "$TW_PATHS" ]
}

# tw_read_cur - the current value per TW_MECH -> TW_CUR ("" = cannot be read)
# ===========================================================================
# THE `bootcfg` MECHANISM
#
# Some settings can only be changed at boot - typically the zram size, which
# requires a swapoff (at runtime with a full swap that risks OOM). They are
# therefore written into a config file that `post-fs-data.sh` reads at the next
# start.
#
# The target has the form "file/KEY", the file being relative to STATE_DIR.
# The file format must stay readable by post-fs-data.sh:
#   grep -m1 '^[ \t]*ZRAM_DISKSIZE[ \t]*='
# ===========================================================================

# tw_bc_split <target> -> TW_BC_FILE, TW_BC_KEY
tw_bc_split() {
	case "$1" in
		*/*) ;;
		*)   return 1 ;;
	esac
	TW_BC_FILE="$STATE_DIR/${1%%/*}"
	TW_BC_KEY="${1##*/}"
	case "$TW_BC_KEY" in
		''|*[!A-Za-z0-9_]*) return 1 ;;
	esac
	return 0
}

# tw_bc_get <target> -> TW_BC_VAL ("" = the key is not there)
tw_bc_get() {
	TW_BC_VAL=""
	tw_bc_split "$1" || return 1
	[ -f "$TW_BC_FILE" ] || return 0
	while IFS='=' read -r _bck _bcv || [ -n "$_bck" ]; do
		# trim the spaces around the key
		while :; do case "$_bck" in ' '*|"	"*) _bck="${_bck#?}" ;; *) break ;; esac; done
		while :; do case "$_bck" in *' '|*"	") _bck="${_bck%?}" ;; *) break ;; esac; done
		if [ "$_bck" = "$TW_BC_KEY" ]; then
			_bcv="${_bcv%%#*}"
			while :; do case "$_bcv" in *' '|*"	") _bcv="${_bcv%?}" ;; *) break ;; esac; done
			case "$_bcv" in \"*\") _bcv="${_bcv#\"}"; _bcv="${_bcv%\"}" ;; esac
			TW_BC_VAL="$_bcv"
		fi
	done < "$TW_BC_FILE"
	return 0
}

# tw_bc_put <target> <value>   (an empty value = delete the key)
tw_bc_put() {
	tw_bc_split "$1" || return 1
	_bct="$TW_BC_FILE.tmp.$$"
	: > "$_bct" 2>/dev/null || return 1
	if [ -f "$TW_BC_FILE" ]; then
		while IFS= read -r _bcl || [ -n "$_bcl" ]; do
			case "$_bcl" in
				"$TW_BC_KEY"=*|" $TW_BC_KEY"=*|"	$TW_BC_KEY"=*) continue ;;
			esac
			print -r -- "$_bcl" >> "$_bct" 2>/dev/null
		done < "$TW_BC_FILE"
	fi
	if [ -n "$2" ]; then
		print -r -- "$TW_BC_KEY=$2" >> "$_bct" 2>/dev/null
	fi
	mv -f "$_bct" "$TW_BC_FILE" 2>/dev/null || { rm -f "$_bct" 2>/dev/null; return 1; }
	chmod 0600 "$TW_BC_FILE" 2>/dev/null
	return 0
}

tw_read_cur() {
	TW_CUR=""
	case "$TW_MECH" in
		sysfs|proc|ro)
			tw_paths "$TW_CIL" || return 1
			rdv "$TW_P1" ""
			bracketv
			TW_CUR="$V"
			;;
		bootcfg)
			# the value that will be used at the next boot
			tw_bc_get "$TW_CIL" || return 1
			TW_CUR="$TW_BC_VAL"
			;;
		prop)
			# getprop is a fork, but it is NOT binder (the property area is shared memory)
			TW_CUR=$(getprop "$TW_CIL" 2>/dev/null)
			;;
		settings)
			framework_ok || return 1
			TW_CUR=$(settings_get "${TW_CIL%%/*}" "${TW_CIL#*/}")
			;;
		*)
			return 1
			;;
	esac
	return 0
}

# tw_read_all - the values of all glob paths -> TW_CURS (sysfs/proc/ro only)
tw_read_all() {
	TW_CURS=""
	for _twra in $TW_PATHS; do
		rdv "$_twra" ""
		bracketv
		TW_CURS="$TW_CURS $V"
	done
	TW_CURS="${TW_CURS# }"
}

# tw_enum_options - the allowed values for the enumf: type -> TW_OPTS
tw_enum_options() {
	TW_OPTS=""
	_tweo_src="${TW_TYP#enumf:}"
	if [ "$_tweo_src" = "@self" ]; then
		tw_paths "$TW_CIL" || return 1
		_tweo_src="$TW_P1"
	fi
	[ -r "$_tweo_src" ] || return 1
	rdv "$_tweo_src" ""
	[ -n "$V" ] || return 1
	# "none [mq-deadline] kyber bfq" -> "none mq-deadline kyber bfq"
	for _tweo in $V; do
		case "$_tweo" in
			"["*"]") _tweo="${_tweo#[}"; _tweo="${_tweo%]}" ;;
		esac
		TW_OPTS="$TW_OPTS $_tweo"
	done
	TW_OPTS="${TW_OPTS# }"
	[ -n "$TW_OPTS" ]
}

# tw_type_hint - a human-readable description of the allowed values -> TW_HINT
tw_type_hint() {
	case "$TW_TYP" in
		bool)   TW_HINT="0 or 1" ;;
		ro)     TW_HINT="read only" ;;
		int:*)  _twth="${TW_TYP#int:}"; TW_HINT="a whole number ${_twth%%:*} to ${_twth#*:}" ;;
		enum:*) TW_HINT="${TW_TYP#enum:}" ;;
		enumf:*)
			if tw_enum_options; then
				TW_HINT="$TW_OPTS"
			else
				TW_HINT="(the options cannot be read from ${TW_TYP#enumf:})"
			fi
			;;
		*)      TW_HINT="?" ;;
	esac
}

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------

# tw_validate <type> <value> -> 0 = OK, otherwise the reason lands in TW_ERR
tw_validate() {
	TW_ERR=""
	# A universal character filter. It also protects the case patterns below from
	# a user value acting as a glob (e.g. '*' would match anything).
	case "$2" in
		'')                   TW_ERR="empty value"; return 1 ;;
		*[!A-Za-z0-9_.:+-]*)  TW_ERR="disallowed characters in the value"; return 1 ;;
	esac
	case "$1" in
		ro)
			TW_ERR="the item is read only"
			return 1
			;;
		bool)
			case "$2" in
				0|1) return 0 ;;
			esac
			TW_ERR="only 0 or 1 allowed"
			return 1
			;;
		int:*)
			case "$2" in
				*[!0-9]*) TW_ERR="expected a whole non-negative number"; return 1 ;;
			esac
			# mksh is 32-bit - reject by length BEFORE the number reaches any
			# arithmetic. 11 characters or more = we are done.
			case "$2" in
				???????????*) TW_ERR="the value is too long (at most 10 digits)"; return 1 ;;
			esac
			_twv_r="${1#int:}"
			_twv_min="${_twv_r%%:*}"
			_twv_max="${_twv_r#*:}"
			if ! tw_num_le "$_twv_min" "$2" || ! tw_num_le "$2" "$_twv_max"; then
				TW_ERR="outside the allowed range $_twv_min to $_twv_max"
				return 1
			fi
			return 0
			;;
		enum:*)
			case ",${1#enum:}," in
				*",$2,"*) return 0 ;;
			esac
			TW_ERR="allowed: ${1#enum:}"
			return 1
			;;
		enumf:*)
			if ! tw_enum_options; then
				TW_ERR="the list of values cannot be read (${1#enumf:})"
				return 1
			fi
			for _twv_o in $TW_OPTS; do
				[ "$_twv_o" = "$2" ] && return 0
			done
			TW_ERR="allowed: $TW_OPTS"
			return 1
			;;
	esac
	TW_ERR="unknown type '$1' in the registry"
	return 1
}

# ---------------------------------------------------------------------------
# Writing a value to the device
# ---------------------------------------------------------------------------

# tw_write_val <value> -> the number of failed writes in TW_WERR
tw_write_val() {
	TW_WERR=0
	case "$TW_MECH" in
		sysfs|proc)
			if ! tw_paths "$TW_CIL"; then
				log ERROR "tweak: $TW_ID: the target does not exist ($TW_CIL)"
				TW_WERR=1
				return 1
			fi
			for _tww in $TW_PATHS; do
				# TRAP: nodes of the form "a [b] c" - without normalisation wr()
				# would keep seeing a difference and writing over and over at 27-31 ms.
				rdv "$_tww" ""
				bracketv
				[ "$V" = "$1" ] && continue
				wr "$_tww" "$1" || TW_WERR=$((TW_WERR + 1))
			done
			;;
		bootcfg)
			if tw_bc_put "$TW_CIL" "$1"; then
				log INFO "tweak: $TW_ID -> '$1' (takes effect after a restart)"
			else
				log ERROR "tweak: $TW_ID: the write to bootcfg failed ($TW_CIL)"
				TW_WERR=1
			fi
			;;
		prop)
			_tww_old=$(getprop "$TW_CIL" 2>/dev/null)
			if [ "$_tww_old" = "$1" ]; then
				return 0
			fi
			if setprop "$TW_CIL" "$1" 2>/dev/null; then
				log INFO "tweak: setprop $TW_CIL: '$_tww_old' -> '$1'"
			else
				log ERROR "tweak: setprop $TW_CIL <- '$1' failed"
				TW_WERR=1
			fi
			;;
		settings)
			if ! framework_ok; then
				log ERROR "tweak: $TW_ID: the framework (binder) is not available, not setting"
				TW_WERR=1
				return 1
			fi
			_tww_ns="${TW_CIL%%/*}"
			_tww_k="${TW_CIL#*/}"
			if [ -z "$1" ]; then
				settings_run delete "$_tww_ns" "$_tww_k" \
					|| settings_run put "$_tww_ns" "$_tww_k" ""
				log INFO "tweak: settings $_tww_ns $_tww_k -> (deleted)"
			elif settings_run put "$_tww_ns" "$_tww_k" "$1"; then
				log INFO "tweak: settings $_tww_ns $_tww_k -> '$1'"
			else
				log ERROR "tweak: settings put $_tww_ns $_tww_k '$1' failed"
				TW_WERR=1
			fi
			;;
		cmd)
			log ERROR "tweak: $TW_ID: the 'cmd' mechanism is not implemented yet"
			TW_WERR=1
			return 1
			;;
		*)
			log ERROR "tweak: $TW_ID: unknown mechanism '$TW_MECH'"
			TW_WERR=1
			return 1
			;;
	esac
	[ "$TW_WERR" -eq 0 ]
}

# tw_write_list <list of values> - restoring the stock of glob targets
# (sda has read_ahead_kb 128, sdb-sdd 1024 - one value for all would be wrong)
tw_write_list() {
	TW_WERR=0
	case "$TW_MECH" in
		sysfs|proc) ;;
		*) tw_write_val "$1"; return $? ;;
	esac
	if ! tw_paths "$TW_CIL"; then
		log ERROR "tweak: $TW_ID: the target does not exist ($TW_CIL)"
		TW_WERR=1
		return 1
	fi
	tw_count_items "$TW_PATHS"; _twl_np="$TW_NITEMS"
	tw_count_items "$1";        _twl_nv="$TW_NITEMS"
	if [ "$_twl_np" -ne "$_twl_nv" ]; then
		log WARN "tweak: $TW_ID: the number of paths ($_twl_np) != the number of stored values ($_twl_nv), using the first value for all"
		tw_nth 1 "$1" || return 1
		tw_write_val "$TW_NTH"
		return $?
	fi
	_twl_i=0
	for _twl_p in $TW_PATHS; do
		_twl_i=$((_twl_i + 1))
		tw_nth "$_twl_i" "$1" || continue
		rdv "$_twl_p" ""
		bracketv
		[ "$V" = "$TW_NTH" ] && continue
		wr "$_twl_p" "$TW_NTH" || TW_WERR=$((TW_WERR + 1))
	done
	[ "$TW_WERR" -eq 0 ]
}

# ---------------------------------------------------------------------------
# Capturing the stock value
#
# The stock is taken ON FIRST TOUCH, not from the registry - the registry
# describes what a node can do, not what value it currently has. The file is
# append-only and the first write wins, so a repeated `set` does not overwrite
# the stock.
# ---------------------------------------------------------------------------

# tw_stock_seed <id> -> TW_SEED / TW_SEED_SET
#
# Some nodes are already controlled by a profile (charge_stop_level,
# read_ahead_kb). If the stock were read from the device after the profile had
# overwritten it, we would store the profile's value as the "stock". For those
# three items we therefore prefer the real stock from backup/stock.conf, which
# was created before the first change.
tw_stock_seed() {
	TW_SEED=""
	TW_SEED_SET=0
	case "$1" in
		batt.charge_stop_level)
			stock_load
			eval "_twss=\${SC_STOCK_CHARGE_STOP_LEVEL:-}"
			;;
		batt.charge_start_level)
			stock_load
			eval "_twss=\${SC_STOCK_CHARGE_START_LEVEL:-}"
			;;
		io.read_ahead_kb)
			stock_load
			_twss=""
			for _twss_d in SDA SDB SDC SDD; do
				eval "_twss_x=\${SC_STOCK_IO_READAHEAD_$_twss_d:-}"
				[ -n "$_twss_x" ] && _twss="$_twss $_twss_x"
			done
			_twss="${_twss# }"
			;;
		*)
			return 0
			;;
	esac
	if [ -n "$_twss" ]; then
		TW_SEED="$_twss"
		TW_SEED_SET=1
	fi
	return 0
}

# tw_stock_ensure <id> - captures the stock when it is not captured yet
tw_stock_ensure() {
	tw_stock_get "$1"
	[ "$TW_SSET" = "1" ] && return 0

	tw_stock_seed "$1"
	if [ "$TW_SEED_SET" = "1" ]; then
		_twse_v="$TW_SEED"
	else
		case "$TW_MECH" in
			sysfs|proc)
				tw_paths "$TW_CIL" || return 1
				tw_read_all
				_twse_v="$TW_CURS"
				;;
			*)
				tw_read_cur || return 1
				_twse_v="$TW_CUR"
				;;
		esac
	fi

	[ -d "$BACKUP_DIR" ] || mkdir -p "$BACKUP_DIR" 2>/dev/null
	if ! { print -r -- "$1=$_twse_v" >> "$TWEAKS_STOCK"; } 2>/dev/null; then
		log ERROR "tweak: cannot write the stock into $TWEAKS_STOCK"
		return 1
	fi
	chmod 0600 "$TWEAKS_STOCK" 2>/dev/null
	tw_key "$1"
	eval "TWS_$TW_KEY=\$_twse_v"
	TW_STOCK_EXISTS=1
	log INFO "tweak: captured stock $1='$_twse_v'"
	return 0
}

# ---------------------------------------------------------------------------
# set / reset
# ---------------------------------------------------------------------------

cmd_tweak_set() {
	if [ -z "$1" ] || [ "$#" -lt 2 ]; then
		warn "pxtune: usage: pxtune tweak set <id> <value>"
		exit 1
	fi
	if ! tw_find "$1"; then
		warn "pxtune: unknown tweak '$1' (list: pxtune tweak list)"
		exit 1
	fi
	if [ "$TW_MECH" = "ro" ] || [ "$TW_TYP" = "ro" ]; then
		warn "pxtune: '$1' is read only and pixel_tune deliberately does not set it."
		warn "        Reason: $TW_DESC"
		exit 1
	fi
	if ! tw_validate "$TW_TYP" "$2"; then
		warn "pxtune: invalid value '$2' for '$1': $TW_ERR"
		log ERROR "tweak set $1='$2' rejected: $TW_ERR"
		exit 1
	fi
	case "$TW_MECH" in
		sysfs|proc)
			if ! tw_paths "$TW_CIL"; then
				warn "pxtune: the target does not exist: $TW_CIL"
				log ERROR "tweak set $1: the target does not exist ($TW_CIL)"
				return 2
			fi
			;;
		settings)
			if ! framework_ok; then
				warn "pxtune: '$1' is set via 'settings' (binder) and the framework is not available right now."
				return 2
			fi
			;;
	esac

	if ! tw_stock_ensure "$1"; then
		warn "pxtune: the stock value for '$1' could not be captured - not setting it."
		warn "        Without a backup the original state could not be restored (HARD CONSTRAINT #5 from the SPEC)."
		return 2
	fi

	if [ "$TW_RISK" = "3" ]; then
		warn "pxtune: CAUTION, '$1' carries a high risk. Read 'pxtune tweak info $1'."
		log WARN "tweak set $1='$2' - an item with risk 3"
	fi

	tw_write_val "$2"
	_twcs_e="$TW_WERR"

	tw_conf_put "$1" "$2" || return 2
	tw_count_write "$_twcs_e"

	tw_stock_get "$1"
	if [ "$_twcs_e" -eq 0 ]; then
		log INFO "tweak set $1='$2' (stock '$TW_SVAL')"
		msg "$1 = $2   (stock: ${TW_SVAL:-?})"
		if tw_hasflag "$TW_FLAGS" unverified; then
			msg "NOTE: the effect of this item on this build is not documented."
		fi
		case "$TW_MECH" in
			prop)     msg "NOTE: the value is read by the HAL at startup - it only fully takes effect after a reboot." ;;
		esac
		return 0
	fi
	warn "pxtune: '$1' saved, but $_twcs_e writes failed (see pxtune log)."
	return 2
}

# tw_reset_one <id> <0|1 = quiet> -> 0 OK
tw_reset_one() {
	if ! tw_find "$1"; then
		[ "$2" = "1" ] || warn "pxtune: unknown tweak '$1'"
		# The record is no longer in the registry (module upgrade) - drop the conf line.
		tw_conf_put "$1" __DEL__
		return 1
	fi
	tw_stock_get "$1"
	if [ "$TW_SSET" != "1" ]; then
		log WARN "tweak reset $1: the stock is not captured, only removing it from tweaks.conf"
		[ "$2" = "1" ] || warn "pxtune: there is no captured stock for '$1', there is nothing to restore - only removing it from tweaks.conf."
		tw_conf_put "$1" __DEL__
		return 1
	fi
	TW_WERR=0
	if [ -z "$TW_SVAL" ]; then
		# An empty stock = the item originally WAS NOT set. That only makes sense
		# for settings and props (delete / empty). An empty value must not be
		# written to sysfs - the kernel would reject it or, worse, accept it.
		case "$TW_MECH" in
			# an empty stock = "the key was not there originally" -> delete
			settings|prop|bootcfg) tw_write_val "" ;;
			*) log WARN "tweak reset $1: the captured stock is empty and a $TW_MECH target cannot be emptied, leaving the node alone" ;;
		esac
	else
		tw_write_list "$TW_SVAL"
	fi
	_twro_e="$TW_WERR"
	tw_conf_put "$1" __DEL__
	log INFO "tweak reset $1 -> stock '$TW_SVAL' (errors: $_twro_e)"
	[ "$2" = "1" ] || msg "$1 restored to stock: ${TW_SVAL:-(not set)}"
	[ "$_twro_e" -eq 0 ]
}

cmd_tweak_reset() {
	if [ -z "$1" ]; then
		warn "pxtune: usage: pxtune tweak reset <id>"
		exit 1
	fi
	tw_conf_get "$1"
	if [ "$TW_CSET" != "1" ]; then
		msg "$1 is not in tweaks.conf (nothing to restore)."
		return 0
	fi
	tw_reset_one "$1" 0
	_twcr_rc=$?
	tw_count_write 0
	return $_twcr_rc
}

# tweak_reset_all - restores ALL tweaks to stock and empties tweaks.conf.
#
# Called from cmd_revert in bin/pxtune, but ONLY BEYOND the RESTORE_ONLY=1
# branch. restore_stock_values() calls cmd_revert on EVERY profile switch; if
# tweaks were reset there too, the user would lose them on every profile change.
tweak_reset_all() {
	tw_conf_load
	if [ "$TW_CONF_N" -eq 0 ]; then
		tw_count_write 0
		return 0
	fi
	_twra_ids="$TW_CONF_IDS"
	_twra_e=0
	log INFO "=== tweak reset-all ($TW_CONF_N items) ==="
	for _twra_id in $_twra_ids; do
		tw_reset_one "$_twra_id" 1 || _twra_e=$((_twra_e + 1))
	done
	{ : > "$TWEAKS_CONF"; } 2>/dev/null
	TW_CONF_LOADED=0
	tw_count_write "$_twra_e"
	log INFO "tweak reset-all done (not restored: $_twra_e)"
	return 0
}

cmd_tweak_reset_all() {
	tw_conf_load
	_twcra_n="$TW_CONF_N"
	tweak_reset_all
	msg "Restored to stock: $_twcra_n tweaks. tweaks.conf is empty."
	msg "NOTE: tweaks.stock is deliberately not deleted - it is the only record of the original values."
	return 0
}

# ---------------------------------------------------------------------------
# Batch deployment (boot / after a profile)
#
# Both functions make ONE pass over the registry and check for each line whether
# the id is in tweaks.conf. The other order (for each conf line, walk the
# registry) would mean N passes over the file.
# ---------------------------------------------------------------------------

# tw_apply_flagged <flag> -> TW_AP_N (deployed), TW_AP_E (errors)
tw_apply_flagged() {
	TW_AP_N=0
	TW_AP_E=0
	tw_conf_load
	[ "$TW_CONF_N" -eq 0 ] && return 0
	[ -f "$TWEAKS_DEF" ] || {
		log ERROR "tweak: registry not found: $TWEAKS_DEF"
		TW_AP_E=1
		return 1
	}
	_twaf_flag="$1"
	while IFS='|' read -r TW_ID TW_KAT TW_MECH TW_CIL TW_TYP TW_RISK TW_FLAGS TW_NAME TW_DESC || [ -n "$TW_ID" ]; do
		case "$TW_ID" in
			''|\#*|' '*) continue ;;
		esac
		tw_hasflag "$TW_FLAGS" "$_twaf_flag" || continue
		tw_key "$TW_ID"
		eval "_twaf_h=\${TWC_$TW_KEY+x}"
		[ -n "${_twaf_h:-}" ] || continue
		eval "_twaf_v=\$TWC_$TW_KEY"

		if ! tw_validate "$TW_TYP" "$_twaf_v"; then
			log ERROR "tweak: $TW_ID='$_twaf_v' in tweaks.conf is invalid ($TW_ERR), skipping"
			TW_AP_E=$((TW_AP_E + 1))
			continue
		fi
		# the stock must be captured, otherwise a revert would be impossible
		tw_stock_get "$TW_ID"
		if [ "$TW_SSET" != "1" ]; then
			if ! tw_stock_ensure "$TW_ID"; then
				log ERROR "tweak: $TW_ID: the stock is missing and cannot be captured, not deploying"
				TW_AP_E=$((TW_AP_E + 1))
				continue
			fi
		fi
		if tw_write_val "$_twaf_v"; then
			TW_AP_N=$((TW_AP_N + 1))
		else
			TW_AP_N=$((TW_AP_N + 1))
			TW_AP_E=$((TW_AP_E + TW_WERR))
		fi
	done < "$TWEAKS_DEF"
	return 0
}

# tweak_apply_boot - called by service.sh via `pxtune tweak apply-boot`
#
# Deploys only items with the `boot` flag, i.e. those that do not survive a
# reboot. Android remembers settings and persist.* props itself and we
# deliberately do not touch them at boot.
tweak_apply_boot() {
	tw_conf_load
	if [ "$TW_CONF_N" -eq 0 ]; then
		log INFO "tweak apply-boot: tweaks.conf is empty, nothing to deploy"
		tw_count_write 0
		return 0
	fi

	# HARD CONSTRAINT #5 from the SPEC: everything must be reversible and backed
	# up. When there is something to deploy but the record of stock values is
	# missing, we must not write anything - otherwise we create a state there is
	# no way back from.
	tw_stock_load
	if [ "$TW_STOCK_EXISTS" != "1" ]; then
		log ERROR "tweak apply-boot: tweaks.conf has $TW_CONF_N items, but $TWEAKS_STOCK IS MISSING - deploying NOTHING (no revert without a backup)"
		warn "pxtune: $TWEAKS_STOCK is missing, tweaks are not deployed (see the log)"
		tw_count_write "$TW_CONF_N"
		return 2
	fi

	log INFO "=== tweak apply-boot ==="
	tw_apply_flagged boot
	tw_count_write "$TW_AP_E"
	log INFO "tweak apply-boot: deployed $TW_AP_N, errors $TW_AP_E"
	msg "Tweaks deployed: $TW_AP_N, errors: $TW_AP_E."
	[ "$TW_AP_E" -gt 0 ] && return 2
	return 0
}

# tweak_reapply - called from profile_apply in bin/pxtune, at its end.
#
# A profile touches the same nodes as some tweaks (charge_stop_level,
# read_ahead_kb). The order is deliberate: the profile writes its values, then a
# tweak with the `reapply` flag overwrites them - the user's tweak has the final
# say.
tweak_reapply() {
	tw_conf_load
	[ "$TW_CONF_N" -eq 0 ] && return 0

	# write statistics belong to the profile, tweaks must not mix into them
	_twrp_ok="${WR_OK:-0}"
	_twrp_fail="${WR_FAIL:-0}"

	tw_apply_flagged reapply

	WR_OK="$_twrp_ok"
	WR_FAIL="$_twrp_fail"

	[ "$TW_AP_N" -gt 0 ] && log INFO "tweak reapply: overwrote $TW_AP_N items after the profile (errors: $TW_AP_E)"
	return 0
}

# ---------------------------------------------------------------------------
# Listings
# ---------------------------------------------------------------------------
cmd_tweak_list() {
	_twl_filter="$1"
	if [ -n "$_twl_filter" ]; then
		case " $TW_CATS " in
			*" $_twl_filter "*) ;;
			*)
				warn "pxtune: unknown category '$_twl_filter' (available: $TW_CATS)"
				exit 1
				;;
		esac
	fi
	[ -f "$TWEAKS_DEF" ] || { warn "pxtune: registry not found: $TWEAKS_DEF"; return 2; }
	tw_conf_load
	tw_stock_load

	TW_ROW=""; col "" 2; col "ID" 42; col "CAT" 6; col "RSK" 4; col "VALUE" 16
	o "${TW_ROW}NAME"
	_twl_n=0
	while IFS='|' read -r TW_ID TW_KAT TW_MECH TW_CIL TW_TYP TW_RISK TW_FLAGS TW_NAME TW_DESC || [ -n "$TW_ID" ]; do
		case "$TW_ID" in
			''|\#*|' '*) continue ;;
		esac
		[ -n "$_twl_filter" ] && [ "$TW_KAT" != "$_twl_filter" ] && continue
		_twl_n=$((_twl_n + 1))

		tw_key "$TW_ID"
		eval "_twl_h=\${TWC_$TW_KEY+x}"
		if [ -n "${_twl_h:-}" ]; then
			eval "_twl_v=\$TWC_$TW_KEY"
			_twl_m="*"
		elif [ "$TW_MECH" = "ro" ]; then
			_twl_v="-"
			_twl_m="#"
		else
			_twl_v="-"
			_twl_m=" "
		fi
		tw_hasflag "$TW_FLAGS" unverified && _twl_m="$_twl_m?" || _twl_m="$_twl_m "
		TW_ROW=""
		col "$_twl_m" 2; col "$TW_ID" 42; col "$TW_KAT" 6; col "$TW_RISK" 4; col "$_twl_v" 16
		o "${TW_ROW}$TW_NAME"
	done < "$TWEAKS_DEF"

	o ""
	o "Items: $_twl_n   * = set in tweaks.conf   # = read only   ? = effect unverified"
	o "Details including the description: pxtune tweak info <id>"
	oflush
	return 0
}

cmd_tweak_categories() {
	[ -f "$TWEAKS_DEF" ] || { warn "pxtune: registry not found: $TWEAKS_DEF"; return 2; }
	for _twc_c in $TW_CATS; do
		eval "TWCAT_$_twc_c=0"
		eval "TWCATRW_$_twc_c=0"
	done
	while IFS='|' read -r TW_ID TW_KAT TW_MECH TW_CIL TW_TYP TW_RISK TW_FLAGS TW_NAME TW_DESC || [ -n "$TW_ID" ]; do
		case "$TW_ID" in
			''|\#*|' '*) continue ;;
		esac
		case " $TW_CATS " in
			*" $TW_KAT "*) ;;
			*) continue ;;
		esac
		eval "TWCAT_$TW_KAT=\$((TWCAT_$TW_KAT + 1))"
		[ "$TW_MECH" = "ro" ] || eval "TWCATRW_$TW_KAT=\$((TWCATRW_$TW_KAT + 1))"
	done < "$TWEAKS_DEF"

	TW_ROW=""; col "CAT" 7; col "TOTAL" 6; col "SETTABLE" 14
	o "${TW_ROW}DESCRIPTION"
	for _twc_c in $TW_CATS; do
		eval "_twc_n=\$TWCAT_$_twc_c"
		eval "_twc_w=\$TWCATRW_$_twc_c"
		tw_cat_name "$_twc_c"
		TW_ROW=""; col "$_twc_c" 7; col "$_twc_n" 6; col "$_twc_w" 14
		o "${TW_ROW}$TW_CATNAME"
	done
	o ""
	o "List a category: pxtune tweak list <cat>"
	oflush
	return 0
}

cmd_tweak_info() {
	if [ -z "$1" ]; then
		warn "pxtune: usage: pxtune tweak info <id>"
		exit 1
	fi
	if ! tw_find "$1"; then
		warn "pxtune: unknown tweak '$1' (list: pxtune tweak list)"
		exit 1
	fi
	tw_cat_name "$TW_KAT"
	tw_risk_name "$TW_RISK"
	tw_conf_get "$1"
	tw_stock_get "$1"

	o "=== $TW_ID ==="
	o "$TW_NAME"
	o ""
	o "$TW_DESC"
	o ""
	o "  category      $TW_KAT ($TW_CATNAME)"
	o "  mechanism     $TW_MECH"
	o "  target        $TW_CIL"
	tw_type_hint
	o "  allowed       $TW_HINT"
	o "  risk          $TW_RISK ($TW_RISKNAME)"
	o "  flags         ${TW_FLAGS:-(none)}"

	if tw_read_cur; then
		o "  currently     ${TW_CUR:-(empty)}"
	else
		o "  currently     (cannot be read)"
	fi
	if [ "$TW_CSET" = "1" ]; then
		o "  set           $TW_CVAL"
	else
		o "  set           no (the system controls it)"
	fi
	if [ "$TW_SSET" = "1" ]; then
		o "  stock         ${TW_SVAL:-(was not set)}"
	else
		o "  stock         (not captured yet - it will be on the first 'tweak set')"
	fi

	case "$TW_MECH" in
		ro) o ""; o "pixel_tune DELIBERATELY does not set this item - the reason is in the description above." ;;
	esac
	if tw_hasflag "$TW_FLAGS" boot; then
		o ""
		o "The setting does not survive a reboot; service.sh redeploys it via 'tweak apply-boot'."
	fi
	if tw_hasflag "$TW_FLAGS" reapply; then
		o "A profile touches the same node - the tweak is therefore deployed after it."
	fi
	if tw_hasflag "$TW_FLAGS" unverified; then
		o "CAUTION: the effect of this item on this build is NOT documented."
	fi
	oflush
	return 0
}

cmd_tweak_get() {
	if [ -z "$1" ]; then
		warn "pxtune: usage: pxtune tweak get <id>"
		exit 1
	fi
	if ! tw_find "$1"; then
		warn "pxtune: unknown tweak '$1'"
		exit 1
	fi
	if tw_read_cur; then
		print -r -- "$TW_CUR"
		return 0
	fi
	warn "pxtune: the value of '$1' could not be read ($TW_CIL)"
	return 2
}

# ---------------------------------------------------------------------------
# JSON for the WebUI
#
# `tweak json` is a SEPARATE command and deliberately NOT part of
# `status --json`:
#   - status --json runs every ~5 s, while the registry only changes on install,
#   - status --json would grow by tens of kB of descriptions on every call.
# The WebUI loads the registry once and then only watches the "tweaks" object
# (active / errors / time of last change) from tweaks.count in `status --json`.
#
# Without --live nothing is read from the device - only the registry +
# tweaks.conf + tweaks.stock.
# ---------------------------------------------------------------------------
cmd_tweak_json() {
	_twj_live=0
	case "$1" in
		"")      ;;
		--live)  _twj_live=1 ;;
		*)       warn "pxtune: usage: pxtune tweak json [--live]"; exit 1 ;;
	esac
	if [ ! -f "$TWEAKS_DEF" ]; then
		print -r -- '{"error":"registry_missing","tweaks":[],"categories":[]}'
		return 2
	fi

	# --- CACHE ---------------------------------------------------------
	# The key = the mtime of the registry + tweaks.conf + tweaks.stock. When none
	# of them changed, the result is bit-identical and it is enough to print it.
	# --live is NOT cached: it reads live values from sysfs, which change.
	_twj_key=""
	for _twj_f in "$TWEAKS_DEF" "$TWEAKS_CONF" "$TWEAKS_STOCK"; do
		if [ -f "$_twj_f" ]; then
			_twj_key="$_twj_key$(stat -c %Y "$_twj_f" 2>/dev/null)-"
		else
			_twj_key="${_twj_key}0-"
		fi
	done
	if [ "$_twj_live" -eq 0 ] && [ -s "$TWEAKS_JCACHE" ]; then
		IFS= read -r _twj_hdr < "$TWEAKS_JCACHE" 2>/dev/null
		if [ "$_twj_hdr" = "#$_twj_key" ]; then
			# the first line is the key, the rest is the JSON
			sed -n '2p' "$TWEAKS_JCACHE" 2>/dev/null
			return 0
		fi
	fi

	tw_conf_load
	tw_stock_load

	for _twj_c in $TW_CATS; do
		eval "TWCAT_$_twj_c=0"
	done

	J="{\"version\":\"$PXTUNE_TWEAKS_VERSION\",\"live\":"
	if [ "$_twj_live" -eq 1 ]; then J="${J}true"; else J="${J}false"; fi
	J="$J,\"tweaks\":["

	_twj_first=1
	while IFS='|' read -r TW_ID TW_KAT TW_MECH TW_CIL TW_TYP TW_RISK TW_FLAGS TW_NAME TW_DESC || [ -n "$TW_ID" ]; do
		case "$TW_ID" in
			''|\#*|' '*) continue ;;
		esac
		case " $TW_CATS " in
			*" $TW_KAT "*) eval "TWCAT_$TW_KAT=\$((TWCAT_$TW_KAT + 1))" ;;
		esac
		[ "$_twj_first" -eq 1 ] || J="$J,"
		_twj_first=0

		tw_key "$TW_ID"
		eval "_twj_h=\${TWC_$TW_KEY+x}"
		if [ -n "${_twj_h:-}" ]; then
			eval "_twj_v=\$TWC_$TW_KEY"
			_twj_set=true
		else
			_twj_v=""
			_twj_set=false
		fi
		eval "_twj_sh=\${TWS_$TW_KEY+x}"
		if [ -n "${_twj_sh:-}" ]; then
			eval "_twj_s=\$TWS_$TW_KEY"
		else
			_twj_s=""
		fi

		# DESCRIPTIONS ARE EMITTED WITHOUT ESCAPING - the registry must not contain
		# " or \, which `tweak selftest` checks. Escaping via sed would cost
		# 7.7 ms per line.
		J="$J{\"id\":\"$TW_ID\",\"cat\":\"$TW_KAT\",\"mech\":\"$TW_MECH\""
		J="$J,\"target\":\"$TW_CIL\",\"type\":\"$TW_TYP\",\"risk\":${TW_RISK:-0},\"flags\":"
		tw_jflags "$TW_FLAGS"
		J="$J,\"name\":\"$TW_NAME\",\"desc\":\"$TW_DESC\",\"set\":$_twj_set,\"value\":"
		tw_jstr "$_twj_v"
		J="$J,\"stock\":"
		tw_jstr "$_twj_s"
		if [ "$_twj_live" -eq 1 ]; then
			J="$J,\"current\":"
			if tw_read_cur; then
				tw_jstr "$TW_CUR"
			else
				J="${J}null"
			fi
		fi
		J="$J}"
	done < "$TWEAKS_DEF"

	J="$J],\"categories\":["
	_twj_first=1
	for _twj_c in $TW_CATS; do
		eval "_twj_n=\$TWCAT_$_twj_c"
		tw_cat_name "$_twj_c"
		[ "$_twj_first" -eq 1 ] || J="$J,"
		_twj_first=0
		J="$J{\"id\":\"$_twj_c\",\"name\":\"$TW_CATNAME\",\"n\":$_twj_n}"
	done
	J="$J],\"count\":{"

	rdv "$TWEAKS_COUNT" ""
	_twj_a=0; _twj_e=0; _twj_t=0
	if [ -n "$V" ]; then
		tw_nth 1 "$V" && _twj_a="$TW_NTH"
		tw_nth 2 "$V" && _twj_e="$TW_NTH"
		tw_nth 3 "$V" && _twj_t="$TW_NTH"
	fi
	case "$_twj_a" in ''|*[!0-9]*) _twj_a=0 ;; esac
	case "$_twj_e" in ''|*[!0-9]*) _twj_e=0 ;; esac
	case "$_twj_t" in ''|*[!0-9]*) _twj_t=0 ;; esac
	J="$J\"active\":$_twj_a,\"errors\":$_twj_e,\"ts\":$_twj_t}}"
	if [ "$_twj_live" -eq 0 ] && [ -d "$STATE_DIR" ]; then
		{ print -r -- "#$_twj_key"; print -r -- "$J"; } > "$TWEAKS_JCACHE.tmp" 2>/dev/null &&
			mv -f "$TWEAKS_JCACHE.tmp" "$TWEAKS_JCACHE" 2>/dev/null
	fi
	print -r -- "$J"
	return 0
}

# ---------------------------------------------------------------------------
# selftest
# ---------------------------------------------------------------------------
cmd_tweak_selftest() {
	TWST_ERR=0
	TWST_WARN=0
	o "pxtune-tweaks $PXTUNE_TWEAKS_VERSION selftest"
	o "registr  : $TWEAKS_DEF"
	o "conf     : $TWEAKS_CONF"
	o "stock    : $TWEAKS_STOCK"
	o "counter  : $TWEAKS_COUNT"
	o ""

	if [ ! -f "$TWEAKS_DEF" ]; then
		o "ERROR: the registry does not exist"
		oflush
		return 2
	fi

	TWST_SEEN=""
	TWST_KEYS=""
	TWST_N=0
	TW_ROW=""; col "ID" 42; col "CAT" 6; col "MECH" 9; col "EXI" 4; col "WRT" 5
	o "${TW_ROW}NOTE"

	while IFS='|' read -r TW_ID TW_KAT TW_MECH TW_CIL TW_TYP TW_RISK TW_FLAGS TW_NAME TW_DESC || [ -n "$TW_ID" ]; do
		case "$TW_ID" in
			''|\#*|' '*) continue ;;
		esac
		TWST_N=$((TWST_N + 1))
		_twst_note=""

		# --- id syntax ---
		case "$TW_ID" in
			*[!a-z0-9._]*) _twst_note="$_twst_note ID:disallowed-characters"; TWST_ERR=$((TWST_ERR + 1)) ;;
		esac
		case " $TWST_SEEN " in
			*" $TW_ID "*) _twst_note="$_twst_note ID:duplicate"; TWST_ERR=$((TWST_ERR + 1)) ;;
		esac
		TWST_SEEN="$TWST_SEEN $TW_ID"
		tw_key "$TW_ID"
		case " $TWST_KEYS " in
			*" $TW_KEY "*) _twst_note="$_twst_note KEY:collision-after-dot-substitution"; TWST_ERR=$((TWST_ERR + 1)) ;;
		esac
		TWST_KEYS="$TWST_KEYS $TW_KEY"

		# --- category / mechanism / risk / flags ---
		case " $TW_CATS " in
			*" $TW_KAT "*) ;;
			*) _twst_note="$_twst_note CAT:unknown"; TWST_ERR=$((TWST_ERR + 1)) ;;
		esac
		case " $TW_MECHS " in
			*" $TW_MECH "*) ;;
			*) _twst_note="$_twst_note MECH:unknown"; TWST_ERR=$((TWST_ERR + 1)) ;;
		esac
		case "$TW_RISK" in
			0|1|2|3) ;;
			*) _twst_note="$_twst_note RISK:outside-0-3"; TWST_ERR=$((TWST_ERR + 1)) ;;
		esac
		_twst_f="$TW_FLAGS"
		while [ -n "$_twst_f" ]; do
			case "$_twst_f" in
				*,*) _twst_one="${_twst_f%%,*}"; _twst_f="${_twst_f#*,}" ;;
				*)   _twst_one="$_twst_f"; _twst_f="" ;;
			esac
			[ -n "$_twst_one" ] || continue
			case " $TW_FLAGS_KNOWN " in
				*" $_twst_one "*) ;;
				*) _twst_note="$_twst_note FLAG:$_twst_one"; TWST_ERR=$((TWST_ERR + 1)) ;;
			esac
		done

		# --- type ---
		case "$TW_TYP" in
			bool|ro|enum:*|enumf:*) ;;
			int:*)
				_twst_r="${TW_TYP#int:}"
				case "$_twst_r" in
					*:*) ;;
					*) _twst_note="$_twst_note TYPE:int-without-range"; TWST_ERR=$((TWST_ERR + 1)) ;;
				esac
				;;
			*) _twst_note="$_twst_note TYPE:unknown"; TWST_ERR=$((TWST_ERR + 1)) ;;
		esac
		if [ "$TW_MECH" = "ro" ] && [ "$TW_TYP" != "ro" ]; then
			_twst_note="$_twst_note MECH-ro-but-TYPE-not-ro"; TWST_ERR=$((TWST_ERR + 1))
		fi

		# --- texts (the JSON is emitted without escaping) ---
		case "$TW_NAME$TW_DESC" in
			*'"'*)  _twst_note="$_twst_note TEXT:quote"; TWST_ERR=$((TWST_ERR + 1)) ;;
		esac
		case "$TW_NAME$TW_DESC" in
			*'\'*)  _twst_note="$_twst_note TEXT:backslash"; TWST_ERR=$((TWST_ERR + 1)) ;;
		esac
		[ -n "$TW_NAME" ] || { _twst_note="$_twst_note NAME:empty"; TWST_ERR=$((TWST_ERR + 1)); }
		[ -n "$TW_DESC" ] || { _twst_note="$_twst_note DESC:empty"; TWST_ERR=$((TWST_ERR + 1)); }

		# --- target ---
		_twst_e="-"; _twst_w="-"
		case "$TW_MECH" in
			sysfs|proc|ro)
				if tw_paths "$TW_CIL"; then
					_twst_e="yes"
					_twst_w="no"
					[ -w "$TW_P1" ] && _twst_w="yes"
					if [ "$TW_MECH" != "ro" ] && [ "$_twst_w" = "no" ]; then
						_twst_note="$_twst_note TARGET:not-writable"
						TWST_ERR=$((TWST_ERR + 1))
					fi
				else
					_twst_e="NO"
					if tw_hasflag "$TW_FLAGS" unverified; then
						_twst_note="$_twst_note TARGET:missing(unverified)"
						TWST_WARN=$((TWST_WARN + 1))
					else
						_twst_note="$_twst_note TARGET:MISSING"
						TWST_ERR=$((TWST_ERR + 1))
					fi
				fi
				;;
			settings)
				case "$TW_CIL" in
					*/*) ;;
					*) _twst_note="$_twst_note TARGET:expected-namespace/key"; TWST_ERR=$((TWST_ERR + 1)) ;;
				esac
				;;
			prop)
				case "$TW_CIL" in
					*.*) ;;
					*) _twst_note="$_twst_note TARGET:does-not-look-like-a-property"; TWST_ERR=$((TWST_ERR + 1)) ;;
				esac
				;;
		esac

		# --- enumf must be readable ---
		case "$TW_TYP" in
			enumf:*)
				if tw_enum_options; then
					_twst_note="$_twst_note [$TW_OPTS]"
				else
					_twst_note="$_twst_note ENUMF:options-cannot-be-read"
					TWST_WARN=$((TWST_WARN + 1))
				fi
				;;
		esac

		TW_ROW=""
		col "$TW_ID" 42; col "$TW_KAT" 6; col "$TW_MECH" 9; col "$_twst_e" 4; col "$_twst_w" 5
		o "${TW_ROW}${_twst_note# }"
	done < "$TWEAKS_DEF"

	# --- state ---
	o ""
	o "== State =="
	tw_conf_load
	tw_stock_load
	o "items in the registry     : $TWST_N"
	o "set (tweaks.conf)         : $TW_CONF_N"
	if [ "$TW_STOCK_EXISTS" = "1" ]; then
		o "tweaks.stock              : exists"
	elif [ "$TW_CONF_N" -gt 0 ]; then
		o "tweaks.stock              : MISSING -> apply-boot will deploy nothing!"
		TWST_ERR=$((TWST_ERR + 1))
	else
		o "tweaks.stock              : does not exist (nothing set yet, OK)"
	fi

	# every set id must be in the registry and have a captured stock
	for _twst_id in $TW_CONF_IDS; do
		if ! tw_find "$_twst_id"; then
			o "tweaks.conf: $_twst_id is NOT in the registry"
			TWST_ERR=$((TWST_ERR + 1))
			continue
		fi
		tw_stock_get "$_twst_id"
		if [ "$TW_SSET" != "1" ]; then
			o "tweaks.conf: $_twst_id has no captured stock"
			TWST_ERR=$((TWST_ERR + 1))
		fi
		tw_conf_get "$_twst_id"
		if ! tw_validate "$TW_TYP" "$TW_CVAL"; then
			o "tweaks.conf: $_twst_id=$TW_CVAL is invalid ($TW_ERR)"
			TWST_ERR=$((TWST_ERR + 1))
		fi
	done

	# --- JSON check ---
	if cmd_tweak_json >/dev/null 2>&1; then
		o "tweak json                : generated without error"
	else
		o "tweak json                : FAILED"
		TWST_ERR=$((TWST_ERR + 1))
	fi

	o ""
	o "Errors: $TWST_ERR   Warnings: $TWST_WARN"
	oflush
	log INFO "tweak selftest: errors=$TWST_ERR warnings=$TWST_WARN items=$TWST_N"
	[ "$TWST_ERR" -gt 0 ] && return 2
	return 0
}

# ---------------------------------------------------------------------------
# dispatcher - called from main() in bin/pxtune
# ---------------------------------------------------------------------------
tweak_usage() {
	cat <<EOF
pxtune tweak - individual kernel/system tweaks

  pxtune tweak list [cat]       list them (cat: $TW_CATS)
  pxtune tweak categories       categories and counts
  pxtune tweak info <id>        details including the description, stock and current value
  pxtune tweak get <id>         the current value (one line, for scripts)
  pxtune tweak set <id> <val>   set it (captures the stock on first touch)
  pxtune tweak reset <id>       restore to stock and remove from tweaks.conf
  pxtune tweak reset-all        restore everything to stock
  pxtune tweak json [--live]    the registry + state for the WebUI (--live also reads the device)
  pxtune tweak apply-boot       deploy the items flagged 'boot' (called by service.sh)
  pxtune tweak selftest         verifies the registry, the targets and state consistency

State: $TWEAKS_CONF
Stock: $TWEAKS_STOCK
EOF
}

cmd_tweak() {
	_twd="$1"
	[ "$#" -ge 1 ] && shift
	case "$_twd" in
		list)              cmd_tweak_list "$1" ;;
		categories|cats)   cmd_tweak_categories ;;
		info|show)         cmd_tweak_info "$1" ;;
		get)               cmd_tweak_get "$1" ;;
		set)               cmd_tweak_set "$@" ;;
		reset)             cmd_tweak_reset "$1" ;;
		reset-all)         cmd_tweak_reset_all ;;
		json)              cmd_tweak_json "$1" ;;
		apply-boot)        tweak_apply_boot ;;
		selftest)          cmd_tweak_selftest ;;
		-h|--help|help)    tweak_usage ;;
		"")                tweak_usage; exit 1 ;;
		*)                 warn "pxtune: unknown subcommand 'tweak $_twd'"; tweak_usage >&2; exit 1 ;;
	esac
}
