#!/system/bin/sh
# =============================================================================
# pxtune-metrics - a sampler for battery, power draw and temperatures
#
# A standalone program (like pxtune-auto), NOT a library. `pxtune metrics ...`
# only hands control over to it via exec.
#
# WHY IT EXISTS: the module's profiles were designed from measured HW facts, but
# nobody measured their EFFECT (how much lower the skin gets, how much slower
# the battery drains). This sampler collects the data needed to work that out
# afterwards - without it, optimisation is something you can talk about but not
# demonstrate.
#
# WHAT IS STORED: one CSV line per interval into $STATE/metrics/m-YYYYMMDD.csv.
# Nothing is sent anywhere, the files stay on the phone.
#
# COST: one pass = ~20 sysfs reads via `read` (a builtin, no forks) plus one
# `date` and one `sleep`. At the default 60 s that is unmeasurable. The write is
# on the order of 150 B/sample, i.e. ~210 kB/day; kept for KEEP_DAYS days
# (default 7).
#
# THE SIGN OF THE CURRENT - READ THIS BEFORE INTERPRETING THE NUMBERS:
# All that is verified is that while CHARGING `current_now` is POSITIVE (+1.3 A
# on akita). That it is negative while discharging is the usual Android
# convention, but NOBODY HAS SEEN IT ON THIS UNIT YET - charging cannot be
# disabled over adb (the phone has no charge_disable node and a
# charge_stop_level below the current battery level does not force a discharge).
# The first running session on battery will show it; until then, do not argue
# from the sign.
#
# The summary is therefore DELIBERATELY sign independent: the drain is computed
# from charge_counter, which falls monotonically while discharging however the
# current is signed, and the mode is distinguished by the `status` field, not by
# the sign of the current.
# =============================================================================

PXTUNE_METRICS_VERSION="1.0.0"

STATE_DIR="/data/adb/pixel_tune"
MDIR="$STATE_DIR/metrics"
PIDF="$STATE_DIR/pxtune-metrics.pid"
ONF="$STATE_DIR/metrics.on"           # exists = keep sampling after a reboot
CONF="$STATE_DIR/metrics.conf"
LOG_FILE="$STATE_DIR/pxtune.log"
SELF="$0"

DEF_INTERVAL=60
DEF_KEEP_DAYS=7
MIN_INTERVAL=5
MAX_INTERVAL=3600

BATT="/sys/class/power_supply/battery"
USBP="/sys/class/power_supply/usb"
TZ="/dev/thermal/tz-by-name"
CDEV="/dev/thermal/cdev-by-name"
CPUFREQ="/sys/devices/system/cpu/cpufreq"
MALI="/sys/class/misc/mali0/device"
BL="/sys/class/backlight/panel0-backlight/brightness"

CSV_HEADER="ts_epoch,time,profile,backlight,status,battery_pct,current_ua,voltage_uv,power_mw,charge_counter_uah,battery_dc,skin_mc,big_mc,mid_mc,little_mc,g3d_mc,cd_cpu0,cd_cpu1,cd_cpu2,cd_gpu,f_little,f_big,f_prime,f_gpu,perapp"

# ---------------------------------------------------------------------------
# Helper functions
# ---------------------------------------------------------------------------

# rd <path> -> R. The `read` builtin, no fork. A missing node = empty.
rd() {
	R=""
	[ -r "$1" ] || return 0
	IFS= read -r R < "$1" 2>/dev/null || R=""
}

log() {
	_lvl="$1"
	shift
	[ -n "$LOG_TS" ] || LOG_TS=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
	{ print -r -- "[$LOG_TS] [$_lvl] $*" >> "$LOG_FILE"; } 2>/dev/null
}

warn() { print -r -- "$*" >&2; }

# The configuration is NOT SOURCED (a syntax error in the data would take down
# the whole script) - only two known keys are read, via a whitelist.
load_conf() {
	INTERVAL=$DEF_INTERVAL
	KEEP_DAYS=$DEF_KEEP_DAYS
	[ -f "$CONF" ] || return 0
	while IFS='=' read -r _k _v; do
		_v="${_v%%#*}"
		_v="${_v%\"}"; _v="${_v#\"}"
		case "$_k" in
			INTERVAL_SEC) case "$_v" in ''|*[!0-9]*) ;; *) INTERVAL=$_v ;; esac ;;
			KEEP_DAYS)    case "$_v" in ''|*[!0-9]*) ;; *) KEEP_DAYS=$_v ;; esac ;;
		esac
	done < "$CONF"
	[ "$INTERVAL" -lt "$MIN_INTERVAL" ] && INTERVAL=$MIN_INTERVAL
	[ "$INTERVAL" -gt "$MAX_INTERVAL" ] && INTERVAL=$MAX_INTERVAL
	[ "$KEEP_DAYS" -lt 1 ]   && KEEP_DAYS=1
	[ "$KEEP_DAYS" -gt 365 ] && KEEP_DAYS=365
	return 0
}

# ---------------------------------------------------------------------------
# One sample
# ---------------------------------------------------------------------------
sample() {
	# The only fork per sample besides the sleep. Epoch and readable time in one call.
	_now=$(date '+%s,%Y-%m-%d %H:%M:%S' 2>/dev/null)
	_epoch="${_now%%,*}"
	[ -n "$_epoch" ] || return 0

	_day=$(date '+%Y%m%d' 2>/dev/null)
	_f="$MDIR/m-$_day.csv"
	if [ ! -f "$_f" ]; then
		{ print -r -- "$CSV_HEADER" > "$_f"; } 2>/dev/null
		chmod 0600 "$_f" 2>/dev/null
		purge_old
	fi

	rd "$BATT/capacity";       _pct=$R
	rd "$BATT/current_now";    _cur=$R
	rd "$BATT/voltage_now";    _vol=$R
	rd "$BATT/charge_counter"; _cc=$R
	rd "$BATT/temp";           _btemp=$R
	rd "$BATT/status";         _st=$R

	# Power in mW. The division happens BEFORE the multiplication so that even
	# charging fits into 64-bit arithmetic (1.5 A x 4.3 V would otherwise be ~6.5e12).
	_pw=""
	case "$_cur$_vol" in
		''|*[!0-9-]*) ;;
		*) _pw=$(( (_cur / 1000) * (_vol / 1000) / 1000 )) ;;
	esac

	rd "$TZ/quiet_therm/temp"; _skin=$R
	rd "$TZ/BIG/temp";         _jb=$R
	rd "$TZ/MID/temp";         _jm=$R
	rd "$TZ/LITTLE/temp";      _jl=$R
	rd "$TZ/G3D/temp";         _jg=$R

	rd "$CDEV/thermal-cpufreq-0/cur_state"; _c0=$R
	rd "$CDEV/thermal-cpufreq-1/cur_state"; _c1=$R
	rd "$CDEV/thermal-cpufreq-2/cur_state"; _c2=$R
	rd "$CDEV/thermal-gpufreq-0/cur_state"; _cg=$R

	rd "$CPUFREQ/policy0/scaling_cur_freq"; _f0=$R
	rd "$CPUFREQ/policy4/scaling_cur_freq"; _f4=$R
	rd "$CPUFREQ/policy8/scaling_cur_freq"; _f8=$R
	rd "$MALI/cur_freq";                    _fg=$R

	rd "$BL"; _bl=$R
	rd "$STATE_DIR/active"; _prof=$R

	# The package layer 3 is CURRENTLY deployed for (empty = none).
	# Deliberately appmode.active, NOT appmode.gamestamp: gamestamp is only a rate
	# limit for GAME_APPLY=enter and keeps the last game in it long after leaving
	# it (verified - pogo then stuck to the CSV even when no rule was running).
	_pkg=""
	if [ -f "$STATE_DIR/appmode.active" ]; then
		rd "$STATE_DIR/appmode.active"
		_pkg="${R%% *}"
	fi

	{
		print -r -- "$_now,$_prof,$_bl,$_st,$_pct,$_cur,$_vol,$_pw,$_cc,$_btemp,$_skin,$_jb,$_jm,$_jl,$_jg,$_c0,$_c1,$_c2,$_cg,$_f0,$_f4,$_f8,$_fg,$_pkg" >> "$_f"
	} 2>/dev/null
	return 0
}

# Deletes files older than KEEP_DAYS. Called only when a new day is started,
# i.e. at most once every 24 h - `find` is a fork, but an insignificant one.
purge_old() {
	[ -d "$MDIR" ] || return 0
	find "$MDIR" -name 'm-*.csv' -mtime "+$KEEP_DAYS" -delete 2>/dev/null
	return 0
}

# ---------------------------------------------------------------------------
# Daemon mode
# ---------------------------------------------------------------------------
cleanup() {
	rm -f "$PIDF" 2>/dev/null
	exit 0
}

do_run() {
	load_conf
	mkdir -p "$MDIR" 2>/dev/null
	chmod 0700 "$MDIR" 2>/dev/null
	{ print -r -- "$$" > "$PIDF"; } 2>/dev/null
	trap cleanup TERM INT HUP
	log INFO "[metrics] start (pid $$, interval ${INTERVAL}s, keeping ${KEEP_DAYS} days)"
	while :; do
		sample
		sleep "$INTERVAL"
		# The configuration is re-read so the interval can be changed without a restart.
		load_conf
	done
}

do_start() {
	if [ -f "$PIDF" ]; then
		read -r _op < "$PIDF" 2>/dev/null
		if [ -n "$_op" ] && [ -d "/proc/$_op" ]; then
			echo "already running (pid $_op)"
			return 0
		fi
	fi
	# Orphaned instances after a crash/kill - the same problem and the same
	# solution as in pxtune-auto: search by command line, not by pidfile.
	# PERFORMANCE: the naive version forked `tr` for EVERY process in /proc (~1000
	# forks). At boot that took 33 s and delayed service.sh by that much. The
	# prefilter via /proc/PID/comm is the `read` builtin (no fork) and only a
	# handful get through - the daemon runs as `sh`, so anything else can be
	# discarded straight away.
	_self=$$
	for _p in /proc/[0-9]*; do
		_pp="${_p##*/}"
		[ "$_pp" = "$_self" ] && continue
		_cm=""
		IFS= read -r _cm < "$_p/comm" 2>/dev/null || continue
		case "$_cm" in
			sh|mksh|busybox) ;;
			*) continue ;;
		esac
		# The braces are necessary: when a process disappears between the glob and
		# the read, THE REDIRECTION ITSELF fails and the message is printed by the
		# shell, not by `tr` - so a `2>/dev/null` after the command would not catch it.
		{ _cl=$(tr '\0' ' ' < "$_p/cmdline"); } 2>/dev/null || continue
		case "$_cl" in
			*pxtune-metrics*run*) kill -KILL "$_pp" 2>/dev/null ;;
		esac
	done
	rm -f "$PIDF" 2>/dev/null

	{ print -r -- "enabled $(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)" > "$ONF"; } 2>/dev/null
	if command -v setsid >/dev/null 2>&1; then
		setsid "$SELF" run >/dev/null 2>&1 &
	else
		"$SELF" run >/dev/null 2>&1 &
	fi
	sleep 1
	do_status
	return 0
}

do_stop() {
	rm -f "$ONF" 2>/dev/null
	if [ -f "$PIDF" ]; then
		read -r _op < "$PIDF" 2>/dev/null
		if [ -n "$_op" ]; then
			kill -TERM "$_op" 2>/dev/null
			sleep 1
			[ -d "/proc/$_op" ] && kill -KILL "$_op" 2>/dev/null
		fi
	fi
	rm -f "$PIDF" 2>/dev/null
	log INFO "[metrics] stopped"
	echo "sampling stopped (the data stays in $MDIR)"
	return 0
}

do_status() {
	load_conf
	_pid=""
	[ -f "$PIDF" ] && read -r _pid < "$PIDF" 2>/dev/null
	if [ -n "$_pid" ] && [ -d "/proc/$_pid" ]; then
		echo "sampling RUNNING (pid $_pid, interval ${INTERVAL}s, keeping ${KEEP_DAYS} days)"
	else
		echo "sampling NOT RUNNING"
	fi
	echo "starts after a reboot: $([ -f "$ONF" ] && echo yes || echo no)"
	echo "data: $MDIR"
	if [ -d "$MDIR" ]; then
		for _f in "$MDIR"/m-*.csv; do
			[ -f "$_f" ] || continue
			_n=$(wc -l < "$_f" 2>/dev/null)
			_sz=$(stat -c %s "$_f" 2>/dev/null)
			echo "  ${_f##*/}  ${_n:-0} lines  ${_sz:-0} B"
		done
	fi
	echo
	echo "SIGN: while charging current_now is POSITIVE (verified). That it is"
	echo "      negative while discharging is the Android convention, but on this"
	echo "      unit it is not verified yet - the first session on battery will show it."
	echo "      'summary' is sign independent (it computes from charge_counter)."
	return 0
}

# ---------------------------------------------------------------------------
# Printing the data
# ---------------------------------------------------------------------------
do_dump() {
	[ -d "$MDIR" ] || { warn "no data ($MDIR does not exist)"; return 1; }
	_any=0
	for _f in "$MDIR"/m-*.csv; do
		[ -f "$_f" ] || continue
		if [ "$_any" = "0" ]; then
			cat "$_f"
			_any=1
		else
			# we already have the header
			sed -n '2,$p' "$_f"
		fi
	done
	[ "$_any" = "1" ] || { warn "no data"; return 1; }
	return 0
}

# A per-profile summary: drain, battery loss per hour, temperatures.
#
# Computed ONLY from lines where the phone was off the charger - otherwise
# "consumption" would be measuring the charger. The drain is taken from
# charge_counter (uAh), which falls monotonically while discharging; it is a
# unit that depends neither on the sign of current_now (see the file header) nor
# on instantaneous noise.
do_summary() {
	[ -d "$MDIR" ] || { warn "no data"; return 1; }
	command -v awk >/dev/null 2>&1 || { warn "awk is not available"; return 1; }
	do_dump | awk -F, '
	NR==1 { next }
	$1=="" { next }
	{
		prof=$3; if (prof=="") prof="(none)"
		st=$5
		if (st != "Discharging" && st != "Not charging") { skipped++; next }
		n[prof]++
		apw[prof] += ($9 < 0 ? -$9 : $9)
		skin[prof]+=$12
		if ($12>maxskin[prof]) maxskin[prof]=$12
		big[prof]+=$13
		if (first[prof]=="") { first[prof]=$1; fpct[prof]=$6; fcc[prof]=$10 }
		last[prof]=$1; lpct[prof]=$6; lcc[prof]=$10
	}
	END {
		if (length(n)==0) {
				print "No discharge data - all " skipped " samples are from the charger."
				print "Unplug the phone and let it sample for at least an hour."
			exit
		}
		printf "%-12s %6s %8s %9s %9s %9s %9s %9s\n", \
				"profile","samples","minutes","drain_mA","%/hour","skin_avg","skin_max","BIG_avg"
		for (p in n) {
			dt = last[p] - first[p]
			rate = (dt>0) ? (fpct[p]-lpct[p])*3600.0/dt : 0
			ma   = (dt>0) ? (fcc[p]-lcc[p])*3.6/dt : 0
			printf "%-12s %6d %8.1f %9.0f %9.2f %9.1f %9.1f %9.1f\n", \
				p, n[p], dt/60.0, ma, rate, skin[p]/n[p]/1000, maxskin[p]/1000, big[p]/n[p]/1000
		}
		print ""
			print "drain_mA: from the charge_counter drop over time (independent of the current sign)."
			print "%/hour  : battery percent lost per hour."
			print "Temperatures in degrees C. Samples from the charger skipped: " skipped+0 "."
			print ""
			print "CAUTION: the numbers only make sense under COMPARABLE load. An hour of"
			print "reading on powersave and an hour of gaming on game cannot be compared."
	}'
	return 0
}

usage() {
	cat <<EOF
pxtune metrics - sampling of battery, power draw and temperatures ($PXTUNE_METRICS_VERSION)

  pxtune metrics start            start sampling (survives a reboot)
  pxtune metrics stop             stop it (the data stays)
  pxtune metrics status           running? how much data?
  pxtune metrics dump             print all data as CSV (to stdout)
  pxtune metrics summary          a per-profile summary (from discharge only)
  pxtune metrics purge            delete all collected data

  pxtune metrics run              INTERNAL - the sampling loop itself

Settings: $CONF
  INTERVAL_SEC=60                 how often to sample ($MIN_INTERVAL-$MAX_INTERVAL)
  KEEP_DAYS=7                     how many days of data to keep

Data: $MDIR/m-YYYYMMDD.csv
Downloading to a computer:
  adb shell 'su -c "pxtune metrics dump"' > metrics.csv
EOF
}

do_purge() {
	rm -f "$MDIR"/m-*.csv 2>/dev/null
	echo "data deleted"
	return 0
}

_c="$1"
[ "$#" -ge 1 ] && shift
case "$_c" in
	start)   do_start ;;
	stop)    do_stop ;;
	status)  do_status ;;
	run)     do_run ;;
	dump)    do_dump ;;
	summary) do_summary ;;
	purge)   do_purge ;;
	-h|--help|help|"") usage; [ -z "$_c" ] && exit 1; exit 0 ;;
	*) warn "pxtune metrics: unknown subcommand '$_c'"; usage >&2; exit 1 ;;
esac
exit $?
