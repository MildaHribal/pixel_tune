# =============================================================================
# pixel_tune - per-app rule template
#
# Copy to /data/adb/pixel_tune/apps/<package>.conf and edit,
# OR (recommended) use the CLI, which validates the values for you:
#
#   pxtune app set com.nianticlabs.pokemongo \
#       APP_DESC="Pokemon GO" APP_PROFILE=game GAME_MODE=2 GAME_FPS=60
#
# ONE FILE PER PACKAGE. The file name MUST be <package>.conf - looking a rule
# up is then a `[ -f ]`, i.e. ZERO forks per foreground event.
# (Measured on this device: fork ~7.7 ms, builtin read 0.44 ms.)
#
# Format: KEY=VALUE, one pair per line. Quotes optional.
# AN EMPTY VALUE OR A MISSING KEY = LEAVE IT ALONE.
# The file is NOT SOURCED - it is read by a dedicated parser in
# bin/pxtune-perapp, so a corrupted or planted file cannot execute anything.
#
# -----------------------------------------------------------------------------
# THREE LAYERS, EACH WITH DIFFERENT PROPERTIES
# -----------------------------------------------------------------------------
#
#  layer 1  Android Game Mode (cmd game)     GENUINELY per-app  no restore needed,
#                                                               the system keeps it
#  layer 2  pxtune profile (uclamp/GPU/vm)   global             restore is FREE -
#                                                               profile_apply() calls
#                                                               restore_stock_values()
#  layer 3  refresh rate, resolution         global             MUST BE RESTORED
#                                                               EXPLICITLY
#
# Layer 3 is deliberately small precisely because it is the only one that
# needs restoring.
#
# -----------------------------------------------------------------------------
# PRIORITY ORDER (hard-coded, CANNOT be overridden by configuration)
# -----------------------------------------------------------------------------
#
#   manual override  >  thermal/battery cap  >  per-app rule
#                                            >  adaptive daemon
# =============================================================================


# --- identity ----------------------------------------------------------------

# Package name. Must match the file name.
APP_PKG="com.nianticlabs.pokemongo"

# Description for `pxtune app list` and the WebUI. Text only, used for nothing.
APP_DESC="Pokemon GO - an outdoor game, the phone is often in the sun"

# 1 = the rule is in service, 0 = it sits here but is ignored.
# Disabling a rule for the currently running app removes layer 3 immediately.
APP_ENABLED="1"


# =============================================================================
# LAYER 1 - Android Game Mode
#
# The only layer that is GENUINELY per-app: the GameManager remembers the
# setting itself and applies it only to this package. Nothing has to be
# restored.
#
# Written ONLY on `pxtune app set` and `pxtune app sync` - NEVER from the
# daemon. `cmd` is binder and the daemon has a NO BINDER rule.
#
# NOT VERIFIED ON THIS DEVICE (see the verification commands in the docs):
#   - does the GameManager consider Pokemon GO a game? If not, all of layer 1
#     falls away for this app and layers 2 and 3 remain.
#   - do `--fps` / `--downscale` survive a reboot? If not, use GAME_APPLY=enter.
# =============================================================================

# 1|standard  2|performance  3|battery  4|custom
GAME_MODE="2"

# Frame rate cap. 0 = no limit.
# For PoGO 30 or 60 makes sense - the game itself offers 60 at most.
GAME_FPS="60"

# Render scale: 0.3 to 0.9 (fraction of native resolution), or `disable`.
# THIS is the safe route to "lowering the resolution" - it is per-app, it is
# done by SurfaceFlinger and NOTHING has to be restored. Unlike APP_RES below.
GAME_DOWNSCALE="0.7"

# once  = layer 1 is written only on `app set` / `app sync` (DEFAULT)
# enter = additionally re-applied on every entry into the app, but at most
#         once every 5 minutes. Use ONLY once it is verified that
#         `cmd game set` does not survive a reboot.
GAME_APPLY="once"


# =============================================================================
# LAYER 2 - pxtune profile
#
# The profile is GLOBAL, not per-app. Restoring costs nothing though:
# profile_apply() calls restore_stock_values() as its first step, so switching
# to any other profile returns everything to the values in backup/stock.conf.
#
# It is deployed by the daemon (target_profile step 3b), not by `app enter`.
# When the daemon is not running (pxtune auto off), `app enter` deploys it
# itself.
# =============================================================================

# Profile name from /data/adb/pixel_tune/profiles/<name>.conf.
# Empty = leave the choice to the adaptive daemon.
APP_PROFILE="game"

# APP_OVERLAY_<profile key> overrides a single key of the chosen profile only
# while this app is in the foreground. The allowed keys are exactly the
# profile contract keys from SPEC.md:
#
#   UCLAMP_TOPAPP_MIN  UCLAMP_TOPAPP_MAX  UCLAMP_FG_MIN   UCLAMP_FG_MAX
#   UCLAMP_BG_MIN      UCLAMP_BG_MAX      UCLAMP_SYSBG_MIN UCLAMP_SYSBG_MAX
#   GPU_MAX_FREQ       GPU_MIN_FREQ       GPU_POWER_POLICY
#   THERMAL_PROFILE_CPU_MID  THERMAL_PROFILE_CPU_HIGH
#   VM_SWAPPINESS  VM_DIRTY_RATIO  VM_DIRTY_BG_RATIO  VM_VFS_CACHE_PRESSURE
#   IO_READAHEAD_KB  CHARGE_STOP_LEVEL
#
# Example: PoGO is light on the GPU but runs for hours on end in the sun.
# Capping the GPU at 723 MHz (from 890) costs a few frames and a lot of heat.
# The GPU frequency MUST come from the list in SPEC.md:
#   150000 302000 337000 376000 419000 467000 521000 580000 649000
#   723000 807000 850000 890000
APP_OVERLAY_GPU_MAX_FREQ="723000"

# uclamp is the main lever (0-100 or "max"). The thermal HAL does not
# overwrite it.
#APP_OVERLAY_UCLAMP_TOPAPP_MIN="30"
#APP_OVERLAY_UCLAMP_BG_MAX="30"


# =============================================================================
# LAYER 3 - refresh rate and resolution
#
# GLOBAL and the only one that MUST BE EXPLICITLY RESTORED. The restore state
# lives in /data/adb/pixel_tune/appmode.active and is written BEFORE applying.
# `pxtune app leave` is idempotent and is called from SIX independent paths
# (a normal exit, screen off, daemon shutdown, start after a crash, reboot via
#  service.sh, `pxtune revert`).
# =============================================================================

# ---- refresh rate -----------------------------------------------------------
#
# DISABLED IN CODE until the key names are verified.
# I DO NOT KNOW what the refresh rate keys are really called on Android 16.
# bin/pxtune-perapp has REFRESH_VERIFIED=0, and until someone writes 1 there,
# these two keys are only logged and NOT APPLIED.
#
# Allowed values: 60 90 120  (SPEC: the panel is adaptive 60-120 Hz, mode 2 = 120)
# SPEC, hard constraint #4: the refresh rate is never lowered GLOBALLY.
# Lowering it here is per-app and temporary - which is why it is admissible,
# but only with a working restore.
#
# For PoGO the opposite of a benchmark applies: the game runs for hours and
# 120 Hz costs more energy than it delivers. 60/60 = a fixed 60 Hz for the
# duration of the game.
APP_REFRESH_MIN="60"
APP_REFRESH_PEAK="60"

# ---- resolution -------------------------------------------------------------
#
# !!! CHANGING THE RESOLUTION IS FORBIDDEN UNTIL YOU EXPLICITLY ALLOW IT !!!
#
# APP_RES_ENABLE DEFAULTS TO 0 IN THE CODE ITSELF (bin/pxtune-perapp,
# APP_RES_ENABLE_DEFAULT). A missing key = 0, not 1. When it is 0, APP_RES is
# ignored and this is logged once per session as a WARN.
#
# If you do enable it, the change MUST go through `pxtune res <preset>`, which
# deploys the existing safety net: res_pending + res_arm_watchdog() = a return
# to native after 60 s if `pxtune res confirm` does not arrive.
#
# BEFORE YOU ENABLE IT, CONSIDER GAME_DOWNSCALE ABOVE. It does almost the same
# thing, is genuinely per-app, is done by SurfaceFlinger and NOTHING HAS TO BE
# RESTORED.
#
# Presets (must match RES_PRESETS in bin/pxtune):
#   native  900x2000  810x1800  720x1600
APP_RES=""
APP_RES_ENABLE="0"


# =============================================================================
# ANTI-FLAPPING - DELIBERATELY ASYMMETRIC
# =============================================================================

# ENTRY IS DELAYED.
# After a foreground event, `@APPARM <pkg>` is scheduled into the daemon's
# FIFO APP_MIN_FG_SEC seconds later, and when processed it VERIFIES that the
# package is still in the foreground. An app start produces 2-5 events over
# ~2 s (splash -> main activity), so quickly flicking through apps triggers
# NOTHING AT ALL.
APP_MIN_FG_SEC="8"

# EXIT IS LAZY.
# After an exit, `@APPLEAVE` is scheduled APP_STICKY_SEC seconds later.
# Returning to the same package sooner = the event is dropped. An alt-tab to
# messages and back therefore costs NOT A SINGLE binder call.
# 0 = no laziness (leave immediately). Maximum 3600.
APP_STICKY_SEC="25"


# =============================================================================
# TEMPERATURE AND PRIORITY
# =============================================================================

# 1 = this app may ignore THERMAL LEVEL 1 (skin >= 41.0 C).
#
# NEVER LEVEL >= 2. That is hard-coded and no configuration will change it.
# Without this you would cook the phone in PoGO: the game runs for hours,
# often in direct sunlight, and the measured self-heating ceiling under full
# load on all 9 cores is 40.5 C - everything above that is external heat that
# the load cannot do anything about.
APP_THERMAL_CAP="1"

# 0-100, default 50.
# When layer 3 is currently held by another package and its sticky window is
# still running, only a rule with the SAME OR HIGHER priority will displace
# it. Thanks to that, a notification or a quick reply in messages will not
# take down the settings of a running game.
APP_PRIORITY="90"
